# bot.relay: relay alone, taking reports and carrying the outbox. long running
# generated by `make env-examples`, do not edit by hand
NEMO_ROLE=bot.relay

# required
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
RELAY_BOT_TOKEN=
RELAY_APP_TOKEN=

# optional
PIPELINE_DB_USER=
PIPELINE_DB_PASSWORD=
ANONYMOUS_ICON_URL=
APP_HOST=
EXEMPT_BOT_IDS=
FD_DEACTIVATE=log
FD_SESSION_RESET=log
FD_SESSION_RESET_MAX=5
FD_SESSION_RESET_STRIKES=2
INTAKE_FILE_MAX_BYTES=
LOG_LEVEL=
INTERNAL_PROXY_URL=
NEMO_JOIN_PACE_SECONDS=
NEMO_JOIN_PER_SWEEP=
NEMO_JOIN_SECONDS=
NEMO_SWEEP_SECONDS=
PROXY_TOKEN_NEMO=
RELAY_SWEEP_SECONDS=
TZ=UTC
NEMO_BOT_TOKEN=
NEMO_APP_TOKEN=
INTERNAL_LOG_CHANNEL_ID=
SLACK_TEAM_ID=
