# sync: the nightly sync worker. long running
# generated by `make env-examples`, do not edit by hand
NEMO_ROLE=sync

# required
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
INTERNAL_PROXY_URL=
INTERNAL_PROXY_TOKEN=

# optional
PIPELINE_DB_USER=
PIPELINE_DB_PASSWORD=
DBT_DB_USER=
DBT_DB_PASSWORD=
SLACK_BOT_TOKEN=
SLACK_ADMIN_TOKEN=
SLACK_TEAM_ID=
NIGHTLY_AT=03:00
NIGHTLY_RUN_AT_START=false
SYNC_POLL_SECONDS=60
PROXY_ALLOW_PLAINTEXT=
MEMBER_HISTORY_LIMIT=
FIRST_REPLY_LIMIT=
TZ=UTC
