# collect: the slack events listener. long running
# generated by `make env-examples`, do not edit by hand
NEMO_ROLE=collect

# required
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# optional
PIPELINE_DB_USER=
PIPELINE_DB_PASSWORD=
SLACK_TEAM_ID=
TZ=UTC
