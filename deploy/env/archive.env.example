# archive: channel history, thread replies and event projection. long running
# generated by `make env-examples`, do not edit by hand
NEMO_ROLE=archive

# required
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
INTERNAL_PROXY_URL=
INTERNAL_PROXY_TOKEN=

# optional
PIPELINE_DB_USER=
PIPELINE_DB_PASSWORD=
ARCHIVE_POLL_SECONDS=300
ARCHIVE_HISTORY_BATCH=
ARCHIVE_REPLIES_BUDGET=
CHANNEL_TAIL_LOOKBACK_DAYS=
PROXY_ALLOW_PLAINTEXT=
SLACK_TEAM_ID=
TZ=UTC
