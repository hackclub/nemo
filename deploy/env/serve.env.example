# serve: the dashboard. the only role with a public URL
# generated by `make env-examples`, do not edit by hand
NEMO_ROLE=serve

# required
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_HOST=

# optional
RAILS_DB_USER=
RAILS_DB_PASSWORD=
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
HCA_ISSUER=https://auth.hackclub.com
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
HCA_REDIRECT_URI=
NEMO_CLIENT_ID=
NEMO_CLIENT_SECRET=
SLACK_TEAM_ID=
FIREHOUSE_CHANNEL_ID=
FD_ENCRYPTION_PRIMARY_KEY=
FD_ENCRYPTION_DETERMINISTIC_KEY=
FD_ENCRYPTION_SALT=
INTERNAL_PROXY_URL=
PROXY_TOKEN_WEB=
PROXY_ALLOW_PLAINTEXT=
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
RAILS_LOG_LEVEL=info
TLS_DOMAIN=
BOOTSTRAP_ADMIN_SLACK_ID=
TZ=UTC
