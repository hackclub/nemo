POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mnemosyne
POSTGRES_TEST_DB=mnemosyne_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# optional. every service falls back to POSTGRES_USER and POSTGRES_PASSWORD.
# set these to give each service its own postgres role, which is what keeps
# analytics out of fd.member and keeps the dashboard from rewriting fd.audit.
PIPELINE_DB_USER=pipeline_writer
PIPELINE_DB_PASSWORD=change_me
DBT_DB_USER=dbt_owner
DBT_DB_PASSWORD=change_me
RAILS_DB_USER=rails_app
RAILS_DB_PASSWORD=change_me

BOOTSTRAP_ADMIN_SLACK_ID=

INTERNAL_PROXY_URL=https://proxy.example.com
INTERNAL_PROXY_TOKEN=change_me_to_match_the_proxy
PROXY_TOKEN_WEB=change_me_to_match_the_proxy
CONTAINER_PROXY_URL=
PROXY_ALLOW_PLAINTEXT=false

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=

NEMO_CLIENT_ID=
NEMO_CLIENT_SECRET=
