<% content_for :page_title, "Access requests" %>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Requests</h2>
      <p class="card-sub"><%= @waiting %> waiting</p>
    </div>
  </div>

  <% if @rows.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>App</th>
            <th>Owner</th>
            <th>State</th>
            <th>By</th>
            <th class="col-date">When</th>
            <th class="col-btn"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |asked| %>
            <tr>
              <td>
                <span class="row-name">
                  <%= face(asked.app.owner_user_id) %>
                  <b><%= asked.app.name %></b>
                </span>
              </td>
              <td class="sub"><%= names[asked.app.owner_user_id] %></td>
              <td><%= access_state_chip(asked.state) %></td>
              <td class="sub"><%= asked.decided_by ? names[asked.decided_by] : "" %></td>
              <td class="col-date">
                <%= time_ago_in_words(asked.decided_at || asked.created_at) %> ago
              </td>
              <td class="col-btn">
                <% if asked.pending? %>
                  <button type="button" class="btn btn-sm" data-modal-open="settle-<%= asked.id %>" aria-haspopup="dialog">Review</button>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title">No requests</p>
    </div>
  <% end %>
</div>

<% @rows.select(&:pending?).each do |asked| %>
  <%= render "settings/requests/settle", asked: asked %>
<% end %>
