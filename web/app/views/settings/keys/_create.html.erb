<%= render layout: "fd/modal", locals: { id: "mint-#{app.id}",
      title: @secret.present? ? "Your key" : "New key", sub: app.name,
      open: @secret.present? && @token&.app_id == app.id } do %>
  <% if @secret.present? %>
    <div class="modal-body">
      <p class="warn-line">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5"/><path d="M12 16.5v.4"/></svg>
        <span>Shown once. If you need it again, you&rsquo;ve to rotate it</span>
      </p>
      <div class="secret">
        <code><%= @secret %></code>
        <button type="button" class="btn btn-primary" data-controller="copy"
                data-copy-id-value="<%= @secret %>" data-action="copy#write">Copy</button>
      </div>
    </div>
    <div class="modal-foot">
      <%= link_to "Done", settings_keys_path, class: "btn btn-primary" %>
    </div>
  <% else %>
    <%= form_with url: settings_tokens_path, method: :post,
          data: { turbo: false }, html: { autocomplete: "off" } do %>
        <%= hidden_field_tag :app_id, app.id, id: nil %>
      <div class="modal-body form-body">
        <label class="field-label">
          Name
          <%= text_field_tag :name, nil, id: nil, class: "input", maxlength: Api::Token::MAX_NAME,
                placeholder: "Toolbox", autofocus: true %>
        </label>
        <label class="field-label">
          Expires
          <%= select_tag :lasting,
                options_for_select(Api::Token::LIFE_WORDS.map { |key, label| [label, key] },
                  Api::Token::DEFAULT_LIFE), id: nil, class: "select" %>
        </label>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
        <%= submit_tag "Generate", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>
