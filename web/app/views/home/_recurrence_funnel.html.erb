<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Onboarding recurrence</h2>
      <% if recurrence_funnel %>
        <p class="card-sub">of <%= number_with_delimiter(recurrence_funnel.total_members) %> total known members</p>
      <% end %>
    </div>
    <% if recurrence_cohort_months.present? %>
      <div class="card-tools">
        <select
          class="select"
          aria-label="cohort month"
          data-recurrence-funnel-target="select"
          data-action="recurrence-funnel#change"
        >
          <% recurrence_cohort_months.each do |m| %>
            <option value="<%= m.iso8601 %>" <%= "selected" if recurrence_month == m %>><%= m.strftime("%b %Y") %></option>
          <% end %>
        </select>
      </div>
    <% end %>
  </div>

  <% if recurrence_funnel %>
    <div style="height: 220px;">
      <canvas
        data-controller="chart"
        data-chart-type-value="bar"
        data-chart-data-value="<%= {
          labels: ["Created account", "Signed in", "Sent message", "Returned next day", "3rd visit in 7 days", "4th visit in 14 days"],
          datasets: [{
            label: "members",
            data: [
              recurrence_funnel.created_account,
              recurrence_funnel.signed_in,
              recurrence_funnel.sent_message,
              recurrence_funnel.returned_next_day,
              recurrence_funnel.third_visit_in_7_days,
              recurrence_funnel.fourth_visit_in_14_days
            ]
          }]
        }.to_json %>"
        data-chart-options-value="<%= { indexAxis: "y", maintainAspectRatio: false, plugins: { legend: { display: false } } }.to_json %>"
      ></canvas>
    </div>
    <% unless recurrence_funnel.visits_knowable %>
      <p class="card-note">
        <span class="chip chip-off">n/a</span>
        the visit steps need 15 consecutive days of member activity data after a first post, and the
        daily snapshots have gaps
      </p>
    <% end %>
  <% else %>
    <p class="card-note">no data loaded yet</p>
  <% end %>
</div>
