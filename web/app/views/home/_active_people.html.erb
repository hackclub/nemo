<% s = activity_series(activity_trend, granularity) %>

<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Active people in the workspace</h2>
      <p class="card-sub">last <%= s[:span] %></p>
    </div>
  </div>
  <div
    data-controller="chart"
    data-chart-kind-value="bars"
    data-chart-height-value="240"
    data-chart-data-value="<%= {
      labels: s[:labels],
      datasets: [
        { label: s[:people_label], data: s[:people] },
        { label: s[:posted_label], data: s[:posted] }
      ]
    }.to_json %>"
  ></div>
  <div
    data-controller="chart"
    data-chart-kind-value="line"
    data-chart-height-value="120"
    data-chart-pct-value="true"
    data-chart-data-value="<%= {
      labels: s[:labels],
      datasets: [{ label: "share of active who posted", data: s[:posted_share] }]
    }.to_json %>"
  ></div>
</div>
