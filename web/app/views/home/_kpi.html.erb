<div class="metric">
  <span class="metric-key"><%= label %></span>
  <span class="metric-value"><%= number_with_delimiter(value) %></span>

  <% if local_assigns[:spark] && spark[:data].compact.many? %>
    <span class="metric-spark"
          title="<%= local_assigns[:spark_title] %>"
          data-controller="chart"
          data-chart-kind-value="line"
          data-chart-spark-value="true"
          data-chart-days-value="true"
          data-chart-height-value="34"
          data-chart-data-value="<%= {
            labels: spark[:labels],
            datasets: [{ label: spark[:name], data: spark[:data] }]
          }.to_json %>"></span>
  <% end %>

  <span class="metric-note">
    <% if prior %>
      <%= delta_chip(value, prior) %>
      <span>vs previous <%= span[:label] %></span>
    <% else %>
      <span>no prior <%= span[:label] %> held</span>
    <% end %>
  </span>
</div>
