<% content_for :page_title, "Overview" %>
<% content_for :page_badge do %>
  <%= as_of_badge(@team_stats&.ds) %>
<% end %>

<% if @team_stats.nil? %>
  <div class="card">
    <div class="card-head">
      <div>
        <h2 class="card-title">No team statistics loaded</h2>
        <p class="card-sub">the headline figures come from Slack&rsquo;s team.stats pull</p>
      </div>
    </div>
    <p class="delta-note">
      Run the nightly sync, or the team_stats stage on its own, from the Engine page.
    </p>
  </div>
<% else %>
  <div class="kpis">
    <% [
      ["Total members", "(Slack's count today)", @team_stats.total_members_count,
       delta_chip(@team_stats.total_members_count, @team_stats_prior&.total_members_count),
       "vs 28 days earlier"],
      ["Claimed accounts", nil, @team_stats.total_claimed_count,
       share_chip(@team_stats.total_claimed_count, @team_stats.total_members_count),
       "of the members Slack counts today"],
      ["Active, last 28 days", "(posted or read)", @team_stats.active_users_28d,
       delta_chip(@team_stats.active_users_28d, @team_stats_prior&.active_users_28d),
       "vs 28 days earlier"],
      ["Posted, last 28 days", nil, @team_stats.writers_count_28d,
       share_chip(@team_stats.writers_count_28d, @team_stats.active_users_28d),
       "of active members"]
    ].each do |label, qualifier, value, chip, note| %>
      <div class="card">
        <p class="kpi-label">
          <%= label %><% if qualifier %> <span class="delta-note"><%= qualifier %></span><% end %>
        </p>
        <p class="kpi-val"><%= number_with_delimiter(value) %></p>
        <div class="delta">
          <%= chip %>
          <span class="delta-note"><%= note %></span>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<div data-controller="people-granularity" data-people-granularity-url-value="<%= root_path %>">
  <div data-people-granularity-target="container">
    <%= render "active_people", activity_trend: @people_trend, granularity: @people_granularity %>
  </div>
</div>

<div data-controller="messages-granularity" data-messages-granularity-url-value="<%= root_path %>">
  <div data-messages-granularity-target="container">
    <%= render "member_messages", activity_trend: @messages_trend, granularity: @messages_granularity %>
  </div>
</div>

<div id="acquisition" data-controller="growth-months" data-growth-months-url-value="<%= root_path %>">
  <div data-growth-months-target="container">
    <%= render "growth", growth_months: @growth_months, growth_span: @growth_span %>
  </div>
</div>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Monthly cohorts</h2>
      <p class="card-sub">members who joined each month, from their all-time message history</p>
    </div>
  </div>
  <% if @monthly_cohorts.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>cohort</th>
            <th class="col-num">members</th>
            <th class="col-num">ever posted</th>
            <th class="col-num">posted in 30d</th>
            <th class="col-num">median days</th>
          </tr>
        </thead>
        <tbody>
          <% @monthly_cohorts.each do |c| %>
            <tr>
              <td>
                <span class="two-line">
                  <b><%= c.cohort_month.strftime("%b %Y") %></b>
                  <% unless c.complete? %>
                    <span><%= number_with_delimiter(c.searched) %> of <%= number_with_delimiter(c.members) %> searched</span>
                  <% end %>
                </span>
              </td>
              <td><%= number_with_delimiter(c.members) %></td>
              <% if c.complete? %>
                <td><%= number_to_percentage(c.ever_posted.to_f / c.members * 100, precision: 1) %></td>
                <td><%= number_to_percentage(c.posted_within_30d.to_f / c.members * 100, precision: 1) %></td>
                <td><%= c.median_days_to_first_post || "n/a" %></td>
              <% else %>
                <td>n/a</td>
                <td>n/a</td>
                <td>n/a</td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">
      No cohort has been searched yet. The member history backfill fills this in, newest months first.
    </p>
  <% end %>
</div>

<div class="grid-2-1">
  <div class="card card-stretch">
    <div class="card-head">
      <div>
        <h2 class="card-title">Activity distribution</h2>
        <% coverage = @activity_bands.first %>
        <p class="card-sub">
          messages posted over each member&rsquo;s whole history &middot;
          <%= number_with_delimiter(@activity_bands.sum(&:members)) %> of
          <%= number_with_delimiter(coverage&.workspace_members) %> members searched
          <% if coverage && window_note(coverage.window_start, coverage.window_end) %>
            &middot; searched <%= window_note(coverage.window_start, coverage.window_end) %>
          <% end %>
        </p>
      </div>
    </div>
    <% total_banded = @activity_bands.sum(&:members) %>
    <div class="band">
      <% @activity_bands.each do |b| %>
        <i class="band-<%= b.band_order %>" style="width:<%= total_banded.positive? ? (b.members.to_f / total_banded * 100).round(2) : 0 %>%"></i>
      <% end %>
    </div>
    <div class="band-list">
      <% @activity_bands.each do |b| %>
        <div class="band-item">
          <i class="band-<%= b.band_order %>"></i>
          <span><%= b.band_order.zero? ? b.activity_band : "messages posted: #{b.activity_band}" %></span>
          <b>
            <%= number_with_delimiter(b.members) %> &middot;
            <%= total_banded.positive? ? number_to_percentage((b.members.to_f / total_banded * 100).round(1), precision: 1) : "0%" %>
          </b>
        </div>
      <% end %>
    </div>
    <p class="card-note">
      Counted from each member&rsquo;s all-time message history. The backfill searches the newest joiners
      first, so until it is finished this leans towards members who have had the least time to post.
    </p>
  </div>

  <div class="card card-flush self-start">
    <div class="card-head">
      <div>
        <h2 class="card-title">Account composition</h2>
        <p class="card-sub">
          <% seen = @account_types.first %>
          live accounts by type<% if seen %> &middot;
            seen in <%= window_note(seen.window_start, seen.window_end) %>
          <% end %>
        </p>
      </div>
    </div>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>type</th>
            <th class="col-num">members</th>
            <th class="col-num">claimed</th>
          </tr>
        </thead>
        <tbody>
          <% @account_types.each do |a| %>
            <tr>
              <td><%= a.account_type %></td>
              <td><%= number_with_delimiter(a.members) %></td>
              <td><%= number_with_delimiter(a.claimed) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div id="distribution" data-controller="top-posters" data-top-posters-url-value="<%= root_path %>">
  <div data-top-posters-target="container">
    <%= render "top_posters", top_posters: @top_posters, top_poster_months: @top_poster_months, top_posters_month: @top_posters_month %>
  </div>
</div>

<% top_channels_stale = stale_note("mart_channel_range") %>
<% if top_channels_stale %>
  <%= stale_card("Top public channels", top_channels_stale) %>
<% else %>
<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Top public channels</h2>
      <p class="card-sub">
        by member messages<% if @top_channels.first %> &middot;
          <%= window_note(@top_channels.first.window_start, @top_channels.first.window_end) %>
        <% end %>
      </p>
    </div>
  </div>
  <div class="scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>channel</th>
          <th class="col-num">member messages</th>
          <th class="col-num">posters</th>
          <th class="col-num">reactions</th>
          <th class="col-num">reactors</th>
          <th class="col-num">huddles</th>
        </tr>
      </thead>
      <tbody>
        <% @top_channels.each do |c| %>
          <tr>
            <td>
              <span class="two-line">
                <%= link_to channel_path(c.channel_id) do %>
                  <b>#<%= c.name %></b>
                <% end %>
                <span><%= c.channel_id %></span>
              </span>
            </td>
            <td><%= number_with_delimiter(c.messages_posted_by_members) %></td>
            <td><%= number_with_delimiter(c.members_who_posted) %></td>
            <td><%= number_with_delimiter(c.reactions_added) %></td>
            <td><%= number_with_delimiter(c.members_who_reacted) %></td>
            <td><%= number_with_delimiter(c.huddles_initiated) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>

<div id="activation" data-controller="newcomer-channels" data-newcomer-channels-url-value="<%= root_path %>">
  <div data-newcomer-channels-target="container">
    <%= render "newcomer_channels", newcomer_channels: @newcomer_channels,
          newcomer_reach: @newcomer_reach, newcomer_measure: @newcomer_measure %>
  </div>
</div>

<% if @channel_scorecard.any? %>
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Channel onboarding scorecard</h2>
        <p class="card-sub">months reaching <%= HomeHelper::MIN_SAMPLE %> newcomers or more</p>
      </div>
    </div>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>channel</th>
            <th class="col-date">month</th>
            <th class="col-num">newcomers</th>
            <th class="col-num">fast reply</th>
            <th class="col-num">90-day retention</th>
          </tr>
        </thead>
        <tbody>
          <% @channel_scorecard.each do |row| %>
            <tr>
              <td>#<%= row.channel_name %></td>
              <td><%= row.post_month.strftime("%b %Y") %></td>
              <td><%= number_with_delimiter(row.newcomer_volume) %></td>
              <td><%= rate_chip((row.fast_reply_share.to_f * 100).round(1)) %></td>
              <td>
                <% if row.day_90_mature %>
                  <%= rate_chip((row.retained_90_share.to_f * 100).round(1)) %>
                <% else %>
                  <span class="chip chip-off">TBD</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card">
    <div class="card-head">
      <div>
        <h2 class="card-title">Channel onboarding scorecard</h2>
        <p class="card-sub">no channel-month qualifies yet</p>
      </div>
      <div class="card-tools"><span class="chip chip-off">0 of <%= @channel_scorecard_total %></span></div>
    </div>
    <p class="delta-note">
      A row needs <%= HomeHelper::MIN_SAMPLE %> newcomers in one channel in one month whose first post
      can be matched to a reply. Empty by measurement, not by error.
    </p>
  </div>
<% end %>

<div id="retention" data-controller="onboarding-funnel" data-onboarding-funnel-url-value="<%= root_path %>">
  <div data-onboarding-funnel-target="container">
    <%= render "onboarding_funnel", onboarding_funnel: @onboarding_funnel, cohort_months: @cohort_months %>
  </div>
</div>

<% if @fast_reply_vs_retention.any? %>
  <div class="grid-3">
    <% @fast_reply_vs_retention.each do |row| %>
      <div class="card">
        <p class="kpi-label">
          <%= row.fast_reply ? "fast reply, under 1 hour" : "slower reply" %>
          <%= incomplete_chip(
                ("no newcomer here has a covered retention window yet" if row.retained_day_30_rate.nil?)
              ) %>
        </p>
        <p class="kpi-val"><%= number_with_delimiter(row.newcomers) %></p>
        <% if row.retained_day_30_rate %>
          <div class="delta">
            <span class="chip chip-off">
              day 30: <%= number_to_percentage((row.retained_day_30_rate.to_f * 100).round(1), precision: 1) %>
              of <%= number_with_delimiter(row.measured_day_30) %>
            </span>
            <span class="chip chip-off">
              day 90: <%= number_to_percentage((row.retained_day_90_rate.to_f * 100).round(1), precision: 1) %>
              of <%= number_with_delimiter(row.measured_day_90) %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div data-controller="recurrence-funnel" data-recurrence-funnel-url-value="<%= root_path %>">
  <div data-recurrence-funnel-target="container">
    <%= render "recurrence_funnel", recurrence_funnel: @recurrence_funnel, recurrence_cohort_months: @recurrence_cohort_months, recurrence_month: @recurrence_month %>
  </div>
</div>

<% checked, by_member, bot_first, bot_first_then_member = @response_rate_totals %>
<div id="response" class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Response rate</h2>
      <p class="card-sub">whether a newcomer&rsquo;s first post got a reply, and how long it took</p>
    </div>
    <div class="card-tools">
      <% if checked.positive? %>
        <%= rate_chip(share_pct(by_member, checked), "answered by a member") %>
        <span class="chip chip-off"><%= pluralize(number_with_delimiter(checked), "first post") %> checked</span>
      <% else %>
        <span class="chip chip-warn">not measured yet</span>
      <% end %>
    </div>
  </div>
  <% if @response_rate.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>first posted</th>
            <th class="col-num">checked</th>
            <th class="col-num">by a member</th>
            <th class="col-num">by a bot</th>
            <th class="col-num">no reply</th>
            <th class="col-num">bot first</th>
            <th class="col-num">median wait</th>
          </tr>
        </thead>
        <tbody>
          <% @response_rate.each do |r| %>
            <tr>
              <td>
                <span class="two-line">
                  <b><%= r.post_month.strftime("%b %Y") %></b>
                  <span><%= number_to_percentage(share_pct(r.answered_by_member, r.first_posts_checked), precision: 1) %> answered by a member</span>
                </span>
              </td>
              <td><%= number_with_delimiter(r.first_posts_checked) %></td>
              <td><%= number_with_delimiter(r.answered_by_member) %></td>
              <td><%= number_with_delimiter(r.answered_by_bot) %></td>
              <td><%= number_with_delimiter(r.unanswered) %></td>
              <td><%= number_with_delimiter(r.bot_replied_first) %></td>
              <td><%= reply_wait(r.median_member_latency_seconds) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if bot_first.positive? %>
      <p class="delta-note">
        A bot replied before any person on
        <b><%= number_to_percentage(share_pct(bot_first, checked), precision: 1) %></b>
        of these first posts, and
        <b><%= number_with_delimiter(bot_first_then_member) %> of <%= number_with_delimiter(bot_first) %></b>
        of those did then get a person.
      </p>
    <% end %>
  <% else %>
    <p class="card-note">
      No first post has been checked yet. The member history backfill finds first posts, then the replies walk
      fills this in, newest cohorts first.
    </p>
  <% end %>
</div>
