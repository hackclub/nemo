<% s = activity_series(activity_trend, granularity) %>

<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Messages from members</h2>
      <p class="card-sub">last <%= s[:span] %></p>
    </div>
    <div class="card-tools">
      <div class="segmented" role="group" aria-label="granularity for member messages">
        <% %w[daily monthly].each do |g| %>
          <button type="button"
                  data-value="<%= g %>"
                  aria-pressed="<%= granularity == g %>"
                  data-action="messages-granularity#choose"><%= g %></button>
        <% end %>
      </div>
    </div>
  </div>
  <div class="mn-growth-chart">
    <canvas
      data-controller="activity-chart"
      data-activity-chart-tick-every-value="<%= s[:tick_every] %>"
      data-activity-chart-data-value="<%= {
        labels: s[:labels],
        datasets: [
          { label: "channel messages", data: s[:messages], backgroundColor: HomeHelper::CHART_SERIES_A, order: 1 },
          ratio_line_dataset("public share", s[:public_share])
        ]
      }.to_json %>"
    ></canvas>
  </div>
</div>
