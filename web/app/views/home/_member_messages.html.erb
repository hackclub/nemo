<% s = activity_series(activity_trend, granularity) %>

<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Messages from members</h2>
      <p class="card-sub">last <%= s[:span] %></p>
    </div>
  </div>
  <div
    data-controller="chart"
    data-chart-kind-value="bars"
    data-chart-height-value="240"
    data-chart-data-value="<%= {
      labels: s[:labels],
      datasets: [{ label: "channel messages", data: s[:messages] }]
    }.to_json %>"
  ></div>
  <div
    data-controller="chart"
    data-chart-kind-value="line"
    data-chart-height-value="120"
    data-chart-pct-value="true"
    data-chart-data-value="<%= {
      labels: s[:labels],
      datasets: [{ label: "public share", data: s[:public_share] }]
    }.to_json %>"
  ></div>
</div>
