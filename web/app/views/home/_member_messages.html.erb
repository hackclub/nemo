<% s = activity_series(activity_trend, granularity) %>
<% was = prior_trend.any? ? activity_series(prior_trend, granularity) : nil %>

<section class="section">

  <div class="grid g-2">
    <div class="card">
      <div class="card-head"><h2 class="card-title">Channel messages</h2></div>
      <div class="card-body">
        <div
          data-controller="chart"
          data-chart-kind-value="bars"
          <% if s[:partial].any? %>data-chart-partial-value="<%= s[:partial].to_json %>"<% end %>
          data-chart-days-value="<%= s[:days] %>"
          data-chart-height-value="210"
          data-chart-data-value="<%= {
            labels: s[:labels],
            datasets: [{ label: "channel messages", data: s[:messages] }]
          }.to_json %>"
        ></div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h2 class="card-title">Public share</h2>
      </div>
      <div class="card-body">
        <div
          data-controller="chart"
          data-chart-kind-value="line"
          data-chart-days-value="<%= s[:days] %>"
          data-chart-height-value="210"
          data-chart-pct-value="true"
          data-chart-nokey-value="true"
          data-chart-data-value="<%= {
            labels: s[:labels],
            datasets: [
              { label: "public share", data: s[:public_share] },
              (was ? { label: "previous period", data: was[:public_share],
                       color: "var(--ink-4)", ghost: true } : nil)
            ].compact
          }.to_json %>"
        ></div>
        <div class="legend chart-legend-under">
          <span><i class="ser-1"></i>public share</span>
          <% if was %><span><i class="ghost"></i>previous period</span><% end %>
        </div>
      </div>
    </div>
  </div>
</section>
