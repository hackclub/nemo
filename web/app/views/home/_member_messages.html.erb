<% s = activity_series(activity_trend, granularity) %>

<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Messages from members</h2>
      <p class="card-sub">last <%= s[:span] %></p>
    </div>
    <div class="card-tools">
      <div class="segmented" role="group" aria-label="granularity for member messages">
        <% %w[daily monthly].each do |g| %>
          <button type="button"
                  data-value="<%= g %>"
                  aria-pressed="<%= granularity == g %>"
                  data-action="messages-granularity#choose"><%= g %></button>
        <% end %>
      </div>
    </div>
  </div>
  <div
    data-controller="svg-chart"
    data-svg-chart-kind-value="bars"
    data-svg-chart-height-value="240"
    data-svg-chart-data-value="<%= {
      labels: s[:labels],
      datasets: [{ label: "channel messages", data: s[:messages] }]
    }.to_json %>"
  ></div>
  <div
    data-controller="svg-chart"
    data-svg-chart-kind-value="line"
    data-svg-chart-height-value="120"
    data-svg-chart-pct-value="true"
    data-svg-chart-data-value="<%= {
      labels: s[:labels],
      datasets: [{ label: "public share", data: s[:public_share] }]
    }.to_json %>"
  ></div>
</div>
