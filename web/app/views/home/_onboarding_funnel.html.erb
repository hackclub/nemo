<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Onboarding funnel</h2>
      <p class="card-sub">
        one created-account cohort &middot; the last two are windows, not stages
      </p>
    </div>
    <% if cohort_months.present? %>
      <div class="card-tools">
        <% if onboarding_funnel %>
          <%= incomplete_chip(
                ("first post needs every member of this cohort searched" if onboarding_funnel.first_post.nil?),
                ("retention needs daily member activity covering each member's day-30 and day-90 window" unless onboarding_funnel.day_30_mature)
              ) %>
        <% end %>
        <select
          class="select"
          aria-label="cohort month"
          data-onboarding-funnel-target="select"
          data-action="onboarding-funnel#change"
        >
          <% cohort_months.each do |m| %>
            <option value="<%= m.iso8601 %>" <%= "selected" if onboarding_funnel&.cohort_month == m %>><%= m.strftime("%b %Y") %></option>
          <% end %>
        </select>
      </div>
    <% end %>
  </div>

  <% if onboarding_funnel %>
    <div class="chart-short">
      <canvas
        data-controller="chart"
        data-chart-type-value="bar"
        data-chart-data-value="<%= {
          labels: ["Created", "Joined", "First post", "Active in days 23-30", "Active in days 83-90"],
          datasets: [{
            label: "members",
            data: [
              onboarding_funnel.invited,
              onboarding_funnel.joined,
              onboarding_funnel.first_post,
              onboarding_funnel.day_30_mature ? onboarding_funnel.retained_day_30 : nil,
              onboarding_funnel.day_90_mature ? onboarding_funnel.retained_day_90 : nil
            ]
          }]
        }.to_json %>"
        data-chart-options-value="<%= { maintainAspectRatio: false, plugins: { legend: { display: false } } }.to_json %>"
      ></canvas>
    </div>
  <% else %>
    <p class="card-note">no cohort data loaded yet</p>
  <% end %>
</div>
