<div class="section">
  <div class="section-head">
    <h2 class="section-title">Slices</h2>
  </div>

  <div class="grid g-1">
    <div class="card card-flush">
      <div class="card-head">
        <div><h2 class="card-title">By source</h2></div>
      </div>
      <% if slices.any? %>
        <div class="scroll">
          <table class="data-table engine-wide-table">
            <thead>
              <tr>
                <th>Source</th>
                <th class="col-num">Complete</th>
                <th class="col-num">Unverified</th>
                <th class="col-num">Short</th>
                <th class="col-num">Claimed</th>
                <th class="col-num">Superseded</th>
                <th class="col-num">No data</th>
                <th class="col-num">Other</th>
                <th class="col-num">Worst landed</th>
                <th class="col-num">Through</th>
              </tr>
            </thead>
            <tbody>
              <% slices.each do |row| %>
                <tr>
                  <td class="font-medium"><%= row.source_key %></td>
                  <td class="col-num"><%= number_with_delimiter(row.complete) %></td>
                  <td class="col-num sub"><%= number_with_delimiter(row.unverified) %></td>
                  <td class="col-num <%= "warn" if row.short.positive? %>"><%= row.short %></td>
                  <td class="col-num"><%= row.claimed %></td>
                  <td class="col-num sub"><%= row.superseded %></td>
                  <td class="col-num sub"><%= row.unavailable %></td>
                  <td class="col-num <%= "warn" if row.other.positive? %>"><%= row.other %></td>
                  <td class="col-num"><%= row.worst_ratio ? number_to_percentage(row.worst_ratio.to_f * 100, precision: 1) : "n/a" %></td>
                  <td class="col-num"><%= row.latest ? row.latest.strftime("%-d %b") : "n/a" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty"><p class="empty-title">No data yet</p></div>
      <% end %>
    </div>

    <% if day_strips.any? %>
      <div class="card card-flush">
        <div class="card-head">
          <div>
            <h2 class="card-title">Last <%= EngineController::SLICE_STRIP_DAYS %> days</h2>
          </div>
        </div>
        <div class="covrows" data-controller="chart-tooltip"
             data-action="mouseover->chart-tooltip#show mouseleave->chart-tooltip#clear">
          <% day_strips.each do |key, days, missing, per_day, eta| %>
            <div class="covrow">
              <div class="covhead">
                <span class="covkey"><%= key %></span>
                <span class="cov-label">
                  <%= missing %> not complete
                  <% if per_day.positive? %>
                    &middot; <%= per_day.round(1) %> a day this week
                  <% end %>
                  <% if eta %>
                    &middot; caught up <%= (Date.current + eta).strftime("~%-d %b") %>
                  <% end %>
                </span>
              </div>
              <div class="coverage">
                <% days.each do |day, state| %><i class="<%= slice_cell(state) %>" data-tip="<%= slice_tip(key, day, state) %>"></i><% end %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="key">
          <span><i class="lg-held"></i>complete</span>
          <span><i class="lg-short"></i>short or claimed</span>
          <span><i class="lg-nofile"></i>Slack has no file</span>
          <span><i class="lg-before"></i>never fetched</span>
        </div>
      </div>
    <% end %>
  </div>
</div>
