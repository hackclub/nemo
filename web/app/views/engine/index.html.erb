<% if @auto_refresh %>
  <% content_for :head do %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
  <% end %>
<% end %>

<% content_for :page_title, "Engine" %>
<% content_for :page_subtitle, "nightly sync runs, stage by stage" %>

<% content_for :page_badge do %>
  <% if @auto_refresh %>
    <span class="chip chip-off" data-controller="run-refresh" data-run-refresh-seconds-value="10">
      live, refreshing every 10s
    </span>
  <% end %>
<% end %>

<% content_for :head_actions do %>
  <% if @active_request %>
    <span class="chip chip-off">
      sync <%= @active_request.status %>, requested by <%= @active_request.requested_by %>
      <%= time_ago_in_words(@active_request.created_at) %> ago
    </span>
    <% if @active_request.status != "cancelling" %>
      <%= button_to "Cancel", engine_cancel_path, class: "btn", form: { class: "contents" } %>
    <% end %>
  <% else %>
    <% if @last_request %>
      <span class="delta-note">
        requested by <%= @last_request.requested_by %> &middot; <%= time_ago_in_words(@last_request.created_at) %> ago
      </span>
      <%= run_status(@last_request) %>
    <% end %>
    <%= button_to "Run the nightly sync now", engine_sync_path,
          class: "btn btn-primary", form: { class: "contents" } %>
  <% end %>
<% end %>

<% if @run.nil? %>
  <div class="card">
    <div class="card-head">
      <div>
        <h2 class="card-title">Latest run</h2>
        <p class="card-sub">nothing recorded yet</p>
      </div>
    </div>
    <p class="delta-note">No nightly run has been recorded. Start one with the button above.</p>
  </div>
<% else %>
  <%= render "run_detail", run: @run, steps: @steps, step_output: @step_output, heading: "Latest run" %>
<% end %>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Day coverage</h2>
      <p class="card-sub">which days each source has actually loaded</p>
    </div>
  </div>
  <% if @day_coverage.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>source</th>
            <th class="col-num">span</th>
            <th class="col-num">loaded</th>
            <th class="col-num">unavailable</th>
            <th class="col-num">never fetched</th>
          </tr>
        </thead>
        <tbody>
          <% @day_coverage.each do |row| %>
            <tr>
              <td>
                <span class="two-line">
                  <b><%= row.source %></b>
                  <span><%= row.first_ds.strftime("%b %-d, %Y") %> to <%= row.last_ds.strftime("%b %-d, %Y") %></span>
                </span>
              </td>
              <td><%= pluralize(row.span, "day") %></td>
              <td><%= number_with_delimiter(row.loaded) %></td>
              <td>
                <% if row.unavailable.positive? %>
                  <span class="chip chip-off"><%= number_with_delimiter(row.unavailable) %></span>
                <% else %>
                  0
                <% end %>
              </td>
              <td>
                <% if row.never_fetched.positive? %>
                  <span class="chip chip-warn"><%= number_with_delimiter(row.never_fetched) %></span>
                <% else %>
                  0
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">n/a</p>
  <% end %>
</div>

<div class="grid-2-1">
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Recent runs</h2>
        <p class="card-sub">last <%= EngineController::HISTORY %> parent runs</p>
      </div>
    </div>
    <% if @history.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>started</th>
              <th class="col-num">status</th>
              <th class="col-num">elapsed</th>
            </tr>
          </thead>
          <tbody>
            <% @history.each do |row| %>
              <% first_step = @history_kind[row.id] %>
              <tr>
                <td>
                  <span class="two-line">
                    <%= link_to row.started_at.strftime("%b %-d, %H:%M"), engine_run_path(row) %>
                    <span>
                      <% if first_step.nil? %>
                        n/a
                      <% elsif first_step.step_total == 1 %>
                        stage &middot; <%= first_step.source %>
                      <% else %>
                        full nightly &middot; <%= first_step.step_total %> stages
                      <% end %>
                    </span>
                  </span>
                </td>
                <td><%= run_status(row) %></td>
                <td><%= run_duration(row) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">n/a</p>
    <% end %>
  </div>

  <div class="card card-flush self-start">
    <div class="card-head">
      <div>
        <h2 class="card-title">Freshness</h2>
        <p class="card-sub">last success per source, stalest first</p>
      </div>
    </div>
    <% if @freshness.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>source</th>
              <th class="col-date">last success</th>
              <% if @active_request.nil? %>
                <th class="col-btn"></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @freshness.each do |stage, finished_at| %>
              <tr>
                <td><%= stage %></td>
                <td><%= time_ago_in_words(finished_at) %> ago</td>
                <% if @active_request.nil? %>
                  <td>
                    <%= button_to "run", engine_trigger_stage_path(stage: stage),
                          class: "run-btn", form: { class: "contents" } %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">n/a</p>
    <% end %>
  </div>
</div>
