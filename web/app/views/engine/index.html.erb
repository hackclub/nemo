<% if @auto_refresh %>
  <% content_for :head do %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
  <% end %>
<% end %>

<% content_for :page_title, "Engine" %>

<% content_for :page_controls do %>
  <span class="segmented">
    <% EngineController::TABS.each do |key, label| %>
      <%= link_to engine_path(key == "runs" ? {} : { tab: key }),
            aria: { current: ("true" if key == @tab) } do %>
        <%= label %>
      <% end %>
    <% end %>
  </span>

  <span class="qspacer"></span>

  <span class="qlab">Nightly at</span>
  <%= render "val", source: Engine::Setting::ENGINE, name: "run_at", may_tune: @may_tune %>
  <span class="qlab">Budget</span>
  <%= render "val", source: Engine::Setting::ENGINE, name: "budget_minutes", may_tune: @may_tune %>
  <span class="qlab">minutes</span>

  <% if @active_request %>
    <span class="chip">
      <i class="dot run"></i>
      step <%= @steps.size %> of <%= Engine::Source::KEYS.size %>
    </span>
    <% if @active_request.status != "cancelling" %>
      <%= button_to "Cancel", engine_cancel_path, class: "btn", form: { class: "contents" } %>
    <% end %>
  <% else %>
    <%= button_to "Run the nightly now", engine_sync_path,
          class: "btn btn-primary", form: { class: "contents" } %>
  <% end %>
<% end %>

<%= render "band", band: @band %>

<% if @tab == "runs" %>
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Tonight</h2>
        <p class="card-sub">
          <% if @run %>
            <%= @run.started_at.strftime("%-d %b, %H:%M") %> &middot; <%= run_duration(@run) %> so far
            &middot; step <%= @steps.size %> of <%= Engine::Source::KEYS.size %>
          <% else %>
            nothing recorded yet
          <% end %>
        </p>
      </div>
      <% if @run&.running? %>
        <div class="card-tools">
          <%= image_tag "nemo.png", class: "sync-fish", alt: "", width: 800, height: 483 %>
          <span class="swatch"><i class="dot run"></i>running</span>
        </div>
      <% end %>
    </div>
    <% if @steps.any? %>
      <%= render "ladder", steps: @steps %>
    <% else %>
      <p class="card-note">n/a</p>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">The last <%= EngineController::NIGHTS %> nights</h2>
      </div>
    </div>
    <%= render "matrix", matrix: @matrix, nights: @nights %>
  </div>

<% elsif @tab == "sources" %>
  <%= render "sources", sources: @sources, active_request: @active_request,
        matrix: @matrix, open: @open, may_tune: @may_tune %>

<% elsif @tab == "coverage" %>
  <%= render "coverage", day_coverage: @day_coverage, held: @held %>

<% elsif @tab == "backfill" %>
  <%= render "backfill", backfills: @backfills, names: @backfill_names,
        queued_requests: @backfill_queued_requests %>

<% elsif @tab == "tuning" %>
  <%= render "tuning", may_tune: @may_tune, sources: @sources %>
<% end %>
