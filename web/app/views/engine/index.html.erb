<% if @auto_refresh %>
  <div data-controller="run-refresh" data-run-refresh-seconds-value="10" hidden></div>
<% end %>

<% content_for :page_title, EngineController::TABS.fetch(@tab) %>

<% content_for :head_actions do %>
  <% if @active_request %>
    <% if @orphaned %>
      <span class="chip chip-crit">worker down</span>
    <% else %>
      <span class="chip">
        <i class="dot run"></i>
        <%= step_progress(@progress) || @active_request.status %>
      </span>
    <% end %>
    <%= button_to(@orphaned ? "Release" : "Cancel", engine_cancel_path,
          class: "btn", form: { class: "contents" }) %>
  <% else %>
    <%= button_to "Run the nightly now", engine_sync_path,
          class: "btn btn-primary", form: { class: "contents" } %>
  <% end %>
<% end %>

<% if @tab == "runs" %>
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Tonight</h2>
        <p class="card-sub">
          <% if @run %>
            <%= @run.started_at.strftime("%-d %b, %H:%M") %>
            &middot; <%= run_duration(@run) %><%= " so far" if @run.running? %>
            <% if (progress = step_progress(@progress)) %>
              &middot; <%= progress %>
            <% end %>
          <% else %>
            nothing recorded yet
          <% end %>
        </p>
      </div>
      <% if @run %>
        <div class="card-tools">
          <% if @run.running? && !@orphaned %>
            <%= image_tag "nemo.png", class: "sync-fish", alt: "", width: 800, height: 483 %>
          <% end %>
          <%= run_age(@run) if run_stale?(@run) %>
          <% if @orphaned %>
            <%= worker_chip(@worker) %>
          <% elsif @run.running? %>
            <span class="swatch"><i class="dot run"></i>running</span>
          <% else %>
            <%= run_status(@run) %>
          <% end %>
          <%= link_to "Open the run", engine_run_path(@run.id), class: "btn btn-ghost" %>
        </div>
      <% end %>
    </div>
    <% if @steps.any? %>
      <%= render "ladder", steps: @steps %>
    <% else %>
      <p class="card-note">n/a</p>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">The last <%= EngineController::NIGHTS %> nights</h2>
        <p class="card-sub">one square a night, worst run of that night wins the colour</p>
      </div>
    </div>
    <%= render "matrix", matrix: @matrix, nights: @nights %>
  </div>

<% elsif @tab == "sources" %>
  <%= render "sources", sources: @sources, active_request: @active_request,
        matrix: @matrix, open: @open, may_tune: @may_tune,
        run: @run, step_output: @step_output %>

<% elsif @tab == "coverage" %>
  <%= render "slices", slices: @slices, day_strips: @day_strips %>
  <%= render "coverage", day_coverage: @day_coverage, held: @held %>

<% elsif @tab == "queues" %>
  <%= render "queues", queues: @queues %>

<% elsif @tab == "faults" %>
  <%= render "faults", incidents: @incidents, breakers: @breakers, local_faults: @local_faults,
        taxonomy: @taxonomy, beats: @beats, breaker_mode: @breaker_mode, may_tune: @may_tune %>

<% elsif @tab == "backfill" %>
  <%= render "backfill", backfills: @backfills, names: @backfill_names,
        queued_requests: @backfill_queued_requests %>

<% elsif @tab == "archive" %>
  <%= render "archive", archive: @archive %>

<% elsif @tab == "tuning" %>
  <%= render "tuning", may_tune: @may_tune, sources: @sources %>
<% end %>
