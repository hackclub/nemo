<div class="section">
  <div class="section-head">
    <h2 class="section-title">Open problems</h2>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Incidents</h2>
        <p class="card-sub"><%= incidents.count { |i| !i.muted } %> open &middot; <%= incidents.count(&:muted) %> muted</p>
      </div>
    </div>
    <% if incidents.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Kind</th>
              <th>Source</th>
              <th class="col-num">Nights</th>
              <th>Class</th>
              <th>Detail</th>
              <th class="col-num">Last seen</th>
              <th class="col-btn"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% incidents.each do |incident| %>
              <tr>
                <td class="mono"><%= incident.kind %></td>
                <td class="mono"><%= incident.source_key %></td>
                <td class="col-num"><%= incident.consecutive %></td>
                <td><span class="chip <%= fault_class_chip(incident.error_class) %>"><%= incident.error_class || "n/a" %></span></td>
                <td class="sub trunc-cell" title="<%= incident.error_detail %>"><%= incident.error_detail || "n/a" %></td>
                <td class="col-num"><%= short_age(incident.last_seen) %></td>
                <td class="col-btn">
                  <% if incident.muted %>
                    <span class="chip chip-off">Muted until <%= incident.muted_until.strftime("%-d %b %H:%M") %></span>
                  <% elsif incident.acked_at %>
                    <span class="chip chip-off">Acked by <%= incident.acked_by %></span>
                  <% elsif may_tune %>
                    <span class="dial-set">
                      <%= button_to "Ack", engine_ack_incident_path(source_key: incident.source_key, kind: incident.kind),
                            class: "btn btn-sm", form: { class: "contents" } %>
                      <%= button_to "Mute a day", engine_mute_incident_path(source_key: incident.source_key, kind: incident.kind),
                            class: "btn btn-sm", form: { class: "contents" } %>
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">No incident open</p>
      </div>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Local</h2>
      </div>
    </div>
    <% if local_faults.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Check</th>
              <th>Severity</th>
              <th class="col-num">Observed</th>
              <th class="col-num">Expected</th>
              <th class="col-num">Checked</th>
            </tr>
          </thead>
          <tbody>
            <% local_faults.each do |row| %>
              <tr>
                <td class="mono"><%= row.subject %>:<%= row.assertion %></td>
                <td><span class="chip <%= row.severity == "error" ? "chip-crit" : "chip-warn" %>"><%= row.severity %></span></td>
                <td class="col-num"><%= row.observed %></td>
                <td class="col-num"><%= row.expected %></td>
                <td class="col-num"><%= short_age(row.checked_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">Every check passed</p>
      </div>
    <% end %>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <h2 class="section-title">Trust checks</h2>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Headlines that disagree</h2>
      </div>
    </div>
    <% if headlines.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Headline</th>
              <th>State</th>
              <th class="col-num">Ours</th>
              <th>Expected</th>
              <th class="col-num">Checked</th>
            </tr>
          </thead>
          <tbody>
            <% headlines.each do |row| %>
              <tr>
                <td class="mono"><%= row.assertion %></td>
                <td><span class="chip <%= row.status == "fail" ? "chip-crit" : "chip-warn" %>"><%= row.status %></span></td>
                <td class="col-num"><%= row.observed %></td>
                <td class="sub trunc-cell" title="<%= row.expected %>"><%= row.expected %></td>
                <td class="col-num"><%= short_age(row.checked_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">Every headline agrees</p>
      </div>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Suppressed</h2>
        <p class="card-sub">Breakers <%= breaker_mode %><%= ", recording only" if breaker_mode == "observe" %></p>
      </div>
      <div class="card-tools">
        <span class="queue-label">Mode</span>
        <%= render "setting_value", source: Engine::Setting::ENGINE, name: "breaker_mode", may_tune: may_tune %>
      </div>
    </div>
    <% if breakers.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Scope</th>
              <th>State</th>
              <th class="col-num">Streak</th>
              <th class="col-num">Trips at</th>
              <th class="col-num">Checked</th>
              <th class="col-btn"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% breakers.each do |row| %>
              <tr>
                <td class="mono"><%= row.assertion %></td>
                <td>
                  <% if row.status == "fail" %>
                    <span class="chip chip-crit"><%= breaker_mode == "on" ? "Open, skipping" : "Would open" %></span>
                  <% elsif row.assertion.start_with?("mode:") %>
                    <span class="chip chip-good">None open</span>
                  <% else %>
                    <span class="chip chip-off">Held closed</span>
                  <% end %>
                </td>
                <td class="col-num"><%= row.observed %></td>
                <td class="col-num"><%= row.expected.to_i + 1 %></td>
                <td class="col-num"><%= short_age(row.checked_at) %></td>
                <td class="col-btn">
                  <% if row.status == "fail" && may_tune %>
                    <%= button_to "Hold closed tonight", engine_override_breaker_path(source_key: row.assertion.split(":", 2).last),
                          class: "btn btn-sm", form: { class: "contents" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">No breaker has tripped</p>
      </div>
    <% end %>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <h2 class="section-title">Workers &amp; history</h2>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Workers</h2>
        <p class="card-sub"><%= worker_note(beats).to_s.upcase_first %></p>
      </div>
    </div>
    <% if beats.empty? %>
      <div class="empty">
        <p class="empty-title">No worker has reported</p>
      </div>
    <% else %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Worker</th>
              <th>State</th>
              <th class="col-num">Last beat</th>
              <th>Detail</th>
            </tr>
          </thead>
          <tbody>
            <% beats.each do |beat| %>
              <tr>
                <td class="mono"><%= beat.worker %></td>
                <td><%= worker_state(beat) %></td>
                <td class="col-num"><%= short_age(beat.beat_at) %></td>
                <td class="sub"><%= beat.note.presence || "n/a" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Taxonomy</h2>
        <p class="card-sub">Failed stage runs, last <%= EngineController::TAXONOMY_WINDOW.inspect %></p>
      </div>
    </div>
    <% if taxonomy.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Class</th>
              <th class="col-num">Runs</th>
              <th class="col-num">Sources</th>
              <th>Latest detail</th>
            </tr>
          </thead>
          <tbody>
            <% taxonomy.each do |taxon| %>
              <tr>
                <td><span class="chip <%= fault_class_chip(taxon.error_class) %>"><%= taxon.error_class %></span></td>
                <td class="col-num"><%= taxon.count %></td>
                <td class="col-num"><%= taxon.sources %></td>
                <td class="<%= taxon.sample ? "mono" : "sub" %>"><%= taxon.sample || "n/a" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">Nothing failed</p>
      </div>
    <% end %>
  </div>
</div>
