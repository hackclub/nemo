<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Archive</h2>
      <p class="card-sub">
        <%= number_with_delimiter(archive.walked) %> messages walked
        <% if archive.unreachable.positive? %>
          &middot; <%= number_with_delimiter(archive.unreachable) %> channels Slack will not return
        <% end %>
        <% if archive.beat %>
          &middot; beat <%= short_age(archive.beat.beat_at) %> ago
          <% if archive.beat.note.present? %>&middot; <%= archive.beat.note %><% end %>
        <% else %>
          &middot; no worker heartbeat
        <% end %>
      </p>
    </div>
  </div>
  <div class="scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>stage</th>
          <th class="col-num">held</th>
          <th class="col-num">outstanding</th>
          <th class="col-num">of</th>
          <th class="col-num">share</th>
          <th class="col-num">last</th>
        </tr>
      </thead>
      <tbody>
        <% archive.stages.each do |stage| %>
          <tr>
            <td class="mono"><%= stage.name %></td>
            <td class="col-num"><%= number_with_delimiter(stage.done) %></td>
            <td class="col-num">
              <%= stage.outstanding ? number_with_delimiter(stage.outstanding) : "n/a" %>
            </td>
            <td class="col-num"><%= stage.total ? number_with_delimiter(stage.total) : "n/a" %></td>
            <td class="col-num">
              <%= stage.share ? number_to_percentage(stage.share, precision: 1) : "n/a" %>
            </td>
            <td class="col-num mono"><%= stage.at ? "#{short_age(stage.at)} ago" : "n/a" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Channels the archive covers least</h2>
      <p class="card-sub">
        against Slack's own count, channels holding <%= number_with_delimiter(Engine::Archive::WORST_FLOOR) %> messages or more
      </p>
    </div>
  </div>
  <% if archive.worst.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>channel</th>
            <th class="col-num">held</th>
            <th class="col-num">Slack says</th>
            <th class="col-num">share</th>
            <th class="col-num">threads</th>
            <th class="col-num">oldest held</th>
          </tr>
        </thead>
        <tbody>
          <% archive.worst.each do |row| %>
            <tr>
              <td>
                <% shown = "##{row.name || row.channel_id}" %>
                <% if may_open_channel?(row.channel_id) %>
                  <%= link_to shown, channel_path(row.channel_id) %>
                <% else %>
                  <%= shown %>
                <% end %>
              </td>
              <td class="col-num"><%= number_with_delimiter(row.messages_held) %></td>
              <td class="col-num"><%= number_with_delimiter(row.slack_messages) %></td>
              <td class="col-num"><%= number_to_percentage(row.held_share, precision: 1) %></td>
              <td class="col-num">
                <%= number_with_delimiter(row.threads_fetched) %> of <%= number_with_delimiter(row.threads_known) %>
              </td>
              <td class="col-num mono">
                <%= row.oldest_held ? row.oldest_held.to_date.to_fs(:db) : "n/a" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">n/a</p>
  <% end %>
</div>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Channels the walk could not read</h2>
      <p class="card-sub">
        <%= number_with_delimiter(archive.errors.sum(&:last)) %> channels holding an error
      </p>
    </div>
  </div>
  <% if archive.errors.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>error</th>
            <th class="col-num">channels</th>
          </tr>
        </thead>
        <tbody>
          <% archive.errors.each do |error, count| %>
            <tr>
              <td class="mono"><%= error %></td>
              <td class="col-num"><%= number_with_delimiter(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">n/a</p>
  <% end %>
</div>
