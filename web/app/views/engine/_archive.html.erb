<% totals = archive.totals %>
<% live = archive.live %>
<% held = live&.messages_held&.to_i || totals.messages_held %>
<% parents = live&.parents_held&.to_i || totals.parents_held %>
<% replies = live&.replies_held&.to_i || totals.replies_held %>

<div class="section">
  <div class="section-head">
    <h2 class="section-title">What we hold</h2>
  </div>

  <div class="<%= "grid g-sided" if archive.queues.any? %>">
    <div class="card card-flush">
      <div class="card-head">
        <div>
          <h2 class="card-title">What the archive holds</h2>
      <p class="card-sub">
        <% if totals.held_days %>
          <%= totals.oldest_held.to_date.strftime("%-d %b %Y") %>
          to <%= totals.newest_held.to_date.strftime("%-d %b %Y") %>
          &middot; <%= number_with_delimiter(totals.held_days) %> days
        <% else %>
          nothing has landed yet
        <% end %>
        <% if archive.beat %>
          &middot; beat <%= short_age(archive.beat.beat_at) %> ago
        <% end %>
      </p>
        </div>
        <% if archive.beat %>
          <div class="card-tools">
            <span title="<%= archive.beat.note %>"><%= worker_state(archive.beat) %></span>
          </div>
        <% end %>
      </div>

      <dl class="facts-strip facts-wrap">
        <div class="fact">
          <dt>Messages held</dt>
          <dd><%= number_with_delimiter(held) %></dd>
        </div>
        <div class="fact">
          <dt>Parents</dt>
          <dd><%= number_with_delimiter(parents) %></dd>
        </div>
        <div class="fact">
          <dt>Replies</dt>
          <dd><%= number_with_delimiter(replies) %></dd>
        </div>
        <div class="fact">
          <dt>Channels holding</dt>
          <dd><%= number_with_delimiter(totals.holding) %> <span class="sub">of <%= number_with_delimiter(totals.reachable) %></span></dd>
        </div>
        <div class="fact">
          <dt>Threads waiting</dt>
          <dd class="<%= "is-none" if totals.threads_waiting.zero? %>">
            <%= totals.threads_waiting.zero? ? "none" : number_with_delimiter(totals.threads_waiting) %>
          </dd>
        </div>
        <div class="fact">
          <dt>Slack will not open</dt>
          <dd class="<%= "is-none" if totals.unreachable.zero? %>">
            <%= totals.unreachable.zero? ? "no channel" : pluralize(totals.unreachable, "channel") %>
          </dd>
        </div>
        <div class="fact">
          <dt>Replies waiting</dt>
          <dd class="<%= "is-none" if totals.replies_waiting.zero? %>">
            <%= totals.replies_waiting.zero? ? "none" : number_with_delimiter(totals.replies_waiting) %>
          </dd>
        </div>
        <div class="fact">
          <dt>Last walk</dt>
          <dd class="<%= "is-none" if totals.last_walked_at.nil? %>">
            <%= totals.last_walked_at ? "#{short_age(totals.last_walked_at)} ago" : "never" %>
          </dd>
        </div>
      </dl>

      <div class="arcrows">
        <% archive.stages.each do |stage| %>
          <div class="arcrow">
            <div class="arcn"><b><%= stage.name %></b></div>
            <div class="arcpct <%= "is-none" if stage.shown_share.nil? %>">
              <%= stage.shown_share ? number_to_percentage(stage.shown_share, precision: 1) : "nothing to measure it against yet" %>
            </div>
            <div class="arcnum">
              <%= number_with_delimiter(stage.done.to_i) %>
              <% if stage.total %>
                <span class="sub">of <%= number_with_delimiter(stage.total) %></span>
              <% end %>
            </div>
            <div class="arcnum">
              <% if stage.outstanding.nil? %>
                <span class="sub">n/a</span>
              <% elsif stage.outstanding.zero? %>
                <span class="sub">none left</span>
              <% else %>
                <%= number_with_delimiter(stage.outstanding.to_i) %> <span class="sub">left</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <% if archive.queues.any? %>
      <div class="card card-flush">
        <div class="card-head">
          <div>
            <h2 class="card-title">What the walker is working through</h2>
          </div>
        </div>
        <div class="scroll">
          <table class="data-table engine-wide-table">
            <thead>
              <tr>
                <th>queue</th>
                <th class="col-num">waiting</th>
                <th class="col-num">in flight</th>
                <th class="col-num">settled, hour</th>
                <th class="col-num">settled, day</th>
                <th class="col-num">short</th>
                <th class="col-num">dead</th>
                <th class="col-num">oldest</th>
                <th class="col-num">drains in</th>
              </tr>
            </thead>
            <tbody>
              <% archive.queues.each do |queue| %>
                <tr>
                  <td class="mono"><%= queue.work_kind %></td>
                  <td class="col-num"><%= number_with_delimiter(queue.pending) %></td>
                  <td class="col-num"><%= queue.claimed %></td>
                  <td class="col-num"><%= number_with_delimiter(queue.settled_last_hour) %></td>
                  <td class="col-num"><%= number_with_delimiter(queue.settled_last_day) %></td>
                  <td class="col-num"><%= queue.short %></td>
                  <td class="col-num <%= "warn" if queue.dead.positive? %>"><%= queue.dead %></td>
                  <td class="col-num mono"><%= queue.oldest_pending_at ? short_age(queue.oldest_pending_at) : "n/a" %></td>
                  <td class="col-num mono"><%= queue_eta(queue) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <p class="chart-note">the queues the archive worker drains, oldest work first</p>
      </div>
    <% end %>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <h2 class="section-title">Coverage</h2>
  </div>

  <% if archive.days.many? %>
    <div class="card">
      <div class="card-head">
        <div>
          <h2 class="card-title">Held against what Slack counted</h2>
        </div>
      </div>
      <div
        data-controller="chart"
        data-chart-kind-value="line"
        data-chart-days-value="true"
        data-chart-height-value="220"
        data-chart-data-value="<%= {
          labels: archive.days.map { |row| row.ds.to_s },
          datasets: [
            { label: "Slack counted", data: archive.days.map { |row| row.slack_messages.to_i } },
            { label: "Held here", data: archive.days.map { |row| row.messages_held.to_i } }
          ]
        }.to_json %>"
      ></div>
    <p class="chart-note">messages landed each day beside the number Slack's own analytics report for that day,
          last <%= pluralize(archive.days.size, "day") %></p>
    </div>
  <% end %>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Channels the archive covers least</h2>
      </div>
    </div>
    <% if archive.worst.any? %>
      <div class="scroll">
        <table class="data-table engine-wide-table">
          <thead>
            <tr>
              <th>channel</th>
              <th class="col-num">members held</th>
              <th class="col-num">Slack counted</th>
              <th class="col-num">share</th>
              <th class="col-num">threads</th>
              <th class="col-num">replies</th>
              <th class="col-num">oldest held</th>
              <th class="col-num">newest held</th>
            </tr>
          </thead>
          <tbody>
            <% archive.worst.each do |row| %>
              <tr>
                <td><%= render "channel_cell", row: row %></td>
                <td class="col-num"><%= number_with_delimiter(row.member_messages_held.to_i) %></td>
                <td class="col-num"><%= number_with_delimiter(row.slack_member_messages) %></td>
                <td class="col-num mono"><%= number_to_percentage(row.member_share, precision: 1) %></td>
                <td class="col-num">
                  <%= number_with_delimiter(row.threads_fetched) %> <span class="sub">of <%= number_with_delimiter(row.threads_known) %></span>
                </td>
                <td class="col-num">
                  <%= row.reply_share ? number_to_percentage(row.reply_share, precision: 0) : "n/a" %>
                </td>
                <td class="col-num mono">
                  <%= row.oldest_held ? row.oldest_held.to_date.to_fs(:db) : "n/a" %>
                </td>
                <td class="col-num mono">
                  <%= row.newest_held ? row.newest_held.to_date.to_fs(:db) : "n/a" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">
        no channel has both a Slack count and <%= number_with_delimiter(Engine::Archive::WORST_FLOOR) %> messages to compare it against yet
      </p>
    <% end %>
  <p class="chart-note">member messages we hold against the number Slack counted on the same days,
        channels where Slack counted <%= number_with_delimiter(Engine::Archive::WORST_FLOOR) %> or more</p>
  </div>
</div>

<div class="section">
  <div class="section-head">
    <h2 class="section-title">Still to walk</h2>
  </div>

  <div class="grid g-sided">
    <div class="card card-flush">
      <div class="card-head">
        <div>
          <h2 class="card-title">Not finished</h2>
        </div>
      </div>
      <% if archive.waiting.any? %>
        <div class="scroll">
          <table class="data-table engine-wide-table">
            <thead>
              <tr>
                <th>channel</th>
                <th>state</th>
                <th class="col-num">held</th>
                <th class="col-num">threads left</th>
                <th class="col-num">last walked</th>
                <th>why it stopped</th>
              </tr>
            </thead>
            <tbody>
              <% archive.waiting.each do |row| %>
                <tr>
                  <td><%= render "channel_cell", row: row %></td>
                  <td>
                    <span class="chip <%= row.walked ? "chip-warn" : "chip-off" %>">
                      <%= row.walked ? "part walked" : "never walked" %>
                    </span>
                  </td>
                  <td class="col-num"><%= number_with_delimiter(row.messages_held.to_i) %></td>
                  <td class="col-num"><%= number_with_delimiter([row.threads_known - row.threads_fetched, 0].max) %></td>
                  <td class="col-num mono"><%= row.last_walked_at ? "#{short_age(row.last_walked_at)} ago" : "n/a" %></td>
                  <td class="sub trunc-cell" title="<%= row.unreachable_reason %>">
                    <%= row.unreachable_reason.presence || "still queued" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
      <% end %>
    </div>

    <div class="card card-flush">
      <div class="card-head">
        <div>
          <h2 class="card-title">Could not read</h2>
        </div>
      </div>
      <% if archive.errors.any? %>
        <div class="scroll">
          <table class="data-table engine-wide-table">
            <thead>
              <tr>
                <th>error</th>
                <th class="col-num">channels</th>
                <th class="col-num">last tried</th>
              </tr>
            </thead>
            <tbody>
              <% archive.errors.each do |said, count, at| %>
                <tr>
                  <td class="mono"><%= said %></td>
                  <td class="col-num"><%= number_with_delimiter(count) %></td>
                  <td class="col-num mono"><%= at ? "#{short_age(at)} ago" : "n/a" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="card-note">no channel is holding a walk error</p>
      <% end %>
    </div>
  </div>
</div>
