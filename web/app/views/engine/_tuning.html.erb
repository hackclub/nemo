<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Schedule</h2>
    </div>
  </div>
  <div class="scroll">
    <table class="data-table engine-table">
      <thead>
        <tr>
          <th style="width:34%">setting</th>
          <th class="col-num" style="width:16%">default</th>
          <th class="col-num" style="width:16%">now</th>
          <th style="width:34%">changed by</th>
        </tr>
      </thead>
      <tbody>
        <% Engine::Setting::ENGINE_DIALS.each do |name, dial| %>
          <%= render "dial", source: Engine::Setting::ENGINE, name: name,
                title: dial[:label], sub: nil, may_tune: may_tune %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Retention</h2>
    </div>
  </div>
  <div class="scroll">
    <table class="data-table engine-table">
      <thead>
        <tr>
          <th style="width:34%">source</th>
          <th class="col-num" style="width:16%">default</th>
          <th class="col-num" style="width:16%">now</th>
          <th style="width:34%">changed by</th>
        </tr>
      </thead>
      <tbody>
        <% Engine::Source.all.select(&:prunable?).each do |s| %>
          <%= render "dial", source: s.key, name: Engine::Setting::RETENTION,
                title: s.key, sub: "floor #{s.prune_floor}", may_tune: may_tune %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Cadence and batch size</h2>
    </div>
  </div>
  <div class="scroll">
    <table class="data-table engine-table">
      <thead>
        <tr>
          <th style="width:34%">source</th>
          <th class="col-num" style="width:16%">default</th>
          <th class="col-num" style="width:16%">now</th>
          <th style="width:34%">changed by</th>
        </tr>
      </thead>
      <tbody>
        <% Engine::Source.all.each do |s| %>
          <%= render "dial", source: s.key, name: Engine::Setting::CADENCE,
                title: s.key, sub: "cadence", may_tune: may_tune %>
          <% s.limits.each_key do |limit| %>
            <%= render "dial", source: s.key, name: limit,
                  title: s.key, sub: limit.tr("_", " "), may_tune: may_tune %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
