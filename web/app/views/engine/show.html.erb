<% content_for :page_title, "Run #{@run.id}" %>

<% if @run.running? && !@orphaned %>
  <div data-controller="run-refresh" data-run-refresh-seconds-value="10" hidden></div>
<% end %>

<% content_for :head_actions do %>
  <%= link_to engine_path, class: "btn" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    <span>Runs</span>
  <% end %>
<% end %>

<%= render "run_detail", run: @run, steps: @steps, step_output: @step_output, heading: "This run",
      orphaned: @orphaned, worker: @worker %>
