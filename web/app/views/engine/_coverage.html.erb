<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Which days of data each source holds</h2>
    </div>
  </div>

  <% if day_coverage.any? %>
    <div class="covrows">
      <% day_coverage.each do |row| %>
        <div class="covrow">
          <div class="covhead">
            <span class="covkey"><%= row.source %></span>
            <span class="covsaid">
              <%= row.first_ds.strftime("%-d %b %Y") %> to <%= row.last_ds.strftime("%-d %b %Y") %>
              &middot; <%= pluralize(row.span, "day") %>
            </span>
          </div>
          <div class="covbar" role="img"
               aria-label="<%= number_with_delimiter(row.loaded) %> of <%= number_with_delimiter(row.span) %> days held">
            <% day_shares(row.never_fetched, row.unavailable, row.loaded).each do |state, count, width| %>
              <i class="<%= state %>" style="width: <%= width %>%"
                 title="<%= number_with_delimiter(count) %> <%= EngineHelper::DAY_STATES.fetch(state) %>"></i>
            <% end %>
          </div>
          <div class="covsaid">
            <%= number_with_delimiter(row.loaded) %> held
            &middot; <%= number_with_delimiter(row.unavailable) %> Slack has no file for
            <% if row.never_fetched.positive? %>
              &middot; <%= number_with_delimiter(row.never_fetched) %> before we started
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="key">
      <span><i class="lg-held"></i>held</span>
      <span><i class="lg-nofile"></i>Slack has no file for that day</span>
      <span><i class="lg-before"></i>before the job existed</span>
    </div>
  <% else %>
    <p class="card-note">n/a</p>
  <% end %>
</div>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">What the day count is holding up</h2>
    </div>
  </div>
  <div class="scroll">
    <table class="data-table engine-wide-table">
      <thead>
        <tr>
          <th>metric</th>
          <th class="col-num">days held</th>
          <th class="col-num">days needed</th>
          <th>progress</th>
          <th class="col-num">first measurable</th>
        </tr>
      </thead>
      <tbody>
        <% EngineController::HOLDING.each do |label, needed| %>
          <% share = needed.positive? ? (held.to_f / needed * 100) : 0 %>
          <tr>
            <td><%= label %></td>
            <td class="col-num"><%= held %></td>
            <td class="col-num"><%= needed %></td>
            <td class="cell-share">
              <div class="inbar <%= "soft" if share < 50 %>">
                <span><i style="width: <%= [share, 2].max.round %>%"></i></span>
                <span><%= share.round %>%</span>
              </div>
            </td>
            <td class="col-num mono">
              <%= held >= needed ? "now" : (Date.current + (needed - held)).strftime("~%-d %b %Y") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
