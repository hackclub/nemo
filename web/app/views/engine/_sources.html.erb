<div class="scroll">
  <table class="data-table engine-table">
    <thead>
      <tr>
        <th style="width:24%">source</th>
        <th style="width:10%">cadence</th>
        <th style="width:12%">window</th>
        <th style="width:15%">retention</th>
        <th class="col-num" style="width:9%">last ok</th>
        <th class="col-num" style="width:9%">typical</th>
        <th class="col-num" style="width:9%">rows</th>
        <th class="col-num" style="width:8%">state</th>
        <% if active_request.nil? %>
          <th class="col-btn" style="width:4%"></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% sources.each do |row| %>
        <% s = row.source %>
        <tr>
          <td>
            <span class="two-line">
              <b class="src-key"><%= s.key %></b>
              <span><%= s.endpoint %></span>
            </span>
          </td>
          <td><%= s.cadence %></td>
          <td class="mono"><%= s.window %></td>
          <td>
            <span class="two-line">
              <b class="src-key"><%= s.retention %></b>
              <% if s.prune_floor %>
                <span>floor <%= s.prune_floor %></span>
              <% end %>
            </span>
          </td>
          <td class="mono"><%= short_age(row.last_ok) %></td>
          <td class="mono"><%= short_seconds(row.typical) %></td>
          <td class="mono"><%= row.rows ? number_with_delimiter(row.rows) : "n/a" %></td>
          <td class="<%= source_state_class(row.state) %>"><%= row.state %></td>
          <% if active_request.nil? %>
            <td>
              <%= button_to "run", engine_trigger_stage_path(stage: s.key),
                    class: "run-btn", form: { class: "contents" } %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
