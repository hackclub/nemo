<% cells_by_key = matrix.to_h { |source, cells| [source.key, cells] } %>
<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Sources</h2>
    </div>
  </div>

  <div class="lhead">
    <div>Source</div>
    <div>Cadence</div>
    <div>Window</div>
    <div>Retention</div>
    <div>Last 14 nights</div>
    <div class="r">Last ok</div>
    <div class="r">Typical</div>
    <div class="r">Rows</div>
    <div></div>
    <div></div>
  </div>

  <% sources.sort_by { |row| row.last_ok || Time.at(0) }.each do |row| %>
    <% source = row.source %>
    <% cells = cells_by_key[source.key] || [] %>
    <% missed = cells.count { |cell| cell == "none" || cell == "fail" } %>
    <% state = row.state == "live" ? "live" : "stale" %>
    <% is_open = open == source.key %>
    <%= link_to engine_path(tab: "sources", open: (source.key unless is_open)),
          class: "lrow", aria: { expanded: is_open.to_s } do %>
      <div class="skey"><i class="dot <%= state %>"></i><b><%= source.key %></b></div>
      <div style="font-size: 12px"><%= Engine::Setting.value(source.key, Engine::Setting::CADENCE) %></div>
      <div class="sub mono" style="font-size: 11.5px"><%= source.window %></div>
      <div style="font-size: 12px">
        <%= Engine::Setting.value(source.key, Engine::Setting::RETENTION) %>
        <% if source.prune_floor.present? %>
          <span class="sub" style="display: block">floor <%= source.prune_floor %></span>
        <% end %>
      </div>
      <div class="cells">
        <% cells.last(14).each do |cell| %><i class="<%= cell %>"></i><% end %>
      </div>
      <div class="snum <%= "warn" if state == "stale" %>"><%= short_age(row.last_ok) %></div>
      <div class="snum"><%= row.typical ? "#{row.typical.round}s" : "n/a" %></div>
      <div class="snum"><%= row.rows ? number_with_delimiter(row.rows) : "n/a" %></div>
      <div class="r"></div>
      <div class="scar">&#9654;</div>
    <% end %>

    <% if is_open %>
      <div class="exp">
        <div>
          <div class="exp-k">The contract &middot; db/sources.yml</div>
          <dl class="facts2">
            <dt>Endpoint</dt><dd><%= source.endpoint %></dd>
            <dt>Credential</dt><dd><%= source.credential %></dd>
            <dt>Feeds</dt><dd class="plain"><%= Array(source.feeds).join(", ") %></dd>
            <dt>Last <%= EngineController::NIGHTS %></dt>
            <dd class="plain">
              <% if missed.positive? %>
                missed <b><%= missed %></b> <%= "night".pluralize(missed) %>
              <% else %>
                ran every night
              <% end %>
            </dd>
          </dl>

          <div class="exp-k" style="margin-top: 16px">Dials</div>
          <div class="dialrow">
            <div class="dn">Cadence<span>how often the night runs it</span></div>
            <div class="dd">was <%= source.cadence %></div>
            <%= render "val", source: source.key, name: Engine::Setting::CADENCE, may_tune: may_tune %>
          </div>
          <div class="dialrow">
            <div class="dn">Retention<span>how many days of its rows are kept</span></div>
            <div class="dd">was <%= Engine::Setting::KEEP %></div>
            <%= render "val", source: source.key, name: Engine::Setting::RETENTION, may_tune: may_tune %>
          </div>
        </div>

        <div>
          <div class="exp-k">
            What it said<% if run %> &middot; run <%= run.id %>, <%= run.started_at.strftime("%-d %b, %H:%M") %><% end %>
          </div>
          <% said = step_output.find { |out| out.source == source.key } %>
          <% if said&.output.present? %>
            <pre><%= said.output %></pre>
          <% else %>
            <p class="card-sub" style="margin: 0">n/a</p>
          <% end %>
          <div class="exp-act">
            <% if active_request.nil? %>
              <%= button_to "Run it now", engine_stage_path(stage: source.key),
                    class: "btn", form: { class: "contents" } %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

</div>
