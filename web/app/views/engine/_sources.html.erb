<% cells_by_key = matrix.to_h { |source, cells| [source.key, cells] } %>
<% stale_count = sources.count { |row| row.state != "live" } %>
<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Every source</h2>
      <p class="card-sub">
        <%= pluralize(sources.size, "source") %>
        <% if stale_count.positive? %>
          &middot; <span class="warn"><%= pluralize(stale_count, "source") %> stale</span>
        <% else %>
          &middot; all live
        <% end %>
      </p>
    </div>
  </div>

  <div class="scroll" data-controller="chart-tooltip"
       data-action="mouseover->chart-tooltip#show mouseleave->chart-tooltip#clear">
    <div class="srclist">
      <div class="source-head">
        <div>Source</div>
        <div>Cadence</div>
        <div>Window</div>
        <div>Retention</div>
        <div>Last 14 nights</div>
        <div class="align-right">Last ok</div>
        <div class="align-right">Typical</div>
        <div class="align-right">Rows</div>
        <div></div>
      </div>

    <% sources.sort_by { |row| row.last_ok || Time.at(0) }.each do |row| %>
      <% source = row.source %>
      <% cells = cells_by_key[source.key] || [] %>
      <% missed = cells.count { |cell| cell == "none" || cell == "fail" } %>
      <% state = row.state == "live" ? "live" : "stale" %>
      <% is_open = open == source.key %>
      <%= link_to engine_path(tab: "sources", open: (source.key unless is_open)),
            class: "source-row", aria: { expanded: is_open.to_s } do %>
        <div class="stat-key"><i class="dot <%= state %>"></i><b><%= source.key %></b></div>
        <div class="src-cell"><%= Engine::Setting.value(source.key, Engine::Setting::CADENCE) %></div>
        <div class="src-dim"><%= source.window %></div>
        <div class="src-cell">
          <%= Engine::Setting.value(source.key, Engine::Setting::RETENTION) %>
          <% if source.prune_floor.present? %>
            <span class="src-floor">floor <%= source.prune_floor %></span>
          <% end %>
        </div>
        <% shown_nights = nights.last(14) %>
        <div class="cells" role="group" aria-label="<%= source.key %>, the last 14 nights">
          <% cells.last(14).each_with_index do |cell, i| %><i class="<%= cell %>" role="img"
             data-tip="<%= night_tip(source.key, shown_nights[i], cell) %>"
             aria-label="<%= shown_nights[i]&.strftime("%-d %b") %>, <%= cell_label(cell) %>"></i><% end %>
        </div>
        <div class="stat-value <%= "warn" if state == "stale" %>"><%= short_age(row.last_ok) %></div>
        <div class="stat-value"><%= row.typical ? "#{row.typical.round}s" : "n/a" %></div>
        <div class="stat-value"><%= row.rows ? number_with_delimiter(row.rows) : "n/a" %></div>
        <svg class="disclosure-caret" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      <% end %>

      <% if is_open %>
        <div class="contract">
          <div>
            <div class="contract-key">Contract, db/sources.yml</div>
            <dl class="facts2">
              <dt>Endpoint</dt><dd><%= source.endpoint %></dd>
              <dt>Credential</dt><dd><%= source.credential %></dd>
              <dt>Feeds</dt><dd class="is-text"><%= Array(source.feeds).join(", ") %></dd>
              <dt>Last <%= EngineController::NIGHTS %></dt>
              <dd class="is-text">
                <% if missed.positive? %>
                  missed <b><%= missed %></b> <%= "night".pluralize(missed) %>
                <% else %>
                  ran every night
                <% end %>
              </dd>
            </dl>

            <div class="contract-key contract-key-next">Dials</div>
            <div class="dialrow">
              <div class="dial-name">Cadence<span>how often the night runs it</span></div>
              <div class="meta-fine">was <%= source.cadence %></div>
              <%= render "setting_value", source: source.key, name: Engine::Setting::CADENCE, may_tune: may_tune %>
            </div>
            <div class="dialrow">
              <div class="dial-name">Retention<span>how many days of its rows are kept</span></div>
              <div class="meta-fine">was <%= Engine::Setting::KEEP %></div>
              <%= render "setting_value", source: source.key, name: Engine::Setting::RETENTION, may_tune: may_tune %>
            </div>
          </div>

          <div>
            <div class="contract-key">
              What it output<% if run %> &middot; run <%= run.id %>, <%= run.started_at.strftime("%-d %b, %H:%M") %><% end %>
            </div>
            <% output = step_output.find { |out| out.source == source.key } %>
            <% if output&.output.present? %>
              <pre><%= output.output %></pre>
            <% else %>
              <p class="card-sub flat">n/a</p>
            <% end %>
            <div class="contract-actions">
              <% if active_request.nil? %>
                <%= button_to "Run it now", engine_stage_path(stage: source.key),
                      class: "btn", form: { class: "contents" } %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <% end %>
    </div>
  </div>
</div>
