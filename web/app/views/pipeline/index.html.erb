<% if @auto_refresh %>
  <% content_for :head do %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
  <% end %>
<% end %>

<% content_for :page_title, "Pipeline" %>
<% content_for :page_subtitle, "nightly sync runs, stage by stage" %>

<% content_for :page_badge do %>
  <% if @auto_refresh %>
    <span class="chip chip-off" data-controller="run-refresh" data-run-refresh-seconds-value="10">
      live, refreshing every 10s
    </span>
  <% end %>
<% end %>

<% content_for :head_actions do %>
  <% if @active_request %>
    <span class="chip chip-off">
      sync <%= @active_request.status %>, requested by <%= @active_request.requested_by %>
      <%= time_ago_in_words(@active_request.created_at) %> ago
    </span>
  <% else %>
    <% if @last_request %>
      <span class="delta-note">
        last requested by <%= @last_request.requested_by %>
        <%= time_ago_in_words(@last_request.created_at) %> ago, <%= @last_request.status %>
      </span>
    <% end %>
    <%= button_to "Run the nightly sync now", pipeline_sync_path,
          class: "btn btn-primary", form: { class: "contents" } %>
  <% end %>
<% end %>

<% if @run.nil? %>
  <div class="card">
    <div class="card-head">
      <div>
        <h2 class="card-title">Latest run</h2>
        <p class="card-sub">nothing recorded yet</p>
      </div>
    </div>
    <p class="delta-note">No nightly run has been recorded. Start one with the button above.</p>
  </div>
<% else %>
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Latest run</h2>
        <p class="card-sub">
          started <%= @run.started_at.strftime("%b %-d, %Y at %H:%M") %>
          &middot; <%= run_duration(@run) %>
          <% if @run.running? && @steps.any? %>
            &middot; step <%= @steps.last.step_index %> of <%= @steps.last.step_total %>
          <% end %>
        </p>
      </div>
      <div class="card-tools">
        <%= run_age(@run) %>
        <%= run_status(@run) %>
      </div>
    </div>

    <% if @steps.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>source</th>
              <th class="col-rank">step</th>
              <th class="col-num">status</th>
              <th class="col-num">elapsed</th>
              <th class="col-num">rows</th>
            </tr>
          </thead>
          <tbody>
            <% @steps.each do |step| %>
              <tr>
                <td>
                  <span class="two-line">
                    <b><%= step.source %></b>
                    <% pct = run_progress_pct(step) %>
                    <% if step.running? && pct %>
                      <span><%= number_to_percentage(pct, precision: 1) %> through</span>
                    <% end %>
                  </span>
                  <% if step.running? && pct %>
                    <span class="progress"><span class="progress-fill" style="width:<%= pct %>%"></span></span>
                  <% end %>
                </td>
                <td><%= step.step_index %>/<%= step.step_total %></td>
                <td><%= run_status(step) %></td>
                <td><%= run_duration(step) %></td>
                <td><%= run_rows(step) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">
        <%= @run.running? ? "No stage has started yet." : "This run predates per-stage tracking." %>
      </p>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Stage output</h2>
        <p class="card-sub">everything each stage printed, captured as it ran</p>
      </div>
      <% if @step_output.any? %>
        <div class="card-tools"><span class="chip chip-off"><%= pluralize(@step_output.size, "stage") %></span></div>
      <% end %>
    </div>

    <% if @step_output.any? %>
      <% @step_output.each do |row| %>
        <details class="log-item">
          <summary>
            <span class="log-source"><%= row.source %></span>
            <span class="log-meta"><%= row.step_index %> &middot; <%= output_size(row.output) %></span>
          </summary>
          <pre class="log"><%= row.output %></pre>
        </details>
      <% end %>
    <% else %>
      <p class="card-note">
        Nothing captured for this run. Stage output is recorded from the run that follows the capture
        being added, so it stays empty until the next nightly.
      </p>
    <% end %>
  </div>
<% end %>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Day coverage</h2>
      <p class="card-sub">which days each source has actually loaded</p>
    </div>
  </div>
  <% if @day_coverage.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>source</th>
            <th class="col-num">span</th>
            <th class="col-num">loaded</th>
            <th class="col-num">unavailable</th>
            <th class="col-num">never fetched</th>
          </tr>
        </thead>
        <tbody>
          <% @day_coverage.each do |row| %>
            <tr>
              <td>
                <span class="two-line">
                  <b><%= row.source %></b>
                  <span><%= row.first_ds.strftime("%b %-d, %Y") %> to <%= row.last_ds.strftime("%b %-d, %Y") %></span>
                </span>
              </td>
              <td><%= pluralize(row.span, "day") %></td>
              <td><%= number_with_delimiter(row.loaded) %></td>
              <td>
                <% if row.unavailable.positive? %>
                  <span class="chip chip-off"><%= number_with_delimiter(row.unavailable) %></span>
                <% else %>
                  0
                <% end %>
              </td>
              <td>
                <% if row.never_fetched.positive? %>
                  <span class="chip chip-warn"><%= number_with_delimiter(row.never_fetched) %></span>
                <% else %>
                  0
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">n/a</p>
  <% end %>
</div>

<div class="grid-2-1">
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Recent runs</h2>
        <p class="card-sub">last <%= PipelineController::HISTORY %> parent runs</p>
      </div>
    </div>
    <% if @history.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>started</th>
              <th class="col-num">status</th>
              <th class="col-num">elapsed</th>
            </tr>
          </thead>
          <tbody>
            <% @history.each do |row| %>
              <tr>
                <td><%= row.started_at.strftime("%b %-d, %H:%M") %></td>
                <td><%= run_status(row) %></td>
                <td><%= run_duration(row) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">n/a</p>
    <% end %>
  </div>

  <div class="card card-flush self-start">
    <div class="card-head">
      <div>
        <h2 class="card-title">Freshness</h2>
        <p class="card-sub">last success per source, stalest first</p>
      </div>
    </div>
    <% if @freshness.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>source</th>
              <th class="col-date">last success</th>
            </tr>
          </thead>
          <tbody>
            <% @freshness.each do |source, finished_at| %>
              <tr>
                <td><%= source %></td>
                <td><%= time_ago_in_words(finished_at) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">n/a</p>
    <% end %>
  </div>
</div>
