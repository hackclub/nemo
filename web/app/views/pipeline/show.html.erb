<% content_for :page_title, "Run #{@run.id}" %>
<% content_for :page_subtitle do %>
  <% if @steps.any? && @steps.first.step_total == 1 %>
    single stage &middot; <%= @steps.first.source %>
  <% elsif @steps.any? %>
    full nightly &middot; <%= @steps.first.step_total %> stages
  <% else %>
    predates per-stage tracking
  <% end %>
<% end %>

<%= render "run_detail", run: @run, steps: @steps, step_output: @step_output, heading: "This run" %>

<div>
  <%= link_to pipeline_path, class: "crumb" do %>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    back to pipeline
  <% end %>
</div>
