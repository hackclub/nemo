<% content_for :page_title, "Your account" %>

<div class="grid g-1">
  <div class="card card-flush">
    <div class="card-head identity-head">
      <%= face(current_account.user_id, css: "avatar avatar-band") %>
      <span class="two-line">
        <b><%= person_name(current_account.user_id) %></b>
        <span class="mono"><%= current_account.user_id %></span>
      </span>
    </div>

    <div class="setlist">
      <div class="setline">
        <span class="setname">Role</span>
        <span class="setval">
          <% if @roles.any? %>
            <span class="chip <%= Authz.superadmin?(@roles.first) ? "chip-primary" : "" %>">
              <%= @roles.map { |role| Authz.role_label(role) }.to_sentence %>
            </span>
          <% else %>
            <span class="is-none">None</span>
          <% end %>
        </span>
      </div>

      <div class="setline">
        <span class="setname">Slack</span>
        <span class="setval">
          <% if @account %>
            <span class="chip chip-good">Linked</span>
            <%= button_to "Unlink Slack", fd_slack_account_path, method: :delete, class: "btn btn-sm",
                  form: { class: "contents" } %>
          <% elsif @linkable %>
            <span class="chip chip-off">Not linked</span>
            <%= button_to "Link Slack", fd_slack_account_path, method: :post, class: "btn btn-sm",
                  form: { class: "contents" } %>
          <% else %>
            <span class="chip chip-off">Not linked</span>
          <% end %>
        </span>
      </div>
    </div>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Activity</h2>
        <p class="card-sub">
          <% if @audit_row_count.positive? %>
            <%= pluralize(@audit_row_count, "action") %>, last 30 days
          <% else %>
            Last 30 days
          <% end %>
        </p>
      </div>
    </div>
    <% if @audit_rows.any? %>
      <%= render "shared/log", audit_rows: @audit_rows %>
    <% else %>
      <div class="empty"><p class="empty-title">Nothing in 30 days</p></div>
    <% end %>
  </div>
</div>
