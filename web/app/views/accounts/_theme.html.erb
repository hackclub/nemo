<div class="card-body">
  <div class="theme-grid" role="group" aria-label="Theme">
    <% Appearance::THEMES.each do |theme| %>
      <% canvas, card, ink = theme.swatch %>
      <button type="button" class="theme-opt" aria-pressed="false"
              data-theme-target="option" data-theme-key="<%= theme.key %>"
              data-action="theme#pick">
        <span class="theme-preview" aria-hidden="true"
              style="--p-canvas: <%= canvas %>; --p-card: <%= card %>; --p-ink: <%= ink %>">
          <span class="theme-preview-card"><i></i><i></i></span>
          <span class="theme-preview-card"><b></b><i></i></span>
          <span class="theme-preview-card"><b></b><i></i></span>
        </span>
        <span class="theme-name">
          <span class="theme-label"><%= theme.label %></span>
          <span class="theme-auto">Auto</span>
        </span>
      </button>
    <% end %>
  </div>
</div>
<div class="setlist">
  <label class="setline">
    <span class="setname">Orange</span>
    <span class="setval">
      <input type="checkbox" class="switch" role="switch"
             data-theme-target="accent" data-action="theme#tint">
    </span>
  </label>
</div>
