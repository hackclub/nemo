<% channel_pattern = Api::V1::ChannelManagersController::CHANNEL.source %>
<% member_pattern = Api::V1::ChannelManagersController::MEMBER.source %>

<dl class="doc-spec">
  <div><dt>Base</dt><dd><%= request.base_url %>/api/v1</dd></div>
  <div><dt>Scheme</dt><dd>Bearer</dd></div>
  <div><dt>Rate</dt><dd><%= @rate %>/min</dd></div>
  <div><dt>Format</dt><dd>application/json</dd></div>
</dl>

<section class="doc-sec" id="access">
  <h2>Access <%= doc_anchor("access") %></h2>

  <p class="doc-lede">
    Keys belong to an app, not to you. Register one on
    <%= link_to "your settings page", settings_keys_path %> with a name and what it does,
    and ask for the scopes it needs. A reviewer approves or declines each scope.
  </p>

  <p>
    The name and description are what members see when they decide whether to answer you,
    so write them for a member, not for the reviewer.
  </p>

  <dl class="doc-defs">
    <div class="doc-def">
      <dt>pending <em>state</em></dt>
      <dd>Waiting on a reviewer. Withdraw it at any time.</dd>
    </div>
    <div class="doc-def">
      <dt>approved <em>state</em></dt>
      <dd>The app may hold keys for that scope. Rechecked on every call.</dd>
    </div>
    <div class="doc-def">
      <dt>declined <em>state</em></dt>
      <dd>Nothing is granted. Ask again with a fuller reason.</dd>
    </div>
  </dl>

  <div class="doc-note">
    <b>Revocation</b>
    An approval taken back stops the app's live keys answering straight away, with
    <code>403 not_approved</code>. Retiring an app revokes every key it held.
  </div>
</section>

<section class="doc-sec" id="auth">
  <h2>Authentication <%= doc_anchor("auth") %></h2>

  <p>
    Keys are <code>nemo_live_</code> plus 20 base58 characters, generated once a scope is
    approved and stored as a SHA-256 digest. Shown once. Rotating one replaces the secret and
    keeps the name, the rate and the audit trail. Never accepted as a query parameter.
  </p>

  <div class="doc-code" data-controller="copy">
    <div class="doc-code-h">
      <span class="grow">header</span>
      <%= doc_copy %>
    </div>
    <pre class="pre" data-copy-target="source">Authorization: Bearer nemo_live_7Fj2QcW8xR4mLpVdA1sT</pre>
  </div>

  <div class="doc-code" data-controller="copy">
    <div class="doc-code-h">
      <span class="verb">GET</span>
      <span class="grow">/api/v1/token</span>
      <%= doc_copy %>
    </div>
    <pre class="pre" data-copy-target="source">{ <span class="k">"name"</span>: <span class="s">"Toolbox"</span>, <span class="k">"prefix"</span>: <span class="s">"nemo_live_7Fj2"</span>,
  <span class="k">"app"</span>: <span class="s">"triage-bot"</span>, <span class="k">"rate_per_minute"</span>: <span class="n"><%= @rate %></span> }</pre>
  </div>
</section>

<section class="doc-sec" id="check">
  <h2><span class="verb">GET</span> Check a member <%= doc_anchor("check") %></h2>

  <div class="doc-code" data-controller="copy">
    <div class="doc-code-h">
      <span class="grow">path</span>
      <%= doc_copy %>
    </div>
    <pre class="pre" data-copy-target="source">/api/v1/channels/{channel_id}/managers/{user_id}</pre>
  </div>

  <p>One channel and one member per request. There is no batch form.</p>

  <h3>Parameters</h3>
  <dl class="doc-defs">
    <div class="doc-def">
      <dt>channel_id <em>path</em></dt>
      <dd>
        <span class="mono"><%= channel_pattern %></span><br>
        Public or private. Never validated against an index.
      </dd>
    </div>
    <div class="doc-def">
      <dt>user_id <em>path</em></dt>
      <dd>
        <span class="mono"><%= member_pattern %></span><br>
        Unknown ids answer <code>withheld</code>.
      </dd>
    </div>
  </dl>

  <h3>Responses</h3>
  <div class="doc-two">
    <div class="doc-code" data-controller="copy">
      <div class="doc-code-h">
        <span class="doc-status">200</span>
        <span class="grow">granted</span>
        <%= doc_copy %>
      </div>
      <pre class="pre" data-copy-target="source">{
  <span class="k">"channel_id"</span>: <span class="s">"C0P5NE3M0"</span>,
  <span class="k">"user_id"</span>: <span class="s">"U0A5PLKMB25"</span>,
  <span class="k">"consent"</span>: <span class="s">"granted"</span>,
  <span class="k">"is_manager"</span>: <span class="n">true</span>,
  <span class="k">"synced_at"</span>: <span class="s">"2026-08-31T04:12:07Z"</span>,
  <span class="k">"stale"</span>: <span class="n">false</span>
}</pre>
    </div>
    <div class="doc-code" data-controller="copy">
      <div class="doc-code-h">
        <span class="doc-status">200</span>
        <span class="grow">withheld</span>
        <%= doc_copy %>
      </div>
      <pre class="pre" data-copy-target="source">{
  <span class="k">"channel_id"</span>: <span class="s">"C0P5NE3M0"</span>,
  <span class="k">"user_id"</span>: <span class="s">"U0A5PLKMB25"</span>,
  <span class="k">"consent"</span>: <span class="s">"withheld"</span>,
  <span class="k">"is_manager"</span>: <span class="n">null</span>,
  <span class="k">"opt_in_url"</span>: <span class="s">"<%= settings_permissions_url %>"</span>
}</pre>
    </div>
  </div>

  <h3>Fields</h3>
  <dl class="doc-defs">
    <div class="doc-def">
      <dt>consent <em>string</em></dt>
      <dd><code>granted</code> or <code>withheld</code>. Always present.</dd>
    </div>
    <div class="doc-def">
      <dt>is_manager <em>bool | null</em></dt>
      <dd><code>null</code> whenever consent is withheld.</dd>
    </div>
    <div class="doc-def">
      <dt>synced_at <em>iso8601?</em></dt>
      <dd>When the channel was last read from Slack. Absent when withheld.</dd>
    </div>
    <div class="doc-def">
      <dt>stale <em>bool?</em></dt>
      <dd><code>true</code> past the cache TTL. Answer still served.</dd>
    </div>
    <div class="doc-def">
      <dt>opt_in_url <em>string?</em></dt>
      <dd>Present only when withheld.</dd>
    </div>
  </dl>
</section>

<section class="doc-sec" id="consent">
  <h2>Consent states <%= doc_anchor("consent") %></h2>

  <p class="doc-lede">
    Members opt in to one app at a time. Consent for somebody else's app says nothing about
    yours, and a member who opted in to you last month has not opted in to anyone since.
  </p>

  <p>Branch on <code>consent</code>, not on the status code. Withheld is a <code>200</code>.</p>

  <dl class="doc-defs">
    <div class="doc-def">
      <dt>granted <em>true | false</em></dt>
      <dd>The member opted in to your app for this scope. This is the answer.</dd>
    </div>
    <div class="doc-def">
      <dt>withheld <em>null</em></dt>
      <dd>They have not opted in to your app, or we do not know them.</dd>
    </div>
  </dl>

  <p>
    A channel with no managers on record, or one that does not exist, answers
    <code>is_manager: false</code>. The API never confirms whether a channel exists.
  </p>

  <div class="doc-note">
    <b>Why private channels answer</b>
    Consent is settled before the channel is touched, so a withheld body is identical
    whatever channel you named: same fields, no <code>synced_at</code>, no
    <code>stale</code>. Mnemosyne does not message members on your behalf; surface
    <code>opt_in_url</code> yourself.
  </div>
</section>

<section class="doc-sec" id="rate">
  <h2>Rate limits <%= doc_anchor("rate") %></h2>

  <p>
    <code><%= @rate %></code> requests per fixed 60 second window, per key. Overridable per key
    by a community manager.
  </p>

  <div class="doc-code" data-controller="copy">
    <div class="doc-code-h">
      <span class="grow">response headers</span>
      <%= doc_copy %>
    </div>
    <pre class="pre" data-copy-target="source">RateLimit-Limit: <%= @rate %>
RateLimit-Remaining: <%= [@rate - 3, 0].max %>
RateLimit-Reset: 34        <span class="c">// seconds until the window rolls</span>
Retry-After: 34            <span class="c">// 429 only, matches body.retry_after</span></pre>
  </div>

  <p>
    The first three are on every answered request. Refusals raised before the key is resolved
    carry none, since there is no budget to report.
  </p>
</section>

<section class="doc-sec" id="errors">
  <h2>Errors <%= doc_anchor("errors") %></h2>

  <div class="doc-code" data-controller="copy">
    <div class="doc-code-h">
      <span class="doc-status is-bad">429</span>
      <span class="grow">body</span>
      <%= doc_copy %>
    </div>
    <pre class="pre" data-copy-target="source">{ <span class="k">"error"</span>: <span class="s">"rate_limited"</span>, <span class="k">"message"</span>: <span class="s">"rate limit spent, see retry_after"</span>, <span class="k">"retry_after"</span>: <span class="n">34</span> }</pre>
  </div>

  <dl class="doc-defs">
    <% Api::V1::BaseController::CALLER_ERRORS.each do |status, key, said| %>
      <div class="doc-def">
        <dt><%= key %> <em><span class="doc-status<%= " is-bad" if status >= 500 %>"><%= status %></span></em></dt>
        <dd><%= said %></dd>
      </div>
    <% end %>
  </dl>
</section>
