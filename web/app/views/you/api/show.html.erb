<% content_for :page_title, "API access" %>
<% api_off = Fd::Flag.off?(:public_api) %>
<% granted = Api::Capability::KEYS.count { |key| @consents[key] == Api::Consent::GRANTED } %>

<div class="cols c-2">
  <div>
    <div class="fbox">
      <div class="ft">
        <span>What apps may ask about you</span>
        <span><%= granted %> of <%= Api::Capability::KEYS.size %></span>
      </div>
      <div class="rows">
        <% Api::Capability::KEYS.each do |key| %>
          <% on = @consents[key] == Api::Consent::GRANTED %>
          <div class="row cap-row">
            <span class="cap-two">
              <b><%= Api::Capability.label(key) %></b>
              <span><%= Api::Capability.covers(key) %></span>
            </span>
            <span class="cap-do">
              <%= button_to on ? "Opt out" : "Opt in",
                    you_consent_path(capability: key, on: on ? "0" : "1"),
                    method: :patch, disabled: api_off,
                    class: "btn #{'btn-primary' unless on} #{'is-off' if api_off}",
                    form: { class: "contents" } %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="facts">
    <p class="facts-h">Your account</p>

    <div class="fcard">
      <div class="fcard-who">
        <% if current_profile&.image_url %>
          <img class="avatar" src="<%= current_profile.image_url %>" alt="" width="30" height="30">
        <% else %>
          <span class="avatar"><%= member_id.first %></span>
        <% end %>
        <span class="two-line">
          <b><%= current_profile&.display_name.presence || member_id %></b>
          <span><%= member_id %></span>
        </span>
      </div>

      <div class="frows">
        <div class="frow">
          <span>Opted in to</span>
          <b class="<%= "is-none" if granted.zero? %>">
            <%= granted.zero? ? "nothing" : "#{granted} of #{Api::Capability::KEYS.size}" %>
          </b>
        </div>
        <div class="frow">
          <span>Channels you are in</span>
          <b class="<%= "is-none" if @rooms.empty? %>">
            <%= @rooms.any? ? number_with_delimiter(@rooms.size) : "n/a" %>
          </b>
        </div>
      </div>
    </div>
  </div>
</div>
