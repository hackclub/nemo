<div class="card-tools">
  <%= render layout: "shared/dropdown", locals: { label: label, trigger_css: "btn daterange-preset",
        pop_css: "menu-compact",
        trigger: capture {
          concat tag.span(chosen)
          concat(tag.svg(width: 16, height: 16, viewBox: "0 0 24 24", fill: "none",
            stroke: "currentColor", "stroke-width": 2, "stroke-linecap": "round",
            "stroke-linejoin": "round", class: "daterange-chev", aria: { hidden: true }) do
            tag.path(d: "m6 9 6 6 6-6")
          end)
        } } do %>
    <% groups.each_with_index do |group, at| %>
      <% next if group[:options].blank? %>
      <% if at.positive? %><div class="menu-sep"></div><% end %>
      <% if group[:title] %><p class="menu-group"><%= group[:title] %></p><% end %>
      <% group[:options].each do |option| %>
        <%= link_to option[:label], option[:href], class: "btn",
              aria: { current: ("true" if option[:current]) } %>
      <% end %>
    <% end %>
  <% end %>
</div>
