<div class="pagebar">
  <% if local_assigns[:back_href] %>
    <%= link_to "Back", back_href, class: "btn",
          data: (local_assigns[:frame] ? { turbo_frame: frame } : {}) %>
  <% else %>
    <span class="btn is-off">Back</span>
  <% end %>
  <span class="pager-at"><%= local_assigns[:said] || "Page #{page} of #{pages}" %></span>
  <% if local_assigns[:next_href] %>
    <%= link_to "Next", next_href, class: "btn",
          data: (local_assigns[:frame] ? { turbo_frame: frame } : {}) %>
  <% else %>
    <span class="btn is-off">Next</span>
  <% end %>
</div>
