<nav id="section-nav" class="cpane" aria-label="Engine sections">
  <%= render "layouts/sidebar_head", title: "Engine", sub: "Ingestion and warehouse" %>

  <div class="cnav">
    <% EngineController::GROUPS.each do |heading, keys| %>
      <p class="community-nav-label"><%= heading %></p>
      <div class="community-nav-group">
        <% keys.each do |key| %>
          <% label = EngineController::TABS.fetch(key) %>
          <%= link_to engine_tab_path(key),
                aria: { current: ("page" if engine_tab == key) } do %>
            <%= nav_icon(key) %><span class="trunc"><%= label %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render "layouts/sidebar_foot" %>
</nav>
