<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mnemosyne" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "layouts/boot" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-section="mn">
    <%= render "shared/synthetic_banner" %>
    <div class="auth">
      <div class="auth-card">
        <span class="auth-word">Mnemosyne</span>
        <%= yield %>
        <% if notice || alert %>
          <p class="auth-alt"><%= notice || alert %></p>
        <% end %>
      </div>
    </div>
  </body>
</html>
