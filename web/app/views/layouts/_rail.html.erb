<nav class="rail" aria-label="Areas">
  <%= link_to root_path, class: "rail-brand", aria: { label: "Mnemosyne home" } do %>
    <%= image_tag "nemo.png", class: "brand-mark", alt: "", width: 800, height: 483 %>
  <% end %>

  <div class="rail-set">
    <% rail_stops(fire_engine: fire_engine).each do |stop| %>
      <%= link_to stop.path, class: "rail-btn", title: stop.label,
            aria: { current: ("page" if stop.here), label: stop.label } do %>
        <%= rail_icon(stop.icon) %>
        <span class="rail-tip"><%= stop.label %></span>
        <% if stop.tally.to_i.positive? %>
          <i class="rail-dot"><%= stop.tally > 99 ? "99+" : stop.tally %></i>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="rail-foot">
    <span class="rail-sep" aria-hidden="true"></span>
    <%= link_to docs_path, class: "rail-btn", title: "Docs",
          aria: { current: ("page" if page_section == "docs"), label: "Docs" } do %>
      <%= rail_icon("book") %>
      <span class="rail-tip">Docs</span>
    <% end %>
    <%= link_to account_path, class: "rail-btn", title: "Settings",
          aria: { current: ("page" if page_section == "settings"), label: "Settings" } do %>
      <%= rail_icon("gear") %>
      <span class="rail-tip">Settings</span>
      <% if may_review_api? && api_queue_waiting.positive? %>
        <i class="rail-dot"><%= api_queue_waiting > 99 ? "99+" : api_queue_waiting %></i>
      <% end %>
    <% end %>
    <%= render "layouts/you", staff: current_account %>
  </div>
</nav>
