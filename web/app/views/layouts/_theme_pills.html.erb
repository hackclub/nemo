<div class="theme-switch" data-controller="theme">
  <div class="theme-pills" role="group" aria-label="Theme">
    <% Appearance::THEMES.each do |theme| %>
      <button type="button" class="theme-pill" aria-pressed="false"
              data-theme-target="option" data-theme-key="<%= theme.key %>"
              data-action="theme#pick"
              aria-label="<%= theme.label %> theme">
        <%= theme_icon(theme.key) %>
      </button>
    <% end %>
  </div>
  <button type="button" class="theme-accent" aria-pressed="false"
          data-theme-target="accent" data-action="theme#tint"
          aria-label="Orange">
    <span aria-hidden="true"></span>
  </button>
</div>
