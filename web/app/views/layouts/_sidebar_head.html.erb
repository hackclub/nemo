<div class="community-nav-head">
  <span class="community-nav-mark" data-controller="logo" aria-hidden="true">
    <span class="community-nav-mark-letter"><%= letter %></span>
    <%= image_tag workspace_logo_path, class: "community-nav-mark-img", alt: "",
          data: { logo_target: "img", action: "error->logo#gone" } %>
  </span>
  <span class="community-nav-title">
    <b><%= title %></b>
    <% if local_assigns[:sub].present? %>
      <span><%= sub %></span>
    <% end %>
  </span>
</div>
