<!DOCTYPE html>
<html lang="en" class="<%= sidebar_class %>" style="<%= sidebar_style %>">
  <head>
    <title><%= content_for(:title) || "Mnemosyne" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mnemosyne">
    <meta name="mobile-web-app-capable" content="yes">
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <meta name="theme-color" content="#0b0b0c">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "layouts/boot" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-section="<%= page_section %>">
    <%= render "shared/synthetic_banner" %>
    <% fire_engine = may_use_fire_engine? %>
    <% nav_partial = fire_engine && page_section == "fd" ? "layouts/fd_pane" : section_pane %>
    <% pane = content_for?(:pane) %>

    <div class="shell" data-controller="cachet dismiss sidebar lightbox<%= " palette" if fire_engine %>"
         data-palette-url-value="<%= fd_search_path(format: :json) %>"
         data-palette-on-value="<%= content_for(:palette_on) %>"
         data-action="keydown@document->palette#key">

      <%= render "layouts/rail", fire_engine: fire_engine %>

      <div class="work<%= " has-nav" if nav_partial %><%= " has-pane" if pane %>"
           data-view="<%= content_for(:pane_default).presence || "main" %>"
           data-controller="mobar case-timeline<%= " pane pane-size" if pane %>">
        <header class="mobar">
          <% if nav_partial %>
            <button type="button" class="iconbtn mobar-menu" data-action="sidebar#toggle"
                    aria-controls="section-nav" aria-label="Open navigation">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16"/>
              </svg>
            </button>
          <% end %>
          <% if pane %>
            <button type="button" class="iconbtn backbtn" aria-label="Back to the list"
                    data-action="click->pane#show" hidden>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
              </svg>
            </button>
          <% end %>
          <% here = here_stop(fire_engine: fire_engine) %>
          <span class="mobar-where">
            <%= strip_tags(content_for(:page_title).to_s).presence || here&.label || "Mnemosyne" %>
          </span>
        </header>

        <% if nav_partial %>
          <%= render nav_partial, fire_engine: fire_engine %>
          <div class="sbackdrop" data-action="click->sidebar#close" aria-hidden="true"></div>
        <% end %>

        <%= content_for :pane if pane %>
        <% if pane %>
          <button type="button" class="qrail" tabindex="-1" aria-hidden="true"
                  data-action="pointerdown->pane-size#drag pointermove->pane-size#move
                               pointerup->pane-size#drop pointercancel->pane-size#drop"></button>
        <% end %>

        <main class="main">
          <div class="rhead">
            <div class="rtop">
              <div class="rhead-said">
                <h1 class="rtitle" title="<%= strip_tags(content_for(:page_title).to_s).presence || "Mnemosyne" %>">
                  <%= yield :page_face %><%= content_for(:page_title) || "Mnemosyne" %>
                </h1>
                <%= content_for(:head_context) if content_for?(:head_context) %>
              </div>

              <% if content_for?(:head_actions) %>
                <div class="ractions"><%= content_for(:head_actions) %></div>
              <% end %>
            </div>

            <% if content_for?(:page_note) %>
              <p class="intro"><%= content_for(:page_note) %></p>
            <% end %>

            <% if content_for?(:page_controls) %>
              <div class="toolbar"><%= content_for(:page_controls) %></div>
            <% end %>

            <% if content_for?(:page_tabs) %>
              <nav class="views" aria-label="Sections"><%= content_for(:page_tabs) %></nav>
            <% end %>
          </div>

          <div class="scrollarea<%= " flush" if content_for?(:flush) %>">
            <div class="body<%= " flush" if content_for?(:flush) %>">
              <%= yield %>
            </div>
          </div>
        </main>
      </div>

      <% if fire_engine %>
        <%= render "fd/palette" %>
      <% end %>

      <%= render "layouts/lightbox" %>

      <%= yield :overlays %>
    </div>

    <div class="topbar-msgs" aria-live="polite" aria-atomic="false">
      <% if alert || notice %>
        <%= render "layouts/told", alert: alert, notice: notice,
              said: flash[:said], did: flash[:did], tone: flash[:tone] %>
      <% end %>
    </div>

    <% if fire_engine %>
      <turbo-frame id="person-drawer" class="person-drawer-frame" data-controller="person-drawer"
        target="_top"></turbo-frame>
    <% end %>
  </body>
</html>
