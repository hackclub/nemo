<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mnemosyne" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mnemosyne">
    <meta name="mobile-web-app-capable" content="yes">
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <meta name="theme-color" content="#143252">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "layouts/boot" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-section="<%= page_section %>">
    <%= render "shared/synthetic_banner" %>
    <% fire_engine = may_use_fire_engine? %>
    <% pane_partial = content_for?(:pane) ? nil : section_pane %>
    <% pane = content_for?(:pane) || pane_partial.present? %>

    <div class="shell" data-controller="cachet dismiss<%= " palette" if fire_engine %>"
         data-palette-url-value="<%= fd_search_path(format: :json) %>"
         data-palette-on-value="<%= content_for(:palette_on) %>"
         data-action="keydown@document->palette#key">

      <header class="top">
        <%= link_to root_path, class: "brand", aria: { label: "Mnemosyne home" } do %>
          <%= image_tag "nemo.png", class: "brand-mark", alt: "", width: 800, height: 483 %>
          <span class="brand-name">Mnemosyne</span>
        <% end %>

        <%= render "layouts/areas", fire_engine: fire_engine %>

        <div class="topright">
          <% if fire_engine %>
            <button type="button" class="findbar" data-action="palette#open"
                    aria-label="Search cases, members, notes">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
              <span class="findbar-text">Search</span>
              <span class="kbd"><span class="mod-meta">⌘K</span><span class="mod-ctrl">Ctrl K</span></span>
            </button>
          <% end %>

          <%= render "layouts/you", staff: current_account %>
        </div>
      </header>

      <div class="work<%= " has-pane" if pane %>"
           data-view="<%= content_for(:pane_default).presence || "main" %>"
           data-controller="case-timeline<%= " pane" if pane %>">
        <% if content_for?(:pane) %>
          <%= content_for :pane %>
        <% elsif pane_partial %>
          <%= render pane_partial %>
        <% end %>

        <main class="main">
          <div class="rhead">
            <div class="rtop">
              <div class="rhead-said">
                <% if pane %>
                  <button type="button" class="btn btn-ghost btn-only backbtn" aria-label="Back"
                          data-action="click->pane#show" hidden>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                  </button>
                <% end %>
                <h1 class="rtitle" title="<%= strip_tags(content_for(:page_title).to_s).presence || "Mnemosyne" %>">
                  <%= yield :page_face %><%= content_for(:page_title) || "Mnemosyne" %>
                </h1>
                <%= content_for(:head_context) if content_for?(:head_context) %>
              </div>

              <div class="ractions">
                <%= content_for(:head_actions) if content_for?(:head_actions) %>
              </div>
            </div>

            <% if content_for?(:page_controls) %>
              <div class="qbar"><%= content_for(:page_controls) %></div>
            <% end %>

            <% if content_for?(:page_tabs) %>
              <nav class="views" aria-label="Sections"><%= content_for(:page_tabs) %></nav>
            <% end %>
          </div>

          <div class="scrollarea<%= " flush" if content_for?(:flush) %>">
            <div class="body<%= " flush" if content_for?(:flush) %>">
              <%= yield %>
            </div>
          </div>
        </main>
      </div>

      <% if fire_engine %>
        <%= render "fd/palette" %>
      <% end %>
    </div>

    <div class="topbar-msgs" aria-live="polite" aria-atomic="false">
      <% if alert || notice %>
        <%= render "layouts/told", alert: alert, notice: notice,
              said: flash[:said], did: flash[:did], tone: flash[:tone] %>
      <% end %>
    </div>

    <% if fire_engine %>
      <turbo-frame id="person-drawer" class="person-drawer-frame" data-controller="person-drawer"
        target="_top"></turbo-frame>
    <% end %>
  </body>
</html>
