<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mnemosyne" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mnemosyne">
    <meta name="mobile-web-app-capable" content="yes">
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= javascript_tag nonce: true do %>
      (function () {
        try {
          var stored = localStorage.getItem("mn-theme");
          if (stored === "paper" || stored === "fog") stored = "light";
          if (stored === "slate" || stored === "midnight" || stored === "ember") stored = "dark";
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
            localStorage.setItem("mn-theme", stored);
          }
          if (localStorage.getItem("mn-dock") === "open") {
            document.documentElement.classList.add("dock-open");
          }
          if (localStorage.getItem("mn-dock-pin") === "pinned") {
            document.documentElement.classList.add("dock-pinned");
          }
        } catch (e) {}
      })();
    <% end %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/synthetic_banner" %>
    <% fire_engine = on?(:fire_engine) %>
    <div class="shell" data-controller="dismiss<%= " palette" if fire_engine %>"
         data-palette-url-value="<%= fd_search_path(format: :json) %>"
         data-palette-on-value="<%= content_for(:palette_on) %>"
         data-action="keydown@document->palette#key">
      <aside class="rail">
        <div class="brand">
          <span class="brand-name">Mnemosyne</span>
        </div>

        <% sections = [] %>
        <% sections << "layouts/rail_analytics" if on?(:analytics) %>
        <% sections << "layouts/rail_fire" if fire_engine %>
        <% sections.reverse! unless current_staff&.manager? %>
        <% sections.each do |section| %>
          <%= render section %>
        <% end %>

        <% if fire_engine %>
          <div class="rail-foot">
            <button type="button" class="rail-item rail-find" data-action="palette#open"
                    aria-label="Search cases, members, notes">
              <span class="rail-ic" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              </span>
              <span class="rail-text">Search</span>
              <span class="kbd">⌘K</span>
            </button>
          </div>
        <% end %>
      </aside>

      <div class="main" data-controller="case-timeline">
        <div class="rhead">
          <div class="rtop">
            <div class="rhead-said">
              <% page_title = content_for(:page_title) || "Mnemosyne" %>
              <h1 class="rtitle" title="<%= page_title %>">
                <%= yield :page_face %><%= page_title %>
              </h1>
            </div>

            <div class="ractions">
              <%= content_for(:head_actions) if content_for?(:head_actions) %>
            </div>

            <%= render "layouts/you", staff: current_staff, profile: current_profile %>
          </div>

          <% if content_for?(:page_controls) %>
            <div class="qbar"><%= content_for(:page_controls) %></div>
          <% end %>

          <div class="topbar-msgs" aria-live="polite" aria-atomic="false">
            <% if alert || notice %>
              <%= render "layouts/told", alert: alert, notice: notice,
                    said: flash[:said], did: flash[:did], tone: flash[:tone] %>
            <% end %>
          </div>
        </div>

        <div class="scrollarea">
          <main class="body">
            <%= yield %>
          </main>
        </div>
      </div>

      <% if fire_engine %>
        <%= render "fd/palette" %>
      <% end %>
    </div>

    <% if fire_engine %>
      <turbo-frame id="person-drawer" class="person-drawer-frame" data-controller="person-drawer"
        target="_top"></turbo-frame>
    <% end %>
  </body>
</html>
