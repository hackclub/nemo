<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mnemosyne" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mnemosyne">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= javascript_tag nonce: true do %>
      (function () {
        try {
          var stored = localStorage.getItem("mn-theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (e) {}
      })();
    <% end %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if notice || alert %>
      <div class="toast-stack">
        <% if notice %>
          <div class="toast" role="status"
               data-controller="toast" data-toast-delay-value="3000"
               data-action="click->toast#dismiss"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="toast toast-alert" role="alert"
               data-controller="toast" data-toast-delay-value="6000"
               data-action="click->toast#dismiss"><%= alert %></div>
        <% end %>
      </div>
    <% end %>

    <div class="shell">
      <aside class="rail">
        <div class="brand">
          <span class="brand-mark">M</span>
          <span class="brand-name">Mnemosyne</span>
        </div>

        <div>
          <p class="rail-label">Main menu</p>
          <nav class="rail-nav" aria-label="Main">
            <%= link_to root_path, class: "rail-item",
                  aria: { current: ("page" if current_page?(root_path)) } do %>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              Overview
            <% end %>
            <%= link_to channels_path, class: "rail-item",
                  aria: { current: ("page" if controller_name == "channels") } do %>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>
              Channels
            <% end %>
            <%= link_to pipeline_path, class: "rail-item",
                  aria: { current: ("page" if controller_name == "pipeline") } do %>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>
              Pipeline
            <% end %>
          </nav>
        </div>

        <div class="rail-foot">
          <div class="toggle-row">
            Dark mode
            <button type="button" class="sw" role="switch" aria-checked="false"
                    aria-label="Dark mode"
                    data-controller="theme" data-action="theme#toggle"></button>
          </div>
          <%= button_to logout_path, method: :delete, class: "rail-item", form: { class: "contents" } do %>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            Sign out
          <% end %>
        </div>
      </aside>

      <div class="main">
        <div class="topbar">
          <%= form_with url: channels_path, method: :get, class: "field-top" do %>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <%= search_field_tag :q, nil, placeholder: "Search channels by name",
                  autocomplete: "off", aria: { label: "Search channels by name" } %>
          <% end %>
          <div class="topbar-icons">
            <span class="delta-note"><%= current_profile&.display_name || current_staff.user_id %></span>
            <% if current_profile&.image_url %>
              <img class="avatar" src="<%= current_profile.image_url %>" alt="" width="28" height="28">
            <% else %>
              <span class="avatar" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
              </span>
            <% end %>
          </div>
        </div>

        <div class="scrollarea">
          <main class="body">
            <div class="head-row">
              <h1 class="head-title"><%= content_for(:page_title) || "Mnemosyne" %></h1>
              <% if content_for?(:page_subtitle) %>
                <span class="head-meta"><%= content_for(:page_subtitle) %></span>
              <% end %>
              <%= yield :page_badge %>
              <% if content_for?(:head_actions) %>
                <div class="head-actions"><%= content_for(:head_actions) %></div>
              <% end %>
            </div>

            <%= yield %>
          </main>
        </div>
      </div>
    </div>
  </body>
</html>
