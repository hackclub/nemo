<!DOCTYPE html>
<html lang="en" class="<%= sidebar_class %>" style="<%= sidebar_style %>">
  <head>
    <title><%= content_for(:title) || "Mnemosyne" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mnemosyne">
    <meta name="mobile-web-app-capable" content="yes">
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <meta name="theme-color" content="#0b0b0c">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "layouts/bootstrap" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-section="<%= page_section %>">
    <a class="skiplink" href="#main">Skip to content</a>
    <%= render "shared/synthetic_banner" %>
    <% fire_engine = may_use_fire_engine? %>
    <% nav_partial = (fire_engine && page_section == "fd" ? "layouts/fd_pane" : section_pane) || "layouts/plain_pane" %>
    <% pane = content_for?(:pane) %>

    <div class="shell" data-controller="cachet dismiss sidebar lightbox<%= " palette" if fire_engine %>"
         data-palette-url-value="<%= fd_search_path(format: :json) %>"
         data-palette-on-value="<%= content_for(:palette_on) %>"
         data-action="keydown@document->palette#key">

      <%= render nav_partial, fire_engine: fire_engine %>
      <div class="sbackdrop" data-action="click->sidebar#close" aria-hidden="true"></div>

      <div class="inset"
           data-view="<%= content_for(:pane_default).presence || "main" %>"
           data-controller="mobile-bar<%= " pane pane-size" if pane %>">
        <%= render "layouts/topbar", fire_engine: fire_engine, pane: pane %>

        <div class="work<%= " has-pane" if pane %>" data-controller="case-timeline">
          <%= content_for :pane if pane %>
          <% if pane %>
            <button type="button" class="queue-rail" tabindex="-1" aria-hidden="true"
                    data-action="pointerdown->pane-size#drag pointermove->pane-size#move
                                 pointerup->pane-size#drop pointercancel->pane-size#drop"></button>
          <% end %>

          <main class="main" id="main" tabindex="-1">
            <% unless content_for?(:headless) %>
            <div class="rhead">
              <div class="row-top">
                <div class="rhead-sub">
                  <h1 class="rtitle" title="<%= strip_tags(content_for(:page_title).to_s).presence || "Mnemosyne" %>">
                    <%= yield :page_face %><%= content_for(:page_title) || "Mnemosyne" %>
                  </h1>
                  <%= content_for(:head_context) if content_for?(:head_context) %>
                </div>

                <% if content_for?(:head_actions) %>
                  <div class="ractions"><%= content_for(:head_actions) %></div>
                <% end %>
              </div>

              <% if content_for?(:page_note) %>
                <p class="intro"><%= content_for(:page_note) %></p>
              <% end %>

              <% if content_for?(:page_controls) %>
                <div class="toolbar"><%= content_for(:page_controls) %></div>
              <% end %>

              <% if content_for?(:page_tabs) %>
                <nav class="views" aria-label="Sections"><%= content_for(:page_tabs) %></nav>
              <% end %>
            </div>
            <% end %>

            <div class="scrollarea<%= " flush" if content_for?(:flush) %>">
              <div class="body<%= " flush" if content_for?(:flush) %>">
                <%= yield %>
              </div>
            </div>
          </main>
        </div>
      </div>

      <% if fire_engine %>
        <%= render "fd/palette" %>
      <% end %>

      <%= render "layouts/lightbox" %>

      <%= yield :overlays %>
    </div>

    <div class="topbar-msgs" aria-live="polite" aria-atomic="false">
      <% if alert || notice %>
        <%= render "layouts/told", alert: alert, notice: notice,
              detail: flash[:detail], action: flash[:action], tone: flash[:tone] %>
      <% end %>
    </div>

    <% if fire_engine %>
      <turbo-frame id="person-drawer" class="person-drawer-frame" data-controller="person-drawer cachet"
        target="_top"></turbo-frame>
    <% end %>
  </body>
</html>
