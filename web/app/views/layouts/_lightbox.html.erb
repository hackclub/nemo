<dialog class="lightbox" data-lightbox-target="box" aria-label="Attachment">
  <button type="button" class="lightbox-shut" data-action="lightbox#shut" aria-label="Close">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <figure class="lightbox-box">
    <img data-lightbox-target="shot" alt="">
    <figcaption class="lightbox-cap">
      <span class="lightbox-name" data-lightbox-target="name"></span>
      <a class="lightbox-open" data-lightbox-target="original" target="_blank" rel="noopener">Open original</a>
    </figcaption>
  </figure>
</dialog>
