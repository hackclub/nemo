<div class="cfoot">
  <button type="button" class="cnav-toggle" data-action="sidebar#toggle"
          aria-controls="section-nav" aria-label="Collapse sidebar">
    <svg class="ic" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/>
    </svg>
    <span class="trunc">Collapse</span>
  </button>
</div>

<button type="button" class="srail" tabindex="-1" aria-hidden="true"
        data-action="pointerdown->sidebar#drag pointermove->sidebar#move
                     pointerup->sidebar#drop pointercancel->sidebar#drop"></button>
