<div class="cfoot">
  <%= link_to docs_path, aria: { current: ("page" if page_section == "docs") } do %>
    <%= nav_icon("news") %><span class="trunc">Docs</span>
  <% end %>
  <%= link_to account_path, aria: { current: ("page" if page_section == "settings") } do %>
    <%= nav_icon("gear") %><span class="trunc">Settings</span>
    <% if may_review_api? && api_queue_waiting.positive? %>
      <span class="community-nav-tally"><%= api_queue_waiting > 99 ? "99+" : api_queue_waiting %></span>
    <% end %>
  <% end %>
</div>

<button type="button" class="srail" tabindex="-1" aria-hidden="true"
        data-action="pointerdown->sidebar#drag pointermove->sidebar#move
                     pointerup->sidebar#drop pointercancel->sidebar#drop"></button>
