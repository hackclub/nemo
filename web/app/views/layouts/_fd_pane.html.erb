<nav id="section-nav" class="cpane fdnav" aria-label="Fire Engine sections">
  <%= render "layouts/sidebar_head", letter: "F", title: "Fire Engine", said: "Conduct" %>

  <div class="cnav">
    <button type="button" class="cnav-find" data-action="palette#open"
            aria-label="Search cases, members, notes">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
      <span>Search</span>
      <span class="kbd"><span class="mod-meta">⌘K</span><span class="mod-ctrl">Ctrl K</span></span>
    </button>

    <div class="cnav-group">
      <% fd_nav_stops.each do |stop| %>
        <%= link_to stop.path, title: stop.label,
              aria: { current: ("page" if stop.here) } do %>
          <%= nav_icon(stop.icon) %>
          <span class="trunc"><%= stop.label %></span>
          <% if stop.tally.to_i.positive? %>
            <span class="cnav-tally" title="<%= pluralize(stop.tally, "case") %> nobody is holding">
              <%= stop.tally > 99 ? "99+" : stop.tally %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render "layouts/sidebar_foot" %>
</nav>
