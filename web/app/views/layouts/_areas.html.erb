<nav class="areas" aria-label="Areas">
  <% if fire_engine %>
    <%= link_to fd_root_path, aria: { current: ("page" if page_section == "fd") } do %>
      <span>Fire Engine</span>
      <% if page_section == "fd" %><i class="line"></i><% end %>
    <% end %>
  <% end %>

  <% if on?(:analytics) %>
    <%= link_to root_path, aria: { current: ("page" if page_section == "mn" && controller_name != "engine") } do %>
      <span>Community</span>
      <% if page_section == "mn" && controller_name != "engine" %><i class="line"></i><% end %>
    <% end %>
  <% end %>

  <% if may_community?("ops.engine") %>
    <%= link_to engine_path, aria: { current: ("page" if controller_name == "engine") } do %>
      <span>Engine</span>
      <% if controller_name == "engine" %><i class="line"></i><% end %>
    <% end %>
  <% end %>

  <% if may_administer? %>
    <%= link_to admin_root_path, aria: { current: ("page" if page_section == "admin") } do %>
      <span>Admin</span>
      <% if page_section == "admin" %><i class="line"></i><% end %>
    <% end %>
  <% end %>
</nav>
