        <div class="navsec">
          <nav class="rail-nav" aria-label="Community">
            <%= link_to root_path, class: "rail-item",
                  aria: { current: ("page" if current_page?(root_path)) } do %>
              <span class="rail-ic" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              </span>
              <span class="rail-text">Overview</span>
            <% end %>
            <% if may_community?("analytics.workspace.read") %>
              <div class="rail-nest">
                <% journey_stages.each do |label, stage| %>
                  <%= link_to public_send(:"#{stage}_journey_path"), class: "rail-item",
                        aria: { current: ("page" if current_page?(public_send(:"#{stage}_journey_path"))) } do %>
                    <span class="rail-text"><%= label %></span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </nav>
        </div>

        <div class="navsec">
          <p class="rail-label">Places</p>
          <nav class="rail-nav" aria-label="Places">
            <%= link_to channels_path, class: "rail-item",
                  aria: { current: ("page" if controller_name == "channels") } do %>
              <span class="rail-ic" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg>
              </span>
              <span class="rail-text">Channels</span>
            <% end %>
          </nav>
        </div>

        <% if may_community?("ops.engine.read") %>
          <div class="navsec">
            <p class="rail-label">Data</p>
            <nav class="rail-nav" aria-label="Data">
              <%= link_to engine_path, class: "rail-item",
                    aria: { current: ("page" if controller_name == "engine") } do %>
                <span class="rail-ic" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12a8 8 0 1 1-2.4-5.7"/><path d="M20 3v4.5h-4.5"/></svg>
                </span>
                <span class="rail-text">Nightly sync</span>
              <% end %>
            </nav>
          </div>
        <% end %>
