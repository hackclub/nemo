<div class="community-nav-group<%= " #{css}" if local_assigns[:css].present? %>">
  <% stops.each do |stop| %>
    <%= link_to stop.path, aria: { current: ("page" if stop.here) } do %>
      <%= nav_icon(stop.icon) %>
      <span class="trunc"><%= stop.label %></span>
      <% if stop.tally.to_i.positive? %>
        <span class="community-nav-tally" title="<%= pluralize(stop.tally, "case") %> nobody is holding">
          <%= stop.tally > 99 ? "99+" : stop.tally %>
        </span>
      <% end %>
    <% end %>
  <% end %>
</div>
