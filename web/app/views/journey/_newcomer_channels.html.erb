<div class="card card-flush">
  <% if newcomer_channels.any? %>
    <% bands = ->(c) { [
         { cls: "funnel-a", label: "posted here", value: c.newcomers_posting.to_i,
           tone: "var(--series-0)" },
         { cls: "funnel-b", label: "first post landed here", value: c.newcomer_first_posts.to_i,
           tone: "var(--series-1)" },
         { cls: "funnel-c", label: "came back on a later day", value: c.newcomers_returning.to_i,
           tone: "var(--series-2)" }
       ] } %>
    <% peak = newcomer_channels.flat_map { |c| bands.call(c).map { |b| b[:value] } }.max.to_i %>
    <% width = ->(v) { peak.positive? ? [(v.to_f / peak * 100), (v.positive? ? 1.2 : 0)].max.round(2) : 0 } %>
    <ul class="sharebars" aria-label="Newcomers by channel" data-controller="chart-tooltip"
        data-action="mouseover->chart-tooltip#show mouseleave->chart-tooltip#clear">
      <% newcomer_channels.each do |c| %>
        <% drawn = bands.call(c) %>
        <% posting = c.newcomers_posting.to_i %>
        <li class="sharebar" data-tip="<%= {
          title: "##{c.name}",
          rows: drawn.map do |band|
            row = { label: band[:label], value: number_with_delimiter(band[:value]),
                    tone: band[:tone] }
            unless band[:cls] == "funnel-a"
              row[:of] = number_to_percentage(share_pct(band[:value], posting) || 0, precision: 1)
            end
            row
          end
        }.to_json %>">
          <div class="sharebar-content">
            <span class="sharebar-label"><%= channel_name_cell(c.channel_id, c.name) %></span>
            <span class="sharebar-value"><%= number_with_delimiter(posting) %></span>
          </div>
          <% drawn.sort_by { |band| -band[:value] }.each do |band| %>
            <div class="sharebar-fill <%= band[:cls] %>" style="--share: <%= width.call(band[:value]) %>" aria-hidden="true"></div>
          <% end %>
        </li>
      <% end %>
    </ul>
    <div class="key">
      <span><i class="funnel-a"></i>posted here</span>
      <span><i class="funnel-b"></i>first post landed here</span>
      <span><i class="funnel-c"></i>came back on a later day</span>
    </div>
  <% else %>
    <p class="card-note">
      <% if newcomer_reach %>
        No channel has reached <%= HomeHelper::MIN_SAMPLE %> newcomer first posts &middot;
        <%= number_with_delimiter(newcomer_reach.searched_of_cohort) %> of
        <%= number_with_delimiter(newcomer_reach.cohort_size) %> searched
      <% else %>
        No newcomer walked yet
      <% end %>
    </p>
  <% end %>
</div>
