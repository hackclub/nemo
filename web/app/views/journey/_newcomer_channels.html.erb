<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Where newcomers land</h2>
      <% if newcomer_reach %>
        <p class="card-sub">
          <%= number_with_delimiter(newcomer_reach.cohort_size) %> members who first signed in
          in the 30 days to <%= newcomer_reach.cohort_end.strftime("%-d %b %Y") %> &middot;
          <%= number_with_delimiter(newcomer_reach.searched_of_cohort) %> searched
        </p>
      <% end %>
    </div>
  </div>

  <% if newcomer_channels.any? %>
    <% peak = newcomer_channels.map { |c| c.newcomer_first_posts.to_i }.max.to_i %>
    <div class="funnelrows" data-controller="marktip"
         data-action="mouseover->marktip#show mouseleave->marktip#clear">
      <% newcomer_channels.each do |c| %>
        <% first = c.newcomer_first_posts.to_i %>
        <% again = c.newcomers_posting.to_i %>
        <% back = c.newcomers_returning.to_i %>
        <% width = ->(v) { peak.positive? ? [(v.to_f / peak * 100), (v.positive? ? 1.2 : 0)].max.round(2) : 0 } %>
        <div class="fn-row">
          <span class="fn-name"><%= channel_name_cell(c.channel_id, c.name) %></span>
          <span class="fn-bar" data-tip="<%= {
            title: "##{c.name}",
            rows: [
              { label: "first post landed here", value: number_with_delimiter(first) },
              { label: "posted again in the window", value: number_with_delimiter(again),
                of: number_to_percentage(share_pct(again, first) || 0, precision: 1) },
              { label: "came back on a later day", value: number_with_delimiter(back),
                of: number_to_percentage(share_pct(back, again) || 0, precision: 1) }
            ]
          }.to_json %>">
            <i class="fn-a" style="width: <%= width.call(first) %>%"></i>
            <i class="fn-b" style="width: <%= width.call(again) %>%"></i>
            <i class="fn-c" style="width: <%= width.call(back) %>%"></i>
          </span>
        </div>
      <% end %>
    </div>
    <div class="key">
      <span><i class="fn-a"></i>first post landed here</span>
      <span><i class="fn-b"></i>posted again in the window</span>
      <span><i class="fn-c"></i>came back on a later day</span>
    </div>
  <% else %>
    <p class="card-note">
      <% if newcomer_reach %>
        No channel has reached <%= HomeHelper::MIN_SAMPLE %> newcomer first posts &middot;
        <%= number_with_delimiter(newcomer_reach.searched_of_cohort) %> of
        <%= number_with_delimiter(newcomer_reach.cohort_size) %> searched
      <% else %>
        No newcomer walked yet
      <% end %>
    </p>
  <% end %>
</div>
