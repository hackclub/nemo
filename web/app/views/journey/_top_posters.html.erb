<% first_poster = top_posters.first %>
<% full_days = first_poster ? Date.new(first_poster.month.year, first_poster.month.month, -1).day : nil %>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Top posters<%= ", #{first_poster.month.strftime("%B %Y")}" if first_poster %></h2>
      <% if first_poster %>
        <p class="card-sub">
          <%= first_poster.days_in_window %> of <%= full_days %> days
          <%= "(month in progress)" if first_poster.days_in_window < full_days %>
        </p>
      <% end %>
    </div>
    <% if top_poster_months.present? %>
      <div class="card-tools">
        <select
          class="select"
          aria-label="month"
          data-top-posters-target="select"
          data-action="top-posters#change"
        >
          <% top_poster_months.each do |m| %>
            <option value="<%= m.iso8601 %>" <%= "selected" if top_posters_month == m %>><%= m.strftime("%b %Y") %></option>
          <% end %>
        </select>
      </div>
    <% end %>
  </div>

  <div class="scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>member</th>
          <th class="col-rank">rank</th>
          <th class="col-num">messages</th>
        </tr>
      </thead>
      <tbody>
        <% if top_posters.any? %>
          <% top_posters.each do |p| %>
            <tr>
              <td>
                <span class="two-line">
                  <b><%= p.display_name.presence || "n/a" %></b>
                  <span><%= p.user_id %></span>
                </span>
              </td>
              <td><%= p.rank %></td>
              <td><%= number_with_delimiter(p.messages_posted) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="3">no top posters loaded</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
