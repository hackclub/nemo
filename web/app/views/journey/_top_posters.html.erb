<% first_poster = top_posters.first %>
<% full_days = first_poster ? Date.new(first_poster.month.year, first_poster.month.month, -1).day : nil %>

<section class="section">
  <div class="section-head">
    <div>
      <h2 class="section-title">Top posters<%= ", #{first_poster.month.strftime("%B %Y")}" if first_poster %></h2>
      <% if first_poster && first_poster.days_in_window < full_days %>
        <p class="section-note">month in progress</p>
      <% end %>
    </div>
    <% if top_poster_months.many? %>
      <div class="section-tools">
        <%= render "shared/picker", said: "month",
              chosen: top_posters_month.strftime("%b %Y"),
              groups: [{ options: top_poster_months.map { |m| {
                label: m.strftime("%b %Y"), current: m == top_posters_month,
                href: active_journey_path(top_posters_month: m.iso8601) } } }] %>
      </div>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th class="col-rank">rank</th>
            <th>member</th>
            <th class="col-num">messages</th>
            <th class="col-num">days posted</th>
          </tr>
        </thead>
        <tbody>
          <% if top_posters.any? %>
            <% top_posters.each do |p| %>
              <tr>
                <td class="col-rank"><%= p.rank %></td>
                <td>
                  <%= render "shared/person", user_id: p.user_id, live: true %>
                </td>
                <td class="col-num"><%= number_with_delimiter(p.messages_posted) %></td>
                <td class="col-num">
                  <%= p.days_measured.to_i.positive? ? p.days_posted : tag.span("n/a", class: "sub2") %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="4">no top posters loaded</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
