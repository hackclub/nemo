<% content_for :page_title, "Who is active" %>

<% searched = @activity_bands.first&.full_history_members.to_i %>
<% posters = @poster_bands.sum(&:members) %>
<% curve = @concentration %>
<% half = curve.find { |p| p.poster_pct == 50 } %>
<% tenth = curve.find { |p| p.poster_pct == 90 } %>

<% if searched.positive? %>
  <% gini = curve.first&.gini&.to_f %>
  <% top_share = tenth ? 100 - tenth.message_pct.to_f : nil %>
  <% spread = Analytics::MartTopPosters.spread(12) %>
  <% spread_months = spread.map { |r| r.month.strftime("%b %Y") } %>
  <div class="metrics">
    <%= render "shared/stat", k: "Ever posted",
          v: safe_join([number_to_percentage(posters.to_f / searched * 100, precision: 1),
                        tag.small("#{number_with_delimiter(posters)} of #{number_with_delimiter(searched)}")]),
          spark: { name: "posters", days: false, labels: spread_months, data: spread.map(&:posters) },
          say: "Posters per month" %>
    <%= render "shared/stat", k: "Concentration", v: gini ? gini.round(3) : "n/a",
          spark: { name: "Gini", days: false, labels: spread_months, data: spread.map(&:gini) },
          say: "Gini by month" %>
    <%= render "shared/stat", k: "Top tenth of posters",
          v: top_share ? number_to_percentage(top_share, precision: 1) : "n/a",
          spark: { name: "top tenth's share", days: false, labels: spread_months,
                   data: spread.map(&:top_tenth_share) },
          say: "Their share of messages by month" %>
  </div>
<% end %>

<section class="section">
  <div class="section-head">
    <h2 class="section-title">Posting concentration</h2>
  </div>

  <div class="grid g-2">
    <div class="card">
      <div class="card-head">
        <div>
          <h2 class="card-title">Messages per poster</h2>
        </div>
      </div>
      <% if @poster_bands.any? %>
        <% splits = [
             band_split(curve.first&.median_messages, @poster_bands, "median"),
             band_split(curve.first&.p90_messages, @poster_bands, "p90")
           ].compact %>
        <div
          data-controller="chart"
          data-chart-kind-value="bars"
          data-chart-height-value="240"
          <% if splits.any? %>data-chart-splits-value="<%= splits.to_json %>"<% end %>
          data-chart-data-value="<%= {
            labels: @poster_bands.map(&:activity_band),
            datasets: [{ label: "posters", data: @poster_bands.map(&:members) }]
          }.to_json %>"
        ></div>
      <% else %>
        <div class="empty"><p class="empty-title">No data yet</p></div>
      <% end %>
    </div>

    <div class="card">
      <div class="card-head">
        <div>
          <h2 class="card-title">Share of messages by share of posters</h2>
        </div>
      </div>
      <% if curve.any? %>
        <div
          data-controller="lorenz"
          data-lorenz-height-value="240"
          data-lorenz-gini-value="<%= curve.first.gini.to_f %>"
          data-lorenz-points-value="<%= curve.map { |p| [p.poster_pct, p.message_pct.to_f] }.to_json %>"
          data-lorenz-marks-value="<%= [half, tenth].compact.map { |p| [p.poster_pct, p.message_pct.to_f] }.to_json %>"
        ></div>
      <% else %>
        <div class="empty"><p class="empty-title">No data yet</p></div>
      <% end %>
    </div>
  </div>
</section>

<% if visible_panel?("journey.top_posters") %>
  <%= turbo_frame_tag "top-posters" do %>
    <%= render "top_posters", top_posters: @top_posters, top_poster_months: @top_poster_months,
          top_posters_month: @top_posters_month, days_measured: @days_measured %>
  <% end %>
<% end %>
