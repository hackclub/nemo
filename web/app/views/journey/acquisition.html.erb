<% content_for :page_title, "Acquisition" %>
<% content_for :page_kicker, "Stage 01" %>

<div id="acquisition" data-controller="growth-months" data-growth-months-url-value="<%= acquisition_journey_path %>">
  <div data-growth-months-target="container">
    <%= render "growth", growth_months: @growth_months, growth_span: @growth_span %>
  </div>
</div>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Monthly cohorts</h2>
      <p class="card-sub">members who joined each month, from their all-time message history</p>
    </div>
  </div>
  <% if @monthly_cohorts.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>cohort</th>
            <th class="col-num">members</th>
            <th class="col-num">ever posted</th>
            <th class="col-num">posted in 30d</th>
            <th class="col-num">median days</th>
          </tr>
        </thead>
        <tbody>
          <% @monthly_cohorts.each do |c| %>
            <tr>
              <td>
                <span class="two-line">
                  <b><%= c.cohort_month.strftime("%b %Y") %></b>
                  <% unless c.complete? %>
                    <span><%= number_with_delimiter(c.searched) %> of <%= number_with_delimiter(c.members) %> searched</span>
                  <% end %>
                </span>
              </td>
              <td class="col-num"><%= number_with_delimiter(c.members) %></td>
              <% if c.complete? %>
                <td class="col-num"><%= number_to_percentage(c.ever_posted.to_f / c.members * 100, precision: 1) %></td>
                <td class="col-num"><%= number_to_percentage(c.posted_within_30d.to_f / c.members * 100, precision: 1) %></td>
                <td class="col-num"><%= c.median_days_to_first_post || "n/a" %></td>
              <% else %>
                <td class="col-num">n/a</td>
                <td class="col-num">n/a</td>
                <td class="col-num">n/a</td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">
      No cohort has been searched yet. The member history backfill fills this in, newest months first.
    </p>
  <% end %>
</div>

<div class="card card-flush self-start">
  <div class="card-head">
    <div>
      <h2 class="card-title">Account composition</h2>
      <p class="card-sub">
        <% seen = @account_types.first %>
        live accounts by type<% if seen %> &middot;
          seen in <%= window_note(seen.window_start, seen.window_end) %>
        <% end %>
      </p>
    </div>
  </div>
  <div class="scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>type</th>
          <th class="col-num">members</th>
          <th class="col-num">claimed</th>
        </tr>
      </thead>
      <tbody>
        <% @account_types.each do |a| %>
          <tr>
            <td><%= a.account_type %></td>
            <td class="col-num"><%= number_with_delimiter(a.members) %></td>
            <td class="col-num"><%= number_with_delimiter(a.claimed) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
