<% content_for :page_title, "Joining" %>

<% content_for :page_controls do %>
  <span class="qlab">Span</span>
  <div class="segmented" role="group" aria-label="months of growth">
    <% HomeHelper::GROWTH_SPANS.each do |span| %>
      <%= link_to "#{span}m", joining_journey_path(growth_months: span),
            aria: { current: ("true" if span == @growth_span) } %>
    <% end %>
  </div>
<% end %>

<div id="acquisition">
  <%= render "growth", growth_months: @growth_months, growth_span: @growth_span %>
</div>

<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Monthly cohorts</h2>
    </div>
  </div>
  <% if @monthly_cohorts.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>cohort</th>
            <th class="col-num">members</th>
            <th class="col-num">ever posted</th>
            <th class="col-num">posted in 30d</th>
            <th class="col-num">median days</th>
          </tr>
        </thead>
        <tbody>
          <% @monthly_cohorts.each do |c| %>
            <tr>
              <td>
                <span class="two-line">
                  <b><%= c.cohort_month.strftime("%b %Y") %></b>
                  <% unless c.fully_known? %>
                    <span><%= number_with_delimiter(c.known) %> of <%= number_with_delimiter(c.members) %> known</span>
                  <% end %>
                </span>
              </td>
              <td class="col-num"><%= number_with_delimiter(c.members) %></td>
              <td class="col-num"><%= number_to_percentage(c.ever_posted.to_f / c.members * 100, precision: 1) %></td>
              <td class="col-num">
                <% if c.mature? %>
                  <%= number_to_percentage(c.posted_within_30d.to_f / c.members * 100, precision: 1) %>
                <% else %>
                  <span class="sub2">matures <%= c.matures_on.strftime("%-d %b") %></span>
                <% end %>
              </td>
              <td class="col-num"><%= c.complete? ? (c.median_days_to_first_post || "n/a") : "n/a" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">n/a</p>
  <% end %>
</div>
