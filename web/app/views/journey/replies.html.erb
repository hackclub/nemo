<% content_for :page_title, "Getting replies" %>

<div id="response" class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Response rate</h2>
    </div>
  </div>
  <% if @response_rate.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>first posted</th>
            <th class="col-num">checked</th>
            <th class="col-num">answered by a member</th>
            <th class="col-num">bot answered only</th>
            <th class="col-num">no reply</th>
            <th class="col-num">median member wait</th>
          </tr>
        </thead>
        <tbody>
          <% @response_rate.each do |r| %>
            <% thin = r.first_posts_checked < HomeHelper::MIN_SAMPLE %>
            <tr>
              <td>
                <b><%= r.post_month.strftime("%b %Y") %></b>
              </td>
              <td class="col-num"><%= number_with_delimiter(r.first_posts_checked) %></td>
              <td class="col-num">
                <% if thin %>
                  <%= number_with_delimiter(r.answered_by_member) %>
                <% else %>
                  <%= rate_cell(r.answered_by_member, r.first_posts_checked) %>
                <% end %>
              </td>
              <td class="col-num"><%= number_with_delimiter(r.answered_by_bot) %></td>
              <td class="col-num"><%= number_with_delimiter(r.unanswered) %></td>
              <td class="col-num">
                <% if thin %>
                  <span class="sub2">n/a</span>
                <% else %>
                  <%= reply_wait(r.median_member_latency_seconds) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">
      No first post has been checked yet. The member history backfill finds first posts, then the replies walk
      fills this in, newest cohorts first.
    </p>
  <% end %>
</div>

<% window = @fast_reply_classes.first %>
<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">First reply speed and day-30 retention</h2>
      <% if window && (note = window_note(window.window_start, window.window_end)) %>
        <p class="card-sub"
           title="observational: nothing assigned these groups, so a gap between them is not evidence that reply speed causes retention">
          <%= note %>
        </p>
      <% end %>
    </div>
  </div>
  <% if @fast_reply_classes.any? %>
    <%= render "reply_speed", classes: @fast_reply_classes %>
  <% end %>
</div>
