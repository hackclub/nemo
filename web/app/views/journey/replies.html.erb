<% content_for :page_title, "Getting replies" %>

<div id="response" class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Response rate</h2>
    </div>
  </div>
  <% if @response_rate.any? %>
    <% bands = [
         { label: "answered by a member", color: "var(--series-2)",
           count: ->(r) { r.answered_by_member.to_i } },
         { label: "bot answered only", color: "var(--series-3)",
           count: ->(r) { r.answered_by_bot.to_i } },
         { label: "no reply", color: "var(--series-0)",
           count: ->(r) { r.unanswered.to_i } }
       ] %>
    <% thin = @response_rate.each_with_index.filter_map { |r, i| i if r.first_posts_checked < HomeHelper::MIN_SAMPLE } %>
    <div style="padding: 0 var(--s-sm) var(--s-2xs)">
      <div
        data-controller="chart"
        data-chart-kind-value="bars"
        data-chart-stacked-value="true"
        data-chart-pct-value="true"
        data-chart-height-value="250"
        <% if thin.any? %>data-chart-partial-value="<%= thin.to_json %>"
        data-chart-partial-note-value="under <%= HomeHelper::MIN_SAMPLE %> checked, no rate published"<% end %>
        data-chart-notes-value="<%= @response_rate.map { |r|
          r.median_member_latency_seconds ? "median member wait #{reply_wait(r.median_member_latency_seconds)}" : nil
        }.to_json %>"
        data-chart-data-value="<%= {
          labels: @response_rate.map { |r| r.post_month.strftime("%b %Y") },
          datasets: bands.map do |band|
            {
              label: band[:label],
              color: band[:color],
              data: @response_rate.map { |r| share_pct(band[:count].call(r), r.first_posts_checked) },
              counts: @response_rate.map { |r| band[:count].call(r) }
            }
          end
        }.to_json %>"
      ></div>
    </div>
  <% else %>
    <p class="card-note">
      No first post has been checked yet. The member history backfill finds first posts, then the replies walk
      fills this in, newest cohorts first.
    </p>
  <% end %>
</div>

<% window = @fast_reply_classes.first %>
<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">First reply speed and day-30 retention</h2>
      <% if window && (note = window_note(window.window_start, window.window_end)) %>
        <p class="card-sub"
           title="observational: nothing assigned these groups, so a gap between them is not evidence that reply speed causes retention">
          <%= note %>
        </p>
      <% end %>
    </div>
  </div>
  <% if @fast_reply_classes.any? %>
    <%= render "reply_speed", classes: @fast_reply_classes %>
  <% end %>
</div>
