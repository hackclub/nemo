<% content_for :page_title, "Getting replies" %>

<% checked, by_member = @response_rate_totals %>
<div id="response" class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Response rate</h2>
    </div>
    <div class="card-tools">
      <% if checked.positive? %>
        <%= rate_chip(share_pct(by_member, checked), "answered by a member") %>
        <span class="chip chip-off"><%= pluralize(number_with_delimiter(checked), "first post") %> checked</span>
      <% else %>
        <span class="chip chip-warn">not measured yet</span>
      <% end %>
    </div>
  </div>
  <% if @response_rate.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>first posted</th>
            <th class="col-num">checked</th>
            <th class="col-num">by a member</th>
            <th class="col-num">no reply</th>
            <th class="col-num">median member wait</th>
          </tr>
        </thead>
        <tbody>
          <% @response_rate.each do |r| %>
            <tr>
              <td>
                <span class="two-line">
                  <b><%= r.post_month.strftime("%b %Y") %></b>
                  <span><%= number_to_percentage(share_pct(r.answered_by_member, r.first_posts_checked), precision: 1) %> answered by a member</span>
                </span>
              </td>
              <td class="col-num"><%= number_with_delimiter(r.first_posts_checked) %></td>
              <td class="col-num"><%= number_with_delimiter(r.answered_by_member) %></td>
              <td class="col-num"><%= number_with_delimiter(r.unanswered) %></td>
              <td class="col-num"><%= reply_wait(r.median_member_latency_seconds) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">
      No first post has been checked yet. The member history backfill finds first posts, then the replies walk
      fills this in, newest cohorts first.
    </p>
  <% end %>
</div>

<% if @fast_reply_vs_retention.any? %>
  <% window = @fast_reply_vs_retention.first %>
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Fast reply vs retention</h2>
        <% if (note = window_note(window.window_start, window.window_end)) %>
          <p class="card-sub"><%= note %></p>
        <% end %>
      </div>
      <div class="card-tools">
        <span class="chip chip-off">
          <%= pluralize(number_with_delimiter(@fast_reply_vs_retention.sum(&:newcomers)), "newcomer") %>
        </span>
      </div>
    </div>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>first member reply</th>
            <th class="col-num">newcomers</th>
            <th class="col-num">still here at day 30</th>
            <th class="col-num">still here at day 90</th>
          </tr>
        </thead>
        <tbody>
          <% @fast_reply_vs_retention.each do |row| %>
            <tr>
              <td><%= reply_class_label(row.reply_class) %></td>
              <td class="col-num"><%= number_with_delimiter(row.newcomers) %></td>
              <td class="col-num"><%= retention_chip(row.retained_day_30_rate, row.measured_day_30) %></td>
              <td class="col-num"><%= retention_chip(row.retained_day_90_rate, row.measured_day_90) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
