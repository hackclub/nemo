<div class="card card-flush">
  <% if lifecycle.any? %>
    <% tops = Journey::Lifecycle::STAGES.to_h { |s| [s[:key], lifecycle.filter_map { |r| r.public_send(s[:key])&.to_f }.max] } %>
    <div class="scroll">
      <div class="lifegrid" style="--stages: <%= Journey::Lifecycle::STAGES.size %>">
        <span class="lg-head lg-left">Cohort</span>
        <% Journey::Lifecycle::STAGES.each do |stage| %>
          <span class="lg-head"><%= stage[:head].upcase_first %></span>
        <% end %>
        <span class="lg-head lg-end">Median days</span>

        <% lifecycle.each do |row| %>
          <span class="lg-row">
            <b><%= row.month.strftime("%b %Y") %></b>
            <span><%= number_with_delimiter(row.invited) %> created</span>
          </span>
          <% Journey::Lifecycle::STAGES.each do |stage| %>
            <%= lifecycle_cell(row, stage, tops[stage[:key]]) %>
          <% end %>
          <span class="lg-plain">
            <%= row.median_days ? number_with_precision(row.median_days, precision: 1) : tag.span("n/a", class: "sub2") %>
          </span>
        <% end %>
      </div>
    </div>
    <div class="key">
      <span class="lg-ramp">
        Low
        <% HomeHelper::HEAT_STEPS.times do |i| %><i class="lg-h<%= i %>"></i><% end %>
        High, per column
      </span>
      <span><i class="lg-swatch-open"></i>Window still open</span>
      <span><i class="lg-swatch-none"></i>No rate to publish</span>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title">No cohorts yet</p>
    </div>
  <% end %>
</div>
