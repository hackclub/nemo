<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Onboarding funnel</h2>
      <p class="card-sub">one created-account cohort</p>
    </div>
    <% if cohort_months.present? %>
      <div class="card-tools">
        <% if onboarding_funnel %>
          <%= incomplete_chip(
                ("day 1 needs the day after each member joined" unless onboarding_funnel.day_1_knowable),
                ("day 7 needs the week after each member joined" unless onboarding_funnel.day_7_knowable),
                ("day 30 needs the month after each member joined" unless onboarding_funnel.day_30_knowable)
              ) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if onboarding_funnel %>
    <div class="chart-short">
      <div
        data-controller="chart"
        data-chart-kind-value="bars"
        data-chart-height-value="240"
        data-chart-data-value="<%= {
          labels: ["Created", "Joined", "Active after day 1", "Active after day 7", "Active after day 30"],
          datasets: [{
            label: "members",
            data: [
              onboarding_funnel.invited,
              onboarding_funnel.joined,
              onboarding_funnel.active_by_day_1,
              onboarding_funnel.active_by_day_7,
              onboarding_funnel.active_by_day_30
            ]
          }]
        }.to_json %>"
      ></div>
    </div>
  <% else %>
    <p class="card-note">no cohort data loaded yet</p>
  <% end %>
</div>
