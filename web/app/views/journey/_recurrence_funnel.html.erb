<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title">Repeat posting</h2>
      <% if recurrence_funnel %>
        <p class="card-sub"
           title="<%= number_with_delimiter(recurrence_funnel.searched) %> of <%= number_with_delimiter(recurrence_funnel.signed_in) %> signed-in members have a searched message history">
          lifetime messages
          <% if recurrence_funnel.searched_share %>
            &middot; <%= number_with_delimiter(recurrence_funnel.searched) %> of
            <%= number_with_delimiter(recurrence_funnel.signed_in) %> searched
          <% end %>
        </p>
      <% end %>
    </div>
    <% if recurrence_cohort_months.present? %>
      <div class="card-tools">
        <details class="menu" data-controller="menu">
          <summary class="btn" aria-label="cohort month">
            <%= recurrence_month&.strftime("%b %Y") || "pick a month" %>
            <span class="car" aria-hidden="true">&#9662;</span>
          </summary>
          <div class="menu-pop">
            <% recurrence_cohort_months.each do |m| %>
              <%= link_to m.strftime("%b %Y"), returning_journey_path(recurrence_month: m.iso8601),
                    class: "btn", aria: { current: ("true" if m == recurrence_month) } %>
            <% end %>
          </div>
        </details>
      </div>
    <% end %>
  </div>

  <% if recurrence_funnel && recurrence_funnel.searched.to_i.positive? %>
    <% f = recurrence_funnel %>
    <% stages = [
         ["Searched", f.searched, nil],
         ["Posted", f.posted_once, f.searched],
         ["2nd post", f.posted_twice, f.posted_once],
         ["3rd post", f.posted_three_times, f.posted_twice]
       ] %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>stage</th>
            <th class="col-num">members</th>
            <th class="col-num">from previous</th>
            <th class="col-num">of searched</th>
          </tr>
        </thead>
        <tbody>
          <% stages.each do |label, count, previous| %>
            <tr>
              <td><b><%= label %></b></td>
              <td class="col-num"><%= number_with_delimiter(count) %></td>
              <td class="col-num">
                <%= previous ? rate_cell(count, previous) : tag.span("n/a", class: "sub2") %>
              </td>
              <td class="col-num"><%= rate_cell(count, f.searched) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note">
      <% if recurrence_funnel %>
        No member of this cohort has a searched message history yet.
      <% else %>
        No cohort searched yet.
      <% end %>
    </p>
  <% end %>
</div>
