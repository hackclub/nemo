<div class="card card-flush">
  <% if recurrence.any? %>
    <% bands = [
         { label: "three or more posts", tone: 88,
           count: ->(f) { f.posted_three_times.to_i } },
         { label: "exactly twice", tone: 58,
           count: ->(f) { f.posted_twice.to_i - f.posted_three_times.to_i } },
         { label: "exactly once", tone: 30,
           count: ->(f) { f.posted_once.to_i - f.posted_twice.to_i } },
         { label: "never posted", tone: nil,
           count: ->(f) { [f.searched.to_i - f.posted_once.to_i, 0].max } }
       ] %>
    <div class="card-body"
      data-controller="funnel"
      data-funnel-label-value="newcomers"
      data-funnel-height-value="230"
      data-funnel-stages-value="<%= [
        { label: "Searched", value: recurrence.sum { |f| f.searched.to_i } },
        { label: "Posted", value: recurrence.sum { |f| f.posted_once.to_i } },
        { label: "Twice", value: recurrence.sum { |f| f.posted_twice.to_i } },
        { label: "3+ times", value: recurrence.sum { |f| f.posted_three_times.to_i } }
      ].to_json %>"
    ></div>
    <div style="padding: 0 var(--s-sm) var(--s-2xs)">
      <div
        data-controller="chart"
        data-chart-kind-value="bars"
        data-chart-stacked-value="true"
        data-chart-pct-value="true"
        data-chart-height-value="260"
        data-chart-caps-value="<%= recurrence.map { |f|
          share = share_pct(f.posted_once, f.searched)
          share ? { v: share, t: number_to_percentage(share, precision: 1) } : nil
        }.to_json %>"
        data-chart-data-value="<%= {
          labels: recurrence.map { |f| f.cohort_month.strftime("%b %Y") },
          datasets: bands.map do |band|
            {
              label: band[:label],
              color: band[:tone] ? "color-mix(in oklab, var(--series-1) #{band[:tone]}%, var(--card))" : "var(--series-rest)",
              data: recurrence.map { |f| share_pct(band[:count].call(f), f.searched) },
              counts: recurrence.map { |f| band[:count].call(f) }
            }
          end
        }.to_json %>"
      ></div>
    </div>
  <% else %>
    <div class="empty"><p class="empty-title">No cohorts yet</p></div>
  <% end %>
</div>
