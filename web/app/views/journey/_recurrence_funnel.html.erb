<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Onboarding recurrence</h2>
      <% if recurrence_funnel %>
        <p class="card-sub">of <%= number_with_delimiter(recurrence_funnel.total_members) %> total known members</p>
      <% end %>
    </div>
    <% if recurrence_cohort_months.present? %>
      <div class="card-tools">
        <% if recurrence_funnel %>
          <%= incomplete_chip(
                ("the sent-message step needs every member of this cohort searched" unless recurrence_funnel.posts_knowable),
                ("the visit steps need 15 consecutive days of member activity after a first post" unless recurrence_funnel.visits_knowable)
              ) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if recurrence_funnel %>
    <div class="chart-short">
      <div
        data-controller="svg-chart"
        data-svg-chart-kind-value="bars"
        data-svg-chart-height-value="240"
        data-svg-chart-data-value="<%= {
          labels: ["Created account", "Signed in", "Sent message", "Returned next day", "3rd visit in 7 days", "4th visit in 14 days"],
          datasets: [{
            label: "members",
            data: [
              recurrence_funnel.created_account,
              recurrence_funnel.signed_in,
              recurrence_funnel.sent_message,
              recurrence_funnel.returned_next_day,
              recurrence_funnel.third_visit_in_7_days,
              recurrence_funnel.fourth_visit_in_14_days
            ]
          }]
        }.to_json %>"y", maintainAspectRatio: false, plugins: { legend: { display: false } } }.to_json %>"
      ></div>
    </div>
  <% else %>
    <p class="card-note">no data loaded yet</p>
  <% end %>
</div>
