<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Accounts created and claimed</h2>
      <p class="card-sub">claimed within 30 days of creation</p>
    </div>
    <div class="card-tools">
      <select
        class="select"
        aria-label="months of growth"
        data-growth-months-target="select"
        data-action="growth-months#change"
      >
        <% HomeHelper::GROWTH_SPANS.each do |span| %>
          <option value="<%= span %>" <%= "selected" if span == growth_span %>><%= span %> months</option>
        <% end %>
      </select>
    </div>
  </div>
  <div
    data-controller="svg-chart"
    data-svg-chart-kind-value="bars"
    data-svg-chart-switchable-value="true"
    data-svg-chart-height-value="240"
    data-svg-chart-data-value="<%= {
      labels: growth_months.map { |m| m.month.strftime("%b %Y") },
      datasets: [
        { label: "accounts created", data: growth_months.map(&:created_members) },
        { label: "claimed within 30d", data: growth_months.map(&:claimed_members_30d) }
      ]
    }.to_json %>"
  ></div>
  <div
    data-controller="svg-chart"
    data-svg-chart-kind-value="line"
    data-svg-chart-height-value="120"
    data-svg-chart-pct-value="true"
    data-svg-chart-data-value="<%= {
      labels: growth_months.map { |m| m.month.strftime("%b %Y") },
      datasets: [{ label: "claim rate", data: growth_months.map { |m| m.claim_rate_30d && m.claim_rate_30d.to_f * 100 } }]
    }.to_json %>"
  ></div>
</div>
