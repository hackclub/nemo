<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Invited and claimed</h2>
    </div>
  </div>
  <div
    data-controller="chart"
    data-chart-kind-value="bars"
    data-chart-switchable-value="true"
    data-chart-height-value="240"
    data-chart-data-value="<%= {
      labels: growth_months.map { |m| m.month.strftime("%b %Y") },
      datasets: [
        { label: "invited", data: growth_months.map(&:invited_members) },
        { label: "claimed", data: growth_months.map(&:claimed_members) }
      ]
    }.to_json %>"
  ></div>
  <div
    data-controller="chart"
    data-chart-kind-value="line"
    data-chart-height-value="120"
    data-chart-pct-value="true"
    data-chart-data-value="<%= {
      labels: growth_months.map { |m| m.month.strftime("%b %Y") },
      datasets: [{ label: "claim rate", data: growth_months.map { |m| m.claim_rate && m.claim_rate.to_f * 100 } }]
    }.to_json %>"
  ></div>
</div>
