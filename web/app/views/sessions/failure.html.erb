<h1>Sign-in did not finish</h1>

<% if @message == "no_slack_id" %>
  <p>Hack Club Auth signed you in, but that account has no Slack ID linked. Link your Hack Club Slack account at auth.hackclub.com, then sign in again.</p>
<% else %>
  <p>Try again. If it keeps failing, quote this code when you ask for help: <span class="mono"><%= @message %></span></p>
<% end %>

<% if current_account %>
  <%= button_to "Sign out", logout_path, method: :delete, class: "btn w-full" %>
<% else %>
  <%= link_to "Sign in again", login_path, class: "btn w-full" %>
<% end %>
