<h1>Access denied</h1>

<% if @message == "not_on_allowlist" %>
  <p>Hack Club auth accepted you, but you are not on Mnemosyne&rsquo;s staff list. Ask whoever runs this to add you.</p>
<% else %>
  <p>Something went wrong signing in.</p>
  <p><span class="chip chip-off"><%= @message %></span></p>
<% end %>

<%= link_to "Back to sign in", login_path, class: "btn w-full" %>
