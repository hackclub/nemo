<h1>Sign-in failed</h1>

<% if @message == "no_slack_id" %>
  <p>No Slack ID linked to this Hack Club account</p>
<% else %>
  <p>Error code: <span class="mono"><%= @message %></span></p>
<% end %>

<% if current_account %>
  <%= button_to "Sign out", logout_path, method: :delete, class: "btn w-full" %>
<% else %>
  <%= link_to "Sign in again", login_path, class: "btn w-full" %>
<% end %>
