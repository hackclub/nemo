<% channels.each do |channel| %>
  <%= link_to channel_path(channel), class: "grid grid-cols-3 gap-4 px-5 py-3 border-b mn-divider last:border-b-0 items-center" do %>
    <span class="mn-label">#<%= channel.name %></span>
    <span class="mn-label text-right"><%= number_with_delimiter(channel.total_members) %></span>
    <span class="mn-label text-right"><%= channel.date_created&.strftime("%b %-d, %Y") %></span>
  <% end %>
<% end %>
