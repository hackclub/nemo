<div class="grid g-2">
  <div class="card card-stretch">
    <div class="card-head">
      <div>
        <h2 class="card-title">First posts</h2>
      </div>
      <div class="card-tools">
        <span class="card-sub"><%= window_note(welcome.window_start, welcome.window_end) %></span>
      </div>
    </div>
    <% if welcome.any? %>
      <% steps = welcome.funnel + [welcome.returned].compact %>
      <div
        data-controller="chart"
        data-chart-kind-value="bars"
        data-chart-height-value="220"
        data-chart-nokey-value="true"
        data-chart-data-value="<%= {
          labels: steps.map { |step| funnel_step_said(step) },
          datasets: [{ label: "newcomers", data: steps.map(&:count) }]
        }.to_json %>"
        data-chart-notes-value="<%= steps.map { |step|
          number_to_percentage(step.share.to_f, precision: 1) }.to_json %>"
      ></div>
    <% else %>
      <div class="empty">
        <p class="empty-title">No first posts yet</p>
        <p>Nobody joined and posted here in this window.</p>
      </div>
    <% end %>
  </div>

  <div class="card card-stretch">
    <div class="card-head">
      <div>
        <h2 class="card-title">Reply time</h2>
      </div>
      <div class="card-tools">
        <span class="card-sub">median <%= duration_said(welcome.median_latency) %></span>
      </div>
    </div>
    <% if welcome.latency.any? %>
      <div
        data-controller="chart"
        data-chart-kind-value="bars"
        data-chart-height-value="220"
        data-chart-nokey-value="true"
        data-chart-data-value="<%= {
          labels: welcome.latency.map { |b| latency_bucket_said(b.bucket) },
          datasets: [{ label: "newcomers", data: welcome.latency.map { |b| b.newcomers.to_i } }]
        }.to_json %>"
        data-chart-notes-value="<%= welcome.latency.map { |bucket|
          number_to_percentage(bucket.share_pct.to_f, precision: 1) }.to_json %>"
      ></div>
    <% else %>
      <div class="empty">
        <p class="empty-title">No reply measured yet</p>
        <p>Not enough first posts here to measure a median reply time.</p>
      </div>
    <% end %>
  </div>
</div>

<% if scorecard_rows.any? %>
  <div class="card">
    <div class="card-head">
      <div>
        <h2 class="card-title">Scorecard</h2>
      </div>
    </div>
    <div
      data-controller="chart"
      data-chart-kind-value="bars"
      data-chart-height-value="190"
      data-chart-data-value="<%= {
        labels: scorecard_rows.map { |r| r.post_month.strftime("%b %Y") },
        datasets: [{ label: "newcomers", data: scorecard_rows.map(&:newcomer_volume) }]
      }.to_json %>"
    ></div>
  </div>
<% end %>
