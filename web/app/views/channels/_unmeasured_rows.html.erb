<% channels.each do |channel_id| %>
  <tr>
    <td>
      <span class="two-line">
        <%= link_to channel_path(channel_id) do %>
          <b class="mono"><%= channel_id %></b>
        <% end %>
        <span>no name yet</span>
      </span>
    </td>
    <td colspan="6">
      <span class="unmeasured-cell">
        <span class="said-cell">Mnemosyne has no data for this channel yet</span>
        <%= open_in_slack slack_channel_url(channel_id) %>
      </span>
    </td>
  </tr>
<% end %>
