<% content_for :page_title, "Public channels" %>
<div class="stack">
  <% if @band_rows.any? %>
    <turbo-frame id="bands" data-turbo-action="advance">
      <div class="card">
        <div class="card-head">
          <div>
            <h2 class="card-title">Channels activity</h2>
            <p class="card-sub"><%= window_note(@band_rows.first.window_start, @band_rows.first.window_end) %></p>
          </div>
          <% if @cohorts.many? %>
            <div class="card-tools">
              <details class="menu" data-controller="menu">
                <summary class="btn" aria-label="activity month">
                  <%= @cohort.strftime("%b %Y") %><span class="car" aria-hidden="true">&#9662;</span>
                </summary>
                <div class="menu-pop">
                  <% @cohorts.each do |month| %>
                    <%= link_to month.strftime("%b %Y"), channel_query(cohort: month.iso8601),
                          class: "btn", aria: { current: ("true" if month == @cohort) } %>
                  <% end %>
                </div>
              </details>
            </div>
          <% end %>
        </div>
        <div class="facets">
          <% @band_measures.each do |_key, rows| %>
            <% silent = rows.find { |r| r.band_order.zero? } %>
            <% busy = rows.reject { |r| r.band_order.zero? } %>
            <% total = rows.sum(&:channels) %>
            <div class="facet">
              <p class="facet-name"><%= band_title(rows.first) %></p>
              <% if silent && total.positive? %>
                <% quiet = (silent.channels.to_f / total * 100).round(1) %>
                <p class="facet-zero"
                   title="<%= number_with_delimiter(silent.channels) %> of <%= number_with_delimiter(total) %> channels recorded zero in this month">
                  <b><%= number_with_delimiter(silent.channels) %></b>
                  <span>at zero</span>
                  <span class="facet-share"><%= number_to_percentage(quiet, precision: 0) %></span>
                </p>
              <% end %>
              <div
                data-controller="chart"
                data-chart-kind-value="bars"
                data-chart-height-value="200"
                data-chart-data-value="<%= {
                  labels: busy.map(&:activity_band),
                  datasets: [{ label: rows.first.measure_label, data: busy.map(&:channels) }]
                }.to_json %>"
              ></div>
            </div>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  <% end %>

  <% if @momentum.any? %>
    <% head = @momentum.first %>
    <details class="foldcard" open
             data-controller="remember"
             data-remember-key-value="channels-treemap"
             data-action="toggle->remember#keep">
      <summary>
        <span class="fold-title">Channels treemap</span>
        <span class="fold-sub"><%= window_note(head.window_start, head.window_end) %></span>
      </summary>
      <%= render "momentum", momentum: @momentum %>
    </details>
  <% end %>

  <turbo-frame id="channels" target="_top" data-turbo-action="advance">
    <div class="card card-flush">
      <div class="card-head">
        <div>
          <h2 class="card-title">Channels</h2>
          <p class="card-sub"><%= channels_window_note(@total, @window) %></p>
        </div>
        <div class="card-tools channel-index-tools">
          <% if @window.adjustable? %>
            <div class="segmented" role="group" aria-label="message range">
              <% @window.choices.each do |days| %>
                <%= link_to "#{days}d",
                      channel_query(days: (days unless days == @window.pulled_days)),
                      data: { turbo_frame: "channels" },
                      aria: { current: ("true" if days == @window.days) } %>
              <% end %>
            </div>
          <% end %>
          <%= form_with url: channels_path, method: :get, class: "qsearch",
                data: { controller: "live-search", action: "input->live-search#go",
                        turbo_frame: "channels", turbo_action: "advance" } do %>
            <% { sort: @sort, direction: @direction, view: @view,
                 days: @window.asked }.compact.each do |key, value| %>
              <%= hidden_field_tag key, value, id: nil %>
            <% end %>
            <% @filter.to_params.each do |i, row| %>
              <%= hidden_field_tag "c[#{i}][f]", row["f"], id: nil %>
              <%= hidden_field_tag "c[#{i}][op]", row["op"], id: nil %>
              <% row["v"].each { |v| concat hidden_field_tag("c[#{i}][v][]", v, id: nil) } %>
            <% end %>
            <%= hidden_field_tag :match, @filter.match, id: nil %>
            <%= search_field_tag :q, @q, placeholder: "Search public channels by name",
                  class: "qsearch-in", autocomplete: "off",
                  aria: { label: "Search public channels by name" } %>
          <% end %>

          <span class="splitbtn">
            <button type="button" class="btn" data-modal-open="channel-filters"
                    aria-haspopup="dialog">
              Filter<% if @filter.any? %><span class="menu-val"><%= @filter.size %></span><% end %>
            </button>
            <% if @filter.any? %>
              <%= link_to "\u2715", channels_path({ q: @q.presence, sort: @sort,
                    direction: @direction, view: @view, days: @window.asked }.compact),
                    class: "btn splitbtn-off", data: { turbo_frame: "channels" },
                    aria: { label: "Clear every condition" } %>
            <% end %>
          </span>
          <div class="segmented" role="group" aria-label="channel view">
            <% { "table" => "Table", "grid" => "Grid" }.each do |value, label| %>
              <%= link_to label, channel_query(view: (value unless value == "table")),
                    data: { turbo_frame: "channels" },
                    aria: { current: ("true" if @view == value) } %>
            <% end %>
          </div>
        </div>
      </div>

      <% if @filter.any? %>
        <div class="cardchips">
        <% @filter.conditions.each_with_index do |condition, i| %>
          <span class="pill">
            <%= condition.label %>
            <%= link_to "\u2715", channels_path({
                  q: @q.presence, sort: @sort, direction: @direction, view: @view,
                  days: @window.asked, match: @filter.match,
                  c: @filter.to_params.except(i.to_s).values }.compact),
                  data: { turbo_frame: "channels" },
                  aria: { label: "Remove #{condition.label}" } %>
          </span>
        <% end %>
        </div>
      <% end %>

      <% if @channels.empty? %>
        <div class="empty">
          <p class="empty-title"><%= channels_empty_title %></p>
        </div>
      <% elsif @view == "grid" %>
        <div class="tiles">
          <%= render "tiles", channels: @channels, peak_messages: @peak_messages %>
        </div>
      <% else %>
        <div class="scroll">
          <table class="data-table cols-fixed channel-table">
            <colgroup>
              <col style="width: 26%">
              <col style="width: 21%">
              <col style="width: 9%">
              <col style="width: 9%">
              <col style="width: 10%">
              <col style="width: 13%">
              <col style="width: 12%">
            </colgroup>
            <thead>
              <tr>
                <%= channel_sort_th("channel", "name") %>
                <%= channel_sort_th("member messages", "messages") %>
                <%= channel_sort_th("posted", "posters", "col-num") %>
                <%= channel_sort_th("read", "viewers", "col-num") %>
                <%= channel_sort_th("members", "members", "col-num") %>
                <%= channel_sort_th("last post", "quiet", "col-date") %>
                <%= channel_sort_th("change", "change", "col-num") %>
              </tr>
            </thead>
            <tbody>
              <%= render "rows", channels: @channels, peak_messages: @peak_messages %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <% if @pages > 1 %>
      <div class="pager">
        <% if @page.positive? %>
          <%= link_to "Back", channels_path(request.query_parameters.merge(page: @page - 1)),
                class: "btn" %>
        <% else %>
          <span class="btn is-off">Back</span>
        <% end %>
        <span class="pager-at">
          Page <%= @page + 1 %> of <%= @pages %>
        </span>
        <% if @has_more %>
          <%= link_to "Next", channels_path(request.query_parameters.merge(page: @page + 1)),
                class: "btn" %>
        <% else %>
          <span class="btn is-off">Next</span>
        <% end %>
      </div>
    <% end %>
  </turbo-frame>

  <%= render "filter_modal" %>
</div>
