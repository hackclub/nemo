<% content_for :page_title, "Channels" %>

<div data-controller="channel-list"
     data-channel-list-url-value="<%= channels_path %>"
     data-channel-list-sort-value="<%= @sort %>"
     data-channel-list-direction-value="<%= @direction %>">
  <div class="mb-4">
    <%= text_field_tag :q, @q, placeholder: "Search channels by name…",
        autocomplete: "off",
        data: { channel_list_target: "input", action: "input->channel-list#search" },
        class: "w-full max-w-xs px-3 py-2 border mn-divider rounded bg-transparent mn-label" %>
  </div>

  <div class="mn-card overflow-x-auto">
    <div class="min-w-[640px]">
      <div class="grid grid-cols-5 gap-4 px-5 py-3 border-b mn-divider">
        <%= channel_sort_link("channel", "name") %>
        <%= channel_sort_link("visibility", "visibility") %>
        <div class="text-right"><%= channel_sort_link("members", "members") %></div>
        <div class="text-right"><%= channel_sort_link("messages tracked", "messages") %></div>
        <div class="text-right"><%= channel_sort_link("views", "views") %></div>
      </div>
      <div data-channel-list-target="rows">
        <%= render "rows", channels: @channels, engagement: @engagement %>
      </div>
    </div>
  </div>

  <div class="mt-4<%= " hidden" unless @has_more %>" data-channel-list-target="moreWrap">
    <%= button_tag "Load more", type: "button",
        data: { action: "channel-list#loadMore" },
        class: "mn-eyebrow px-3 py-2 border mn-divider rounded cursor-pointer transition hover:opacity-70" %>
  </div>
</div>
