<% content_for :page_title, "Public channels" %>
<div class="stack">
  <% if @band_rows.any? %>
    <details class="card reveal" <%= "open" if params[:measure].present? %>>
      <summary class="reveal-head">
        <span class="card-title">Channels activity</span>
        <span class="car" aria-hidden="true">▾</span>
      </summary>
      <div class="reveal-body">
        <div class="segmented" role="group" aria-label="measure">
          <% @band_measures.each do |key, rows| %>
            <%= link_to rows.first.measure_label, channel_query(measure: key),
                  aria: { current: ("true" if key == @measure) } %>
          <% end %>
        </div>
        <div
          data-controller="svg-chart"
          data-svg-chart-kind-value="bars"
          data-svg-chart-height-value="220"
          data-svg-chart-data-value="<%= {
            labels: @band_rows.map(&:activity_band),
            datasets: [{ label: "channels", data: @band_rows.map(&:channels) }]
          }.to_json %>"
        ></div>
      </div>
    </details>
  <% end %>

  <% content_for :page_controls do %>
    <%= form_with url: channels_path, method: :get, class: "qsearch",
          data: { controller: "live-search", action: "input->live-search#go",
                  turbo_frame: "channels", turbo_action: "advance" } do %>
      <% { sort: @sort, direction: @direction, view: @view }.each do |key, value| %>
        <%= hidden_field_tag key, value, id: nil %>
      <% end %>
      <% @filters.each { |key| concat hidden_field_tag("f[]", key, id: nil) } %>
      <%= search_field_tag :q, @q, placeholder: "Search public channels by name",
            class: "qsearch-in", autocomplete: "off",
            aria: { label: "Search public channels by name" } %>
    <% end %>

    <% if channel_filter_options.any? %>
      <details class="menu" data-controller="menu">
        <summary class="btn">Filter<span class="car" aria-hidden="true">▾</span></summary>
        <div class="menu-pop menu-start">
          <% channel_filter_options.each do |key, (label, value, _sql)| %>
            <%= link_to channel_query(f: @filters + [key]), class: "btn" do %>
              <%= label %><span class="menu-val"><%= value %></span>
            <% end %>
          <% end %>
        </div>
      </details>
    <% end %>

    <% @filters.each do |key| %>
      <% label, value, _sql = ChannelsController::FILTERS.fetch(key) %>
      <span class="pill">
        <%= label %> <em><%= value %></em>
        <%= link_to "✕", channel_query(f: (@filters - [key]).presence),
              aria: { label: "Remove #{label} #{value}" } %>
      </span>
    <% end %>

    <span class="qspacer"></span>
    <div class="segmented" role="group" aria-label="channel view">
      <% { "table" => "Table", "grid" => "Grid" }.each do |value, label| %>
        <%= link_to label, channel_query(view: (value unless value == "table")),
              aria: { current: ("true" if @view == value) } %>
      <% end %>
    </div>
  <% end %>

  <turbo-frame id="channels" target="_top" data-turbo-action="advance">
    <div class="card card-flush">
      <div class="card-head">
        <div>
          <h2 class="card-title">Channels</h2>
          <p class="card-sub"><%= number_with_delimiter(@total) %> channels</p>
        </div>
      </div>

      <% if @view == "grid" %>
        <div class="tiles">
          <%= render "tiles", channels: @channels %>
        </div>
      <% else %>
        <div class="scroll">
          <table class="data-table">
            <thead>
              <tr>
                <%= channel_sort_th("channel", "name") %>
                <%= channel_sort_th("member messages", "messages") %>
                <%= channel_sort_th("posted", "posters", "col-num") %>
                <%= channel_sort_th("read", "viewers", "col-num") %>
                <%= channel_sort_th("members", "members", "col-num") %>
                <%= channel_sort_th("last post", "quiet", "col-date") %>
                <th class="col-num">who spoke</th>
              </tr>
            </thead>
            <tbody>
              <%= render "rows", channels: @channels %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

    <% if @pages > 1 %>
      <div class="pager">
        <% if @page.positive? %>
          <%= link_to "Back", channels_path(request.query_parameters.merge(page: @page - 1)),
                class: "btn" %>
        <% else %>
          <span class="btn is-off">Back</span>
        <% end %>
        <span class="pager-at">
          Page <%= @page + 1 %> of <%= @pages %>
        </span>
        <% if @has_more %>
          <%= link_to "Next", channels_path(request.query_parameters.merge(page: @page + 1)),
                class: "btn" %>
        <% else %>
          <span class="btn is-off">Next</span>
        <% end %>
      </div>
    <% end %>
  </turbo-frame>
</div>
