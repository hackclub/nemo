<% content_for :page_title, "Public channels" %>
<div data-controller="channel-list"
     data-channel-list-url-value="<%= channels_path %>"
     data-channel-list-sort-value="<%= @sort %>"
     data-channel-list-direction-value="<%= @direction %>"
     class="stack">
  <div class="qbar">
    <label class="field">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <%= text_field_tag :q, @q, placeholder: "Search public channels by name",
          autocomplete: "off", aria: { label: "Search public channels by name" },
          data: { channel_list_target: "input", action: "input->channel-list#search" } %>
    </label>
    <span class="qspacer"></span>
    <span class="qlab"><%= number_with_delimiter(@total) %> channels</span>
  </div>

  <div class="card card-flush">
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <%= channel_sort_th("channel", "name") %>
            <%= channel_sort_th("member messages", "messages") %>
            <%= channel_sort_th("posted", "posters", "col-num") %>
            <%= channel_sort_th("members", "members", "col-num") %>
            <th class="col-num">who spoke</th>
            <%= channel_sort_th("created", "created", "col-date") %>
          </tr>
        </thead>
        <tbody data-channel-list-target="rows">
          <%= render "rows", channels: @channels %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="<%= "hidden" unless @has_more %>" data-channel-list-target="moreWrap">
    <%= button_tag "Load more", type: "button", class: "btn",
        data: { action: "channel-list#loadMore" } %>
  </div>
</div>
