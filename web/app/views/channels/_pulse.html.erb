<% if range&.stats %>
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Slack analytics</h2>
      <p class="card-sub"><%= slack_window_said(range, start_date, end_date) %></p>
      </div>
    </div>
    <dl class="facts-strip facts-wrap">
      <% [["unique viewers", "unique_viewers"], ["unique reactors", "unique_reactors"],
          ["huddles", "huddles_count"], ["unique posters", "unique_posters"],
          ["messages", "messages_count"], ["reactions", "reactions_count"]].each do |label, key| %>
        <div class="fact">
          <dt><%= label %></dt>
          <dd><%= number_with_delimiter(range.stats[key] || 0) %></dd>
        </div>
      <% end %>
    </dl>
  </div>
<% else %>
  <div class="lede">
    <span class="lede-said">
      <b>Slack analytics unavailable</b>
      <span>
        <% if range&.error == :not_configured %>
          Analytics proxy is not configured on this deployment. Set INTERNAL_PROXY_URL and PROXY_TOKEN_WEB.
        <% elsif range&.error == :reauth %>
          Analytics service needs re-authentication, refresh the Slack session cookie.
        <% elsif range&.error == :not_found %>
          No analytics for this channel in the selected range.
        <% elsif range&.error == :truncated %>
          Too many channels share this name to find this one. Try a narrower range.
        <% else %>
          Couldn&rsquo;t load ranged analytics right now.
        <% end %>
      </span>
    </span>
  </div>
<% end %>

<div class="metrics">
  <%= render "shared/stat", k: "Messages", v: number_with_delimiter(pulse.member_messages),
        say: pulse_delta(pulse.change(:member_messages), "vs the window before"),
        spark: (pulse.any? ? { name: "member messages", labels: pulse.labels,
          data: pulse.series.map(&:member_messages) } : nil) %>

  <%= render "shared/stat", k: "Posting",
        v: (pulse.posters_per_day ? number_with_delimiter(pulse.posters_per_day) : "n/a"),
        say: pulse_delta(pulse.posters_change, "vs the window before"),
        spark: (pulse.any? ? { name: "people posting", labels: pulse.labels,
          data: pulse.series.map(&:authors) } : nil) %>

  <%= render "shared/stat", k: "Reactions", v: number_with_delimiter(pulse.reactions),
        say: pulse_delta(pulse.change(:reactions), "vs the window before"),
        spark: (pulse.any? ? { name: "reactions", labels: pulse.labels,
          data: pulse.series.map(&:reactions) } : nil) %>

  <%= render "shared/stat", k: "Threads", v: number_with_delimiter(pulse.thread_roots),
        say: "#{number_with_delimiter(pulse.thread_replies)} replies",
        spark: (pulse.any? ? { name: "threads started", labels: pulse.labels,
          data: pulse.series.map(&:thread_roots) } : nil) %>
</div>
<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Traffic</h2>
    </div>
  </div>

  <% if pulse.any? %>
    <div
      data-controller="chart"
      data-chart-kind-value="bars"
      data-chart-stacked-value="true"
      data-chart-days-value="true"
      data-chart-height-value="230"
      data-chart-data-value="<%= {
        labels: pulse.labels,
        datasets: [
          { label: "member messages", data: pulse.series.map(&:member_messages) },
          ({ label: "bot messages", data: pulse.series.map(&:bot_messages) } if pulse.bot_messages.positive?)
        ].compact
      }.to_json %>"
    ></div>
    <div class="substrip">
      <span class="substrip-k">people posting</span>
      <div
        data-controller="chart"
        data-chart-kind-value="line"
        data-chart-spark-value="true"
        data-chart-days-value="true"
        data-chart-height-value="46"
        data-chart-data-value="<%= {
          labels: pulse.labels,
          datasets: [{ label: "people posting", data: pulse.series.map(&:authors) }]
        }.to_json %>"
      ></div>
    </div>
  <% else %>
    <p class="card-note">no message landed in this range</p>
  <% end %>
</div>

<%= render "shared/clock", clock: clock %>

