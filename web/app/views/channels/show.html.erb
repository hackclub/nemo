<% content_for :page_title, "##{@channel.name}" %>

<div class="kpis">
  <div class="card">
    <p class="kpi-label">Members</p>
    <p class="kpi-val"><%= @member_count ? number_with_delimiter(@member_count) : "n/a" %></p>
    <div class="delta"><span class="delta-note">current</span></div>
  </div>
  <% [["Messages", "messages_count"], ["Unique viewers", "unique_viewers"],
      ["Reactions", "reactions_count"]].each do |label, key| %>
    <div class="card">
      <p class="kpi-label"><%= label %></p>
      <p class="kpi-val"><%= @all_time.stats ? number_with_delimiter(@all_time.stats[key] || 0) : "n/a" %></p>
      <div class="delta"><span class="delta-note">last 13 months</span></div>
    </div>
  <% end %>
</div>

<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Activity over a range</h2>
      <p class="card-sub">
        <%= @start_date.strftime("%b %-d") %> to <%= @end_date.strftime("%b %-d, %Y") %>
        &middot; queried live from Slack, not from the warehouse
      </p>
    </div>
    <div class="card-tools">
      <div class="segmented" role="group" aria-label="range length">
        <% ChannelsController::RANGE_PRESETS.each do |days| %>
          <%= link_to "#{days}d", channel_path(@channel, days: days),
                aria: { current: ("true" if @range_preset == days) } %>
        <% end %>
        <%= link_to "custom", channel_path(@channel, start: @start_date, end: @end_date),
              aria: { current: ("true" if @range_preset.nil?) } %>
      </div>
    </div>
  </div>

  <% if @range_preset.nil? %>
    <%= form_with url: channel_path(@channel), method: :get, class: "qbar" do %>
      <%= render "datepicker", caption: "from", name: :start, value: @start_date,
            min: @range_min, max: @range_max %>
      <%= render "datepicker", caption: "to", name: :end, value: @end_date,
            min: @range_min, max: @range_max %>
      <%= submit_tag "Apply", class: "btn btn-primary" %>
    <% end %>
  <% end %>

  <% if @range.stats %>
    <div class="stat-row">
      <% [["unique posters", "unique_posters"], ["unique viewers", "unique_viewers"],
          ["unique reactors", "unique_reactors"], ["messages", "messages_count"],
          ["reactions", "reactions_count"], ["huddles", "huddles_count"]].each do |label, key| %>
        <div>
          <p class="kpi-label"><%= label %></p>
          <p class="kpi-val"><%= number_with_delimiter(@range.stats[key] || 0) %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="card-note">
      <% if @range.error == :not_configured %>
        Analytics proxy is not configured on this deployment. Set INTERNAL_PROXY_URL and PROXY_TOKEN_WEB.
      <% elsif @range.error == :reauth %>
        Analytics service needs re-authentication, refresh the Slack session cookie.
      <% elsif @range.error == :not_found %>
        No analytics for this channel in the selected range.
      <% elsif @range.error == :truncated %>
        Too many channels share this name to find this one. Try a narrower range.
      <% else %>
        Couldn&rsquo;t load ranged analytics right now.
      <% end %>
    </p>
  <% end %>

</div>

<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Daily activity</h2>
      <% if @activity_trend.any? %>
        <p class="card-sub">
          <%= @activity_trend.first.window_start.strftime("%b %-d, %Y") %> to
          <%= @activity_trend.last.window_start.strftime("%b %-d, %Y") %>
        </p>
      <% end %>
    </div>
    <% if @activity_trend.any? %>
      <% span_days = (@activity_trend.last.window_start - @activity_trend.first.window_start).to_i + 1 %>
      <% if @activity_trend.size < span_days %>
        <div class="card-tools">
          <span class="chip chip-warn"><%= pluralize(span_days - @activity_trend.size, "day") %> never fetched</span>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @activity_trend.any? %>
    <div class="chart-short">
      <canvas
        data-controller="chart"
        data-chart-type-value="bar"
        data-chart-data-value="<%= {
          labels: @activity_trend.map { |a| a.window_start.strftime("%b %d") },
          datasets: [{
            label: "messages posted",
            data: @activity_trend.map(&:messages_posted)
          }]
        }.to_json %>"
        data-chart-options-value="<%= { maintainAspectRatio: false, plugins: { legend: { display: false } } }.to_json %>"
      ></canvas>
    </div>
  <% else %>
    <p class="card-note">no daily activity data yet</p>
  <% end %>
</div>

<% if @scorecard_rows.any? %>
  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">Onboarding scorecard</h2>
        <p class="card-sub">months reaching <%= HomeHelper::MIN_SAMPLE %> newcomers or more</p>
      </div>
    </div>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th class="col-date">month</th>
            <th class="col-num">newcomers</th>
            <th class="col-num">fast reply</th>
            <th class="col-num">90-day retention</th>
          </tr>
        </thead>
        <tbody>
          <% @scorecard_rows.each do |row| %>
            <tr>
              <td><%= row.post_month.strftime("%b %Y") %></td>
              <td><%= number_with_delimiter(row.newcomer_volume) %></td>
              <td><%= row.fast_reply_share ? rate_chip((row.fast_reply_share.to_f * 100).round(1)) : "n/a" %></td>
              <td><%= row.retained_90_share ? rate_chip((row.retained_90_share.to_f * 100).round(1)) : "n/a" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card">
    <div class="card-head">
      <div>
        <h2 class="card-title">Onboarding scorecard</h2>
        <p class="card-sub">no month qualifies for this channel</p>
      </div>
    </div>
    <p class="delta-note">
      A row needs newcomers whose first post here can be matched to a reply, and no month reaches the
      <%= HomeHelper::MIN_SAMPLE %>-newcomer threshold yet. Empty by measurement, not by error.
    </p>
  </div>
<% end %>

<div>
  <%= link_to channels_path, class: "crumb" do %>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    back to channels
  <% end %>
</div>
