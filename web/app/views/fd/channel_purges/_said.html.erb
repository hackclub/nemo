<div class="msg">
  <%= face(said.user, css: "avatar") %>
  <span>
    <span class="msg-head">
      <span class="msg-who"><%= member_link(said.user) %></span>
      <% if said.at %>
        <span class="msg-at"><%= said.at.strftime("%-d %b %H:%M") %></span>
      <% end %>
    </span>
    <div class="msg-body"><%= said.text.presence || "no text held" %></div>
  </span>
</div>
