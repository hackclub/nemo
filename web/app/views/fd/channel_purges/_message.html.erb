<div class="msg">
  <%= face(message.user, css: "avatar") %>
  <span>
    <span class="msg-head">
      <span class="msg-who"><%= member_link(message.user) %></span>
      <% if message.at %>
        <span class="msg-at"><%= message.at.strftime("%-d %b %H:%M") %></span>
      <% end %>
    </span>
    <div class="msg-body"><%= message.text.presence || "no text held" %></div>
  </span>
</div>
