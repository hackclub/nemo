<%= form_with url: fd_case_merge_path(kase), method: :get, class: "qsearch merge-find",
      data: { turbo_frame: "merge-body", controller: "merge-search",
              action: "input->merge-search#look", merge_search_url_value:
              fd_case_merge_path(kase) },
      html: { autocomplete: "off" } do %>
  <%= search_field_tag :q, term, id: nil, placeholder: "case number, subject or channel",
        class: "qsearch-in", aria: { label: "Search cases" },
        data: { merge_search_target: "field" } %>
<% end %>
