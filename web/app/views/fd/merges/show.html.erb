<% content_for :page_title, "Merge case #{@case.id}" %>
<% content_for :page_face do %>
  <span class="crumb"><%= link_to "Case #{@case.id}", fd_case_path(@case) %> /</span>
<% end %>

<div class="card card-flush" data-controller="merge-picker">
  <div class="merge-searchbar">
    <%= render "find", kase: @case, term: @term %>
  </div>
  <%= render "body", kase: @case, groups: @groups, term: @term, more: @more,
        violations: @violations, priors_by_user: @priors, reachable: @reachable_report_ids %>
</div>
