<% content_for :page_title, "Merge case #{@case.id}" %>
<% content_for :page_face do %>
  <span class="crumb"><%= link_to "Case #{@case.id}", fd_case_path(@case) %> /</span>
<% end %>
<% content_for :page_subtitle, "the older case holds both" %>

<div class="card card-flush">
  <div class="merge-pane">
    <%= render "find", kase: @case, term: @term %>
  </div>
  <%= render "body", kase: @case, groups: @groups, target: @target, plan: @plan, term: @term %>
</div>
