<%= turbo_frame_tag "merge-body" do %>
  <%= form_with url: fd_confirm_merge_cases_path, method: :get,
        data: { turbo_frame: "merge-body", merge_picker_target: "form" } do %>
    <%= hidden_field_tag "case_ids[]", kase.id, id: nil %>

    <div class="merge-results">
      <% if groups.empty? %>
        <div class="empty merge-empty">
          <p class="empty-title">
          <%= term.present? ? "No matches" : "No candidates" %>
          </p>
        </div>
      <% end %>

      <% groups.each do |label, group_cases| %>
        <section class="merge-section">
          <h3 class="merge-group"><%= label == Fd::Case::NEARBY_GROUP ? "Nearby cases" : label %></h3>
          <%= tag.div class: "merge-list",
                id: ("merge-around" if label == Fd::Case::NEARBY_GROUP) do %>
            <% group_cases.each do |other| %>
              <%= render "fd/merges/candidate", other: other, violations: violations,
                    priors_by_user: priors_by_user, reachable: reachable %>
            <% end %>
          <% end %>
        </section>
      <% end %>

      <% if more %>
        <div class="pane-more" data-controller="expand" data-expand-into-value="merge-around"
             data-expand-root-value=".merge-results"
             data-expand-url-value="<%= fd_case_merge_path(kase, page: 2) %>">
          <span class="sub2">Loading more cases</span>
        </div>
      <% end %>
    </div>

    <div class="merge-act">
      <span class="merge-selected" data-merge-picker-target="count">Select at least one case</span>
      <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
      <%= submit_tag "Next", name: nil, class: "btn btn-primary is-off", disabled: true,
            data: { merge_picker_target: "submit" } %>
    </div>
  <% end %>
<% end %>
