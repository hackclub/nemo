<section class="section">
  <div class="section-head">
    <h2 class="section-title">How cases ended</h2>
    <p class="section-note">of the <%= number_with_delimiter(closed) %> closed cases</p>
  </div>

  <div class="card card-flush">
    <ul class="sharebars" aria-label="Closed cases by ending">
      <% endings.each do |label, count| %>
        <% share = closed.positive? ? count.to_f / closed * 100 : 0 %>
        <li class="sharebar" style="--share: <%= share.round(1) %>">
          <div class="sharebar-content">
            <span class="sharebar-label"><%= label %></span>
            <span class="sharebar-value"><span class="sharebar-count"><%= number_with_delimiter(count) %></span><%= closed.positive? ? "#{share.round}%" : "n/a" %></span>
          </div>
          <div class="sharebar-fill" aria-hidden="true"></div>
        </li>
      <% end %>
    </ul>
  </div>
</section>
