<% content_for :page_title, "Overview" %>
<% content_for :head_actions do %>
  <%= link_to "Open a case", fd_cases_path(open: "1"), class: "btn btn-primary" %>
<% end %>

<div class="metrics">
  <div class="metric">
    <span class="metric-k">Open cases</span>
    <span class="metric-v"><%= @open %></span>
    <span class="metric-say">
      <% if @unclaimed.positive? %>
        <span class="delta-down"><%= @unclaimed %></span>
        <span>with nobody on it</span>
      <% else %>
        <span>everything has somebody on it</span>
      <% end %>
    </span>
  </div>
  <div class="metric">
    <span class="metric-k">Median time to resolve</span>
    <span class="metric-v"><%= @resolve_lag ? case_age_label(@resolve_lag) : "n/a" %></span>
    <span class="metric-say"><span>from when the report arrived</span></span>
  </div>
  <div class="metric">
    <span class="metric-k">Actions, 30 days</span>
    <span class="metric-v"><%= @actions_total %></span>
    <span class="metric-say"><span><%= @reversed %> later reversed</span></span>
  </div>
</div>

<% if @endings.any? %>
  <%= render "endings", endings: @endings, closed: @closed_count %>
<% end %>
