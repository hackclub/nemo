<% layout = cluster_layout(cluster) %>
<% points = layout.points %>
<% node = layout.node %>
<section class="card cluster-map" data-controller="cluster-map"
         data-cluster-map-steps-value="<%= cluster.members.size %>">
  <div class="card-head">
    <h2 class="card-title">Map</h2>
    <div class="card-tools">
      <button type="button" class="btn btn-ghost btn-sm" data-action="cluster-map#play"
              data-cluster-map-target="button">Replay</button>
    </div>
  </div>
  <div class="cluster-map-body">
    <svg viewBox="0 0 <%= layout.size %> <%= layout.size %>" role="img"
         class="<%= "is-crowded" if layout.crowded %> <%= "is-packed" if layout.packed %>"
         style="max-width: <%= [layout.size, 544].max %>px"
         aria-label="Accounts in this cluster and the links between them">
      <% cluster.edges.each do |edge| %>
        <% a, b = points[edge.a_user_id], points[edge.b_user_id] %>
        <% next if a.nil? || b.nil? %>
        <path class="<%= cluster_edge_class(edge) %>" d="<%= cluster_edge_path(layout, a, b) %>"
              data-a="<%= edge.a_user_id %>" data-b="<%= edge.b_user_id %>"
              data-step="<%= [a[:step], b[:step]].max %>"><title><%= cluster_edge_title(edge) %></title></path>
      <% end %>
      <defs>
        <clipPath id="cluster-face"><circle r="<%= node %>"></circle></clipPath>
      </defs>
      <% cluster.members.each do |one| %>
        <% at = points[one.user_id] %>
        <a href="<%= fd_member_path(one.user_id) %>" data-turbo-frame="person-drawer"
           class="node <%= one.deactivated ? "node-gone" : "node-active" %> <%= "node-oldest" if one.user_id == cluster.cluster_id %>"
           data-step="<%= at[:step] %>" data-user="<%= one.user_id %>"
           data-name="<%= person_label(one.user_id) %>" data-x="<%= at[:lx].round(1) %>" data-y="<%= at[:ly].round(1) %>"
           data-action="mouseenter->cluster-map#focus mouseleave->cluster-map#blur focusin->cluster-map#focus focusout->cluster-map#blur">
          <title><%= person_label(one.user_id) %>, <%= one.joined_at ? "joined #{on_day(one.joined_at)}" : "join date n/a" %></title>
          <g transform="translate(<%= at[:x].round(1) %> <%= at[:y].round(1) %>)">
            <circle class="face-bg" r="<%= node %>"></circle>
            <text class="face-initial" text-anchor="middle" dominant-baseline="central"><%= names.initial(one.user_id) %></text>
            <image href="<%= cachet_face_url(one.user_id) %>" x="-<%= node %>" y="-<%= node %>"
                   width="<%= node * 2 %>" height="<%= node * 2 %>" decoding="async"
                   clip-path="url(#cluster-face)" preserveAspectRatio="xMidYMid slice"></image>
            <circle class="face-ring" r="<%= node %>"></circle>
          </g>
          <% unless layout.packed %>
            <text class="node-name" text-anchor="<%= at[:anchor] %>" dominant-baseline="middle"
                  transform="translate(<%= at[:lx].round(1) %> <%= at[:ly].round(1) %>)<%= " rotate(#{at[:turn].round(1)})" if at[:turn].nonzero? %>"><%= person_label(one.user_id).to_s.truncate(18) %></text>
          <% end %>
        </a>
      <% end %>
      <% if layout.packed %>
        <text class="map-hover" text-anchor="middle" data-cluster-map-target="label"></text>
      <% end %>
    </svg>
  </div>
  <div class="cluster-map-key">
    <span><i class="key-edge edge-certain"></i>Certain</span>
    <span><i class="key-edge edge-strong"></i>Strong</span>
    <span><i class="key-edge edge-worth"></i>Worth a look</span>
    <span><i class="key-edge edge-together"></i>Same person, by verdict</span>
    <span><i class="key-edge edge-apart"></i>Different people, by verdict</span>
    <span><i class="key-node node-gone"></i>Deactivated</span>
  </div>
</section>
