<span class="action-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <% case icon %>
    <% when "shield" %>
      <path d="M12 3 4 6v6c0 4 3.4 7.4 8 8 4.6-.6 8-4 8-8V6z"/>
    <% when "gauge" %>
      <path d="M20 14a8 8 0 1 0-16 0"/><path d="m15 10-3.4 3.4"/>
    <% when "note" %>
      <path d="M5 4h14v12H8l-3 3z"/>
    <% when "thread" %>
      <path d="M4 6h16M4 11h10M4 16h13"/>
    <% when "resolve" %>
      <circle cx="12" cy="12" r="9"/><path d="m8.2 12.2 2.6 2.6 5-5.4"/>
    <% when "history" %>
      <path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 3v4.5h4.5"/><path d="M12 8v4.4l3 1.8"/>
    <% when "plus" %>
      <path d="M12 5v14M5 12h14"/>
    <% when "external" %>
      <path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 19V8a1.5 1.5 0 0 1 1.5-1.5H10"/>
    <% when "people" %>
      <circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 8h5M18.5 5.5v5"/>
    <% end %>
  </svg>
</span>
<% if label.present? %><span><%= label %></span><% end %>
<% if local_assigns[:shortcut].present? %>
  <span class="kbd" aria-hidden="true"><%= shortcut %></span>
<% end %>
