<%= render layout: "fd/modal", locals: { id: "new-decision", title: "New decision",
      open: params[:new] == "1" } do %>
  <%= form_with url: fd_decisions_path, method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <%= render "fd/decisions/words", decision: nil, with_reasons: false %>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Write it down", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
