<label class="field-label">
  Call it
  <%= text_field_tag :title, decision&.title, class: "textarea", id: nil,
        placeholder: "Spam accounts" %>
</label>

<label class="field-label">
  What FD does from now on
  <%= text_area_tag :statement, decision&.statement, rows: 3, class: "textarea", id: nil,
        placeholder: "One sentence. If it needs a paragraph, it is two decisions." %>
</label>

<div class="field-label">
  <span>Category</span>
  <details class="picker" data-controller="picker" data-action="change->picker#choose">
    <summary class="select">
      <span data-picker-target="label" data-blank="Any category"><%=
        decision&.category_key ? category_label(decision.category_key) : "Any category"
      %></span>
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
    </summary>
    <div class="menu-pop picker-pop">
      <label class="picker-opt">
        <%= radio_button_tag :category_key, "", decision&.category_key.blank?,
              id: nil, data: { label: "Any category" } %>
        Any category
      </label>
      <% Fd::Case::CATEGORIES.each do |key| %>
        <label class="picker-opt">
          <%= radio_button_tag :category_key, key, decision&.category_key == key,
                id: nil, data: { label: category_label(key) } %>
          <%= category_label(key) %>
        </label>
      <% end %>
    </div>
  </details>
</div>

<% if with_reasons %>
  <label class="field-label">
    Why, one line each
    <%= text_area_tag :reasons, decision.reasons.join("\n"), rows: 4, class: "textarea", id: nil %>
  </label>
<% end %>
