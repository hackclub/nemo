<% content_for :page_title, @decision.title %>
<% content_for :palette_on, "decision:#{@decision.id}" %>
<% content_for :page_subtitle do %>
  <%= decision_head_meta(@decision) %>
<% end %>
<% content_for :page_badge do %>
  <%= decision_state_chip(@decision) %>
<% end %>
<% content_for :head_actions do %>
  <% if @decision.proposed? %>
    <%= gated_button "decision.settle", "Settle it",
          fd_decision_settlement_path(@decision), css: "btn btn-primary", method: :post,
          form: { class: "contents", data: { turbo_confirm:
            "Settle #{@decision.title}? It becomes the rule." } } %>
  <% end %>
  <% if @previous %>
    <%= link_to "Previous", fd_decision_path(@previous), class: "btn" %>
  <% else %>
    <span class="btn is-off">Previous</span>
  <% end %>
  <% if @next %>
    <%= link_to "Next", fd_decision_path(@next), class: "btn" %>
  <% else %>
    <span class="btn is-off">Next</span>
  <% end %>
  <% unless @decision.superseded? %>
    <details class="menu">
      <summary class="btn btn-only" aria-label="Change the wording">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
      </summary>
      <div class="menu-pop">
        <%= opens_modal "decision.write", "Edit", opens: "edit-decision" %>
        <% if @decision.settled? %>
          <div class="menu-sep"></div>
          <%= opens_modal "decision.retire", "Replace", opens: "supersede-decision" %>
          <%= gated_button "decision.retire", "Retire",
                fd_decision_retirement_path(@decision), method: :post,
                form: { class: "contents",
                data: { turbo_confirm: "Retire #{@decision.title}?" } } %>
        <% end %>
      </div>
    </details>
  <% end %>
<% end %>

<div class="stack">
  <div class="card">
    <p class="dec-said"><%= @decision.statement %></p>

    <% if @decision.reasons.any? %>
      <div class="dec-why">
        <% @decision.reasons.each do |reason| %>
          <p class="fact-line"><%= reason %></p>
        <% end %>
      </div>
    <% else %>
      <p class="card-note">No reasons written down.</p>
    <% end %>
  </div>

  <%= render "fd/decisions/threads", decision: @decision, threads: @decision.threads,
        chosen: @chosen_thread, messages: @messages %>

  <p class="band-label">
    <%= cases_band_label(@decision) %> · <%= @cases.any? ? @cases.size : "none" %>
  </p>

  <% if @cases.any? %>
    <div class="card card-flush">
      <div class="scroll">
        <table class="data-table">
          <tbody>
            <% @cases.each do |kase| %>
              <tr>
                <td>
                  <span class="two-line">
                    <%= link_to fd_case_path(kase) do %>
                      <b>case <%= kase.id %></b>
                    <% end %>
                    <span class="idline">
                      <%= category_label(kase.category_key).downcase %> ·
                      <%= kase.opened_at.strftime("%-d %b") %>
                    </span>
                  </span>
                </td>
                <td class="said-cell"><%= mentioned(kase.member_note) %></td>
                <td class="col-state"><%= case_status_chip(kase) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card">
      <p class="card-note">No case linked yet.</p>
    </div>
  <% end %>

  <p class="band-label">History</p>
  <div class="card">
    <p class="thr-gone"><%= decision_history_line(@decision) %></p>
    <% if @replaced.any? %>
      <div class="dec-why">
        <% @replaced.each do |old| %>
          <p class="fact-line">
            Replaced <%= link_to old.title, fd_decision_path(old), class: "lnk" %>,
            retired <%= old.retired_at.strftime("%-d %b %Y") %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% unless @decision.superseded? %>
  <%= render "fd/decisions/edit_modal", decision: @decision %>
<% end %>
<% if @decision.settled? %>
  <%= render "fd/decisions/supersede_modal", decision: @decision %>
<% end %>
<%= render "fd/decisions/link_threads_modal", decision: @decision %>
