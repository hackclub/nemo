<% content_for :page_title, @decision.title %>
<% content_for :page_subtitle do %>
  <%= decision_head_meta(@decision) %>
<% end %>
<% content_for :page_badge do %>
  <%= decision_state_chip(@decision) %>
<% end %>
<% content_for :head_actions do %>
  <% if @decision.proposed? %>
    <%= button_to "Settle it", fd_decision_settlement_path(@decision), method: :post,
          class: "btn btn-primary", form: { class: "contents", data: { turbo_confirm:
            "Settle #{@decision.title}? It becomes the rule." } } %>
    <label for="edit-decision" class="btn">Edit</label>
  <% elsif @decision.settled? %>
    <label for="edit-decision" class="btn">Amend</label>
    <label for="supersede-decision" class="btn">Supersede</label>
  <% end %>
  <label for="link-threads" class="btn">Link threads</label>
  <%= link_to "The log", fd_decisions_path, class: "btn" %>
  <% if @previous %>
    <%= link_to "Previous", fd_decision_path(@previous), class: "btn" %>
  <% else %>
    <span class="btn is-off">Previous</span>
  <% end %>
  <% if @next %>
    <%= link_to "Next", fd_decision_path(@next), class: "btn" %>
  <% else %>
    <span class="btn is-off">Next</span>
  <% end %>
<% end %>

<div class="stack">
  <div class="card">
    <p class="dec-said"><%= @decision.statement %></p>

    <% if @decision.reasons.any? %>
      <div class="dec-why">
        <% @decision.reasons.each do |reason| %>
          <p class="fact-line"><%= reason %></p>
        <% end %>
      </div>
    <% else %>
      <p class="card-note">No reasons written down.</p>
    <% end %>
  </div>

  <p class="band-label">
    Where it was argued ·
    <%= @decision.threads.any? ? pluralize(@decision.threads.size, "thread") : "none linked" %>
  </p>

  <% if @decision.threads.any? %>
    <% @decision.threads.each do |thread| %>
      <div class="card">
        <div class="thr-head">
          <span class="thr-where"><%= thread.channel_id %></span>
          <span class="chip <%= thread.internal? ? "chip-warn" : "chip-off" %>">
            <%= thread.internal? ? "internal" : "reference" %>
          </span>
          <% if thread.said_why? %>
            <span class="thr-why"><%= thread.why %></span>
          <% end %>
          <span class="thr-end">
            <%= link_to "Open in Slack", slack_thread_url(thread.channel_id, thread.thread_ts),
                  class: "btn", target: "_blank", rel: "noopener" %>
          </span>
        </div>
        <% held = @messages[thread.coordinates] %>
        <% if held.blank? %>
          <p class="thr-gone">No messages held for this thread yet.</p>
        <% else %>
          <%= render "fd/messages", messages: held %>
        <% end %>

        <div class="rail-card">
          <div class="thin">
            <span>
              <b>Linked</b> <%= member_link(thread.added_by) %> ·
              <%= last_case_label(thread.added_at) %>
            </span>
            <%= button_to "Unlink", fd_decision_thread_path(@decision, thread),
                  method: :delete, class: "text-btn",
                  form: { class: "contents", data: { turbo_confirm: "Unlink this thread?" } } %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card">
      <p class="card-note">No thread linked.</p>
    </div>
  <% end %>

  <p class="band-label">
    <%= cases_band_label(@decision) %> · <%= @cases.any? ? @cases.size : "none" %>
  </p>

  <% if @cases.any? %>
    <div class="card card-flush">
      <div class="scroll">
        <table class="data-table">
          <tbody>
            <% @cases.each do |kase| %>
              <tr>
                <td>
                  <span class="two-line">
                    <%= link_to fd_case_path(kase) do %>
                      <b>case <%= kase.id %></b>
                    <% end %>
                    <span class="idline">
                      <%= category_label(kase.category_key).downcase %> ·
                      <%= kase.opened_at.strftime("%-d %b") %>
                    </span>
                  </span>
                </td>
                <td class="said-cell"><%= kase.member_note %></td>
                <td class="col-state"><%= case_status_chip(kase) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card">
      <p class="card-note">No case linked yet.</p>
    </div>
  <% end %>

  <p class="band-label">History</p>
  <div class="card">
    <p class="thr-gone"><%= decision_history_line(@decision) %></p>
    <% if @replaced.any? %>
      <div class="dec-why">
        <% @replaced.each do |old| %>
          <p class="fact-line">
            Replaced <%= link_to old.title, fd_decision_path(old), class: "lnk" %>,
            retired <%= old.retired_at.strftime("%-d %b %Y") %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% unless @decision.superseded? %>
  <%= render "fd/decisions/edit_modal", decision: @decision %>
<% end %>
<% if @decision.settled? %>
  <%= render "fd/decisions/supersede_modal", decision: @decision %>
<% end %>
<%= render "fd/decisions/link_threads_modal", decision: @decision %>
