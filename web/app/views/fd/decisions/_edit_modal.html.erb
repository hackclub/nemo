<%= render layout: "fd/modal", locals: { id: "edit-decision", title: "Edit",
      open: params[:do] == "edit" } do %>
  <%= form_with url: fd_decision_path(decision), method: :patch,
        html: { autocomplete: "off", id: "edit-wording" } do %>
    <div class="modal-body">
      <%= render "fd/decisions/words", decision: decision, with_reasons: true %>
    </div>
  <% end %>

  <div class="modal-foot">
    <% if decision.proposed? && decision.proposed_by == current_account.user_id %>
      <%= button_to "Drop it", fd_decision_path(decision), method: :delete,
            class: "btn", form: { class: "contents",
            data: { turbo_confirm: "Drop this proposal?" } } %>
    <% end %>
    <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
    <%= submit_tag "Save", class: "btn btn-primary", form: "edit-wording" %>
  </div>
<% end %>
