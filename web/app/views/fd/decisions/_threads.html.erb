<p class="band-label">
  Threads ·
  <%= threads.any? ? pluralize(threads.size, "thread") : "none linked" %>
</p>

<turbo-frame id="threads" target="_top" data-turbo-action="advance">
<div class="inspector">
  <div class="index-side">
    <% threads.each do |row| %>
      <%= link_to fd_decision_path(decision, thread: row.id), class: "index-item",
            data: { turbo_frame: "threads" },
            aria: { current: (chosen && row.id == chosen.id ? "true" : nil) } do %>
        <span class="mono"><%= row.channel_id %></span>
        <span class="chip <%= row.internal? ? "chip-warn" : "chip-off" %>"><%= row.kind %></span>
      <% end %>
    <% end %>
    <%= opens_modal "decision.link", opens: "link-threads",
          css: "index-item index-add" do %>
      <span class="index-face">+</span>
      Link threads
    <% end %>
  </div>

  <div class="pane">
    <% if chosen.nil? %>
      <p class="card-note">No thread linked.</p>
    <% else %>
      <div class="thr-head">
        <span class="thr-where"><%= chosen.channel_id %></span>
        <% if chosen.said_why? %>
          <span class="thr-why"><%= chosen.why %></span>
        <% end %>
        <span class="thr-end">
          <%= link_to "Open in Slack", slack_thread_url(chosen.channel_id, chosen.thread_ts),
                class: "btn", target: "_blank", rel: "noopener" %>
        </span>
      </div>

      <% held = messages[chosen.coordinates] %>
      <% if held.blank? %>
        <p class="thr-gone">No messages held for this thread yet.</p>
      <% else %>
        <%= render "fd/messages", messages: held %>
      <% end %>

      <div class="rail-card">
        <div class="thin">
          <span>
            <b>Linked</b> <%= member_link(chosen.added_by) %> ·
            <%= last_case_label(chosen.added_at) %>
          </span>
          <%= gated_button "decision.link", "Unlink",
                fd_decision_thread_path(decision, chosen), css: "text-btn", method: :delete,
                form: { class: "contents", data: { turbo_frame: "_top",
                turbo_confirm: "Unlink this thread?" } } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
</turbo-frame>
