<div class="card-head record-head">
  <div>
    <h2 class="card-title">Record</h2>
  </div>
  <span class="chip chip-off"><%= pluralize(history.size, "entry") %></span>
  <div class="card-tools">
    <div class="chiprow">
      <% Fd::MemberTimeline::KINDS.each do |key, label| %>
        <%= link_to label.downcase, fd_member_path(user_id, show: (key unless key == "all")),
              class: "filt", aria: { current: ("true" if key == only) } %>
      <% end %>
    </div>
  </div>
</div>

<% if history.any? %>
  <div class="record">
    <% history.each do |entry| %>
      <div class="record-line">
        <span class="record-when"><%= entry.at.strftime("%-d %b") %></span>
        <span class="record-what">
          <% if entry.case_id %>
            <%= link_to entry.title, fd_case_path(entry.case_id), class: "record-title" %>
          <% else %>
            <span class="record-title"><%= entry.title %></span>
          <% end %>
          <% if entry.detail.present? %>
            <span class="record-detail">· <%= entry.detail %></span>
          <% end %>
          <% if entry.said.present? %>
            <span class="record-said"><%= mentioned(entry.said) %></span>
          <% end %>
        </span>
        <span class="chip <%= history_chip_tone(entry.state) %>"><%= entry.state %></span>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="card-note record-none"><%= history_empty_note(only) %></p>
<% end %>
