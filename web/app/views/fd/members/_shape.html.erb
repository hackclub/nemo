<div class="card">
  <div class="card-head">
    <div>
      <h2 class="card-title">Summary</h2>
      <p class="card-sub"><%= shape_sub(record) %></p>
    </div>
    <% if record.actions.any? %>
      <div class="card-tools">
        <span class="chip <%= record.reversed_actions.positive? ? "chip-warn" : "chip-off" %>">
          <%= action_tally(record) %>
        </span>
      </div>
    <% end %>
  </div>

  <div class="shape-nums">
    <div>
      <div class="fact-label">Subject of</div>
      <div class="fact-val"><%= record.subject_cases.size %></div>
    </div>
    <div>
      <div class="fact-label">Logged in</div>
      <div class="fact-val"><%= record.logged_cases.size %></div>
    </div>
    <div>
      <div class="fact-label">Actions</div>
      <div class="fact-val"><%= record.actions.size %></div>
    </div>
    <div>
      <div class="fact-label">Reversed</div>
      <div class="fact-val muted"><%= record.reversed_actions %></div>
    </div>
  </div>

  <div class="spine">
    <div class="spine-rule"></div>
    <% record.spine.each do |mark| %>
      <%= link_to fd_case_path(mark.case_id), class: "spine-dot dot-#{mark.tone}",
            style: "left:#{mark.label}%",
            title: "case #{mark.case_id} · #{Fd::MemberRecord::TONES.fetch(mark.tone)}" do %>
        <i>#<%= mark.case_id %></i>
      <% end %>
    <% end %>
  </div>
  <div class="spine-ends">
    <span><%= record.first_case_at.strftime("%-d %b %Y") %></span>
    <% if record.quiet_months %>
      <span class="spine-gap"><%= pluralize(record.quiet_months, "quiet month") %></span>
    <% end %>
    <span><%= record.last_case_at.strftime("%-d %b %Y") %></span>
  </div>

  <div class="spine-key">
    <% record.spine.map(&:tone).uniq.each do |tone| %>
      <span><i class="dot-<%= tone %>"></i> <%= Fd::MemberRecord::TONES.fetch(tone) %></span>
    <% end %>
  </div>
</div>
