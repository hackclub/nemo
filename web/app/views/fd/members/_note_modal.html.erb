<%= render layout: "fd/modal", locals: { id: "add-member-note",
      title: "Note on #{names[user_id]}", label: "Add a note about this member" } do %>
  <%= form_with url: fd_member_notes_path(user_id), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <label class="field-label">
        The note
        <%= render "fd/mention_field", name: :body, value: nil, rows: 4,
              placeholder: "type @ to name somebody" %>
      </label>
    </div>
    <div class="modal-foot">
      <label for="add-member-note" class="btn">Close</label>
      <%= submit_tag "Save the note", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
