<% rows.each do |row| %>
  <% member = names.member(row.user_id) %>
  <% member_context = context[row.user_id] %>
  <% grant = grants[row.user_id] %>
  <% member_name = person_name(row.user_id) %>
  <% raw_handle = member&.handle.presence || row.user_id %>
  <% member_handle = raw_handle.start_with?("@") ? raw_handle : "@#{raw_handle}" %>
  <%= link_to fd_member_path(row.user_id, local_assigns.fetch(:query_params, {})), class: "queue-row member-queue-row", role: "option",
        aria: { selected: (open_id == row.user_id).to_s },
        data: { pane_filter_target: "row", action: "click->pane#hide" } do %>
    <span class="queue-top member-queue-top">
      <%= avatar(row.user_id) %>
      <span class="queue-category trunc"><%= member_handle %></span>
      <span class="queue-age"><%= fact_number(member_context&.messages_posted) %></span>
    </span>

    <span class="queue-subject trunc">
      <%= member_name %> &middot;
      <%= member_context&.cohort_at ? "joined #{member_context.cohort_at.to_date.strftime('%b %Y')}" : "join date n/a" %>
    </span>

    <% if row.cases.positive? || row.in_force.positive? || row.open_cases.positive? || grant %>
      <span class="queue-meta">
        <% if row.cases.positive? %>
          <span class="chip chip-warn"><%= pluralize(row.cases, "case") %></span>
        <% end %>
        <% if row.in_force.positive? %>
          <span class="state state-crit"><%= row.in_force == 1 ? "In force" : "#{row.in_force} in force" %></span>
        <% elsif row.open_cases.positive? %>
          <span class="state state-warn">Open case</span>
        <% end %>
        <%= role_chip(grant.name) if grant %>
      </span>
    <% end %>
  <% end %>
<% end %>
<% if local_assigns[:more].present? %>
  <template data-expand-next="<%= more %>"></template>
<% end %>
