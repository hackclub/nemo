<% rows.each do |row| %>
  <% member = names.member(row.user_id) %>
  <% seen = context[row.user_id] %>
  <% grant = grants[row.user_id] %>
  <% shown = person_name(row.user_id) %>
  <% raw_handle = member&.handle.presence || row.user_id %>
  <% member_handle = raw_handle.start_with?("@") ? raw_handle : "@#{raw_handle}" %>
  <%= link_to fd_member_path(row.user_id), class: "qrow member-qrow", role: "option",
        aria: { selected: (open_id == row.user_id).to_s },
        data: { pane_filter_target: "row", action: "click->pane#hide" } do %>
    <span class="qtop member-qtop">
      <%= face(row.user_id) %>
      <span class="qcat trunc"><%= member_handle %></span>
      <span class="qage"><%= fact_number(seen&.messages_posted) %></span>
    </span>

    <span class="qsubj trunc">
      <%= shown %> &middot;
      <%= seen&.cohort_at ? "here since #{seen.cohort_at.to_date.strftime('%b %Y')}" : "tenure unavailable" %>
    </span>

    <span class="qmeta">
      <% if row.cases.positive? %>
        <span class="chip chip-warn"><%= pluralize(row.cases, "case") %></span>
      <% end %>
      <% if row.in_force.positive? %>
        <span class="state state-crit"><%= row.in_force == 1 ? "in force" : "#{row.in_force} in force" %></span>
      <% elsif row.open_cases.positive? %>
        <span class="state state-warn">Open case</span>
      <% elsif row.cases.zero? %>
        <span class="state state-good">Clear</span>
      <% end %>
      <%= role_chip(grant.name) if grant %>
    </span>
  <% end %>
<% end %>
<% if local_assigns[:more].present? %>
  <template data-more-next="<%= more %>"></template>
<% end %>
