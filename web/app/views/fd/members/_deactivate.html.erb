<%= render layout: "fd/modal", locals: { id: "member-deactivate",
      title: "Deactivate account", sub: member,
      open: params[:do] == "deactivate" } do %>
  <%= form_with url: fd_member_guards_path(user_id), method: :post,
        html: { autocomplete: "off",
                data: { controller: "confirm-word", confirm_word_word_value: handle } } do %>
    <%= hidden_field_tag :kind, Fd::MemberGuard::DEACTIVATION, id: nil %>
    <div class="modal-body">
      <label class="field-label">
        Reason
        <%= text_area_tag :reason, submitted_value(:reason) || local_assigns[:reason], rows: 3, class: "textarea", id: nil %>
      </label>
      <%= field_wrong(:reason) %>

      <%= render "fd/start_fields", label: "Start (UTC, optional)" %>

      <div class="field-label">
        <span>End (UTC, optional)</span>
        <span class="field-pair">
          <%= date_field_tag :expires_on, nil, class: "input", id: nil, aria: { label: "End date" } %>
          <%= time_field_tag :expires_time, nil, class: "input", id: nil, aria: { label: "End time (UTC)" } %>
        </span>
      </div>

      <% if current_account.may?("member.purge") %>
        <label class="tickline">
          <%= check_box_tag :purge_messages, "1", false, class: "tick", id: nil %>
          Purge all messages
        </label>
      <% end %>

      <label class="field-label">
        Type <b class="mono"><%= handle %></b> to confirm
        <%= text_field_tag :confirm, nil, class: "input", id: nil, autocomplete: "off",
              data: { confirm_word_target: "field", action: "input->confirm-word#toggleSubmit" } %>
      </label>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
      <%= submit_tag "Deactivate", class: "btn btn-danger",
            data: { confirm_word_target: "go" }, disabled: true %>
    </div>
  <% end %>
<% end %>
