<%= render layout: "fd/modal", locals: { id: "member-deactivate",
      title: "Deactivate the account", sub: member,
      open: params[:do] == "deactivate" } do %>
  <%= form_with url: fd_member_guards_path(user_id), method: :post,
        html: { autocomplete: "off",
                data: { controller: "confirm-word", confirm_word_word_value: handle } } do %>
    <%= hidden_field_tag :kind, Fd::MemberGuard::DEACTIVATION, id: nil %>
    <div class="modal-body">
      <label class="field-label">
        Why
        <%= text_area_tag :reason, field_was(:reason), rows: 3, class: "textarea", id: nil %>
      </label>
      <%= field_wrong(:reason) %>

      <label class="field-label">
        Until when (optional)
        <%= date_field_tag :expires_on, nil, class: "input", id: nil %>
      </label>

      <label class="field-label">
        Type <b class="mono"><%= handle %></b> to confirm
        <%= text_field_tag :confirm, nil, class: "input", id: nil, autocomplete: "off",
              data: { confirm_word_target: "field", action: "input->confirm-word#fit" } %>
      </label>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Deactivate", class: "btn btn-danger",
            data: { confirm_word_target: "go" }, disabled: true %>
    </div>
  <% end %>
<% end %>
