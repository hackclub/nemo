<%= turbo_frame_tag "member-links-#{user_id}", target: "_top" do %>
<div class="pane-body">
  <% if links.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr><th>Account</th><th>Score</th><th>On</th><th>Last seen</th><th>Verdict</th></tr>
        </thead>
        <tbody>
          <% links.each do |side| %>
            <tr>
              <td><%= member_face(side.other_id) %></td>
              <td><%= link_band_chip(side) %>
                <span class="sub2"><%= number_with_precision(side.score, precision: 1) %></span>
              </td>
              <td class="link-why">
                <% side.evidence.each do |one| %>
                  <div class="sub2">
                    <%= one["label"] %>
                    <span class="mono"><%= one["value"] %></span>
                    <%= "shared with #{one['people']}" if one["people"].to_i > 2 %>
                  </div>
                <% end %>
              </td>
              <td class="sub2"><%= side.last_seen ? on_day(side.last_seen) : "n/a" %></td>
              <% judged = Fd::LinkVerdict.of(verdicts, user_id, side.other_id) %>
              <td><%= verdict_cell(user_id, side.other_id, judged) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if mates.any? %>
    <section class="link-mates">
      <div class="link-mates-head">
        <h3 class="link-mates-title">Same cluster</h3>
        <span class="sub2"><%= pluralize(number_with_delimiter(mates.size), "other account") %></span>
        <%= link_to "Open cluster", fd_cluster_path(cluster_of), class: "btn btn-sm link-mates-open" if cluster_of %>
      </div>
      <div class="link-mates-list">
        <% mates.first(Fd::MemberLink::MATES_SHOWN).each do |mate| %>
          <%= member_face(mate) %>
        <% end %>
        <% if mates.size > Fd::MemberLink::MATES_SHOWN %>
          <span class="sub2"><%= number_with_delimiter(mates.size - Fd::MemberLink::MATES_SHOWN) %> more</span>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if cluster_of && mates.none? %>
    <div class="pane-foot">
      <%= link_to "Open cluster", fd_cluster_path(cluster_of), class: "btn btn-sm" %>
    </div>
  <% end %>

  <% if links.none? && mates.none? %>
    <div class="empty">
      <p class="empty-title">No linked accounts</p>
    </div>
  <% end %>
</div>
<% end %>
