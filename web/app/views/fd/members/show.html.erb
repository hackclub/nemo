<% content_for :page_title, names[@user_id] %>
<% content_for :page_face do %>
  <span class="crumb"><%= link_to "Members", fd_members_path %> /</span>
<% end %>
<% content_for :head_actions do %>
  <%= link_to "Open a case", fd_cases_path(subject_user_id: @user_id, open: "1"),
        class: "btn btn-primary" %>
  <details class="menu" data-controller="menu">
    <summary class="btn btn-only" aria-label="More actions">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
    </summary>
    <div class="menu-pop">
      <%= link_to menu_item("cases", "Their cases"), fd_cases_path(subject: @user_id),
            class: "btn" %>
      <%= link_to menu_item("external", "Open in Slack"), slack_member_url(@user_id),
            class: "btn", target: "_blank", rel: "noopener" %>
    </div>
  </details>
<% end %>

<div class="cols c-2">
  <div>
    <% show_write = current_staff.may?("member.note") && @only == "notes" %>

    <% if @standing.in_force.any? %>
      <div class="standing">
        <p class="standing-t">In force now</p>
        <% @standing.in_force.each do |action| %>
          <div class="standing-row">
            <span class="grow standing-line"><%= in_force_line(action, names) %></span>
            <%= link_to "Reverse it", fd_case_path(action.case_id, tab: "actions"),
                  class: "btn" %>
            <%= link_to "Open case #{action.case_id}", fd_case_path(action.case_id),
                  class: "btn btn-ghost" %>
          </div>
        <% end %>
      </div>
    <% end %>

  <div class="panel">
    <div class="panel-head">
      <span class="segmented">
        <% Fd::MemberTimeline::KINDS.each do |key, label| %>
          <%= member_tab_link(@user_id, key, label, @counts.fetch(key, 0)) %>
        <% end %>
      </span>
      <span class="grow"></span>
      <% if current_staff.may?("member.note") && !show_write %>
        <%= link_to "Write a note", fd_member_path(@user_id, show: "notes"), class: "btn" %>
      <% end %>
    </div>

    <% if @history.any? %>
      <div class="record-list">
        <% history_by_month(@history).each do |month, entries| %>
          <p class="record-month"><%= month.strftime("%B %Y") %></p>
          <% entries.each do |entry| %>
            <div class="record-row">
              <span class="record-when">
                <span class="record-day"><%= entry.at.strftime("%-d %b") %></span>
                <%= history_word_chip(entry) %>
              </span>
              <span class="record-what">
                <% if entry.case_id %>
                  <b><%= link_to entry.title, fd_case_path(entry.case_id) %></b>
                <% else %>
                  <b><%= entry.title %></b>
                <% end %>
                <% if entry.said.present? %>
                  <span class="record-said"><%= mentioned(entry.said) %></span>
                <% else %>
                  <% under = [entry.state, entry.detail].reject(&:blank?).join(" · ") %>
                  <% if under.present? %><span class="record-said"><%= under %></span><% end %>
                <% end %>
                <span class="record-by">
                  <%= entry.who ? member_link(entry.who) : "n/a" %>
                  <% if entry.ref.is_a?(Fd::Note) %>
                    <%= render "note_remove", user_id: @user_id, note: entry.ref %>
                  <% end %>
                </span>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title"><%= history_empty_note(@only) %></p>
      </div>
    <% end %>

    <% if show_write %>
      <div class="panel-foot">
        <%= field_wrong(:body) %>
        <%= form_with url: fd_member_notes_path(@user_id), method: :post,
              class: "note-composer", html: { autocomplete: "off" } do %>
          <div class="mention-field" data-controller="mention"
               data-mention-send-value="true"
               data-mention-url-value="<%= fd_member_search_path %>">
            <%= text_area_tag :body, field_was(:body), rows: 1, class: "note-input", id: nil,
                  maxlength: Fd::NotesController::MAX_LENGTH,
                  placeholder: "Write a note about #{names[@user_id]}, Enter saves it",
                  data: { mention_target: "field", action: "input->mention#type " \
                          "keydown->mention#keys" } %>
            <div class="menu-pop pick-pop mention-pop" hidden data-mention-target="results"></div>
          </div>
          <button type="submit" class="chat-send" aria-label="Save the note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
  </div>

  <div class="facts">
    <p class="facts-h">Member facts</p>

    <div class="fcard">
      <div class="fcard-who">
        <%= face(@user_id) %>
        <span class="two-line">
          <b><%= names[@user_id] %></b>
          <span><%= identity_line(@identity) %></span>
        </span>
      </div>

      <div class="fstats">
        <div class="fstat">
          <span class="fstat-n <%= "is-none" if @standing.cases_named.zero? %>">
            <%= @standing.cases_named %>
          </span>
          <span class="fstat-k"><%= "case".pluralize(@standing.cases_named) %></span>
        </div>
        <div class="fstat">
          <span class="fstat-n <%= "is-none" if @standing.actions.zero? %>">
            <%= @standing.actions %>
          </span>
          <span class="fstat-k"><%= "action".pluralize(@standing.actions) %></span>
        </div>
        <div class="fstat">
          <span class="fstat-n <%= "is-none" if @standing.reversed.zero? %>">
            <%= @standing.reversed %>
          </span>
          <span class="fstat-k">reversed</span>
        </div>
      </div>

      <div class="frows">
        <div class="frow">
          <span>Here since</span>
          <b class="<%= "is-none" unless @context&.cohort_at %>">
            <%= @context&.cohort_at ? @context.cohort_at.to_date.strftime("%b %Y") : "n/a" %>
          </b>
        </div>
        <div class="frow">
          <span>Messages</span>
          <b class="<%= "is-none" unless @context&.messages_posted %>">
            <%= fact_number(@context&.messages_posted) %>
          </b>
        </div>
        <div class="frow">
          <span>Last seen</span>
          <b class="<%= "is-none" unless @context&.last_active_at %>">
            <%= last_active_label(@context&.last_active_at) %>
          </b>
        </div>
      </div>
    </div>
  </div>
</div>
