<% content_for :page_title, names[@user_id] %>
<% content_for :page_face do %>
  <span class="head-face" aria-hidden="true"><%= @member ? @member.initial : "?" %></span>
<% end %>
<% content_for :page_subtitle do %>
  <span class="idline">
    <%= handle(@user_id) %>
    <% if @member&.handle.present? %><span>@<%= @member.handle %></span><% end %>
    <% if @member&.pronouns.present? %><span><%= @member.pronouns %></span><% end %>
    <% if @member&.tz.present? %><span><%= @member.tz %></span><% end %>
    <%= member_facts(@context, @identity) %>
  </span>
<% end %>
<% content_for :head_actions do %>
  <%= link_to "Open in Slack", slack_member_url(@user_id), class: "btn",
        target: "_blank", rel: "noopener" %>
  <%= link_to "Their cases", fd_cases_path(subject: @user_id), class: "btn" %>
  <%= link_to "Open a case", fd_cases_path(subject_user_id: @user_id, open: "1"),
        class: "btn btn-primary" %>
<% end %>

<div class="stack">
  <div class="stand <%= member_standing_tone(@standing) %>">
    <%= standing_chip(@standing) %>
    <span><%= member_standing_line(@standing, names) %></span>
  </div>

  <% if @history.any? || @only != "all" %>
    <div class="card card-flush">
      <%= render "history", history: @history, only: @only, user_id: @user_id %>
      <% if @record.anything? || @standing.actions.positive? %>
        <div class="record-strip">
          <span>subject of <b><%= @standing.cases %></b></span>
          <span>logged in <b><%= @standing.logged_in %></b></span>
          <span>actions <b><%= @standing.actions %></b></span>
          <span>reversed <b><%= @standing.reversed %></b></span>
          <% if @record.first_case_at %>
            <span>first seen <b><%= @record.first_case_at.strftime("%-d %b %Y") %></b></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="card">
    <div class="card-head">
      <div>
        <h2 class="card-title">Notes on <%= names[@user_id] %></h2>
      </div>
      <span class="chip chip-off"><%= @record.notes.size %></span>
    </div>
    <% if @record.notes.any? %>
      <div class="notes">
        <% @record.notes.each do |note| %>
          <div class="note-row">
            <div class="note-body"><%= mentioned(note.body) %></div>
            <div class="note-by">
              <span><%= note_byline(note) %></span>
              <%= render "note_remove", user_id: @user_id, note: note %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <span class="note-none">No notes</span>
    <% end %>

    <% if current_staff.may?("member.note") %>
      <%= form_with url: fd_member_notes_path(@user_id), method: :post,
            class: "note-composer", html: { autocomplete: "off" } do %>
        <div class="mention-field" data-controller="mention"
             data-mention-url-value="<%= fd_member_search_path %>">
          <%= text_area_tag :body, nil, rows: 1, class: "note-input", id: nil,
                maxlength: Fd::NotesController::MAX_LENGTH,
                placeholder: "Write a note about #{names[@user_id]}",
                data: { mention_target: "field", action: "input->mention#type " \
                        "keydown->mention#keys" } %>
          <div class="menu-pop pick-pop mention-pop" hidden data-mention-target="results"></div>
        </div>
        <button type="submit" class="chat-send" aria-label="Save the note">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
        </button>
      <% end %>
    <% end %>
  </div>
</div>
