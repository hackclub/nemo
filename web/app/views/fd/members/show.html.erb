<% raw_handle = @member&.handle.presence || @user_id %>
<% member_handle = raw_handle.start_with?("@") ? raw_handle : "@#{raw_handle}" %>
<% member_name = @member&.display_name.presence || names[@user_id] %>
<% may_note = current_account.may?("member.note") %>

<% content_for :page_title, (names.unknown?(@user_id) ? person_name(@user_id) : member_handle) %>
<% content_for :page_face do %><%= face(@user_id) %><% end %>
<% if member_name.present? && member_name.delete_prefix("@") != member_handle.delete_prefix("@") %>
  <% content_for :head_context do %>
    <span class="triad-sep">&middot;</span>
    <span class="triad-who"><%= member_name %></span>
  <% end %>
<% end %>
<% content_for :head_actions do %>
  <%= link_to case_action_button("external", "Slack"), slack_member_url(@user_id),
        class: "btn btn-ghost", target: "_blank", rel: "noopener" %>
  <% if may_note %>
    <button type="button" class="btn" data-modal-open="member-note" aria-haspopup="dialog">
      <%= case_action_button("note", "Write a note") %>
    </button>
  <% end %>
  <%= link_to case_action_button("plus", "Open a case"),
        fd_cases_path(subject_user_id: @user_id, open: "1"), class: "btn btn-primary" %>
<% end %>
<% content_for :pane do %>
  <%= render "pane", rows: @pane_rows, views: @pane_views, query: @pane_query,
        context: @pane_context, grants: @pane_grants, open_id: @user_id %>
<% end %>
<% content_for :flush, true %>

<div class="stack member-record">
  <dl class="facts-strip member-facts">
    <div class="fact">
      <dt>Slack ID</dt>
      <dd class="mono"><%= @user_id %></dd>
    </div>
    <div class="fact">
      <dt>Email</dt>
      <dd class="<%= "is-none" unless @identity&.email.present? && !@identity.refused? && !@identity.purged? %>"><%= identity_line(@identity) %></dd>
    </div>
    <div class="fact">
      <dt>Here since</dt>
      <dd class="<%= "is-none" unless @context&.cohort_at %>"><%= here_since(@context) %></dd>
    </div>
    <div class="fact">
      <dt>Messages</dt>
      <dd class="<%= "is-none" unless @context&.messages_posted %>"><%= fact_number(@context&.messages_posted) %></dd>
    </div>
    <div class="fact">
      <dt>Cases</dt>
      <dd class="<%= "is-none" if @standing.cases_named.zero? %>"><%= @standing.cases_named.zero? ? "none" : @standing.cases_named %></dd>
    </div>
    <div class="fact">
      <dt>Actions</dt>
      <dd class="<%= "is-none" if @standing.actions.zero? %>"><%= @standing.actions.zero? ? "none" : @standing.actions %></dd>
    </div>
  </dl>

  <div class="member-record-content">
    <% if @standing.in_force.any? %>
      <div class="standing">
        <p class="standing-t">In force now</p>
        <% @standing.in_force.each do |action| %>
          <div class="standing-row">
            <span class="evdot crit"><%= case_action_icon("gauge") %></span>
            <span class="grow standing-line"><%= in_force_line(action, names) %></span>
            <%= link_to "Reverse it", fd_case_path(action.case_id, tab: "actions"), class: "btn" %>
            <%= link_to "Open case ##{action.case_id}", fd_case_path(action.case_id), class: "btn btn-ghost" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @record.subject_cases.any? %>
      <section class="member-section">
        <h2 class="member-section-title">Cases</h2>
        <div class="list member-case-list">
          <% @record.subject_cases.reverse_each do |kase| %>
            <div class="lrow">
              <span class="evdot <%= kase.resolved? ? "good" : "crit" %>"><%= case_action_icon("shield") %></span>
              <span class="grow">
                <b>#<%= kase.id %> <%= kase.category_key ? category_label(kase.category_key) : "No violation set" %></b>
                <span class="sub"><%= case_first_report(kase)&.body.presence || (kase.resolved? ? "resolved" : "open case") %></span>
              </span>
              <span class="lrow-right"><%= link_to "Open", fd_case_path(kase), class: "btn" %></span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="member-section member-history-section">
      <div class="member-section-head">
        <h2 class="member-section-title">History</h2>
        <% if may_note %>
          <button type="button" class="btn" data-modal-open="member-note" aria-haspopup="dialog">
            <%= case_action_button("note", "Write a note") %>
          </button>
        <% end %>
      </div>

      <nav class="views member-record-tabs" aria-label="Member history">
        <% Fd::MemberTimeline::KINDS.each do |key, label| %>
          <%= member_tab_link(@user_id, key, label, @counts.fetch(key, 0)) %>
        <% end %>
      </nav>

      <% if @history.any? %>
        <div class="member-timeline">
          <% history_by_month(@history).each do |month, entries| %>
            <p class="record-month"><%= month.strftime("%B %Y") %></p>
            <div class="list">
              <% entries.each do |entry| %>
                <% event_icon = entry.kind == "cases" ? "shield" : entry.kind == "actions" ? "gauge" : "note" %>
                <% event_tone = entry.word == "reversal" ? "good" : entry.kind == "actions" ? "warn" : entry.state == "open" ? "crit" : "" %>
                <div class="evrow">
                  <span class="evdot <%= event_tone %>"><%= case_action_icon(event_icon) %></span>
                  <div>
                    <div class="member-event-head">
                      <% if entry.case_id %>
                        <b><%= link_to entry.title, fd_case_path(entry.case_id) %></b>
                      <% else %>
                        <b><%= entry.title %></b>
                      <% end %>
                      <span class="evwhen"><%= entry.at.strftime("%-d %b") %></span>
                    </div>
                    <% if entry.said.present? %>
                      <p class="member-event-said"><%= mentioned(entry.said) %></p>
                    <% else %>
                      <% under = [entry.state, entry.detail].reject(&:blank?).join(" · ") %>
                      <% if under.present? %><p class="member-event-said"><%= under %></p><% end %>
                    <% end %>
                    <span class="member-event-by">
                      <%= entry.who ? member_link(entry.who) : "n/a" %>
                      <% if entry.ref.is_a?(Fd::Note) %>
                        <%= render "note_remove", user_id: @user_id, note: entry.ref %>
                      <% end %>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty"><p class="empty-title"><%= history_empty_note(@only) %></p></div>
      <% end %>

    </section>
  </div>
</div>

<% if may_note %>
  <%= render layout: "fd/modal", locals: { id: "member-note", title: "Write a note",
        sub: names[@user_id], open: field_was(:body).present? } do %>
    <%= form_with url: fd_member_notes_path(@user_id), method: :post, html: { autocomplete: "off" } do %>
      <div class="modal-body">
        <label class="field-label">
          The note
          <%= render "fd/mention_field", name: :body, value: field_was(:body), rows: 4,
                placeholder: "type @ to name somebody" %>
        </label>
        <%= field_wrong(:body) %>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
        <%= submit_tag "Save the note", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>
