<% raw_handle = @member&.handle.presence || @user_id %>
<% member_handle = raw_handle.start_with?("@") ? raw_handle : "@#{raw_handle}" %>
<% member_name = @member&.display_name.presence || names[@user_id] %>
<% may_note = current_account.may?("member.note") %>
<% may_guard = current_account.may?("member.guard") %>
<% may_deactivate = current_account.may?("member.deactivate") %>
<% may_identity = current_account.may?("identity.read") %>
<% may_links = current_account.may?("member.links") %>
<% standing_guard = @guards.find(&:deactivation?) %>

<% member_title = names.unknown?(@user_id) ? person_name(@user_id) : member_handle %>
<% content_for :page_title, member_title %>
<% content_for :headless, true %>
<% content_for :pane do %>
  <%= render "pane", rows: @pane_rows, views: @pane_views, query: @pane_query,
        context: @pane_context, grants: @pane_grants, open_id: @user_id %>
<% end %>
<% content_for :flush, true %>

<div class="stack member-record">

  <div class="member-record-content" data-controller="pending-flush"
       data-pending-flush-frame-value="<%= Fd::MemberGuardBroadcast.frame(@user_id) %>">
    <%= turbo_stream_from Fd::MemberGuardBroadcast.stream(@user_id) %>
    <section class="card member-hero">
      <div class="member-hero-head">
        <%= face(@user_id, css: "avatar member-hero-face") %>
        <div class="member-hero-who">
          <h1 class="member-hero-name"><%= member_title %></h1>
          <% if member_name.present? && member_name.delete_prefix("@") != member_handle.delete_prefix("@") %>
            <span class="member-hero-sub"><%= member_name %></span>
          <% end %>
        </div>
        <div class="member-hero-do">
          <%= open_in_slack slack_member_url(@user_id), css: "btn btn-ghost" %>
          <% if may_note %>
            <button type="button" class="btn" data-modal-open="member-note" aria-haspopup="dialog">
              <%= case_action_button("note", "Write a note") %>
            </button>
          <% end %>
          <% if may_guard %>
            <button type="button" class="btn" data-modal-open="member-guard" aria-haspopup="dialog">
              <%= case_action_button("gauge", "Take action") %>
            </button>
          <% end %>
          <%= render layout: "shared/dropdown", locals: {
                label: "More actions", trigger: menu_dots } do %>
            <%= opens_modal "identity.read", menu_item("sessions", "Sessions"),
                  opens: "member-sessions" %>
            <%= opens_modal "member.links", menu_item("people", "Linked accounts"),
                  opens: "member-links" %>
            <% if standing_guard %>
              <%= opens_modal "member.deactivate", menu_item("hand", "Activate"),
                    opens: "guard-lift-#{standing_guard.id}" %>
            <% else %>
              <%= opens_modal "member.deactivate", menu_item("deactivate", "Deactivate"),
                    opens: "member-deactivate" %>
            <% end %>
          <% end %>
          <%= link_to case_action_button("plus", "Open a case"),
                fd_cases_path(subject_user_id: @user_id, open: "1"), class: "btn btn-primary" %>
        </div>
      </div>
      <dl class="fact-grid member-facts <%= "has-links" if @links_held %>">
        <div class="fact">
          <dt>Slack ID</dt>
          <dd class="mono fact-one"><%= @user_id %></dd>
        </div>
        <div class="fact">
          <dt>Email</dt>
          <dd class="fact-one <%= "is-none" unless @identity&.email.present? && !@identity.refused? && !@identity.purged? %>"><%= identity_line(@identity) %></dd>
        </div>
        <div class="fact">
          <dt>Here since</dt>
          <dd class="fact-one <%= "is-none" unless @context&.cohort_at %>"><%= member_since(@context) %></dd>
        </div>
        <div class="fact">
          <dt>Messages</dt>
          <dd class="<%= "is-none" unless @context&.messages_posted %>"><%= fact_number(@context&.messages_posted) %></dd>
        </div>
        <div class="fact">
          <dt>Cases</dt>
          <dd class="<%= "is-none" if @standing.cases_named.zero? %>">
            <%= @standing.cases_named.zero? ? "None" : @standing.cases_named %>
          </dd>
        </div>
        <div class="fact">
          <dt>Actions</dt>
          <dd class="<%= "is-none" if @standing.actions.zero? %>">
            <%= @standing.actions.zero? ? "None" : @standing.actions %>
          </dd>
        </div>
        <% if @links_held %>
          <div class="fact">
            <dt>Links</dt>
            <dd class="fact-one <%= "is-none" if @links_held.count.zero? %>">
              <% if @links_held.count.zero? %>
                None
              <% else %>
                <button type="button" class="fact-go" data-modal-open="member-links" aria-haspopup="dialog">
                  <%= @links_held.count %>
                </button>
                <% if @links_held.certain.positive? %>
                  <span class="sub"><%= @links_held.certain %> certain</span>
                <% elsif @links_held.strong.positive? %>
                  <span class="sub"><%= @links_held.strong %> strong</span>
                <% end %>
              <% end %>
            </dd>
          </div>
          <div class="fact">
            <dt>Cluster</dt>
            <dd class="fact-one <%= "is-none" unless @cluster %>">
              <% if @cluster %>
                <%= link_to pluralize(@cluster.accounts, "account"), fd_cluster_path(@cluster.cluster_id), class: "fact-go" %>
                <% if @cluster.conflict %><span class="state state-crit">Conflict</span><% end %>
                <% if @cluster.ring %><span class="state state-warn">Ring</span><% end %>
              <% else %>
                None
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </section>
    <%= render "standing", user_id: @user_id, guards: @guards, names: names,
          may_guard: may_guard, may_deactivate: may_deactivate %>

    <% if @record.subject_cases.any? %>
      <section class="member-section">
        <div class="member-section-head">
          <h2 class="member-section-title">Cases</h2>
        </div>
        <div class="list member-case-list">
          <% @record.subject_cases.reverse_each do |kase| %>
            <div class="lrow">
              <span class="evdot <%= kase.resolved? ? "good" : "crit" %>"><%= case_action_icon("shield") %></span>
              <span class="grow">
                <b>#<%= kase.id %><%= " #{category_label(kase.category_key)}" if kase.category_key.present? %></b>
                <span class="sub short"><%= plain_text(case_first_report(kase)&.body.presence) .presence || (kase.resolved? ? "Resolved" : "Open case") %></span>
              </span>
              <span class="lrow-right"><%= link_to "Open", fd_case_path(kase), class: "btn btn-sm" %></span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="member-section member-history-section">
      <div class="member-section-head">
        <h2 class="member-section-title">History</h2>
        <% if may_note %>
          <button type="button" class="btn" data-modal-open="member-note" aria-haspopup="dialog">
            <%= case_action_button("note", "Write a note") %>
          </button>
        <% end %>
      </div>

      <nav class="views member-record-tabs" aria-label="Member history">
        <% Fd::MemberTimeline::KINDS.each do |key, label| %>
          <%= member_tab_link(@user_id, key, label, @counts.fetch(key, 0)) %>
        <% end %>
      </nav>

      <% if @history.any? %>
        <div class="member-timeline">
          <% history_by_month(@history).each do |month, entries| %>
            <p class="record-month"><%= month.strftime("%B %Y") %></p>
            <div class="list">
              <% entries.each do |entry| %>
                <% event_icon = entry.kind == "cases" ? "shield" : entry.kind == "actions" ? "gauge" : "note" %>
                <% event_tone = entry.word == "reversal" ? "good" : entry.kind == "actions" ? "warn" : entry.state == "open" ? "crit" : "" %>
                <div class="evrow<%= " is-reversed" if entry.state == "reversed" && entry.word != "reversal" %>">
                  <span class="evdot <%= event_tone %>"><%= case_action_icon(event_icon) %></span>
                  <div>
                    <div class="member-event-head">
                      <% if entry.case_id %>
                        <b><%= link_to entry.title, fd_case_path(entry.case_id) %></b>
                      <% else %>
                        <b><%= entry.title %></b>
                      <% end %>
                    </div>
                    <% if entry.body.present? %>
                      <p class="member-event-body"><%= mentioned(entry.body) %></p>
                    <% else %>
                      <% under = [entry.state, entry.detail].reject(&:blank?).join(" · ") %>
                      <% if under.present? %><p class="member-event-body"><%= named_text(under) %></p><% end %>
                    <% end %>
                    <span class="member-event-by">
                      <%= entry.who ? member_link(entry.who) : "n/a" %>
                    </span>
                  </div>
                  <span class="evrow-right">
                    <span class="evwhen"><%= entry.at.strftime("%-d %b") %></span>
                    <% if entry.ref.is_a?(Fd::Note) %>
                      <%= render "note_remove", user_id: @user_id, note: entry.ref %>
                    <% end %>
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty"><p class="empty-title"><%= history_empty_note(@only) %></p></div>
      <% end %>

    </section>
  </div>
</div>

<% if may_guard %>
  <%= render "guards", user_id: @user_id, member: names[@user_id] %>
<% end %>

<% if may_identity %>
  <%= render layout: "fd/modal", locals: { id: "member-sessions", title: "Sessions",
        sub: names[@user_id], size: "wide", open: params[:do] == "sessions" } do %>
    <div class="modal-body">
      <%= turbo_frame_tag Fd::MemberSessions.frame(@user_id), target: "_top",
            src: fd_member_logins_path(@user_id), loading: "lazy" do %>
        <p class="card-note">Reading the sign-ins…</p>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if may_links %>
  <%= render layout: "fd/modal", locals: { id: "member-links", title: "Linked accounts",
        sub: names[@user_id], size: "wide", open: params[:do] == "links" } do %>
    <div class="modal-body">
      <%= turbo_stream_from Fd::MemberLinkBroadcast.stream(@user_id) %>
      <%= turbo_frame_tag Fd::MemberLinkBroadcast.frame(@user_id), target: "_top",
            src: fd_member_links_path(@user_id), loading: "lazy" do %>
        <p class="card-note">Reading the links…</p>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if may_links && may_judge? %>
  <%= render "fd/member_links/verdict_modal", back: fd_member_path(@user_id, do: "links") %>
<% end %>

<% if may_deactivate && standing_guard.nil? %>
  <%= render "deactivate", user_id: @user_id, member: names[@user_id],
        handle: member_handle %>
<% end %>

<% if may_note %>
  <%= render layout: "fd/modal", locals: { id: "member-note", title: "Write a note",
        sub: names[@user_id], open: field_was(:body).present? } do %>
    <%= form_with url: fd_member_notes_path(@user_id), method: :post, html: { autocomplete: "off" } do %>
      <div class="modal-body">
        <label class="field-label">
          The note
          <%= render "fd/mention_field", name: :body, value: field_was(:body), rows: 4,
                placeholder: "type @ to name somebody" %>
        </label>
        <%= field_wrong(:body) %>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
        <%= submit_tag "Save the note", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>
