<%= render layout: "fd/modal", locals: { id: "member-photo-removal", title: "Remove pfp",
      sub: member } do %>
  <%= form_with url: fd_member_photo_removals_path(user_id), method: :post,
        html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <label class="field-label">
        Reason (optional)
        <%= text_area_tag :reason, nil, rows: 3, class: "textarea", id: nil %>
      </label>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
      <%= submit_tag "Remove pfp", class: "btn btn-danger" %>
    </div>
  <% end %>
<% end %>
