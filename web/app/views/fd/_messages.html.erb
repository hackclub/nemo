<% kase = local_assigns[:kase] %>
<% flags = local_assigns[:flags] || {} %>
<% cited_by = local_assigns[:cited_by] || {} %>

<div>
  <% messages.each do |said| %>
    <% flag = flags[said.id] %>
    <div class="msg <%= "msg-flagged" if flag %>">
      <span class="avatar"><%= names.initial(said.author_user_id) %></span>
      <span>
        <span class="msg-who">
          <%= member_link(said.author_user_id) %>
          <span class="msg-at"><%= said.posted_at.strftime("%-d %b %H:%M") %></span>
          <% if flag %><span class="chip chip-crit">flagged as evidence</span><% end %>
          <% if said.edited? %><span class="chip chip-off">edited</span><% end %>
          <% if said.purged? %>
            <span class="chip chip-off">erased</span>
          <% elsif said.deleted? %>
            <span class="chip chip-off">deleted in slack</span>
          <% end %>
          <% if kase %>
            <span class="msg-end">
              <% if flag %>
                <%= gated_button "case.thread", "Unflag", fd_case_citation_path(kase, flag),
                      on: kase, css: "text-btn", method: :delete,
                      params: { person: params[:person] },
                      form: { class: "contents", data: { turbo_frame: "threads" } } %>
              <% else %>
                <%= gated_button "case.thread", "Flag", fd_case_citations_path(kase),
                      on: kase, css: "text-btn",
                      params: { thread_message_id: said.id, person: params[:person] },
                      form: { class: "contents", data: { turbo_frame: "threads" } } %>
              <% end %>
            </span>
          <% end %>
        </span>
        <% if said.readable? %>
          <div class="msg-text<%= " msg-gone" if said.deleted? || said.purged? %>"><% if said.deleted? || said.purged? %>kept here: <% end %><%= mentioned(said.body) %></div>
        <% end %>
        <% if said.purged? %>
          <div class="sub2">erased by <%= names[said.purged_by] %></div>
        <% elsif said.deleted? %>
          <div class="sub2">deleted in Slack <%= last_case_label(said.deleted_at) %></div>
        <% end %>
        <% if flag %>
          <div class="sub2">
            flagged by <%= names[flag.flagged_by] %> ·
            <%= cited_by[said.id].present? ? "cited by an action" : "not cited by an action yet" %>
          </div>
        <% end %>
      </span>
    </div>
  <% end %>
</div>
