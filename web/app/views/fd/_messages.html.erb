<% kase = local_assigns[:kase] %>
<% flags = local_assigns[:flags] || {} %>
<% cited_by = local_assigns[:cited_by] || {} %>

<div>
  <% messages.each do |said| %>
    <% flag = flags[said.id] %>
    <div class="msg <%= "msg-flagged" if flag %>">
      <span class="avatar"><%= names.initial(said.author_user_id) %></span>
      <span>
        <span class="msg-who">
          <%= member_link(said.author_user_id) %>
          <span class="msg-at">
            <%= said.posted_at.strftime("%-d %b %H:%M") %><%= " · edited" if said.edited? %>
          </span>
          <% if kase %>
            <span class="msg-end">
              <% if flag %>
                <%= gated_button "case.thread", "Unflag", fd_case_citation_path(kase, flag),
                      on: kase, css: "text-btn", method: :delete,
                      params: { person: params[:person] },
                      form: { class: "contents", data: { turbo_frame: "threads" } } %>
              <% else %>
                <%= gated_button "case.thread", "Flag", fd_case_citations_path(kase),
                      on: kase, css: "text-btn",
                      params: { thread_message_id: said.id, person: params[:person] },
                      form: { class: "contents", data: { turbo_frame: "threads" } } %>
              <% end %>
            </span>
          <% end %>
        </span>
        <% if said.readable? %>
          <div class="msg-text"><%= mentioned(said.body) %></div>
        <% end %>
        <% if said.purged? %>
          <div class="msg-flag">Erased by <%= names[said.purged_by] %>.</div>
        <% elsif said.deleted? %>
          <div class="msg-flag">
            Deleted in Slack <%= last_case_label(said.deleted_at) %>
          </div>
        <% end %>
        <% cited_by[said.id]&.each do |action| %>
          <div class="msg-flag">
            The <%= action_label(action.type_key).downcase %> of
            <%= action.performed_at.strftime("%-d %b %H:%M") %> cites this message
          </div>
        <% end %>
      </span>
    </div>
  <% end %>
</div>
