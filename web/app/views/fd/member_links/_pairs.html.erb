<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">Accounts that look like one person</h2>
  </div>

  <% if @links.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>One</th>
            <th>The other</th>
            <th>Score</th>
            <th>Reasons</th>
            <th>Last seen</th>
          </tr>
        </thead>
        <tbody>
          <% @links.each do |one| %>
            <tr>
              <td><%= member_link(one.a_user_id) %></td>
              <td><%= member_link(one.b_user_id) %></td>
              <td><%= link_score_chip(one.score) %></td>
              <td><%= link_reasons(Fd::MemberLink.evidence_of(one.signals)) %></td>
              <td class="sub2"><%= one.last_seen ? on_day(one.last_seen) : "n/a" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title">No links</p>
    </div>
  <% end %>
</div>
