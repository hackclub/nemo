<% content_for :page_title, "Linked accounts" %>

<% if @view == "pairs" %>
  <% content_for :head_actions do %>
    <span class="segmented">
      <%= link_to "All", fd_links_path(view: "pairs"),
            aria: { current: ("true" if params[:over].blank?) } %>
      <%= link_to "Strong", fd_links_path(view: "pairs", over: "strong"),
            aria: { current: ("true" if params[:over] == "strong") } %>
      <%= link_to "Certain", fd_links_path(view: "pairs", over: "certain"),
            aria: { current: ("true" if params[:over] == "certain") } %>
    </span>
  <% end %>
<% end %>

<% content_for :page_tabs do %>
  <% Fd::MemberLinksController::VIEWS.each do |key, label| %>
    <%= link_to label, fd_links_path(view: (key unless key == Fd::MemberLinksController::DEFAULT_VIEW)),
          class: "view", aria: { current: ("true" if @view == key) } %>
  <% end %>
<% end %>

<%= turbo_stream_from Fd::MemberLinkBroadcast::LIST_STREAM %>

<%= turbo_frame_tag Fd::MemberLinkBroadcast::LIST_FRAME, target: "_top",
      data: { src: fd_links_path(view: (@view unless @view == Fd::MemberLinksController::DEFAULT_VIEW),
                                 over: params[:over].presence) } do %>
  <div class="stack">
    <%= render @view %>
  </div>
<% end %>
