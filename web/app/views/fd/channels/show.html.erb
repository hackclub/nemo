<% name = @channel&.name.presence %>
<% content_for :page_title, name ? "##{name}" : @channel_id %>
<% content_for :head_context do %>
  <span class="triad-sep">&middot;</span>
  <span class="triad-who mono"><%= @channel_id %></span>
<% end %>
<% content_for :head_actions do %>
  <%= link_to case_action_button("external", "Slack"), slack_channel_url(@channel_id),
        class: "btn btn-ghost", target: "_blank", rel: "noopener" %>
<% end %>
<% content_for :pane do %>
  <%= render "pane", query: @query, rows: @rows, open_id: @open_id %>
<% end %>

<div class="stack">
  <section class="card">
    <div class="card-head">
      <span class="card-title">Bot allow list</span>
      <% if @guard %>
        <span class="card-tools card-sub"><%= channel_guard_line(@guard) %></span>
      <% end %>
    </div>

    <% if @guard %>
      <div class="facts-strip facts-wrap">
        <div class="fstat">
          <b><%= @allows.size %></b>
          <span><%= "bot".pluralize(@allows.size) %> allowed</span>
        </div>
        <div class="fstat">
          <b class="<%= "is-none" unless @guard.live? %>"><%= @guard.live? ? "on" : "off" %></b>
          <span>guard</span>
        </div>
        <div class="fstat">
          <b class="<%= channel_seat_tone(@standing) %>"><%= channel_seat_word(@standing) %></b>
          <span>nemo</span>
        </div>
      </div>

      <p class="sub2"><%= channel_guard_why(@guard, names) %></p>
    <% else %>
      <div class="empty">
        <p class="empty-title">This channel is not guarded</p>
      </div>
    <% end %>
  </section>

  <% if @guard %>
    <section class="card">
      <div class="card-head">
        <span class="card-title">Allowed here</span>
      </div>

      <% if @allows.any? %>
        <div class="people-list">
          <% @allows.each do |one| %>
            <div class="line-row fat">
              <span class="grow two-line">
                <b><%= one.name %></b>
                <span>
                  <span class="mono"><%= one.subject_id %></span>
                  &middot; <%= vouched_line(one, names) %>
                </span>
              </span>
              <% if one.reason.present? %>
                <span class="row-right sub2 trunc"><%= one.reason %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty">
          <p class="empty-title">Nothing is allowed here yet</p>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
