<% name = @channel&.name.presence %>
<% label = name ? "##{name}" : @channel_id %>
<% content_for :page_title, label %>
<% content_for :head_context do %>
  <span class="triad-sep">&middot;</span>
  <span class="triad-who mono"><%= @channel_id %></span>
<% end %>
<% content_for :head_actions do %>
  <%= open_in_slack slack_channel_url(@channel_id), css: "btn btn-ghost" %>
<% end %>
<% content_for :pane do %>
  <%= render "pane", query: @query, rows: @rows, open_id: @open_id %>
<% end %>

<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">Bot allow list</h2>
    <div class="card-tools">
      <% if @guard %>
        <%= opens_modal "channel.guard", "Allow a bot", opens: "allow-bot",
              css: "btn btn-sm" %>
      <% end %>
      <%= channel_guard_switch(@channel_id, @guard) %>
    </div>
  </div>

  <% if @guard %>
    <% if @allows.any? %>
      <div class="people-list">
        <% @allows.each do |one| %>
          <div class="line-row fat">
            <%= guard_face(one.subject_id) %>
            <span class="grow two-line">
              <b><%= bot_name_link(one.name, @app_ids[one.subject_id]) %></b>
              <span>
                <span class="mono"><%= one.subject_id %></span>
                &middot; <%= vouched_line(one) %>
              </span>
            </span>
            <span class="row-right">
              <%= gated_button("channel.guard", "Remove",
                    fd_channel_allow_path(@channel_id, one.subject_id),
                    css: "btn btn-sm btn-ghost", method: :delete,
                    data: { turbo_confirm: "Put #{one.name} out of #{label}?" }) %>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">No bot allowed yet</p>
      </div>
    <% end %>
  <% else %>
    <div class="empty">
      <p class="empty-title">Not guarded</p>
    </div>
  <% end %>
</div>

<div class="card card-flush">
  <div class="card-head">
    <h2 class="card-title">Activity</h2>
  </div>

  <% if @events.any? %>
    <div class="activity">
      <% @events.each do |one| %>
        <div class="activity-item">
          <div class="line-row">
            <%= guard_face(one.subject_id) %>
            <span class="grow two-line">
              <b><%= bot_name_link(activity_who(one, @labels), one.app_id) %></b>
              <span><%= activity_ids(one) %></span>
            </span>
            <span class="row-right">
              <span class="sub2 mono"><%= at_minute(one.at) %></span>
            </span>
          </div>

          <span class="activity-what"><%= activity_verb(one) %></span>

          <% if one.said.present? %>
            <span class="qcite">
              <span class="qcite-said"><%= plain_words(one.said) %></span>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title">Nothing yet</p>
    </div>
  <% end %>
</div>

<% if @guard %>
  <%= render "allow_modal", channel_id: @channel_id, label: label %>
<% end %>
