<% name = @channel&.name.presence %>
<% label = name ? "##{name}" : @channel_id %>
<% content_for :page_title, label %>
<% content_for :head_context do %>
  <span class="triad-sep">&middot;</span>
  <span class="triad-who mono"><%= @channel_id %></span>
<% end %>
<% content_for :head_actions do %>
  <%= link_to case_action_button("external", "Slack"), slack_channel_url(@channel_id),
        class: "btn btn-ghost", target: "_blank", rel: "noopener" %>
<% end %>
<% content_for :pane do %>
  <%= render "pane", query: @query, rows: @rows, open_id: @open_id %>
<% end %>

<div class="stack">
  <section class="card">
    <div class="card-head">
      <span class="card-title">Bot allow list</span>
      <span class="card-tools">
        <%= channel_guard_switch(@channel_id, @guard) %>
      </span>
    </div>

    <% if @guard %>
      <p class="sub2"><%= channel_guard_why(@guard) %></p>
      <%= channel_seat_said(@seat, @standing) %>
    <% else %>
      <div class="empty">
        <p class="empty-title">This channel is not guarded</p>
      </div>
    <% end %>
  </section>

  <% if @guard %>
    <section class="card">
      <div class="card-head">
        <span class="card-title">Allowed here</span>
        <span class="card-tools">
          <%= opens_modal "channel.guard", "Allow a bot", opens: "allow-bot",
                css: "btn btn-sm btn-primary" %>
        </span>
      </div>

      <% if @allows.any? %>
        <div class="people-list">
          <% @allows.each do |one| %>
            <div class="line-row fat">
              <span class="grow two-line">
                <b><%= one.name %></b>
                <span>
                  <span class="mono"><%= one.subject_id %></span>
                  &middot; <%= vouched_line(one) %>
                </span>
              </span>
              <span class="row-right">
                <%= gated_button("channel.guard", "Remove",
                      fd_channel_allow_path(@channel_id, one.subject_id),
                      css: "btn btn-sm", method: :delete,
                      data: { turbo_confirm: "Put #{one.name} out of #{label}?" }) %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty">
          <p class="empty-title">Nothing is allowed here yet</p>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @events.any? %>
    <section class="card">
      <div class="card-head">
        <span class="card-title">Activity</span>
      </div>

      <div class="activity">
        <% @events.each do |one| %>
          <div class="activity-item">
            <div class="line-row">
              <span class="grow two-line">
                <b><%= activity_who(one, @labels) %></b>
                <span><%= activity_ids(one) %></span>
              </span>
              <span class="row-right">
                <%= marketplace_link(one) %>
                <span class="sub2 mono"><%= at_minute(one.at) %></span>
              </span>
            </div>

            <span class="activity-what"><%= activity_verb(one) %></span>

            <% if one.said.present? %>
              <span class="qcite">
                <span class="qcite-said"><%= plain_words(one.said) %></span>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

<% if @guard %>
  <%= render "allow_modal", channel_id: @channel_id, label: label %>
<% end %>
