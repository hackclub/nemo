<% content_for :page_title, "Channels" %>
<% content_for :pane_default, @open_id.present? ? "main" : "pane" %>
<% content_for :pane do %>
  <%= render "pane", query: @query, rows: @rows, open_id: @open_id %>
<% end %>

<section class="section">
  <div class="section-head">
    <h2 class="section-title">Channels nemo joins</h2>
    <p class="section-note"><%= join_standing_line(@joining) %></p>
    <div class="section-tools">
      <%= join_mode_switch(@joining.mode) %>
    </div>
  </div>
  <%= join_unattended_said(@joining) %>
</section>

<section class="section">
  <div class="section-head">
    <h2 class="section-title">Could not join</h2>
  </div>

  <div class="card card-flush">
    <% if @joining.refusals.any? %>
      <div class="people-list">
        <% @joining.refusals.each do |one| %>
          <div class="line-row fat">
            <span class="grow two-line">
              <b><%= link_to one.label, fd_channel_path(one.channel_id), class: "lnk" %></b>
              <span class="mono"><%= one.channel_id %></span>
            </span>
            <span class="row-right">
              <span class="sub2"><%= one.why.presence || "refused" %></span>
              <span class="sub2 mono"><%= at_minute(one.at) %></span>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title">Nothing refused</p>
      </div>
    <% end %>
  </div>
</section>
