<% rows.each do |row| %>
  <%= link_to fd_channels_path(q: params[:q].presence, open: row.channel_id), class: "qrow",
        role: "option", aria: { selected: (open_id == row.channel_id).to_s },
        data: { pane_filter_target: "row", action: "click->pane#hide" } do %>
    <span class="qtop">
      <span class="qid">#</span>
      <span class="qby trunc"><%= row.name.presence || row.channel_id %></span>
      <% if row.private? %>
        <span class="chip chip-off">private</span>
      <% end %>
      <span class="qage"><%= row.members ? number_to_human(row.members, units: { unit: "", thousand: "k" }) : "—" %></span>
    </span>

    <span class="qmeta">
      <span class="qviol trunc">
        <% if row.quiet? %>
          nothing said yet
        <% else %>
          <%= number_with_delimiter(row.messages) %> messages
        <% end %>
      </span>
      <% if row.last_active_at %>
        <span class="qpriors">active <%= ago_label(row.last_active_at) %></span>
      <% end %>
    </span>
  <% end %>
<% end %>
<% if local_assigns[:more].present? %>
  <template data-more-next="<%= more %>"></template>
<% end %>
