<%= render layout: "fd/modal", locals: { id: "guard-channel",
      title: "Guard #{label}", label: "Guard this channel" } do %>
  <%= form_with url: fd_channel_guard_path(channel_id), method: :post,
        html: { autocomplete: "off" } do %>
    <label class="field-label">
      Why
      <%= text_field_tag :reason, nil, class: "input", id: nil,
            placeholder: "app spam after a cross-post" %>
    </label>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Turn the guard on", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
