<label class="field-label">
  What was done
  <%= select_tag :type_key, options_for_select(action_options),
        class: "select action-type", id: nil %>
</label>
<label class="field-label">
  Directed at
  <%= text_field_tag :target_user_id, target, class: "input", id: nil %>
</label>
<label class="field-label when when-expiry">
  Until when
  <%= date_field_tag :expires_on, nil, class: "input", id: nil %>
</label>
<label class="field-label when when-channel">
  Which channel
  <%= text_field_tag :channel_id, nil, class: "input", id: nil,
        placeholder: "C0266FRGV" %>
</label>
<label class="field-label">
  What it is about
  <%= select_tag :category_key,
        options_for_select([["not set", ""]] + category_options, kase.category_key),
        class: "select", id: nil %>
</label>
<label class="field-label">
  Why
  <%= text_area_tag :reason, field_was(:reason), rows: 3, class: "textarea", id: nil,
        placeholder: "what they did, and why this is the answer to it" %>
</label>
<%= field_wrong(:reason) %>
<% if flagged.any? %>
  <label class="field-label">
    Which flagged message it is about
    <%= select_tag :cites_message_id,
          options_for_select([["nothing in particular", ""]] + cite_options(flagged)),
          class: "select", id: nil %>
  </label>
<% end %>
