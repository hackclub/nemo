<label class="field-label">
  What was done
  <%= select_tag :type_key, options_for_select(action_options),
        class: "select action-type", id: nil %>
</label>
<label class="field-label">
  Directed at
  <%= text_field_tag :target_user_id, target, class: "textarea", id: nil %>
</label>
<label class="field-label when when-expiry">
  Until when
  <%= date_field_tag :expires_on, nil, class: "textarea", id: nil %>
</label>
<label class="field-label when when-channel">
  Which channel
  <%= text_field_tag :channel_id, nil, class: "textarea", id: nil,
        placeholder: "C0266FRGV" %>
</label>
