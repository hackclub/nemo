<div class="field-label" data-action-standing-target="targetFields">
  <%= render "shared/combobox", name: "target_user_id", single: true,
        url: fd_member_search_path(case_id: kase.id),
        label: "Search members", preset: preset_faces(target) %>
</div>

<div class="standing-slot" data-action-standing-target="standing">
  <%= render "standing", guards: standing, kase: kase, names: names,
        logged: guards_logged %>
</div>

<div class="fieldset" data-action-standing-target="fields" data-controller="reason-field"
     data-reason-field-categories-value="<%= Fd::InfractionCategory::NO_REASON_KEYS.to_json %>">
  <label class="field-label">
    Action
    <%= select_tag :type_key, action_select_options,
          class: "select action-type", id: nil,
          data: { action: "change->action-standing#toggleKindFields" } %>
  </label>
  <p class="deactivation-note" data-action-standing-target="deactivation" hidden></p>
  <%= render "thread_lock_pick", locks: thread_locks, kase: kase, logged: locks_logged %>
  <div class="field-label" data-action-standing-target="expiry" hidden>
    <span>End (UTC)</span>
    <span class="field-pair">
      <%= date_field_tag :expires_on, nil, class: "input", id: nil, aria: { label: "End date" } %>
      <%= time_field_tag :expires_time, nil, class: "input", id: nil, aria: { label: "End time (UTC)" } %>
    </span>
  </div>
  <div class="field-label" data-action-standing-target="channel" hidden>
    <span>Channel</span>
    <%= render "shared/combobox", kind: "channel", name: :channel_id, label: "Search channels" %>
  </div>
  <label class="field-label">
    Category
    <%= select_tag :category_key,
          options_for_select([["Not set", ""]] + category_options, kase.category_key),
          class: "select", id: nil,
          data: { reason_field_target: "category", action: "change->reason-field#toggle" } %>
  </label>
  <div class="contents" data-action-standing-target="why">
    <div data-reason-field-target="reason">
      <label class="field-label">
        Reason
        <%= text_area_tag :reason, submitted_value(:reason), rows: 3, class: "textarea", id: nil %>
      </label>
      <%= field_wrong(:reason) %>
    </div>
  </div>
  <label class="field-label" data-action-standing-target="why">
    How Was This Solved? (Text edition)
    <%= text_area_tag :solution, nil, rows: 2, class: "textarea", id: nil %>
  </label>
  <div class="field-label" data-action-standing-target="why">
    <span>Who Resolved This? (Thank you btw &lt;3)</span>
    <%= render "shared/combobox", name: "resolved_by[]", url: fd_member_search_path(case_id: kase.id),
          label: "Search members" %>
  </div>
</div>

<label class="opt">
  <%= check_box_tag :resolve_case, "1", false, class: "tick", id: nil %>
  <span>
    <span class="opt-label">Resolve Case?</span>
  </span>
</label>

<% if open_reports.positive? %>
  <label class="opt only only-resolving">
    <%= check_box_tag :notify_reporter, "1", true, class: "tick", id: nil %>
    <span>
      <span class="opt-label">Notify the reporter</span>
    </span>
  </label>
  <label class="field-label only only-resolving only-notifying">
    Message to reporter
    <%= text_area_tag :member_message, Fd::Resolution::DEFAULT_MESSAGE, rows: 3,
          class: "textarea", id: nil, maxlength: Fd::IntakeOutbox::MAX_LENGTH %>
  </label>
<% end %>
