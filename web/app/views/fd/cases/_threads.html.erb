<p class="band-label">
  The threads ·
  <%= threads.any? ? pluralize(threads.size, "attached") : "none attached" %>
</p>

<turbo-frame id="threads" target="_top" data-turbo-action="advance">
<div class="inspector">
  <div class="index-side">
    <% threads.each do |row| %>
      <%= link_to fd_case_path(kase, thread: row.id, person: params[:person]),
            class: "index-item", data: { turbo_frame: "threads" },
            aria: { current: threads.chosen?(row) ? "true" : nil } do %>
        <span class="mono"><%= row.channel_id %></span>
        <span class="chip <%= row.tone %>"><%= row.state %></span>
      <% end %>
    <% end %>
    <%= opens_modal "case.thread", opens: "attach-thread", on: kase,
          css: "index-item index-add" do %>
      <span class="index-face">+</span>
      Attach a thread
    <% end %>
  </div>

  <div class="pane">
    <% if threads.chosen.nil? %>
      <p class="card-note">No thread attached.</p>
    <% else %>
      <% row = threads.chosen %>
      <div class="thr-head">
        <span class="thr-where"><%= row.channel_id %></span>
        <% if row.locked? %>
          <span class="chip chip-warn">locked</span>
        <% end %>
        <span class="thr-end">
          <%= link_to "Open in Slack", slack_thread_url(row.channel_id, row.thread_ts),
                class: "btn", target: "_blank", rel: "noopener" %>
        </span>
      </div>

      <% if row.held.zero? %>
        <p class="thr-gone">No messages held for this thread yet.</p>
      <% else %>
        <%= render "fd/messages", messages: row.messages, kase: kase,
              flags: flags, cited_by: cited_by %>
      <% end %>

      <div class="rail-card">
        <div class="thin">
          <span><b>Attached</b> <%= member_link(row.added_by) %> · <%= last_case_label(row.added_at) %></span>
          <%= gated_button "case.thread", "Detach", fd_case_thread_path(kase, row.record),
                on: kase, css: "text-btn", method: :delete,
                form: { class: "contents", data: { turbo_frame: "_top",
                turbo_confirm: "Detach this thread?" } } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
</turbo-frame>
