<turbo-frame id="threads" target="_top" data-turbo-action="advance">
<% row = threads.chosen %>
<% marks = citation_numbers(flags) %>

<div class="panel">
  <div class="panel-head">
    <span class="segmented">
      <% threads.each do |one| %>
        <%= link_to fd_case_path(kase, tab: "evidence", thread: one.id, person: params[:person]),
              data: { turbo_frame: "threads" },
              aria: { current: (threads.chosen?(one) ? "true" : nil) } do %>
          <span><%= channel_label(one.channel_id) %></span>
          <span class="seg-count"><%= one.held %></span>
        <% end %>
      <% end %>
    </span>

    <span class="grow"></span>

    <% if row %>
      <span class="sheet-by">
        attached by <%= member_link(row.added_by) %>, <%= last_case_label(row.added_at) %>
      </span>
    <% end %>

    <% if row && flagged_count(row, flags).positive? %>
      <span class="segmented">
        <%= link_to fd_case_path(kase, tab: "evidence", thread: row.id, person: params[:person]),
              data: { turbo_frame: "threads" },
              aria: { current: ("true" unless params[:only] == "flagged") } do %>
          All <span class="seg-count"><%= row.held %></span>
        <% end %>
        <%= link_to fd_case_path(kase, tab: "evidence", thread: row.id,
              person: params[:person], only: "flagged"),
              data: { turbo_frame: "threads" },
              aria: { current: ("true" if params[:only] == "flagged") } do %>
          Flagged <span class="seg-count"><%= flagged_count(row, flags) %></span>
        <% end %>
      </span>
    <% end %>

    <%= render "thread_menu", kase: kase, row: row %>
  </div>

  <% if row.nil? %>
    <div class="empty">
      <p class="empty-title">No thread chosen</p>
      <p class="card-note">Pick one above, or attach another.</p>
    </div>
  <% else %>
    <% if row.locked? %>
      <div class="flag flag-warn flag-wide">
        <span class="flag-icon" aria-hidden="true">&#9679;</span>
        <div>
          <b>This thread is locked in Slack.</b>
          What is held here is the last copy taken. Nothing new will arrive, and the
          <%= pluralize(row.held, "message") %> below stay readable.
        </div>
      </div>
    <% end %>

    <% shown = shown_messages(row, flags, params[:only]) %>
    <% if shown.empty? && params[:only] == "flagged" %>
      <div class="sheet-none">
        <span class="grow">
          Nothing in this thread is flagged yet. Flagging marks a message so an action
          can cite it.
        </span>
        <%= link_to "Show all #{row.held}",
              fd_case_path(kase, tab: "evidence", thread: row.id, person: params[:person]),
              class: "btn", data: { turbo_frame: "threads" } %>
      </div>
    <% elsif shown.empty? %>
      <div class="empty">
        <p class="empty-title">Nothing has been copied across yet</p>
        <div class="empty-do">
          <%= link_to "Open in Slack &#8599;".html_safe,
                slack_thread_url(row.channel_id, row.thread_ts),
                class: "btn", target: "_blank", rel: "noopener" %>
        </div>
      </div>
    <% else %>
      <div class="sheet">
        <% messages_by_day(shown).each do |day, said_on| %>
          <p class="sheet-day"><%= day.strftime("%-d %B %Y") %></p>
          <% said_on.each do |said| %>
            <%= render "sheet_row", said: said, kase: kase, flags: flags,
                  cited_by: cited_by, marks: marks %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
</turbo-frame>
