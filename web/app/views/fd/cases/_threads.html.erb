<p class="band-label">
  The threads ·
  <%= threads.any? ? pluralize(threads.size, "attached") : "none attached" %>
</p>

<turbo-frame id="threads" target="_top" data-turbo-action="advance">
<div class="inspector">
  <div class="index-side">
    <% threads.each do |row| %>
      <%= link_to fd_case_path(kase, thread: row.id, person: params[:person]),
            class: "index-item", data: { turbo_frame: "threads" },
            aria: { current: threads.chosen?(row) ? "true" : nil } do %>
        <span class="mono"><%= row.channel_id %></span>
        <span class="chip <%= row.tone %>"><%= row.state %></span>
      <% end %>
    <% end %>
    <label for="attach-thread" class="index-item index-add">
      <span class="index-face">+</span>
      Attach a thread
    </label>
  </div>

  <div class="pane">
    <% if threads.chosen.nil? %>
      <p class="card-note">No thread attached.</p>
    <% else %>
      <% row = threads.chosen %>
      <div class="thr-head">
        <span class="thr-where"><%= row.channel_id %></span>
        <% if row.locked? %>
          <span class="chip chip-warn">locked</span>
        <% end %>
        <span class="thr-end">
          <%= link_to "Open in Slack", slack_thread_url(row.channel_id, row.thread_ts),
                class: "btn", target: "_blank", rel: "noopener" %>
        </span>
      </div>

      <% if row.held.zero? %>
        <p class="thr-gone">No messages held for this thread yet.</p>
      <% else %>
        <div>
          <% row.messages.each do |said| %>
            <% flag = flags[said.id] %>
            <div class="msg <%= "msg-flagged" if flag %>">
              <span class="avatar"><%= names.initial(said.author_user_id) %></span>
              <span>
                <span class="msg-who">
                  <%= member_link(said.author_user_id) %>
                  <span class="msg-at">
                    <%= said.posted_at.strftime("%-d %b %H:%M") %><%= " · edited" if said.edited? %>
                  </span>
                  <span class="msg-end">
                    <% if flag %>
                      <%= button_to "Unflag", fd_case_citation_path(kase, flag),
                            method: :delete, class: "text-btn",
                            params: { person: params[:person] },
                            form: { class: "contents", data: { turbo_frame: "threads" } } %>
                    <% else %>
                      <%= button_to "Flag", fd_case_citations_path(kase),
                            params: { thread_message_id: said.id, person: params[:person] },
                            class: "text-btn",
                            form: { class: "contents", data: { turbo_frame: "threads" } } %>
                    <% end %>
                  </span>
                </span>
                <% if said.readable? %>
                  <div class="msg-text"><%= mentioned(said.body) %></div>
                <% end %>
                <% if said.purged? %>
                  <div class="msg-flag">Erased by <%= names[said.purged_by] %>.</div>
                <% elsif said.deleted? %>
                  <div class="msg-flag">
                    Deleted in Slack <%= last_case_label(said.deleted_at) %>
                  </div>
                <% end %>
                <% cited_by[said.id]&.each do |action| %>
                  <div class="msg-flag">
                    The <%= action_label(action.type_key).downcase %> of
                    <%= action.performed_at.strftime("%-d %b %H:%M") %> cites this message
                  </div>
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="rail-card">
        <div class="thin">
          <span><b>Attached</b> <%= member_link(row.added_by) %> · <%= last_case_label(row.added_at) %></span>
          <%= button_to "Detach", fd_case_thread_path(kase, row.record),
                method: :delete, class: "text-btn",
                form: { class: "contents", data: { turbo_frame: "_top",
                turbo_confirm: "Detach this thread?" } } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
</turbo-frame>
