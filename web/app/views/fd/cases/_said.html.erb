<div id="said-<%= entry.key %>" class="msg <%= entry.side == "out" ? "out" : "in" %>"
     data-kind="<%= entry.kind %>">
  <%= face(entry.who) %>
  <div>
    <div class="msg-head">
      <span class="msg-who"><%= entry.name %></span>
      <span class="msg-at"><%= entry.at.strftime("%-d %b, %H:%M") %></span>
      <% if entry.kind == "chat" %><span class="tag">internal</span><% end %>
      <% if entry.state %><span class="tag <%= state_tone(entry.state).sub("chip-", "") %>"><%= entry.state %></span><% end %>
    </div>
    <% if entry.body.present? %>
      <p class="msg-body"><%= mentioned(entry.body) %></p>
    <% end %>
    <% if entry.shares.present? %>
      <div class="msg-cites">
        <% entry.shares.each do |cite| %>
          <figure class="cite <%= "cite-bare" unless cite.said? %>">
            <figcaption class="cite-head">
              <%= face(cite.source_author_user_id, css: "row-avatar cite-face") %>
              <span class="cite-who">
                <%= cite.source_author_user_id.present? ? handle(cite.source_author_user_id) : "somebody" %>
              </span>
              <span class="cite-how">
                <%= cite.word %><%= " from" if cite.source_channel_id.present? %>
              </span>
              <% if cite.source_channel_id.present? %>
                <%= channel_mention(cite.source_channel_id, cite.source_channel_name) %>
              <% end %>
              <% if cite.permalink.present? %>
                <%= link_to cite.permalink, class: "cite-open", target: "_blank", rel: "noopener",
                      title: "open it in Slack" do %>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14L21 3"/></svg>
                <% end %>
              <% end %>
            </figcaption>
            <% if cite.said? %>
              <blockquote class="cite-body"><%= mentioned(cite.source_body) %></blockquote>
            <% else %>
              <p class="cite-body none"><%= cite.why_not %></p>
            <% end %>
          </figure>
        <% end %>
      </div>
    <% end %>
    <% if entry.files.present? %>
      <div class="msg-files">
        <% entry.files.each do |file| %>
          <% if file.image? %>
            <%= link_to fd_file_path(file), class: "msg-shot", title: file.shown_name,
                  data: { lightbox: file.shown_name } do %>
              <%= image_tag fd_file_path(file), alt: file.shown_name, decoding: "async",
                    width: file.original_w, height: file.original_h %>
            <% end %>
          <% elsif file.kept? %>
            <%= link_to fd_file_path(file), class: "msg-file", target: "_blank", rel: "noopener" do %>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M15 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/></svg>
              <span class="trunc"><%= file.shown_name %></span>
            <% end %>
          <% else %>
            <span class="msg-file is-out">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v5h5"/><path d="M15 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/></svg>
              <span class="trunc"><%= file.shown_name %></span>
              <span class="tag off"><%= file.said %></span>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
