<%= render layout: "fd/modal", locals: { id: "add-person",
      title: "Add a subject to case #{kase.id}", label: "Add a subject to the case" } do %>
  <%= form_with url: fd_case_participants_path(kase), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <div class="field-label">
        <span>Subject</span>
        <%= render "fd/member_picker", name: "user_ids[]", single: false,
              label: "search for the subject of the case" %>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Add to the case", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>
