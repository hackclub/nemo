<% mentioned.each do |user_id| %>
  <div class="offered">
    <span class="grow rail-line">
      <%= link_to at_name(user_id), fd_member_path(user_id), class: "mention" %>
      is named in a note but is not on the case
    </span>
    <%= gated_button "case.people", "Add them", fd_case_participants_path(kase),
          on: kase, css: "btn", params: { user_ids: [user_id], role: "involved" } %>
  </div>
<% end %>
