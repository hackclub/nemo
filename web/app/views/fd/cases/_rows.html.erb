<% cases.each do |kase| %>
  <tr>
    <td class="col-tick">
      <% unless kase.resolved? %>
        <%= check_box_tag "case_ids[]", kase.id, false,
              id: "tick-#{kase.id}", form: "merge-form", class: "tick",
              data: { action: "change->merge#refresh" },
              aria: { label: "select case #{kase.id}" } %>
      <% end %>
    </td>
    <td>
      <span class="two-line">
        <%= link_to fd_case_path(kase) do %>
          <b>
            <span class="sev <%= case_severity(kase) %>"></span>
            <%= kase.subject_user_id ? "@#{kase.subject_user_id}" : "no subject set" %>
            <span class="mono">#<%= kase.id %></span>
          </b>
        <% end %>
        <span><%= subject_context_line(context[kase.subject_user_id]) %></span>
      </span>
    </td>
    <td><%= kase.category_key || "n/a" %></td>
    <td class="col-num"><%= action_counts.fetch(kase.id, 0) %></td>
    <td class="col-num"><%= case_age_chip(kase) %></td>
    <td>
      <% if kase.claimed? %>
        @<%= kase.claimed_by %>
      <% elsif kase.resolved? %>
        n/a
      <% else %>
        <%= button_to "Claim", fd_case_claim_path(kase), method: :post,
              class: "btn", form: { class: "contents" } %>
      <% end %>
    </td>
  </tr>
<% end %>
