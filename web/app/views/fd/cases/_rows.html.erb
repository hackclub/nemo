<% cases.each do |kase| %>
  <tr>
    <td class="col-tick">
      <% unless kase.resolved? %>
        <%= check_box_tag "case_ids[]", kase.id, false,
              id: "tick-#{kase.id}", form: "merge-form", class: "tick tick-case",
              data: { action: "change->merge#refresh" },
              aria: { label: "select case #{kase.id}" } %>
      <% end %>
    </td>
    <td>
      <span class="two-line">
        <%= link_to fd_case_path(kase) do %>
          <b>
            <span class="sev <%= case_severity(kase) %>"></span>
            <%= subject_handles(kase) %>
            <span class="mono">#<%= kase.id %></span>
          </b>
        <% end %>
        <span>
          <% if kase.subject_user_ids.many? %>
            <%= pluralize(kase.subject_user_ids.size, "subject") %>
          <% else %>
            <%= subject_context_line(context[kase.subject_user_id]) %>
          <% end %>
        </span>
      </span>
    </td>
    <td><%= kase.category_key || "n/a" %></td>
    <td class="col-num"><%= action_counts.fetch(kase.id, 0) %></td>
    <td class="col-num"><%= case_age_chip(kase) %></td>
    <td>
      <% if kase.assigned? %>
        <%= handle_list(kase.assignee_user_ids) %>
      <% elsif kase.resolved? %>
        n/a
      <% else %>
        <%= gated_button "case.open", "Claim", fd_case_claim_path(kase), on: kase,
              method: :post %>
      <% end %>
    </td>
  </tr>
<% end %>
