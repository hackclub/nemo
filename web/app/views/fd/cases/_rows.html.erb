<% cases.each do |kase| %>
  <tr data-controller="row-link" data-row-link-href-value="<%= fd_case_path(kase) %>"
      data-action="click->row-link#go"
      class="<%= "row-resolved" if kase.resolved? %>">
    <td>
      <div class="row-subject">
        <% unless kase.resolved? %>
          <%= check_box_tag "case_ids[]", kase.id, false,
                id: "tick-#{kase.id}", form: "merge-form", class: "tick tick-case",
                data: { action: "change->merge#refresh" },
                aria: { label: "select case #{kase.id}" } %>
        <% end %>
        <span class="sev <%= case_severity(kase) %>"></span>
        <%= row_reporter_avatar(kase) %>
        <span class="two-line">
          <%= link_to fd_case_path(kase) do %>
            <b>
              <%= row_reporter_label(kase) %>
              <span class="mono">#<%= kase.id %></span>
            </b>
          <% end %>
          <span><%= row_subtitle(kase, thread_counts) %></span>
        </span>
      </div>
    </td>
    <td><%= prior_chip(kase, prior_counts) %></td>
    <td class="col-num"><%= case_age_label(case_age_seconds(kase)) %></td>
    <td>
      <% if kase.assigned? %>
        <%= assignee_faces(kase.assignee_user_ids) %>
      <% elsif kase.resolved? %>
        n/a
      <% else %>
        <%= gated_button "case.open", "claim", fd_case_claim_path(kase), on: kase,
              method: :post %>
      <% end %>
    </td>
  </tr>
<% end %>
