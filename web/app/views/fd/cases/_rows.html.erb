<% cases.each do |kase| %>
  <tr data-controller="row-link" data-row-link-href-value="<%= fd_case_path(kase) %>"
      data-action="click->row-link#go"
      class="<%= "row-resolved" if kase.resolved? %>">
    <td class="<%= case_stripe(kase) %>">
      <div class="row-subject">
        <% unless kase.resolved? %>
          <%= check_box_tag "case_ids[]", kase.id, false,
                id: "tick-#{kase.id}", form: "merge-form", class: "tick tick-case",
                data: { action: "change->merge#refresh" },
                aria: { label: "select case #{kase.id} to merge" } %>
        <% end %>
        <span class="two-line">
          <%= link_to fd_case_path(kase) do %>
            <b>Case <%= kase.id %></b>
          <% end %>
          <% if kase.duplicate_of %>
            <span><%= row_merged_phrase(kase) %></span>
          <% end %>
          <% gist = case_gist(kase) %>
          <% if gist %>
            <%= gist %>
          <% else %>
            <span>no report on file</span>
          <% end %>
        </span>
      </div>
    </td>
    <% if violation %>
      <td class="sub2"><%= category_label(kase.category_key) %></td>
    <% end %>
    <td>
      <div class="subjcell">
        <%= row_reporter_face(kase) %>
        <span><%= row_reporter_label(kase) %></span>
      </div>
    </td>
    <td class="col-state"><%= case_status_chip(kase) %></td>
    <td>
      <% if kase.subject_user_ids.any? %>
        <% priors = case_priors(kase, priors_by_user) %>
        <div class="subjcell">
          <%= row_subject_avatar(kase) %>
          <span class="two-line">
            <b><%= row_subject_label(kase) %></b>
            <% if priors.positive? %>
              <span class="mchip warn"><%= pluralize(priors, "prior case") %></span>
            <% else %>
              <span>no priors</span>
            <% end %>
          </span>
        </div>
      <% else %>
        <span class="sub2">nobody named yet</span>
      <% end %>
    </td>
    <td>
      <% if kase.assigned? %>
        <%= assignee_faces(kase.assignee_user_ids) %>
      <% elsif kase.resolved? %>
        <span class="sub2">n/a</span>
      <% else %>
        <%= gated_button "case.open", "Claim", fd_case_claim_path(kase), on: kase,
              css: "btn btn-primary", method: :post %>
      <% end %>
    </td>
    <td class="col-num <%= age_ink(case_age_seconds(kase)) unless kase.resolved? %>">
      <%= kase.resolved? ? "resolved" : case_age_label(case_age_seconds(kase)) %>
    </td>
  </tr>
<% end %>
