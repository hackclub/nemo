<% user_id = person&.user_id %>
<div class="card">
  <div class="subject">
    <div class="subject-avatar" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
    </div>
    <div>
      <h2 class="card-title">
        <%= user_id ? handle(user_id) : "No subject set" %>
      </h2>
      <div class="mono"><%= subject_identity_line(user_id, context) %></div>
      <% if person %>
        <%= render "person_remove", kase: kase, person: person %>
      <% end %>
    </div>
  </div>

  <% if user_id %>
    <div class="subject-facts">
      <div>
        <div class="fact-label">Messages</div>
        <div class="fact-val"><%= fact_number(context&.messages_posted) %></div>
      </div>
      <div>
        <div class="fact-label">Active days</div>
        <div class="fact-val"><%= fact_number(context&.days_active) %></div>
      </div>
      <div>
        <div class="fact-label">Channels</div>
        <div class="fact-val"><%= fact_number(context&.channels_joined) %></div>
      </div>
      <div>
        <div class="fact-label">Last active</div>
        <div class="fact-val"><%= last_active_label(context&.last_active_at) %></div>
      </div>
    </div>

    <div class="subject-notes">
      <span class="fact-label">Notes on <%= names[user_id] %></span>
      <% if notes.any? %>
        <div class="notes">
          <% notes.each do |note| %>
            <div class="note-row">
              <div class="note-body"><%= mentioned(note.body) %></div>
              <div class="note-by">
                <span><%= note_byline(note) %></span>
                <%= render "note_remove", kase: kase, note: note %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <span class="note-none">No notes</span>
      <% end %>
    </div>
  <% end %>
</div>
