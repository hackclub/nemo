<p class="facts-h">Case facts</p>

<% if missing.any? %>
  <%= render "finish_off", kase: kase, missing: missing %>
<% end %>

<% if kase.duplicate_of %>
  <div class="fbox">
    <div class="ft">Folded into</div>
    <div class="fb">
      <div class="rail-line">
        Closed as a duplicate of
        <%= link_to "case #{kase.duplicate_of}", fd_case_path(kase.duplicate_of),
              class: "lnk" %>, which carries everything from here.
      </div>
    </div>
  </div>
<% end %>

<% first = reports.min_by(&:received_at) %>
<% on = threads.find(&:is_primary) || threads.first %>

<div class="fcard">
  <div class="fcard-head">
    <% if subject %>
      <div class="who">
        <%= face(subject, css: "person-face") %>
        <span class="grow two-line">
          <b><%= member_link(subject) %></b>
          <span><%= tenure_label(contexts[subject]&.tenure_days) %></span>
        </span>
      </div>
      <%= prior_chip_for(priors) %>
    <% else %>
      <div class="line-row">
        <span class="grow rail-line">Nobody identified yet</span>
        <% unless kase.resolved? %>
          <%= opens_modal "case.people", "Say who", opens: "add-person", on: kase %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="frows">
    <div class="frow">
      <span>Violation</span>
      <b class="<%= "is-none" if kase.category_key.blank? %>">
        <%= category_short(kase.category_key) %>
      </b>
    </div>
    <div class="frow">
      <span>Where</span>
      <% if on.nil? %>
        <b class="is-none">n/a</b>
      <% elsif channels.named?(on.channel_id) %>
        <b><%= channel_label(on.channel_id) %></b>
      <% else %>
        <b class="is-none">unknown</b>
      <% end %>
    </div>
    <div class="frow">
      <span>Opened</span>
      <b><%= on_day(kase.opened_at) %></b>
    </div>
    <div class="frow">
      <span>Reported by</span>
      <% if first.nil? %>
        <b class="is-none">nobody</b>
      <% elsif first.anonymous? %>
        <b>Anonymous</b>
      <% else %>
        <b><%= member_link(first.reporter_user_id) %></b>
      <% end %>
    </div>
  </div>

  <% if actions.any? %>
    <div class="acts-now">
      <p class="acts-h"><%= pluralize(actions.size, "action") %> taken</p>
      <% actions.each do |action| %>
        <div class="acts-row">
          <span class="mchip act"><%= action_label(action.type_key) %></span>
          <span class="acts-why"><%= action_reason(action) %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if subject || (!kase.resolved? && !kase.assigned?) %>
    <div class="fcard-do">
      <% if !kase.resolved? && !kase.assigned? %>
        <%= gated_button "case.open", "Claim", fd_case_claim_path(kase), on: kase,
              css: "btn btn-primary", method: :post %>
      <% end %>
      <% if subject %>
        <%= link_to "Their whole history", fd_member_path(subject), class: "btn",
              data: { turbo_frame: "person-drawer" } %>
      <% end %>
    </div>
  <% end %>
</div>
