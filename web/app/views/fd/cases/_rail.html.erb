<p class="facts-h">Case facts</p>

<% if missing.any? %>
  <%= render "finish_off", kase: kase, missing: missing, guesses: guesses %>
<% end %>

<% if kase.duplicate_of %>
  <div class="fbox">
    <div class="ft">Folded into</div>
    <div class="fb">
      <div class="rail-line">
        Closed as a duplicate of
        <%= link_to "case #{kase.duplicate_of}", fd_case_path(kase.duplicate_of),
              class: "lnk" %>, which carries everything from here.
      </div>
    </div>
  </div>
<% end %>

<div class="fbox">
  <div class="ft">Subject</div>
  <div class="fb">
    <% if subject %>
      <div class="line-row">
        <%= face(subject) %>
        <span class="grow two-line">
          <b><%= member_link(subject) %></b>
          <span><%= subject_standing(subject, contexts[subject]) %></span>
        </span>
      </div>
      <div class="sub2">
        <%= link_to "their whole history →", fd_member_path(subject),
              data: { turbo_frame: "person-drawer" } %>
      </div>
    <% else %>
      <div class="line-row">
        <span class="grow rail-line">Nobody identified yet</span>
        <% unless kase.resolved? %>
          <%= opens_modal "case.people", "Say who", opens: "add-person", on: kase %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% first = reports.min_by(&:received_at) %>
<div class="fbox">
  <div class="ft">Reported by</div>
  <div class="fb">
    <% if first.nil? %>
      <div class="line-row">
        <span class="grow rail-line">Nobody, this was opened by hand</span>
      </div>
    <% else %>
      <div class="line-row">
        <%= face(first.anonymous? ? nil : first.reporter_user_id) %>
        <span class="grow two-line">
          <b><%= first.anonymous? ? "Anonymous" : member_link(first.reporter_user_id) %></b>
          <span>
            <% unless first.anonymous? %><%= pluralize(reports.size, "report") %> · <% end %>
            <%= on_day(first.received_at) %>
          </span>
        </span>
      </div>
    <% end %>
  </div>
</div>

<% on = threads.find(&:is_primary) || threads.first %>
<div class="facts-grid">
  <div class="cell">
    <span class="fg-k">Opened</span>
    <span class="fg-v"><%= on_day(kase.opened_at) %></span>
  </div>
  <div class="cell">
    <span class="fg-k">Channel</span>
    <span class="fg-v"><%= on ? channel_label(on.channel_id) : "n/a" %></span>
  </div>
  <div class="cell">
    <span class="fg-k">Violation</span>
    <span class="fg-v"><%= category_short(kase.category_key) %></span>
  </div>
  <div class="cell">
    <span class="fg-k">Priors</span>
    <span class="fg-v"><%= priors.positive? ? priors : "n/a" %></span>
  </div>
</div>
