<% content_for :page_title, @case.id.to_s %>
<% content_for :page_face do %>
  <span class="crumb"><%= link_to "Cases", fd_cases_path %> /</span>
<% end %>
<% content_for :palette_on, "case:#{@case.id}" %>
<% content_for :page_subtitle do %>
  <%= case_head_meta(@case, @reports) %>
<% end %>
<% content_for :page_badge do %>
  <%= case_status_chip(@case) %>
  <% if @case.category_key %>
    <span class="chip chip-off"><%= category_short(@case.category_key) %></span>
  <% end %>
  <% if @unfinished %>
    <span class="chip chip-warn">nothing set yet</span>
  <% end %>
  <%= followed_chip(@case) unless @case.resolved? %>
  <% if @case.duplicate_of %>
    <%= link_to "duplicate of case #{@case.duplicate_of}", fd_case_path(@case.duplicate_of),
          class: "chip chip-off" %>
  <% end %>
<% end %>
<% content_for :head_actions do %>
  <% if @case.resolved? %>
    <%= gated_button "case.reopen", "Reopen", fd_case_resolution_path(@case), on: @case,
          method: :delete, form: { class: "contents", data: { turbo_confirm:
            "Reopen case #{@case.id}? It goes back in the queue." } } %>
  <% else %>
    <% if @case.assigned? %>
      <%= opens_modal "case.resolve", "Resolve", opens: "resolve-case", on: @case,
            css: "btn btn-primary" %>
    <% else %>
      <%= gated_button "case.open", "Claim", fd_case_claim_path(@case), on: @case,
            css: "btn btn-primary", method: :post %>
    <% end %>

    <% if @merge_into %>
      <%= link_to "Merge", fd_case_merge_path(@case, into: @merge_into.id), class: "btn" %>
    <% end %>
  <% end %>

  <button type="button" class="btn" data-action="click->case-timeline#open">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h13M3 12h9M3 19h13"/><circle cx="20" cy="5" r="1.6"/><circle cx="16" cy="12" r="1.6"/><circle cx="20" cy="19" r="1.6"/></svg>
    Timeline
  </button>

  <details class="menu">
    <summary class="btn" aria-label="More actions">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
    </summary>
    <div class="menu-pop">
      <%= opens_modal "case.note", "Add a note", opens: "add-note" %>
      <%= opens_modal "case.act", "Log an action", opens: "log-action", on: @case %>
      <% if @decisions.any? %>
        <%= opens_modal "decision.link", "Link a decision", opens: "follow-decision" %>
      <% end %>
      <% unless @case.resolved? %>
        <div class="menu-sep"></div>
        <% if @case.assigned_to?(current_staff.user_id) %>
          <%= gated_button "case.open", "Put it back in the queue", fd_case_claim_path(@case),
                on: @case, method: :delete %>
        <% elsif !@case.assigned? %>
          <%= opens_modal "case.resolve", "Resolve without claiming", opens: "resolve-case",
                on: @case %>
        <% end %>
      <% end %>
    </div>
  </details>
<% end %>

<div class="stack">
  <% if @case.resolved? %>
    <div class="closed">
      <span class="closed-what">
        Closed <%= @case.resolved_at.strftime("%-d %b") %> ·
        <%= resolution_label(@case.resolution).downcase %>
      </span>
      <% if @case.member_note.present? %>
        <span class="closed-why"><%= @case.member_note %></span>
      <% end %>
      <%= followed_chip(@case) %>
      <span class="closed-end">
        <% if @case.assigned? %>
          <span class="faces"><%= assignee_faces(@case.assignee_user_ids) %></span>
        <% end %>
        <%= told_chip(@reports, @open_reports) %>
      </span>
    </div>
  <% end %>

  <%= render "fd/flagstrip", flags: @flags %>

  <% kept_tabs, demoted_tabs = case_tab_groups(@tab_counts) %>
  <div class="views">
    <% kept_tabs.each do |tab| %>
      <%= link_to fd_case_path(@case, tab: tab[:key]), class: "view",
            aria: { current: ("true" if tab[:key] == @tab) } do %>
        <%= tab[:label] %>
        <% if tab[:count] %><span class="view-count"><%= tab[:count] %></span><% end %>
      <% end %>
    <% end %>
    <% if demoted_tabs.any? %><span class="views-fill"></span><% end %>
    <% demoted_tabs.each do |tab| %>
      <%= link_to fd_case_path(@case, tab: tab[:key]), class: "view view-off",
            aria: { current: ("true" if tab[:key] == @tab) } do %>
        <%= tab[:label] %>
        <span class="view-count"><%= tab[:count] %></span>
      <% end %>
    <% end %>
  </div>

  <div class="cols c-2">
    <div>
  <% if @tab == "report" %>
    <div class="card card-chat">
      <%= render "chat", kase: @case, reports: @reports, chat: @chat, earlier: @earlier_chat,
            messages: @conversation_said, queued: @queued %>
    </div>
  <% end %>

  <% if @tab == "people" %>
    <%= render "people", kase: @case, people: @people, contexts: @context,
          notes: @standing_notes, mentioned: @mentioned, priors: @person_priors,
          said_counts: @said_counts, total_messages: @thread_messages.size %>
  <% end %>

  <% if @tab == "evidence" %>
    <%= render "threads", kase: @case, threads: @thread_list,
          flags: @citations, cited_by: @cited_by %>
  <% end %>

  <% if @tab == "actions" %>
    <% if @actions.any? %>
      <% @actions.each do |action| %>
        <div class="card">
          <div class="line-row line-first">
            <span class="chip <%= action_tone(action) %>"><%= action_label(action.type_key).downcase %></span>
            <span class="grow"><%= action_line(action, @case) %></span>
            <%= action_state_chip(action) %>
            <% unless action.reversed? %>
              <%= opens_modal "case.reverse", "Reverse", opens: "reverse-#{action.id}",
                    on: @case, css: "text-btn" %>
            <% end %>
          </div>

          <% cited = @cited_messages[action.cites_message_id] if action.cites? %>
          <% if cited %>
            <div class="said said-cite">
              <div class="msg-text"><%= cited.readable? ? cited.body : "no text held" %></div>
              <div class="sub2">
                the message it cites · <%= member_link(cited.author_user_id) %> ·
                <%= channel_label(cited.channel_id) %> ·
                <%= cited.posted_at.strftime("%-d %b %H:%M") %>
              </div>
            </div>
          <% end %>

          <div class="sub2"><%= action_standing_line(action, @case) %></div>
        </div>
      <% end %>
    <% else %>
      <div class="card">
        <p class="card-note">Nothing has been done yet.</p>
      </div>
    <% end %>
  <% end %>

  <% if @tab == "notes" %>
    <div class="card notes-card">
      <div class="notes-head">
        <span class="lbl grow">What the team said to itself</span>
        <%= opens_modal "case.note", "Add a note", opens: "add-note" %>
      </div>

      <% if @notes.any? %>
        <div class="notes">
          <% @notes.each do |note| %>
            <div class="note-row">
              <%= face(note.author) %>
              <div class="note-main">
                <div class="note-body"><%= mentioned(note.body) %></div>
                <div class="note-by">
                  <span><%= note_byline(note) %></span>
                  <%= render "note_remove", kase: @case, note: note %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="notes-none">No notes yet. They stay internal, and nobody outside FD sees them.</p>
      <% end %>
    </div>
  <% end %>
    </div>

    <div>
      <%= render "rail", kase: @case, subject: @subject, priors: @subject_priors,
            contexts: @context, unfinished: @unfinished, guesses: @guesses %>
    </div>
  </div>
</div>

<% @live_actions.each do |action| %>
  <%= render layout: "fd/modal", locals: { id: "reverse-#{action.id}",
        title: "Reverse this action", sub: action_option_label(action) } do %>
    <%= form_with url: fd_case_reversals_path(@case), method: :post, html: { autocomplete: "off" } do %>
      <%= hidden_field_tag :action_id, action.id, id: nil %>
      <div class="modal-body">
        <label class="field-label">
          Why
          <%= text_area_tag :reversal_reason, nil, rows: 3, class: "textarea", id: nil,
                maxlength: Fd::ReversalsController::MAX_REASON %>
        </label>
      </div>
      <div class="modal-foot">
        <label for="reverse-<%= action.id %>" class="btn">Close</label>
        <%= submit_tag "Reverse it", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "log-action", title: "Log an action",
      open: params[:do] == "action" } do %>
  <%= form_with url: fd_case_actions_path(@case), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <%= render "action_fields", kase: @case, flagged: @flagged_messages,
              target: @people.chosen&.user_id || lone_subject(@case) %>

      <% standing = @live_actions.reject(&:expired?).max_by(&:performed_at) %>
      <% if standing %>
        <div class="flag flag-mid">
          <span class="flag-icon" aria-hidden="true">◆</span>
          <div><b><%= names[standing.target_user_id] %> already has a
            <%= action_label(standing.type_key).downcase %> from
            <%= standing.performed_at.strftime("%-d %b") %> that still stands.</b></div>
        </div>
      <% end %>

      <%= render "what_this_does",
            lines: action_consequences(@case, @people.chosen&.user_id || lone_subject(@case)) %>
    </div>
    <div class="modal-foot">
      <label for="log-action" class="btn">Close</label>
      <%= submit_tag "Log it", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "attach-thread", title: "Attach a thread",
      open: params[:do] == "thread" } do %>
  <%= form_with url: fd_case_threads_path(@case), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <label class="field-label">
        Slack link
        <%= text_field_tag :link, nil, class: "textarea", id: nil,
              placeholder: "https://hackclub.slack.com/archives/C0266FRGV/p1754487721123456" %>
      </label>
      <div class="field-label">
        <span>What that thread is</span>
        <div class="segmented seg-radio">
          <label>
            <%= radio_button_tag :kind, "evidence", true, id: nil %>
            Evidence
          </label>
          <label>
            <%= radio_button_tag :kind, "internal", false, id: nil %>
            Internal discussion
          </label>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <label for="attach-thread" class="btn">Close</label>
      <%= submit_tag "Attach", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "set-category",
      title: "What kind of thing is case #{@case.id}?" } do %>
  <%= form_with url: fd_case_path(@case), method: :patch, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <div class="outcomes">
        <% Fd::Case::CATEGORIES.each_with_index do |key, i| %>
          <label class="opt">
            <%= radio_button_tag :category_key, key, i.zero? %>
            <span class="opt-dot" aria-hidden="true"></span>
            <span><span class="opt-label"><%= category_label(key) %></span></span>
          </label>
        <% end %>
      </div>
    </div>
    <div class="modal-foot">
      <label for="set-category" class="btn">Close</label>
      <%= submit_tag "Set it", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= render "add_person_modal", kase: @case %>
<% if @decisions.any? %>
  <%= render "follow_decision_modal", kase: @case, decisions: @decisions %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "add-note", title: "Add a note",
      sub: "internal", open: params[:do] == "note" } do %>
  <%= form_with url: fd_case_notes_path(@case), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <div class="outcomes">
        <label class="opt">
          <%= radio_button_tag :about, "case", true %>
          <span class="opt-dot" aria-hidden="true"></span>
          <span>
            <span class="opt-label">About this case</span>
          </span>
        </label>
        <% @case.subjects.each do |person| %>
          <label class="opt">
            <%= radio_button_tag :about, person.user_id, false %>
            <span class="opt-dot" aria-hidden="true"></span>
            <span>
              <span class="opt-label">About <%= names[person.user_id] %></span>
            </span>
          </label>
        <% end %>
      </div>
      <label class="field-label">
        The note
        <%= render "fd/mention_field", name: :body, value: nil, rows: 4,
              placeholder: "meow" %>
      </label>
    </div>
    <div class="modal-foot">
      <label for="add-note" class="btn">Close</label>
      <%= submit_tag "Save the note", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<% unless @case.resolved? %>
<%= render layout: "fd/modal", locals: { id: "resolve-case",
      title: "Resolve case #{@case.id}", label: "Resolve this case",
      open: params[:do] == "resolve",
      sub: @case.assigned? ? "assigned to #{@case.assignee_handles}" : "not assigned to anybody" } do %>
      <%= form_with url: fd_case_resolution_path(@case), method: :post, html: { autocomplete: "off" } do %>
        <div class="modal-body">
          <% if @live_actions.any? %>
            <div class="field-label">
              <span>Why it is closing</span>
              <div class="said"><%= closing_because(@live_actions) %></div>
            </div>
          <% else %>
            <label class="field-label">
              Why it is closing
              <%= select_tag :close_reason,
                    options_for_select(close_reason_options), class: "select" %>
            </label>
          <% end %>

          <label class="field-label">
            Summary
            <%= text_area_tag :member_note, nil, rows: 2, class: "textarea" %>
          </label>

          <% if @open_reports.positive? %>
            <label class="opt">
              <%= check_box_tag :tell_reporter, "1", true %>
              <span class="opt-box" aria-hidden="true"></span>
              <span>
                <span class="opt-label">Notify the reporter</span>
              </span>
            </label>
            <label class="field-label only only-telling">
              What they are told
              <%= text_area_tag :member_message, Fd::Resolution::TOLD, rows: 3,
                    class: "textarea", maxlength: Fd::IntakeOutbox::MAX_LENGTH %>
            </label>
          <% end %>

          <% if @merge_into %>
            <div class="flag flag-mid">
              <span class="flag-icon" aria-hidden="true">◆</span>
              <div><b>#<%= @merge_into.id %> is <%= merge_reason(@case, @merge_into) %> and still open.</b>
                Merging first would resolve both together.</div>
            </div>
          <% end %>
        </div>
        <div class="modal-foot">
          <label for="resolve-case" class="btn">Close</label>
          <%= submit_tag "Resolve", class: "btn btn-primary" %>
        </div>
      <% end %>
<% end %>
<% end %>

<aside class="drawer" aria-label="Timeline" data-case-timeline-target="panel">
  <div class="drawer-head">
    <h2>Timeline · case <%= @case.id %></h2>
    <span class="chip chip-off"><%= pluralize(@timeline.size, "entry") %></span>
    <button type="button" class="drawer-shut" data-action="click->case-timeline#close">
      <span class="kbd">esc</span>
    </button>
  </div>
  <div class="drawer-body">
    <% if @timeline.any? %>
      <div class="chiprow tl-filter">
        <%= radio_button_tag :tl, "all", true, class: "tl-pick", id: "tl-all" %>
        <label for="tl-all" class="filt">everything</label>
        <%= radio_button_tag :tl, "changed", false, class: "tl-pick", id: "tl-changed" %>
        <label for="tl-changed" class="filt">what changed</label>
      </div>
      <div class="timeline">
        <% @timeline.each do |entry| %>
          <div class="tl-item tl-<%= entry.mark %>">
            <div class="tl-when">
              <%= entry.at.strftime("%-d %b") %><br><%= entry.at.strftime("%H:%M") %>
            </div>
            <div class="tl-what">
              <div class="tl-head">
                <span class="tl-title"><%= entry.title %></span>
                <% if entry.mark %>
                  <span class="tl-mark tl-mark-<%= entry.mark %>"><%= entry.mark %></span>
                <% end %>
                <% entry.chips.each do |chip| %>
                  <span class="chip chip-off"><%= chip %></span>
                <% end %>
              </div>
              <% if entry.detail.present? %>
                <div class="tl-detail"><%= entry.detail %></div>
              <% end %>
              <% if entry.said.present? %>
                <div class="said"><%= mentioned(entry.said) %></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="card-note">Nothing recorded yet.</p>
    <% end %>
    <div class="tl-open"><%= timeline_standing(@case, @timeline) %></div>
  </div>
</aside>
