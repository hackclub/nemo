<% content_for :page_title, "Case #{@case.id}" %>
<% content_for :page_subtitle do %>
  <%= case_head_meta(@case, @reports) %>
<% end %>
<% content_for :page_badge do %>
  <%= case_status_chip(@case) %>
<% end %>
<% content_for :head_actions do %>
  <% unless @case.resolved? %>
    <% if @case.assigned? %>
      <label for="resolve-case" class="btn btn-primary">Resolve</label>
    <% else %>
      <%= button_to "Claim", fd_case_claim_path(@case), method: :post,
            class: "btn btn-primary", form: { class: "contents" } %>
    <% end %>
  <% end %>

  <label for="case-timeline" class="btn drawer-open">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h13M3 12h9M3 19h13"/><circle cx="20" cy="5" r="1.6"/><circle cx="16" cy="12" r="1.6"/><circle cx="20" cy="19" r="1.6"/></svg>
    Timeline
  </label>

  <details class="menu">
    <summary class="btn" aria-label="More actions">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
    </summary>
    <div class="menu-pop">
      <label for="add-note" class="btn">Add a note</label>
      <label for="log-action" class="btn">Log an action</label>
      <% unless @case.resolved? %>
        <div class="menu-sep"></div>
        <% if @case.assigned_to?(current_staff.user_id) %>
          <%= button_to "Put it back in the queue", fd_case_claim_path(@case),
                method: :delete, class: "btn", form: { class: "contents" } %>
        <% elsif !@case.assigned? %>
          <label for="resolve-case" class="btn">Resolve without claiming</label>
        <% end %>
      <% end %>
    </div>
  </details>
<% end %>

<div class="stack">
  <% if @case.subjects.any? %>
    <% @case.subjects.each do |person| %>
      <%= render "subject_card", kase: @case, person: person,
            context: @context[person.user_id],
            notes: @standing_notes.fetch(person.user_id, []) %>
    <% end %>
  <% else %>
    <%= render "subject_card", kase: @case, person: nil, context: nil, notes: [] %>
  <% end %>

  <div class="card">
    <div class="card-head">
      <div>
        <h2 class="card-title">Notes</h2>
        <p class="card-sub">internal</p>
      </div>
      <div class="card-tools">
        <label for="add-note" class="btn">Add a note</label>
      </div>
    </div>

    <% if @notes.any? %>
      <div class="notes">
        <% @notes.each do |note| %>
          <div class="note-row">
            <div class="note-body"><%= mentioned(note.body) %></div>
            <div class="note-by">
              <span><%= note_byline(note) %></span>
              <%= render "note_remove", kase: @case, note: note %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <span class="note-none">No notes</span>
    <% end %>
  </div>

  <% if @case.resolved? %>
    <div class="card card-flush">
      <table class="data-table">
        <tbody>
          <tr>
            <td>Resolved</td>
            <td>
              <%= @case.resolved_at.strftime("%b %-d, %Y") %>
              as <%= @case.resolution.tr("_", " ") %>
            </td>
          </tr>
          <% if @case.duplicate_of %>
            <tr>
              <td>Duplicate of</td>
              <td><%= link_to "case #{@case.duplicate_of}", fd_case_path(@case.duplicate_of) %></td>
            </tr>
          <% end %>
          <tr>
            <td>Reason recorded</td>
            <td><%= @case.member_note || "n/a" %></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">What was done</h2>
        <p class="card-sub"><%= pluralize(@actions.size, "action") %>, oldest first</p>
      </div>
    </div>
    <% if @actions.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Action</th>
              <th>Directed at</th>
              <th>Decided by</th>
              <th class="col-date">When</th>
              <th>State</th>
            </tr>
          </thead>
          <tbody>
            <% @actions.each do |action| %>
              <tr>
                <td>
                  <span class="two-line">
                    <b><%= action_label(action.type_key) %></b>
                    <span>
                      <% detail = action_detail_note(action) %>
                      <%= detail %>
                      <% unless action.reversed? %>
                        <%= "·" if detail %>
                        <label for="reverse-<%= action.id %>" class="text-btn">Reverse</label>
                      <% end %>
                    </span>
                  </span>
                </td>
                <td>
                  <span class="two-line">
                    <b><%= handle(action.target_user_id) %></b>
                    <span><%= action_target_note(action, @case) %></span>
                  </span>
                </td>
                <td>
                  <span class="two-line">
                    <b><%= handle(action.decided_by) %></b>
                    <span><%= action_performer_note(action) %></span>
                  </span>
                </td>
                <td class="col-date"><%= action.performed_at.strftime("%b %-d, %Y") %></td>
                <td><%= action_state_chip(action) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">
        Nothing has been done yet.
      </p>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">How this arrived</h2>
        <p class="card-sub"><%= reports_summary(@reports) %></p>
      </div>
    </div>
    <% if @reports.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Reporter</th>
              <th class="col-date">Received</th>
              <th>First reply</th>
              <th>Told the outcome</th>
              <th>What they wrote</th>
            </tr>
          </thead>
          <tbody>
            <% @reports.each do |report| %>
              <tr>
                <td>
                  <span class="two-line">
                    <b><%= report.reporter_label %></b>
                    <span>via <%= report.source_app %></span>
                  </span>
                </td>
                <td class="col-date"><%= report.received_at.strftime("%b %-d, %Y") %></td>
                <td>
                  <% if report.replied? %>
                    <%= reply_latency_label(report) %>
                  <% else %>
                    <span class="chip chip-crit">no reply yet</span>
                  <% end %>
                </td>
                <td><%= report.told_of_outcome? ? "yes" : "not yet" %></td>
                <td><%= report.body.present? ? mentioned(report.body) : "n/a" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">No report.</p>
    <% end %>
  </div>

  <div class="grid-2-1">
    <div class="card card-flush">
      <div class="card-head">
        <div>
          <h2 class="card-title">Threads</h2>
        </div>
        <div class="card-tools">
          <label for="attach-thread" class="btn">Attach a thread</label>
        </div>
      </div>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Channel</th>
              <th>Thread</th>
              <th>Added by</th>
            </tr>
          </thead>
          <tbody>
            <% @threads.each do |thread| %>
              <tr>
                <td>
                  <span class="two-line">
                    <b><%= thread.channel_id %></b>
                    <span><%= thread_kind_note(thread) %></span>
                  </span>
                </td>
                <td>
                  <%= link_to "open in Slack",
                        slack_thread_url(thread.channel_id, thread.thread_ts),
                        target: "_blank", rel: "noopener" %>
                </td>
                <td>
                  <span class="two-line">
                    <b><%= handle(thread.added_by) %></b>
                    <span>
                      <%= button_to "Detach", fd_case_thread_path(@case, thread),
                            method: :delete, class: "text-btn",
                            form: { class: "contents", data: { turbo_confirm:
                              "Detach this thread? The trail keeps which one it was." } } %>
                    </span>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="stack">
      <div class="card" id="who-else">
        <div class="card-head">
          <div>
            <h2 class="card-title">Who else is logged</h2>
          </div>
          <div class="card-tools">
            <label for="add-person" class="btn">Add</label>
          </div>
        </div>
        <% if @others.any? %>
          <div class="who">
            <% @others.each do |person| %>
              <div class="who-row">
                <span class="avatar" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                </span>
                <% note = person_note(person, @context[person.user_id]) %>
                <span>
                  <span class="who-name"><%= handle(person.user_id) %></span>
                  <% if note %>
                    <br><span class="who-note"><%= note %></span>
                  <% end %>
                </span>
                <span class="chip <%= role_tone(person.role) %>"><%= role_label(person.role) %></span>
                <%= render "person_remove", kase: @case, person: person %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="card-note">n/a</p>
        <% end %>
        <%= render "mentioned", kase: @case, mentioned: @mentioned %>
      </div>

      <div class="card card-flush">
        <div class="card-head">
          <div>
            <h2 class="card-title">Duplicate Cases</h2>
          </div>
        </div>
        <% if @siblings.any? %>
          <table class="data-table">
            <tbody>
              <% @siblings.each do |sibling| %>
                <tr>
                  <td>
                    <span class="two-line">
                      <%= link_to fd_case_path(sibling) do %>
                        <b>Case <%= sibling.id %></b>
                      <% end %>
                      <span><%= subject_handles(sibling) %></span>
                    </span>
                  </td>
                  <td><%= case_status_chip(sibling) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="card-note">n/a</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% @live_actions.each do |action| %>
  <div class="modal-host">
    <input type="checkbox" id="reverse-<%= action.id %>" class="modal-flip">
    <label for="reverse-<%= action.id %>" class="modal-veil" aria-hidden="true"></label>
    <div class="modal-wrap">
      <div class="modal" role="dialog" aria-label="Reverse this action">
        <div class="modal-head">
          <h2 class="modal-title">Reverse this action</h2>
          <span class="modal-sub"><%= action_option_label(action) %></span>
        </div>
        <%= form_with url: fd_case_reversals_path(@case), method: :post do %>
          <%= hidden_field_tag :action_id, action.id, id: nil %>
          <div class="modal-body">
            <label class="field-label">
              Why
              <%= text_area_tag :reversal_reason, nil, rows: 3, class: "textarea", id: nil,
                    maxlength: Fd::ReversalsController::MAX_REASON %>
            </label>
          </div>
          <div class="modal-foot">
            <label for="reverse-<%= action.id %>" class="btn">Close</label>
            <%= submit_tag "Reverse it", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="modal-host">
  <input type="checkbox" id="log-action" class="modal-flip">
  <label for="log-action" class="modal-veil" aria-hidden="true"></label>
  <div class="modal-wrap">
    <div class="modal" role="dialog" aria-label="Log an action">
      <div class="modal-head">
        <h2 class="modal-title">Log an action</h2>
      </div>
      <%= form_with url: fd_case_actions_path(@case), method: :post do %>
        <div class="modal-body">
          <%= render "action_fields", kase: @case %>
        </div>
        <div class="modal-foot">
          <label for="log-action" class="btn">Close</label>
          <%= submit_tag "Log it", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="modal-host">
  <input type="checkbox" id="attach-thread" class="modal-flip">
  <label for="attach-thread" class="modal-veil" aria-hidden="true"></label>
  <div class="modal-wrap">
    <div class="modal" role="dialog" aria-label="Attach a thread">
      <div class="modal-head">
        <h2 class="modal-title">Attach a thread</h2>
      </div>
      <%= form_with url: fd_case_threads_path(@case), method: :post do %>
        <div class="modal-body">
          <label class="field-label">
            Slack link
            <%= text_field_tag :link, nil, class: "textarea", id: nil,
                  placeholder: "https://hackclub.slack.com/archives/C0266FRGV/p1754487721123456" %>
          </label>
          <div class="field-label">
            <span>What that thread is</span>
            <div class="segmented seg-radio">
              <label>
                <%= radio_button_tag :kind, "evidence", true, id: nil %>
                Evidence
              </label>
              <label>
                <%= radio_button_tag :kind, "internal", false, id: nil %>
                Internal discussion
              </label>
            </div>
          </div>
        </div>
        <div class="modal-foot">
          <label for="attach-thread" class="btn">Close</label>
          <%= submit_tag "Attach", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render "add_person_modal", kase: @case %>

<div class="modal-host">
  <input type="checkbox" id="add-note" class="modal-flip">
  <label for="add-note" class="modal-veil" aria-hidden="true"></label>
  <div class="modal-wrap">
    <div class="modal" role="dialog" aria-label="Add a note">
      <div class="modal-head">
        <h2 class="modal-title">Add a note</h2>
        <span class="modal-sub">internal</span>
      </div>
      <%= form_with url: fd_case_notes_path(@case), method: :post do %>
        <div class="modal-body">
          <div class="outcomes">
            <label class="opt">
              <%= radio_button_tag :about, "case", true %>
              <span class="opt-dot" aria-hidden="true"></span>
              <span>
                <span class="opt-label">About this case</span>
              </span>
            </label>
            <% @case.subjects.each do |person| %>
              <label class="opt">
                <%= radio_button_tag :about, person.user_id, false %>
                <span class="opt-dot" aria-hidden="true"></span>
                <span>
                  <span class="opt-label">About <%= names[person.user_id] %></span>
                </span>
              </label>
            <% end %>
          </div>
          <label class="field-label">
            The note
            <%= render "fd/mention_field", name: :body, value: nil, rows: 4,
                  placeholder: "meow" %>
          </label>
        </div>
        <div class="modal-foot">
          <label for="add-note" class="btn">Close</label>
          <%= submit_tag "Save the note", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% unless @case.resolved? %>
<div class="modal-host">
  <input type="checkbox" id="resolve-case" class="modal-flip">
  <label for="resolve-case" class="modal-veil" aria-hidden="true"></label>
  <div class="modal-wrap">
    <div class="modal" role="dialog" aria-label="Resolve this case">
      <div class="modal-head">
        <h2 class="modal-title">Resolve case <%= @case.id %></h2>
        <span class="modal-sub">
          <%= @case.assigned? ? "assigned to #{@case.assignee_handles}" : "not assigned to anybody" %>
        </span>
      </div>
      <%= form_with url: fd_case_resolution_path(@case), method: :post do %>
        <div class="modal-body">
          <div class="outcomes">
            <label class="opt">
              <%= radio_button_tag :outcome, "report", true %>
              <span class="opt-dot" aria-hidden="true"></span>
              <span>
                <span class="opt-label">File a report</span>
                <span class="opt-note">Something was done about it.</span>
              </span>
            </label>
            <label class="opt">
              <%= radio_button_tag :outcome, "close", false %>
              <span class="opt-dot" aria-hidden="true"></span>
              <span>
                <span class="opt-label">Close it</span>
                <span class="opt-note">Nothing to act on, or not ours to act on.</span>
              </span>
            </label>
            <label class="opt">
              <%= radio_button_tag :outcome, "duplicate", false %>
              <span class="opt-dot" aria-hidden="true"></span>
              <span>
                <span class="opt-label">Duplicate</span>
                <span class="opt-note">Already being handled as another case.</span>
              </span>
            </label>
          </div>

          <div class="only only-report">
            <%= render "action_fields", kase: @case %>
          </div>

          <div class="only only-close">
            <label class="field-label">
              Why
              <%= select_tag :close_reason,
                    options_for_select(close_reason_options), class: "select" %>
            </label>
          </div>

          <div class="only only-duplicate">
            <% if @duplicate_candidates.any? %>
              <label class="field-label">
                Duplicate of which case
                <%= select_tag :duplicate_of,
                      options_for_select(case_options(@duplicate_candidates)),
                      include_blank: "pick the case this duplicates", class: "select" %>
             </label>
            <% else %>
              <span class="opt-note">There is no other case this could duplicate.</span>
            <% end %>
          </div>

          <label class="field-label unless-duplicate">
            Reason
            <%= text_area_tag :member_note, nil, rows: 3, class: "textarea" %>
          </label>
        </div>
        <div class="modal-foot">
          <label for="resolve-case" class="btn">Close</label>
          <%= submit_tag "Resolve", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<input type="checkbox" id="case-timeline" class="drawer-flip">
<label for="case-timeline" class="drawer-veil" aria-hidden="true"></label>

<aside class="drawer" aria-label="Timeline">
  <div class="drawer-head">
    <h2>Timeline</h2>
    <label for="case-timeline" class="drawer-shut">Close</label>
  </div>
  <div class="drawer-body">
    <% if @timeline.any? %>
      <div class="timeline">
        <% @timeline.each do |entry| %>
          <div class="tl-item">
            <div class="tl-when">
              <%= entry.at.strftime("%-d %b") %><br><%= entry.at.strftime("%H:%M") %>
            </div>
            <div class="tl-what">
              <div class="tl-head">
                <span class="tl-title"><%= entry.title %></span>
                <% if entry.mark %>
                  <span class="tl-mark tl-mark-<%= entry.mark %>"><%= entry.mark %></span>
                <% end %>
                <% entry.chips.each do |chip| %>
                  <span class="chip chip-off"><%= chip %></span>
                <% end %>
              </div>
              <% if entry.detail.present? %>
                <div class="tl-detail"><%= entry.detail %></div>
              <% end %>
              <% if entry.said.present? %>
                <div class="said"><%= mentioned(entry.said) %></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="card-note">Nothing recorded yet.</p>
    <% end %>
    <div class="tl-open"><%= timeline_standing(@case, @timeline) %></div>
  </div>
</aside>
