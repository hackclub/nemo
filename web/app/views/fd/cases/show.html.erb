<% content_for :page_title, violations_label(@case.violations, short: true) || "No category" %>
<% content_for :page_face do %>
  <span class="triad-id">#<%= @case.id %></span>
<% end %>
<% content_for :head_context do %>
  <span class="queue-age <%= age_class(case_age_seconds(@case)) unless @case.resolved? %>">
    <%= @case.resolved? ? "closed" : case_age_label(case_age_seconds(@case)) %>
  </span>
  <% if @case.subject_user_ids.any? %>
    <span class="triad-who"><%= subject_faces(@case) %></span>
  <% end %>
<% end %>
<% content_for :palette_on, "case:#{@case.id}" %>
<% content_for :flush, true %>
<% content_for :pane do %>
  <%= render "pane", cases: @pane_cases, views: @pane_views, query: @pane_query,
        priors_by_user: @pane_priors, violations: @pane_violations, open_id: @case.id,
        reachable: @pane_reachable_report_ids %>
<% end %>

<% content_for :head_actions do %>
  <% if @case.assigned? %>
    <span class="avatar-stack"><%= safe_join(@case.assignee_user_ids.map { |id| slack_face(id) }) %></span>
  <% end %>

  <% if @case.resolved? %>
    <%= gated_button "case.reopen", case_action_button("history", "Reopen"),
          fd_case_resolution_path(@case), on: @case,
          method: :delete, form: { class: "contents", data: { turbo_confirm:
            "Reopen case #{@case.id}?" } } %>
  <% else %>
    <% unless @case.assigned_to?(current_account.user_id) %>
      <%= gated_button "case.open", case_action_button("shield", "Claim", shortcut: "c"),
            fd_case_claim_path(@case), on: @case, css: "btn btn-primary", method: :post,
            data: { shortcut: "c" } %>
    <% end %>
    <%= opens_modal "case.act", case_action_button("gauge", "Log an action", shortcut: "a"),
          opens: "log-action", on: @case, data: { shortcut: "a" } %>
    <% if @case.assigned? %>
      <%= opens_modal "case.resolve", case_action_button("resolve", "Resolve", shortcut: "r"),
            opens: "resolve-case", on: @case, data: { shortcut: "r" } %>
    <% end %>
  <% end %>

  <%= render layout: "shared/dropdown", locals: {
        label: "More actions", trigger: menu_dots } do %>
      <% unless @case.resolved? %>
        <%= opens_modal "case.people", menu_item("category", "Set category"),
              opens: "set-category", on: @case %>
        <p class="menu-group">Assignees</p>
        <% if @case.assigned_to?(current_account.user_id) %>
          <%= gated_button "case.open", menu_item("hand", "Unclaim"),
                fd_case_claim_path(@case), on: @case, method: :delete %>
        <% elsif @case.assigned? %>
          <%= gated_button "case.open", menu_item("join", "Assign me"),
                fd_case_claim_path(@case), on: @case, method: :post %>
        <% end %>
        <% @case.assignees.oldest_first.each do |row| %>
          <% next if row.user_id == current_account.user_id %>
          <%= gated_button "case.open", menu_item("hand", "Unassign @#{row.user_id}"),
                fd_case_assignee_path(@case, row.user_id), on: @case, method: :delete,
                form: { class: "contents", data: { turbo_confirm:
                  "Unassign @#{row.user_id} from case #{@case.id}?" } } %>
        <% end %>
        <%= opens_modal "case.open", menu_item("join", "Assign member"),
              opens: "assign-case", on: @case %>

        <p class="menu-group">Close</p>
        <%= opens_modal "case.resolve", menu_item("merge", "Merge into another case"),
              opens: "merge-case", on: @case %>
        <% unless @case.assigned? %>
          <%= opens_modal "case.resolve", menu_item("resolve", "Resolve without claiming"),
                opens: "resolve-case", on: @case %>
        <% end %>
      <% end %>
      <% if @case.resolved? %>
        <%= gated_button "case.reopen", menu_item("hand", "Reopen"),
              fd_case_resolution_path(@case), on: @case, method: :delete,
              form: { class: "contents", data: { turbo_confirm:
                "Reopen case #{@case.id}?" } } %>
      <% end %>
  <% end %>
<% end %>

<% content_for :page_controls do %>
  <%= render "tags", kase: @case, links: @case.case_tags.includes(:tag).to_a %>
<% end %>

<% content_for :page_tabs do %>
  <% case_tabs(@tab_counts).each do |tab| %>
    <%= link_to fd_case_path(@case, @pane_params.merge(tab: tab[:key])),
          class: class_names("view", "view-off" => tab[:count]&.zero?),
          aria: { current: ("true" if tab[:key] == @tab) } do %>
      <%= tab[:label] %>
      <% if tab[:count] %><span class="tab-count"><%= tab[:count] %></span><% end %>
    <% end %>
  <% end %>
<% end %>

<div class="stack case-record case-record-<%= @tab %>" data-controller="case-shortcuts">
  <% if @case.resolved? %>
    <div class="closed">
      <span class="closed-what">
        Closed <%= Fd::ShortDate.for(@case.resolved_at) %> ·
        <%= resolution_label(@case.resolution).downcase %>
      </span>
      <% if @case.member_note.present? %>
        <span class="closed-why"><%= mentioned(@case.member_note) %></span>
      <% end %>
    </div>
  <% end %>

  <% if @case.duplicate_of %>
    <div class="warnbar">
      <span>Duplicate of
        <%= link_to "case #{@case.duplicate_of}", fd_case_path(@case.duplicate_of), class: "lnk" %></span>
    </div>
  <% end %>

  <div class="<%= @tab == "report" ? "card report-solo" : "case-tab-body" %>">
    <% if @tab == "report" %>
      <%= render "chat", kase: @case, reports: @reports, chat: @chat, earlier: @earlier_count,
            messages: @conversation_messages, queued: @queued_replies, thread: @thread,
            conversation: @thread_conversation, message_count: @conversation_count,
            reachable: @reachable_report_ids, root: @root_chat %>
    <% end %>

    <% if @tab == "people" %>
      <%= render "people", kase: @case, people: @people, contexts: @context,
            notes: @standing_notes, mentioned: @mentioned, priors: @person_priors %>
    <% end %>

    <% if @tab == "actions" %>
      <div class="section-head">
        <h2 class="section-title">Actions</h2>
        <div class="section-tools">
          <%= opens_modal "case.act", "Log an action", opens: "log-action", on: @case %>
        </div>
      </div>
      <% if @thread_guards.any? %>
        <%= render "thread_guards", guards: @thread_guards, names: names, kase: @case %>
      <% end %>
      <% if @actions.any? %>
        <%= render "actions", kase: @case, actions: @actions %>
      <% else %>
        <div class="empty">
          <span class="empty-mark">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20 14a8 8 0 1 0-16 0"/><path d="m15 10-3.4 3.4"/></svg>
          </span>
          <p class="empty-title">No actions</p>
          <div class="empty-do">
            <%= opens_modal "case.act", "Log an action", opens: "log-action", on: @case,
                  css: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @tab == "notes" %>
      <div class="section-head">
        <h2 class="section-title">Notes</h2>
        <div class="section-tools">
          <%= opens_modal "case.note", "Add note", opens: "add-note" %>
        </div>
      </div>
      <% if @notes.any? %>
        <div class="list">
          <% @notes.each do |note| %>
            <div class="lrow">
              <%= avatar(note.author) %>
              <span class="grow">
                <b class="note-fine"><%= mentioned(note.body) %></b>
                <span class="sub"><%= note_byline(note) %></span>
              </span>
              <span class="lrow-right">
                <%= render "fd/notes/buttons", note: note, capability: "case.note",
                      path: fd_case_note_path(@case, note) %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty">
          <span class="empty-mark">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v12H8l-3 3z"/></svg>
          </span>
          <p class="empty-title">No notes</p>
          <div class="empty-do">
            <%= opens_modal "case.note", "Add note", opens: "add-note", css: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @tab == "timeline" %>
      <div class="section-head">
        <h2 class="section-title">Timeline</h2>
      </div>
      <% if @timeline.any? %>
        <div class="list">
          <% @timeline.each do |entry| %>
            <div class="evrow">
              <span class="evdot <%= timeline_tone(entry.mark) %>"><%= timeline_glyph(entry.mark) %></span>
              <div>
                <div class="msg-head">
                  <span class="msg-who"><%= named_text(entry.title) %></span>
                  <span class="msg-at"><%= clock_stamp(entry.at, "%-d %b, %H:%M") %></span>
                </div>
                <% marks = [entry.detail.presence, *entry.chips].compact %>
                <% if marks.any? %>
                  <p class="card-note"><%= named_text(marks.join(" · ")) %></p>
                <% end %>
                <% if entry.body.present? %>
                  <p class="msg-body"><%= mentioned(entry.body) %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <p class="card-note" style="padding: var(--s-xs) var(--s-md)">
          <%= timeline_standing(@case, @timeline) %>
        </p>
      <% else %>
        <div class="empty">
          <p class="empty-title">No events</p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% @actions.each do |action| %>
  <%= render layout: "fd/modal", locals: { id: "edit-action-#{action.id}",
        title: "Edit action", sub: action_option_label(action),
        open: params[:do] == "edit-action-#{action.id}" } do %>
    <%= form_with url: fd_case_action_path(@case, action), method: :patch, html: { autocomplete: "off" } do %>
      <div class="modal-body" data-controller="reason-field"
           data-reason-field-categories-value="<%= Fd::InfractionCategory::NO_REASON_KEYS.to_json %>">
        <label class="field-label">
          Category
          <%= select_tag :category_key, options_for_select(action_category_options(action), action.category_key),
                class: "select", id: nil,
                data: { reason_field_target: "category", action: "change->reason-field#toggle" } %>
        </label>
        <div data-reason-field-target="reason">
          <label class="field-label">
            Reason
            <%= text_area_tag :reason, submitted_value(:edit_reason, action.reason), rows: 3,
                  class: "textarea", id: nil %>
          </label>
          <%= field_wrong(:edit_reason) %>
        </div>
        <label class="field-label">
          How Was This Solved? (Text edition)
          <%= text_area_tag :solution, action.solution, rows: 2, class: "textarea", id: nil %>
        </label>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
        <%= submit_tag "Save", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% @live_actions.each do |action| %>
  <%= render layout: "fd/modal", locals: { id: "reverse-#{action.id}",
        title: "Reverse action", sub: action_option_label(action),
        open: params[:do] == "reverse-#{action.id}" } do %>
    <%= form_with url: fd_case_reversals_path(@case), method: :post, html: { autocomplete: "off" } do %>
      <%= hidden_field_tag :action_id, action.id, id: nil %>
      <div class="modal-body">
        <label class="field-label">
          Reason
          <%= text_area_tag :reversal_reason, submitted_value(:reversal_reason), rows: 3,
                class: "textarea", id: nil,
                maxlength: Fd::ReversalsController::MAX_REASON %>
        </label>
        <%= field_wrong(:reversal_reason) %>
      </div>
      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
        <%= submit_tag "Reverse", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "log-action", title: "Log an action",
      open: params[:do] == "action" } do %>
  <div data-controller="action-standing"
       data-action="combobox:selected->action-standing#reloadStanding
                    turbo:frame-load->action-standing#toggleFields"
       data-action-standing-url-value="<%= fd_case_standing_path(@case) %>">
  <%= form_with url: fd_case_actions_path(@case), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <%= render "action_fields", kase: @case, names: names,
              standing: @action_standing, thread_locks: @thread_locks,
              guards_logged: @guards_logged, locks_logged: @locks_logged,
              open_reports: @open_reports,
              target: @people.selected&.user_id || sole_subject_id(@case) %>

    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
      <%= submit_tag "Log", class: "btn btn-primary" %>
    </div>
  <% end %>
  </div>
<% end %>

<%= render layout: "fd/modal", locals: { id: "set-category",
      title: "Set category",
      sub: "case #{@case.id}",
      open: params[:do] == "category" } do %>
  <%= form_with url: fd_case_path(@case), method: :patch, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <div class="field-label">
        <span>Category</span>
        <%= render "shared/choice", name: :category_key,
              chosen: category_label(@case.category_key.presence || Fd::InfractionCategory.active_keys.first),
              options: Fd::InfractionCategory.active_keys.each_with_index.map { |key, i| {
                value: key, label: category_label(key),
                current: @case.category_key.present? ? key == @case.category_key : i.zero? } } %>
      </div>
      <%= field_wrong(:category_key) %>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
      <%= submit_tag "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= render "add_person_modal", kase: @case %>
<%= render "assign_modal", kase: @case %>

<% @notes.each do |note| %>
  <%= render "fd/notes/edit_modal", note: note, url: fd_case_note_path(@case, note),
        search_url: fd_member_search_path(case_id: @case.id) %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "add-note", title: "Add note",
      open: params[:do] == "note" } do %>
  <%= form_with url: fd_case_notes_path(@case), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <div class="field-label">
        <span>About</span>
        <div class="segmented">
          <label>
            <%= radio_button_tag :about, "case", true, id: nil %>
            This case
          </label>
          <% @participants.map(&:user_id).uniq.each do |user_id| %>
            <label>
              <%= radio_button_tag :about, user_id, false, id: nil %>
              <%= names[user_id] %>
            </label>
          <% end %>
        </div>
      </div>
      <label class="field-label">
        Note
        <%= render "fd/mention_field", name: :body, value: submitted_value(:body), rows: 4,
              url: fd_member_search_path(case_id: @case.id),
              placeholder: nil %>
      </label>
      <%= field_wrong(:body) %>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
      <%= submit_tag "Save", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<% unless @case.resolved? %>
<%= render layout: "fd/modal", locals: { id: "resolve-case",
      title: "Resolve case #{@case.id}", label: "Resolve case",
      open: params[:do] == "resolve",
      sub: @case.assigned? ? safe_join(["Assigned to ", to_sentence(@case.assignee_user_ids.map { |id| person_name(id) })]) : "Unassigned" } do %>
      <%= form_with url: fd_case_resolution_path(@case), method: :post, html: { autocomplete: "off" } do %>
        <div class="modal-body">
          <% if @live_actions.any? %>
            <div class="field-label">
              <span>Reason</span>
              <div class="quote-block"><%= closing_reason(@live_actions) %></div>
            </div>
          <% else %>
            <label class="field-label">
              Reason
              <%= select_tag :close_reason,
                    options_for_select(close_reason_options), class: "select" %>
            </label>
          <% end %>

          <label class="field-label">
            Summary (optional)
            <%= text_area_tag :member_note, nil, rows: 2, class: "textarea" %>
          </label>

          <% if @open_reports.positive? %>
            <label class="opt">
              <%= check_box_tag :notify_reporter, "1", true, class: "tick" %>
              <span>
                <span class="opt-label">Notify the reporter</span>
              </span>
            </label>
            <label class="field-label only only-notifying">
              Message to reporter
              <%= text_area_tag :member_message, Fd::Resolution::DEFAULT_MESSAGE, rows: 3,
                    class: "textarea", maxlength: Fd::IntakeOutbox::MAX_LENGTH %>
            </label>
          <% end %>

        </div>
        <div class="modal-foot">
          <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
          <%= submit_tag "Resolve", class: "btn btn-primary" %>
        </div>
      <% end %>
<% end %>
<% end %>

<%= render "merge_modal", kase: @case %>
