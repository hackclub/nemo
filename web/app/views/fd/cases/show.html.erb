<% content_for :page_title, "Case #{@case.id}" %>
<% content_for :page_subtitle do %>
  <%= case_head_meta(@case, @reports) %>
<% end %>
<% content_for :page_badge do %>
  <%= case_status_chip(@case) %>
<% end %>
<% content_for :head_actions do %>
  <% unless @case.resolved? %>
    <label for="resolve-case" class="btn btn-primary">Resolve</label>
    <% if @case.claimed_by == current_staff.user_id %>
      <%= button_to "Unclaim", fd_case_claim_path(@case), method: :delete,
            class: "btn", form: { class: "contents" } %>
    <% elsif !@case.claimed? %>
      <%= button_to "Claim", fd_case_claim_path(@case), method: :post,
            class: "btn btn-primary", form: { class: "contents" } %>
    <% end %>
  <% end %>
  <label for="case-timeline" class="btn drawer-open">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h13M3 12h9M3 19h13"/><circle cx="20" cy="5" r="1.6"/><circle cx="16" cy="12" r="1.6"/><circle cx="20" cy="19" r="1.6"/></svg>
    Timeline
  </label>
<% end %>

<div class="stack">
  <% subject = @context[@case.subject_user_id] %>
  <div class="card">
    <div class="subject">
      <div class="subject-avatar" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
      </div>
      <div>
        <h2 class="card-title">
          <%= @case.subject_user_id ? "@#{@case.subject_user_id}" : "No subject set" %>
        </h2>
        <div class="mono"><%= subject_identity_line(@case, subject) %></div>
      </div>
    </div>

    <% if @case.subject_user_id %>
      <div class="subject-facts">
        <div>
          <div class="fact-label">Messages</div>
          <div class="fact-val"><%= fact_number(subject&.messages_posted) %></div>
        </div>
        <div>
          <div class="fact-label">Active days</div>
          <div class="fact-val"><%= fact_number(subject&.days_active) %></div>
        </div>
        <div>
          <div class="fact-label">Channels</div>
          <div class="fact-val"><%= fact_number(subject&.channels_joined) %></div>
        </div>
        <div>
          <div class="fact-label">Last active</div>
          <div class="fact-val"><%= last_active_label(subject&.last_active_at) %></div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @case.resolved? %>
    <div class="card card-flush">
      <table class="data-table">
        <tbody>
          <tr>
            <td>Resolved</td>
            <td>
              <%= @case.resolved_at.strftime("%b %-d, %Y") %>
              as <%= @case.resolution.tr("_", " ") %>
            </td>
          </tr>
          <% if @case.duplicate_of %>
            <tr>
              <td>Duplicate of</td>
              <td><%= link_to "case #{@case.duplicate_of}", fd_case_path(@case.duplicate_of) %></td>
            </tr>
          <% end %>
          <tr>
            <td>Reason recorded</td>
            <td><%= @case.member_note || "n/a" %></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">What was done</h2>
        <p class="card-sub"><%= pluralize(@actions.size, "action") %>, oldest first</p>
      </div>
    </div>
    <% if @actions.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Action</th>
              <th>Directed at</th>
              <th>Decided by</th>
              <th class="col-date">When</th>
              <th>State</th>
            </tr>
          </thead>
          <tbody>
            <% @actions.each do |action| %>
              <tr>
                <td>
                  <span class="two-line">
                    <b><%= action_label(action.type_key) %></b>
                    <span><%= action_detail_note(action) || "n/a" %></span>
                  </span>
                </td>
                <td>
                  <span class="two-line">
                    <b>@<%= action.target_user_id %></b>
                    <span><%= action_target_note(action, @case) %></span>
                  </span>
                </td>
                <td>
                  <span class="two-line">
                    <b>@<%= action.decided_by %></b>
                    <span><%= action_performer_note(action) %></span>
                  </span>
                </td>
                <td class="col-date"><%= action.performed_at.strftime("%b %-d, %Y") %></td>
                <td><%= action_state_chip(action) || "n/a" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">
        Nothing has been done yet. A case can also resolve with no action, which is recorded
        as an outcome rather than an absence.
      </p>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title">How this arrived</h2>
        <p class="card-sub"><%= reports_summary(@reports) %></p>
      </div>
    </div>
    <% if @reports.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Reporter</th>
              <th class="col-date">Received</th>
              <th>First reply</th>
              <th>Told the outcome</th>
              <th>What they wrote</th>
            </tr>
          </thead>
          <tbody>
            <% @reports.each do |report| %>
              <tr>
                <td>
                  <span class="two-line">
                    <b><%= report.reporter_label %></b>
                    <span>via <%= report.source_app %></span>
                  </span>
                </td>
                <td class="col-date"><%= report.received_at.strftime("%b %-d, %Y") %></td>
                <td>
                  <% if report.replied? %>
                    <%= reply_latency_label(report) %>
                  <% else %>
                    <span class="chip chip-crit">no reply yet</span>
                  <% end %>
                </td>
                <td><%= report.told_of_outcome? ? "yes" : "not yet" %></td>
                <td><%= report.body || "n/a" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note">
        No report. A firefighter opened this case from something they saw themselves.
      </p>
    <% end %>
  </div>

  <div class="grid-2-1">
    <div class="card card-flush">
      <div class="card-head">
        <div>
          <h2 class="card-title">Threads</h2>
          <p class="card-sub">where it happened</p>
        </div>
      </div>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Channel</th>
              <th>Thread</th>
              <th>Added by</th>
            </tr>
          </thead>
          <tbody>
            <% @threads.each do |thread| %>
              <tr>
                <td>
                  <span class="two-line">
                    <b><%= thread.channel_id %></b>
                    <span><%= thread.is_primary ? "primary" : "added later" %></span>
                  </span>
                </td>
                <td>
                  <%= link_to "open in Slack",
                        slack_thread_url(thread.channel_id, thread.thread_ts),
                        target: "_blank", rel: "noopener" %>
                </td>
                <td>@<%= thread.added_by %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="stack">
      <div class="card card-flush">
        <div class="card-head">
          <div>
            <h2 class="card-title">Who else was involved</h2>
            <p class="card-sub">the subject is above, not in this list</p>
          </div>
        </div>
        <% if @participants.any? %>
          <table class="data-table">
            <tbody>
              <% @participants.each do |person| %>
                <tr>
                  <td>
                    <span class="two-line">
                      <b>@<%= person.user_id %></b>
                      <span><%= role_label(person.role) %></span>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="card-note">n/a</p>
        <% end %>
      </div>

      <div class="card card-flush">
        <div class="card-head">
          <div>
            <h2 class="card-title">Duplicate Cases</h2>
            <p class="card-sub">other cases citing one of these threads</p>
          </div>
        </div>
        <% if @siblings.any? %>
          <table class="data-table">
            <tbody>
              <% @siblings.each do |sibling| %>
                <tr>
                  <td>
                    <span class="two-line">
                      <%= link_to fd_case_path(sibling) do %>
                        <b>Case <%= sibling.id %></b>
                      <% end %>
                      <span>
                        <%= sibling.subject_user_id ? "@#{sibling.subject_user_id}" : "no subject set" %>
                      </span>
                    </span>
                  </td>
                  <td><%= case_status_chip(sibling) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="card-note">n/a</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% unless @case.resolved? %>
  <input type="checkbox" id="resolve-case" class="modal-flip">
  <label for="resolve-case" class="modal-veil" aria-hidden="true"></label>
  <div class="modal-wrap">
    <div class="modal" role="dialog" aria-label="Resolve this case">
      <div class="modal-head">
        <h2 class="modal-title">Resolve case <%= @case.id %></h2>
        <span class="modal-sub">
          <%= @case.claimed? ? "assigned to @#{@case.claimed_by}" : "not assigned to anybody" %>
        </span>
      </div>
      <%= form_with url: fd_case_resolution_path(@case), method: :post do %>
        <div class="modal-body">
          <div class="outcomes">
            <label class="opt">
              <%= radio_button_tag :outcome, "report", true %>
              <span class="opt-dot" aria-hidden="true"></span>
              <span>
                <span class="opt-label">File a report</span>
                <span class="opt-note">Something was done about it. Records the action.</span>
              </span>
            </label>
            <label class="opt">
              <%= radio_button_tag :outcome, "close", false %>
              <span class="opt-dot" aria-hidden="true"></span>
              <span>
                <span class="opt-label">Close it</span>
                <span class="opt-note">Nothing to act on, or not ours to act on.</span>
              </span>
            </label>
            <label class="opt">
              <%= radio_button_tag :outcome, "duplicate", false %>
              <span class="opt-dot" aria-hidden="true"></span>
              <span>
                <span class="opt-label">Duplicate</span>
                <span class="opt-note">Already being handled as another case.</span>
              </span>
            </label>
          </div>

          <div class="only only-report">
            <label class="field-label">
              What was done
              <%= select_tag :type_key, options_for_select(action_options), class: "select" %>
            </label>
            <label class="field-label">
              Directed at
              <%= text_field_tag :target_user_id, @case.subject_user_id, class: "textarea" %>
            </label>
            <label class="field-label when when-expiry">
              Until when
              <%= date_field_tag :expires_on, nil, class: "textarea" %>
            </label>
            <label class="field-label when when-channel">
              Which channel
              <%= text_field_tag :channel_id, nil, class: "textarea", placeholder: "C0266FRGV" %>
            </label>
          </div>

          <div class="only only-close">
            <label class="field-label">
              Why
              <%= select_tag :close_reason,
                    options_for_select(close_reason_options), class: "select" %>
            </label>
          </div>

          <div class="only only-duplicate">
            <% if @duplicate_candidates.any? %>
              <label class="field-label">
                Duplicate of which case
                <%= select_tag :duplicate_of,
                      options_for_select(case_options(@duplicate_candidates)),
                      include_blank: "pick the case this duplicates", class: "select" %>
             </label>
            <% else %>
              <span class="opt-note">There is no other case this could duplicate.</span>
            <% end %>
          </div>

          <label class="field-label unless-duplicate">
            Reason
            <%= text_area_tag :member_note, nil, rows: 3, class: "textarea" %>
            <span class="opt-note">
              Kept on the record. Nothing here is sent to anybody.
            </span>
          </label>
        </div>
        <div class="modal-foot">
          <label for="resolve-case" class="btn">Close</label>
          <%= submit_tag "Resolve", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<input type="checkbox" id="case-timeline" class="drawer-flip">
<label for="case-timeline" class="drawer-veil" aria-hidden="true"></label>

<aside class="drawer" aria-label="Timeline">
  <div class="drawer-head">
    <h2>Timeline</h2>
    <label for="case-timeline" class="drawer-shut">Close</label>
  </div>
  <div class="drawer-body">
    <% if @timeline.any? %>
      <div class="timeline">
        <% @timeline.each do |entry| %>
          <div class="tl-item">
            <div class="tl-when">
              <%= entry.at.strftime("%-d %b") %><br><%= entry.at.strftime("%H:%M") %>
            </div>
            <div class="tl-what">
              <div class="tl-head">
                <span class="tl-title"><%= entry.title %></span>
                <% if entry.mark %>
                  <span class="tl-mark tl-mark-<%= entry.mark %>"><%= entry.mark %></span>
                <% end %>
                <% entry.chips.each do |chip| %>
                  <span class="chip chip-off"><%= chip %></span>
                <% end %>
              </div>
              <% if entry.detail.present? %>
                <div class="tl-detail"><%= entry.detail %></div>
              <% end %>
              <% if entry.said.present? %>
                <div class="said"><%= entry.said %></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="card-note">Nothing recorded yet.</p>
    <% end %>
    <div class="tl-open"><%= timeline_standing(@case, @timeline) %></div>
  </div>
</aside>
