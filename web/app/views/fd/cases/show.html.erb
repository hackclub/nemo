<% content_for :page_title, violations_label(@case.violations, short: true) || "No violation set" %>
<% content_for :page_face do %>
  <span class="triad-id">#<%= @case.id %></span>
<% end %>
<% if @subject %>
  <% content_for :head_context do %>
    <span class="triad-sep" aria-hidden="true">&middot;</span>
    <span class="triad-who"><%= slack_face(@subject) %><%= member_link(@subject) %></span>
  <% end %>
<% end %>
<% content_for :palette_on, "case:#{@case.id}" %>
<% content_for :flush, true %>
<% content_for :pane do %>
  <%= render "pane", cases: @pane_cases, views: @pane_views, query: @pane_query,
        priors_by_user: @pane_priors, violations: @pane_violations, open_id: @case.id,
        reachable: @pane_reachable %>
<% end %>

<% content_for :head_actions do %>
  <span class="qage <%= age_ink(case_age_seconds(@case)) unless @case.resolved? %>">
    <%= @case.resolved? ? "closed" : case_age_label(case_age_seconds(@case)) %>
  </span>
  <% if @case.assigned? %>
    <span class="faces"><%= safe_join(@case.assignee_user_ids.map { |id| slack_face(id) }) %></span>
  <% end %>

  <details class="menu" data-controller="menu">
    <summary class="btn btn-only" aria-label="More actions">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg>
    </summary>
    <div class="menu-pop">
      <% unless @case.resolved? %>
        <%= opens_modal "case.people", menu_item("category", "Set the violation"),
              opens: "set-category", on: @case %>
        <p class="menu-group">Who holds it</p>
        <% if @case.assigned_to?(current_account.user_id) %>
          <%= gated_button "case.open", menu_item("hand", "Put it back in the queue"),
                fd_case_claim_path(@case), on: @case, method: :delete %>
        <% elsif @case.assigned? %>
          <%= gated_button "case.open", menu_item("join", "Put myself on it too"),
                fd_case_claim_path(@case), on: @case, method: :post %>
        <% end %>
        <% @case.assignees.oldest_first.each do |row| %>
          <% next if row.user_id == current_account.user_id %>
          <%= gated_button "case.open", menu_item("hand", "Take @#{row.user_id} off it"),
                fd_case_assignee_path(@case, row.user_id), on: @case, method: :delete,
                form: { class: "contents", data: { turbo_confirm:
                  "Take @#{row.user_id} off case #{@case.id}?" } } %>
        <% end %>
        <%= opens_modal "case.open", menu_item("join", "Assign somebody"),
              opens: "assign-case", on: @case %>

        <p class="menu-group">Closes this case</p>
        <%= opens_modal "case.resolve", menu_item("merge", "Merge into another case",
              note: "Folds it into an older case, which then holds both"),
              opens: "merge-case", on: @case %>
        <% unless @case.assigned? %>
          <%= opens_modal "case.resolve", menu_item("resolve", "Resolve without claiming",
                note: "Closes it under your name without putting you on it"),
                opens: "resolve-case", on: @case %>
        <% end %>
      <% end %>
      <% if @case.resolved? %>
        <%= gated_button "case.reopen", menu_item("hand", "Reopen this case"),
              fd_case_resolution_path(@case), on: @case, method: :delete,
              form: { class: "contents", data: { turbo_confirm:
                "Reopen case #{@case.id}? It goes back in the queue." } } %>
      <% end %>
    </div>
  </details>
<% end %>

<% content_for :page_controls do %>
  <% if @case.resolved? %>
    <%= gated_button "case.reopen", case_action_button("history", "Reopen"),
          fd_case_resolution_path(@case), on: @case,
          method: :delete, form: { class: "contents", data: { turbo_confirm:
            "Reopen case #{@case.id}? It goes back in the queue." } } %>
  <% else %>
    <% unless @case.assigned_to?(current_account.user_id) %>
      <%= gated_button "case.open", case_action_button("shield", "Claim", shortcut: "c"),
            fd_case_claim_path(@case), on: @case, css: "btn btn-primary", method: :post,
            data: { shortcut: "c" } %>
    <% end %>
    <%= opens_modal "case.act", case_action_button("gauge", "Log an action", shortcut: "a"),
          opens: "log-action", on: @case, data: { shortcut: "a" } %>
    <%= opens_modal "case.note", case_action_button("note", "Note", shortcut: "n"),
          opens: "add-note", data: { shortcut: "n" } %>
    <%= opens_modal "case.thread", case_action_button("thread", "Attach a thread", shortcut: "t"),
          opens: "attach-thread", on: @case, data: { shortcut: "t" } %>
    <% if @case.assigned? %>
      <span class="bar-sep"></span>
      <%= opens_modal "case.resolve", case_action_button("resolve", "Resolve", shortcut: "r"),
            opens: "resolve-case", on: @case, data: { shortcut: "r" } %>
    <% end %>
  <% end %>

  <span class="qspacer"></span>

  <% if @subject %>
    <%= link_to case_action_button("history", "Their history"), fd_member_path(@subject),
          class: "btn",
          data: { turbo_frame: "person-drawer" } %>
  <% end %>

<% end %>

<% content_for :page_tabs do %>
  <% case_tabs(@tab_counts).each do |tab| %>
    <%= link_to fd_case_path(@case, @pane_params.merge(tab: tab[:key])),
          class: class_names("view", "view-off" => tab[:count]&.zero?),
          aria: { current: ("true" if tab[:key] == @tab) } do %>
      <%= tab[:label] %>
      <% if tab[:count] %><span class="tab-count"><%= tab[:count] %></span><% end %>
    <% end %>
  <% end %>
<% end %>

<div class="stack case-record case-record-<%= @tab %>" data-controller="case-shortcuts">
  <%= render "highlights", kase: @case, subject: @subject, reports: @reports,
        threads: @threads, actions: @live_actions %>

  <% if @case.resolved? %>
    <div class="closed">
      <span class="closed-what">
        Closed <%= @case.resolved_at.strftime("%-d %b") %> ·
        <%= resolution_label(@case.resolution).downcase %>
      </span>
      <% if @case.member_note.present? %>
        <span class="closed-why"><%= mentioned(@case.member_note) %></span>
      <% end %>
    </div>
  <% end %>

  <% if @missing.any? %>
    <%= render "finish_off", kase: @case, missing: @missing %>
  <% end %>

  <% if @case.duplicate_of %>
    <div class="warnbar">
      <span>Closed as a duplicate of
        <%= link_to "case #{@case.duplicate_of}", fd_case_path(@case.duplicate_of), class: "lnk" %>,
        which carries everything from here.</span>
    </div>
  <% end %>

  <div class="<%= @tab == "report" ? "panel" : "case-tab-body" %>">
    <% if @tab == "report" %>
      <%= render "chat", kase: @case, reports: @reports, chat: @chat, earlier: @earlier_chat,
            messages: @conversation_said, queued: @queued, thread: @thread,
            conversation: @thread_conversation, said_count: @conversation_count %>
    <% end %>

    <% if @tab == "people" %>
      <%= render "people", kase: @case, people: @people, contexts: @context,
            notes: @standing_notes, mentioned: @mentioned, priors: @person_priors,
            said_counts: @said_counts, total_messages: @thread_messages.size %>
    <% end %>

    <% if @tab == "evidence" %>
      <% if @thread_list.any? %>
        <%= render "threads", kase: @case, threads: @thread_list,
              flags: @citations, cited_by: @cited_by %>
      <% else %>
        <div class="empty">
          <span class="empty-mark">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 6h16M4 11h10M4 16h13"/></svg>
          </span>
          <p class="empty-title">No evidence attached</p>
          <p class="card-note">A thread is copied here when you attach it, so it stays readable even if the original is deleted or locked.</p>
          <div class="empty-do">
            <%= opens_modal "case.thread", "Attach a thread", opens: "attach-thread",
                  on: @case, css: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @tab == "actions" %>
      <% if @actions.any? %>
        <%= render "actions", kase: @case, actions: @actions,
              cited_messages: @cited_messages %>
      <% else %>
        <div class="empty">
          <span class="empty-mark">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20 14a8 8 0 1 0-16 0"/><path d="m15 10-3.4 3.4"/></svg>
          </span>
          <p class="empty-title">No action taken yet</p>
          <p class="card-note">An action is recorded against a person and stays on their history, whether or not it is later reversed.</p>
          <div class="empty-do">
            <%= opens_modal "case.act", "Log an action", opens: "log-action", on: @case,
                  css: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @tab == "notes" %>
      <% if @notes.any? %>
        <div class="list">
          <% @notes.each do |note| %>
            <div class="lrow">
              <%= face(note.author) %>
              <span class="grow">
                <b class="note-said"><%= mentioned(note.body) %></b>
                <span class="sub"><%= note_byline(note) %></span>
              </span>
              <span class="lrow-right">
                <%= render "note_remove", kase: @case, note: note %>
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty">
          <span class="empty-mark">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v12H8l-3 3z"/></svg>
          </span>
          <p class="empty-title">No notes yet</p>
          <p class="card-note">Notes are internal. The reporter and the subject never see them.</p>
          <div class="empty-do">
            <%= opens_modal "case.note", "Add a note", opens: "add-note", css: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @tab == "timeline" %>
      <% if @timeline.any? %>
        <div class="list">
          <% @timeline.each do |entry| %>
            <div class="evrow">
              <span class="evdot <%= timeline_tone(entry.mark) %>"><%= timeline_glyph(entry.mark) %></span>
              <div>
                <div class="msg-head">
                  <span class="msg-who"><%= entry.title %></span>
                  <span class="msg-at"><%= entry.at.strftime("%-d %b, %H:%M") %></span>
                </div>
                <% marks = [entry.detail.presence, *entry.chips].compact %>
                <% if marks.any? %>
                  <p class="card-note"><%= marks.join(" · ") %></p>
                <% end %>
                <% if entry.said.present? %>
                  <p class="msg-body"><%= mentioned(entry.said) %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <p class="card-note" style="padding: var(--s-xs) var(--s-md)">
          <%= timeline_standing(@case, @timeline) %>
        </p>
      <% else %>
        <div class="empty">
          <p class="empty-title">Nothing recorded yet</p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% @live_actions.each do |action| %>
  <%= render layout: "fd/modal", locals: { id: "reverse-#{action.id}",
        title: "Reverse this action", sub: action_option_label(action),
        open: params[:do] == "reverse-#{action.id}" } do %>
    <%= form_with url: fd_case_reversals_path(@case), method: :post, html: { autocomplete: "off" } do %>
      <%= hidden_field_tag :action_id, action.id, id: nil %>
      <div class="modal-body">
        <label class="field-label">
          Why
          <%= text_area_tag :reversal_reason, field_was(:reversal_reason), rows: 3,
                class: "textarea", id: nil,
                maxlength: Fd::ReversalsController::MAX_REASON %>
        </label>
        <%= field_wrong(:reversal_reason) %>
      </div>
      <div class="modal-foot">
        <p class="modal-note">It stops standing. The record keeps both it and the reversal.</p>
        <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
        <%= submit_tag "Reverse it", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "log-action", title: "Log an action",
      open: params[:do] == "action" } do %>
  <%= form_with url: fd_case_actions_path(@case), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <%= render "action_fields", kase: @case, flagged: @flagged_messages,
              target: @people.chosen&.user_id || lone_subject(@case) %>

      <% standing = @live_actions.reject(&:expired?).max_by(&:performed_at) %>
      <% if standing %>
        <div class="flag flag-mid">
          <span class="flag-icon" aria-hidden="true">◆</span>
          <div><b><%= names[standing.target_user_id] %> already has a
            <%= action_label(standing.type_key).downcase %> from
            <%= standing.performed_at.strftime("%-d %b") %> that still stands.</b></div>
        </div>
      <% end %>

    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Log it", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "attach-thread", title: "Attach a thread",
      open: params[:do] == "thread" } do %>
  <%= form_with url: fd_case_threads_path(@case), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <label class="field-label">
        Slack link
        <%= text_field_tag :link, nil, class: "input", id: nil,
              placeholder: "https://hackclub.slack.com/archives/C0266FRGV/p1754487721123456" %>
      </label>
      <div class="field-label">
        <span>What that thread is</span>
        <div class="segmented seg-radio">
          <label>
            <%= radio_button_tag :kind, "evidence", true, id: nil %>
            Evidence
          </label>
          <label>
            <%= radio_button_tag :kind, "internal", false, id: nil %>
            Internal discussion
          </label>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Attach", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= render layout: "fd/modal", locals: { id: "set-category",
      title: "Set the violation",
      sub: "case #{@case.id}",
      open: params[:do] == "category" } do %>
  <%= form_with url: fd_case_path(@case), method: :patch, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <div class="field-label">
        <span>What kind of thing it is</span>
        <details class="picker" data-controller="picker" data-action="change->picker#choose">
          <summary class="select">
            <span data-picker-target="label"><%= category_label(Fd::Case::CATEGORIES.first) %></span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="menu-pop picker-pop">
            <% Fd::Case::CATEGORIES.each_with_index do |key, i| %>
              <label class="picker-opt">
                <%= radio_button_tag :category_key, key, i.zero?, id: nil,
                      data: { label: category_label(key) } %>
                <%= category_label(key) %>
              </label>
            <% end %>
          </div>
        </details>
      </div>
      <%= field_wrong(:category_key) %>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Set it", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<%= render "add_person_modal", kase: @case %>
<%= render "assign_modal", kase: @case %>

<%= render layout: "fd/modal", locals: { id: "add-note", title: "Add a note",
      open: params[:do] == "note" } do %>
  <%= form_with url: fd_case_notes_path(@case), method: :post, html: { autocomplete: "off" } do %>
    <div class="modal-body">
      <div class="field-label">
        <span>What it is about</span>
        <div class="segmented seg-radio">
          <label>
            <%= radio_button_tag :about, "case", true, id: nil %>
            This case
          </label>
          <% @participants.map(&:user_id).uniq.each do |user_id| %>
            <label>
              <%= radio_button_tag :about, user_id, false, id: nil %>
              <%= names[user_id] %>
            </label>
          <% end %>
        </div>
      </div>
      <label class="field-label">
        The note
        <%= render "fd/mention_field", name: :body, value: field_was(:body), rows: 4,
              placeholder: "type @ to name somebody" %>
      </label>
      <%= field_wrong(:body) %>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
      <%= submit_tag "Save the note", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<% unless @case.resolved? %>
<%= render layout: "fd/modal", locals: { id: "resolve-case",
      title: "Resolve case #{@case.id}", label: "Resolve this case",
      open: params[:do] == "resolve",
      sub: @case.assigned? ? "assigned to #{@case.assignee_handles}" : "not assigned to anybody" } do %>
      <%= form_with url: fd_case_resolution_path(@case), method: :post, html: { autocomplete: "off" } do %>
        <div class="modal-body">
          <% if @live_actions.any? %>
            <div class="field-label">
              <span>Why it is closing</span>
              <div class="said"><%= closing_because(@live_actions) %></div>
            </div>
          <% else %>
            <label class="field-label">
              Why it is closing
              <%= select_tag :close_reason,
                    options_for_select(close_reason_options), class: "select" %>
            </label>
          <% end %>

          <label class="field-label">
            Summary
            <%= text_area_tag :member_note, nil, rows: 2, class: "textarea" %>
          </label>

          <% if @open_reports.positive? %>
            <label class="opt">
              <%= check_box_tag :tell_reporter, "1", true %>
              <span class="opt-box" aria-hidden="true"></span>
              <span>
                <span class="opt-label">Notify the reporter</span>
              </span>
            </label>
            <label class="field-label only only-telling">
              What they are told
              <%= text_area_tag :member_message, Fd::Resolution::TOLD, rows: 3,
                    class: "textarea", maxlength: Fd::IntakeOutbox::MAX_LENGTH %>
            </label>
          <% end %>

          <% if @merge_into %>
            <div class="flag flag-mid">
              <span class="flag-icon" aria-hidden="true">◆</span>
              <div><b>#<%= @merge_into.id %> is <%= merge_reason(@case, @merge_into) %> and still open.</b>
                Merging first would resolve both together.</div>
            </div>
          <% end %>
        </div>
        <div class="modal-foot">
          <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
          <%= submit_tag "Resolve", class: "btn btn-primary" %>
        </div>
      <% end %>
<% end %>
<% end %>

<%= render "merge_modal", kase: @case %>
