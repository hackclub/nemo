<% content_for :page_title, "Cases" %>
<% content_for :page_subtitle do %>
  <%= @open_count %> open · <%= @unassigned_count %> unassigned
<% end %>
<% content_for :head_actions do %>
  <div class="segmented">
    <% Fd::CasesController::FILTERS.each do |name| %>
      <%= link_to name.capitalize, fd_cases_path(filter: name),
            aria: { current: ("true" if @filter == name) } %>
    <% end %>
  </div>
  <%= link_to "Open a case", new_fd_case_path, class: "btn btn-primary" %>
<% end %>

<div class="stack" data-controller="merge">
<div class="card card-flush">
  <div class="card-head">
    <div>
      <h2 class="card-title"><%= filter_title(@filter) %></h2>
      <p class="card-sub"><%= filter_ordering(@filter) %> · subject context from the warehouse</p>
    </div>
    <div class="card-tools">
      <span class="chip chip-off"><%= pluralize(@cases.size, "case") %></span>
    </div>
  </div>

  <% if @cases.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th class="col-tick"><span class="sr-only">Select</span></th>
            <th>Subject</th>
            <th>Category</th>
            <th class="col-num">Actions</th>
            <th class="col-num">Age</th>
            <th>Assigned</th>
          </tr>
        </thead>
        <tbody>
          <%= render "rows", cases: @cases, context: @context, action_counts: @action_counts %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="card-note"><%= filter_empty_note(@filter) %></p>
  <% end %>
</div>

<% if @cases.any? { |kase| !kase.resolved? } %>
  <%= form_with url: fd_merge_cases_path, method: :post, id: "merge-form", class: "bulk" do %>
    <%= hidden_field_tag :filter, @filter %>
    <span class="bulk-note">
      <b><span data-merge-target="count">0</span> ticked</b>
      <span class="bulk-ids" data-merge-target="ids"></span>
      <span class="bulk-rule">Oldest case stays open</span>
    </span>
    <%= submit_tag "Mark as duplicates", class: "btn btn-primary" %>
  <% end %>
<% end %>
</div>
