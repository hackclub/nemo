<% content_for :page_title, "Cases" %>
<% content_for :page_subtitle do %>
  <%= number_with_delimiter(@stats.total) %> <%= since_label(@stats.first_opened) %> ·
  <%= @stats.open_count %> open ·
  <%= @stats.unassigned %> unassigned <%= oldest_unassigned_chip(@stats) %> ·
  median to resolve <%= span_label(@stats.median_now) %>
<% end %>
<% content_for :head_actions do %>
  <%= opens_modal "case.open", "Open a case", opens: "open-case", css: "btn btn-primary" %>
<% end %>

<% tabs, pill_views = @views.partition { |view| Fd::CaseQuery::TABS.include?(view.key) } %>

<div class="stack" data-controller="merge">
  <turbo-frame id="queue" target="_top" data-turbo-action="advance">
  <div class="views">
    <% tabs.each do |view| %>
      <%= link_to fd_cases_path(view: view.key), class: "view",
            data: { turbo_frame: "queue" },
            aria: { current: ("true" if view.current) } do %>
        <%= view.label %>
        <span class="view-count"><%= view.count %></span>
      <% end %>
    <% end %>
  </div>

  <div class="filters">
    <% pill_views.each do |view| %>
      <span class="facet-set <%= "on" if view.current %>">
        <%= link_to fd_cases_path(view: view.key), class: "facet",
              data: { turbo_frame: "queue" },
              aria: { current: ("true" if view.current) } do %>
          <%= view.label %>
          <b><%= view.count %></b>
        <% end %>
      </span>
    <% end %>
    <% @query.inline_facets.each do |facet| %>
      <span class="facet-set <%= "on" if facet.on %>">
        <details class="facet-drop" name="queue-facet">
          <summary class="facet">
            <%= facet.label %>
            <% if facet.on || facet.key == "sort" %>
              <b><%= facet.value_label %></b>
            <% end %>
            <% unless facet.on %>
              <span class="facet-caret" aria-hidden="true">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            <% end %>
          </summary>
          <div class="menu-pop facet-pop">
            <%= render "facet_options", query: @query, facet: facet %>
          </div>
        </details>
        <% if facet.on %>
          <%= link_to facet_link(@query, facet.key, Fd::CaseQuery::DEFAULTS[facet.key]),
                class: "facet-x", data: { turbo_frame: "queue" },
                aria: { label: "clear the #{facet.label.downcase} filter" } do %>
            &times;
          <% end %>
        <% end %>
      </span>
    <% end %>

    <% if @query.more_facets.any? %>
      <span class="facet-set">
        <details class="facet-drop" name="queue-facet">
          <summary class="facet">
            More
            <span class="facet-caret" aria-hidden="true">
              <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="menu-pop facet-pop more-pop">
            <% @query.more_facets.each do |facet| %>
              <details class="more-item" name="queue-more">
                <summary class="more-name">
                  <%= facet.label %>
                  <span class="facet-caret" aria-hidden="true">
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6"/></svg>
                  </span>
                </summary>
                <div class="more-options">
                  <%= render "facet_options", query: @query, facet: facet %>
                </div>
              </details>
            <% end %>
          </div>
        </details>
      </span>
    <% end %>
  </div>

  <div class="card card-flush">
    <div class="card-head">
      <div>
        <h2 class="card-title"><%= @query.title %></h2>
        <p class="card-sub"><%= @query.summary(@cases.size, @total_count) %></p>
      </div>
      <div class="card-tools">
        <span class="chip chip-off"><%= pluralize(@cases.size, "case") %></span>
      </div>
    </div>

    <% if @cases.any? %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th class="col-tick"><span class="sr-only">Select</span></th>
              <th>Subject</th>
              <th>History</th>
              <th class="col-num">Age</th>
              <th>Assigned</th>
            </tr>
          </thead>
          <tbody>
            <%= render "rows", cases: @cases, context: @context, prior_counts: @prior_counts %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="card-note"><%= @query.empty_note %></p>
    <% end %>
  </div>

  <% if @cases.any? { |kase| !kase.resolved? } %>
    <%= form_with url: fd_merge_cases_path, method: :post, id: "merge-form", class: "bulk" do %>
      <% @query.to_params.each do |key, value| %>
        <%= hidden_field_tag key, value, id: nil %>
      <% end %>
      <span class="bulk-note">
        <b><span data-merge-target="count">0</span> ticked</b>
        <span class="bulk-ids" data-merge-target="ids"></span>
        <span class="bulk-rule">Oldest case stays open</span>
      </span>
      <%= submit_tag "Mark as duplicates", class: "btn btn-primary" %>
    <% end %>
  <% end %>
  </turbo-frame>
</div>

<%= render "open_case_modal" %>
