<div class="report">
  <% if report.body.present? %>
    <p class="report-said"><%= mentioned(report.body) %></p>
  <% else %>
    <p class="report-said note-none">No words with it.</p>
  <% end %>
  <span class="report-when">
    <%= report.anonymous? ? "anonymous" : member_link(report.reporter_user_id) %>
    · <%= report_when_line(report, kase) %>
  </span>
</div>
