<%= render layout: "fd/modal", locals: { id: "merge-case",
      title: kase ? "Merge case #{kase.id}" : "Merge ticked cases",
      label: "Merge cases" } do %>
  <div class="merge-shell"
       <% if kase %>
         data-controller="merge-picker"
         data-merge-picker-base-id-value="<%= kase.id %>"
         data-merge-picker-base-opened-at-value="<%= kase.opened_at.iso8601 %>"
       <% end %>>
    <% if kase %>
      <div class="merge-searchbar">
        <%= render "fd/merges/find", kase: kase, term: nil %>
      </div>
    <% end %>
    <%= turbo_frame_tag "merge-body", src: (fd_case_merge_path(kase) if kase),
          loading: ("lazy" if kase), class: "merge-frame" do %>
      <div class="merge-pane">
        <p class="lines" aria-label="<%= kase ? "Looking for duplicates" : "Reading the ticked cases" %>">
          <i style="width:78%"></i>
          <i style="width:62%"></i>
          <i style="width:70%"></i>
        </p>
      </div>
    <% end %>
  </div>
<% end %>
