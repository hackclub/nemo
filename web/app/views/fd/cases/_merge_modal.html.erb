<%= render layout: "fd/modal", locals: { id: "merge-case",
      title: kase ? "Merge case #{kase.id}" : "Merge ticked cases",
      sub: kase ? "the older case holds both" : "the older case holds them",
      label: "Merge this case into another" } do %>
  <div class="merge-shell">
    <% if kase %>
      <div class="merge-pane">
        <%= render "fd/merges/find", kase: kase, term: nil %>
      </div>
    <% end %>
    <%= turbo_frame_tag "merge-body", src: (fd_case_merge_path(kase) if kase),
          loading: ("lazy" if kase), class: "merge-frame" do %>
      <div class="merge-pane">
        <p class="card-note flush">
          <%= kase ? "Looking for duplicates..." : "Reading the ticked cases..." %>
        </p>
      </div>
    <% end %>
  </div>
<% end %>
