<%= render layout: "fd/modal", locals: { id: "merge-case",
      title: kase ? "Merge case #{kase.id}" : "Merge selected cases",
      label: "Merge cases" } do %>
  <div class="merge-shell"
       <% if kase %>data-controller="merge-picker"<% end %>>
    <% if kase %>
      <div class="merge-searchbar">
        <%= render "fd/merges/find", kase: kase, term: nil %>
      </div>
    <% end %>
    <%= turbo_frame_tag "merge-body", src: (fd_case_merge_path(kase) if kase),
          loading: ("lazy" if kase), class: "merge-frame" do %>
      <div class="merge-pane">
        <p class="lines" aria-label="<%= "Loading" %>">
          <i style="width:78%"></i>
          <i style="width:62%"></i>
          <i style="width:70%"></i>
        </p>
      </div>
    <% end %>
  </div>
<% end %>
