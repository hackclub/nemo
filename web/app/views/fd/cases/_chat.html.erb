<% composer = local_assigns.fetch(:composer, true) %>
<% chat = local_assigns.fetch(:chat, []) %>
<% messages = local_assigns.fetch(:messages, []) %>
<% queued = local_assigns.fetch(:queued, []) %>
<% earlier = local_assigns.fetch(:earlier, 0) %>
<% thread = local_assigns.fetch(:thread, reports.last) %>
<% conversation = local_assigns.fetch(:conversation, nil) %>
<% reachable = local_assigns.fetch(:reachable, Set.new) %>
<% message_count = local_assigns.fetch(:message_count, messages.size) %>
<% root = local_assigns.fetch(:root, nil) %>

<div class="chatwrap" data-controller="sticky pending-flush chat-filter"
     data-chat-filter-key-value="<%= kase.id %>"
     data-pending-flush-frame-value="<%= chat_log_id(kase) %>">

  <div class="chat-head">
    <% if reports.size > 1 %>
      <%= render "fd/cases/thread_switch", kase: kase, reports: reports, thread: thread,
            names: names, reachable: reachable %>
    <% elsif thread %>
      <%= thread.anonymous? ? anonymous_face : avatar(thread.reporter_user_id) %>
      <span class="grow two-line">
        <b>
          <% if thread.anonymous? %>
            <%= thread.reporter_label(names) %>
          <% else %>
            <%= link_to thread.reporter_label(names), fd_member_path(thread.reporter_user_id),
                  class: "lnk", data: { turbo_frame: "person-drawer" } %>
          <% end %>
        </b>
        <span><%= chat_head_line([thread], kase, count: message_count) %></span>
      </span>
    <% elsif root %>
      <%= avatar(root.author_user_id) %>
      <span class="grow two-line">
        <b>
          <%= link_to names[root.author_user_id], fd_member_path(root.author_user_id),
                class: "lnk", data: { turbo_frame: "person-drawer" } %>
        </b>
        <span>reported it <%= on_day(root.posted_at) %></span>
      </span>
    <% else %>
      <span class="grow two-line">
        <b>Internal chat</b>
      </span>
    <% end %>
    <% if thread %>
      <span class="segmented chat-only" role="group" aria-label="Message filter">
        <button type="button" aria-pressed="true" data-chat-filter-target="all"
                data-action="chat-filter#showAll">All</button>
        <button type="button" aria-pressed="false" data-chat-filter-target="replies"
                data-action="chat-filter#onlyReplies">Replies</button>
      </span>
    <% end %>
  </div>

  <%= turbo_stream_from chat_stream(kase) %>
  <%= render "chat_log", kase: kase, reports: [thread].compact, chat: chat, earlier: earlier,
        messages: messages, queued: queued %>

  <% if composer && !kase.resolved? %>
    <div class="composer">
      <%= form_with url: fd_case_chats_path(kase), method: :post,
            data: { controller: "chat", chat_reporter_value: thread.present?,
                    chat_reporter_label_value: thread&.reporter_label(names).to_s,
                    chat_case_value: (thread.case_id.to_s if thread && thread.case_id != kase.id),
                    chat_note_url_value: fd_case_chats_path(kase),
                    chat_reply_url_value: fd_case_replies_path(kase) },
            html: { autocomplete: "off" } do %>
        <% if conversation %>
          <%= hidden_field_tag :conversation_id, conversation.id, id: nil %>
        <% end %>
        <div class="cfield" data-action="click->chat#focus" data-chat-target="box" data-recipient="team">
          <% if thread %>
            <span class="segmented chat-mode" role="group" aria-label="Recipient">
              <button type="button" aria-pressed="true" data-chat-target="team"
                      data-action="chat#messageTeam">Internal</button>
              <button type="button" aria-pressed="false" data-chat-target="reply"
                      data-action="chat#replyToReporter">Reply to <%= thread.reporter_label(names) %></button>
            </span>
          <% end %>
          <%= hidden_field_tag :anon, "", data: { chat_target: "anon" }, id: nil %>
          <div class="mention-field" data-controller="mention"
               data-mention-url-value="<%= fd_member_search_path(case_id: kase.id) %>">
            <%= text_area_tag :body, nil, rows: 1, class: "chat-input", id: nil,
                  maxlength: Fd::CaseChat::MAX_LENGTH,
                  aria: { label: "Message" },
                  placeholder: composer_hint(thread),
                  data: { chat_target: "field", mention_target: "field",
                          action: "input->mention#type input->chat#type " \
                                  "keydown->mention#keys keydown->chat#keys" } %>
            <div class="combo-pop menu-start" popover="manual" data-mention-target="pop">
              <div class="combo-list" data-mention-target="list"></div>
            </div>
          </div>

          <button type="submit" class="chat-send" data-chat-target="send" aria-label="Send">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
          </button>
        </div>
      <% end %>

    </div>
  <% end %>
</div>
