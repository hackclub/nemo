<div class="card card-flush">
  <div class="scroll">
    <table class="data-table queue-table">
      <thead>
        <tr>
          <th class="col-tick"></th>
          <th>what happened</th>
          <th>reported by</th>
          <th>who it is about</th>
          <th class="col-state">state</th>
          <th>on it</th>
          <th class="col-num">age</th>
        </tr>
      </thead>
      <tbody>
        <%= render "rows", cases: cases, priors_by_user: priors_by_user,
              thread_counts: thread_counts, flagged_counts: flagged_counts,
              live_action_counts: live_action_counts, violations: violations %>
      </tbody>
    </table>
  </div>
</div>
