<% violation = cases.any? && cases.all?(&:resolved?) %>
<div class="card card-flush">
  <div class="scroll">
    <table class="data-table queue-table">
      <thead>
        <tr>
          <th>case</th>
          <% if violation %><th>violation</th><% end %>
          <th>reported by</th>
          <th class="col-state">state</th>
          <th>subject</th>
          <th>on it</th>
          <th class="col-num">age</th>
        </tr>
      </thead>
      <tbody>
        <%= render "rows", cases: cases, violation: violation, priors_by_user: priors_by_user,
              thread_counts: thread_counts, flagged_counts: flagged_counts,
              live_action_counts: live_action_counts %>
      </tbody>
    </table>
  </div>
</div>
