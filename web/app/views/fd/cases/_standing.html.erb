<%= turbo_frame_tag "action-standing", data: { deactivated: guards.any?(&:deactivation?) } do %>
  <% if guards.any? %>
    <% family = kase.family_ids %>
    <div class="field-label">
      <span>Active guards</span>
      <div class="optlist">
        <% guards.each do |guard| %>
          <% attached = guard.on_case?(family) %>
          <% already_linked = attached || logged.include?(guard.id) %>
          <label class="opt">
            <%= radio_button_tag :standing_guard_id, guard.id, false, id: nil, disabled: already_linked,
                  data: { action: "change->action-standing#toggleFields" } %>
            <span class="opt-dot" aria-hidden="true"></span>
            <span class="opt-body">
              <span class="opt-label"><%= guard_kind_line(guard) %></span>
              <span class="opt-note">
                <%= already_linked ? already_attached_note(attached) : guard_option_note(guard, kase.id) %>
              </span>
            </span>
          </label>
        <% end %>
        <label class="opt">
          <%= radio_button_tag :standing_guard_id, "", true, id: nil,
                data: { action: "change->action-standing#toggleFields" } %>
          <span class="opt-dot" aria-hidden="true"></span>
          <span class="opt-body">
            <span class="opt-label">New action</span>
          </span>
        </label>
      </div>
    </div>
  <% end %>
<% end %>
