<div class="card card-flush">
  <div class="people-list">
    <% people.each do |person| %>
      <div class="person-block">
      <div class="line-row fat person-row">
        <%= face(person.user_id) %>
        <span class="grow two-line">
          <b><%= handle(person.user_id) %></b>
          <span><%= person_line(person, contexts[person.user_id], said_counts, total_messages) %></span>
        </span>
        <% person.records.each do |record| %>
          <span class="chip-token">
            <span class="chip <%= role_tone(record.role) %>"><%= role_label(record.role) %></span>
            <%= render "person_remove", kase: kase, person: record %>
          </span>
        <% end %>
        <% if priors.fetch(person.user_id, 0).positive? %>
          <%= prior_chip_for(priors.fetch(person.user_id)) %>
        <% end %>
        <%= link_to "Their history", fd_member_path(person.user_id), class: "btn",
              data: { turbo_frame: "person-drawer" } %>
      </div>
      <% Array(notes[person.user_id]).each do |note| %>
        <div class="person-note">
          <div class="note-body"><%= mentioned(note.body) %></div>
          <div class="sub2"><%= note_byline(note) %></div>
        </div>
      <% end %>
      </div>
    <% end %>

    <%= opens_modal "case.people", opens: "add-person", on: kase,
          css: "line-row fat person-add" do %>
      <span class="face-slot" aria-hidden="true">+</span>
      <span class="grow">Add somebody</span>
    <% end %>
  </div>
</div>

<%= render "mentioned", kase: kase, mentioned: mentioned %>
