<% said = chat_entries(reports, chat, messages, queued) %>
<% earlier_said = local_assigns.fetch(:earlier_said, 0) %>
<% limit = local_assigns.fetch(:limit, Fd::CaseChat::SHOWN) %>

<%= turbo_frame_tag chat_log_id(kase),
      data: { src: fd_case_chat_log_path(kase, thread: reports.first&.id) } do %>
<div id="chat-said-<%= kase.id %>" class="chatscroll" data-version="<%= Fd::ChatVersion.for(kase.id) %>"
     data-stick-target="log">
  <%= render "fd/cases/chat_entries", entries: said, earlier: earlier, earlier_said: earlier_said,
        limit: limit, kase: kase, reports: reports %>
</div>
<% end %>
