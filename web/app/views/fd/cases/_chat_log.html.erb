<% said = chat_entries(reports, chat, messages, queued) %>

<%= turbo_frame_tag chat_log_id(kase),
      data: { src: fd_case_chat_log_path(kase, thread: reports.first&.id) } do %>
<div id="chat-said-<%= kase.id %>" class="chat-log" data-version="<%= Fd::ChatVersion.for(kase.id) %>">
  <% if earlier.positive? %>
    <p class="sub2 chat-earlier"><%= pluralize(earlier, "earlier message") %> on the case page</p>
  <% end %>

  <%= render partial: "fd/cases/said", collection: said, as: :entry %>

  <% if said.empty? %>
    <p id="chat-empty-<%= kase.id %>" class="card-note">
      <% if reports.any? %>
        Nothing said yet.
      <% else %>
        No report on file. <%= member_link(kase.opened_by) %> opened this case directly.
      <% end %>
    </p>
  <% end %>
</div>
<% end %>
