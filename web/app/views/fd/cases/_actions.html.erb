<div class="list">
  <% actions.each do |action| %>
    <div class="lrow <%= "is-reversed" if action.reversed? %>">
      <span class="evdot <%= "act" unless action.reversed? %>" aria-hidden="true">
        <%= case_action_button("gauge", nil) %>
      </span>
      <span class="grow">
        <span class="lrow-head">
          <b><%= action_label(action.type_key) %></b>
          <%= action_state_chip(action) %>
        </span>
        <span class="sub"><%= action_reason(action) %></span>
        <% if action.solution.present? %>
          <span class="sub"><%= action_solution(action) %></span>
        <% end %>
        <span class="sub"><%= action_sentence(action) %></span>

        <% standing = action_standing_line(action, kase) %>
        <% if standing %>
          <span class="sub"><%= standing %></span>
        <% end %>
      </span>
      <span class="lrow-right">
        <% thread_url = action_thread_url(action) %>
        <% if thread_url %>
          <%= open_in_slack thread_url, css: "btn btn-sm" %>
        <% end %>
        <%= opens_modal "case.act", "Edit", opens: "edit-action-#{action.id}",
              on: kase, css: "btn btn-sm btn-ghost" %>
        <% unless action.reversed? %>
          <%= opens_modal reversal_capability(action), "Reverse", opens: "reverse-#{action.id}",
                on: kase, css: "btn btn-sm btn-ghost btn-ghost-danger" %>
        <% end %>
      </span>
    </div>
  <% end %>
</div>
