<div class="list">
  <% actions.each do |action| %>
    <div class="lrow <%= "is-reversed" if action.reversed? %>">
      <span class="evdot <%= "act" unless action.reversed? %>" aria-hidden="true">
        <%= case_action_button("gauge", nil) %>
      </span>
      <span class="grow">
        <span class="lrow-head">
          <b><%= action_label(action.type_key) %></b>
          <%= action_state_chip(action) %>
        </span>
        <span class="sub"><%= action_reason(action) %></span>
        <span class="sub"><%= action_sentence(action) %></span>

        <% cited = cited_messages[action.cites_message_id] if action.cites? %>
        <% if cited %>
          <div class="lcite">
            <div><%= cited.readable? ? cited.body : "no text held" %></div>
            <div class="sub">
              <%= member_link(cited.author_user_id) %> ·
              <%= channel_link(cited.channel_id) %> ·
              <%= cited.posted_at.strftime("%-d %b %H:%M") %>
            </div>
          </div>
        <% end %>

        <% standing = action_standing_line(action, kase) %>
        <% if standing %>
          <span class="sub"><%= standing %></span>
        <% end %>
      </span>
      <span class="lrow-right">
        <% unless action.reversed? %>
          <%= opens_modal "case.reverse", "Reverse it", opens: "reverse-#{action.id}",
                on: kase, css: "btn btn-sm btn-danger" %>
        <% end %>
      </span>
    </div>
  <% end %>
</div>
