<div class="todo">
  <p class="todo-t"><%= still_needed(missing) %></p>
  <div class="todo-row">
    <% if missing.include?(:subject) %>
      <%= opens_modal "case.people", "Pick a subject", opens: "add-person", on: kase %>
    <% end %>
    <% if missing.include?(:violation) %>
      <label for="set-category" class="btn">Set the violation</label>
    <% end %>
    <% if missing.include?(:evidence) %>
      <%= opens_modal "case.thread", "Attach evidence", opens: "attach-thread", on: kase %>
    <% end %>
  </div>
</div>
