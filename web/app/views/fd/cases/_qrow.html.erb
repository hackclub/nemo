<% said = violations_label(violations[kase.id] || [kase.category_key].compact, short: true) %>
<% priors = case_priors(kase, priors_by_user) %>
<span class="qtop">
  <%= row_reporter_face(kase) %>
  <span class="qid">#<%= kase.id %></span>
  <span class="qby trunc"><%= row_reporter_label(kase) %></span>
  <span class="qage <%= age_ink(case_age_seconds(kase)) unless kase.resolved? %>">
    <%= kase.resolved? ? "closed" : case_age_label(case_age_seconds(kase)) %>
  </span>
</span>

<% cited = case_cited(kase) %>
<% if cited %>
  <span class="qcite">
    <span class="qcite-head">
      <%= face(cited.author, css: "row-avatar qcite-face") %>
      <span class="qcite-who trunc"><%= names[cited.author] %></span>
      <% named = cited.channel.present? && channels.named?(cited.channel) %>
      <span class="qcite-how"><%= cited.word %><%= " from" if named %></span>
      <% if named %>
        <span class="qcite-in trunc"><%= channels[cited.channel] %></span>
      <% end %>
    </span>
    <span class="qcite-said"><%= plain_words(cited.body) %></span>
  </span>
<% else %>
  <span class="qsubj"><%= case_words(kase) %></span>
<% end %>

<span class="qmeta">
  <span class="qviol trunc"><%= said || "no violation set" %></span>
  <%= case_state_chip(kase, reachable: local_assigns[:reachable]) %>
  <% if priors.positive? %>
    <span class="qpriors"><%= pluralize(priors, "prior") %></span>
  <% end %>
  <% if kase.assigned? %>
    <span class="faces">
      <%= safe_join(kase.assignee_user_ids.map { |id| face(id) }) %>
    </span>
  <% end %>
</span>
