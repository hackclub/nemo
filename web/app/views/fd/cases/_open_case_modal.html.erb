<%= render layout: "fd/modal", locals: { id: "open-case", title: "Open a case",
      open: @open_modal } do %>
      <%= form_with url: fd_cases_path, method: :post, html: { autocomplete: "off" } do %>
        <div class="modal-body">
          <% if @open_for_subject.any? %>
            <div class="dup">
              <span>
                <b><%= already_open_line(@open_for_subject, @subject_preset) %></b>
                <% @open_for_subject.each do |other| %>
                  <%= link_to "##{other.id}", fd_case_path(other) %>
                  <%= category_label(other.category_key).downcase %>,
                  <%= case_age_label(case_age_seconds(other)) %><%= other.assigned? ? ", assigned to #{other.assignee_handles}" : ", unassigned" %>.
                <% end %>
              </span>
            </div>
          <% end %>

          <div class="field-label">
            <span>Who the case is about</span>
            <%= render "fd/member_picker", name: "subject_user_ids[]", single: false,
                  label: "search for who the case is about", preset: @subject_preset %>
          </div>

          <div class="field-label">
            <span>Category</span>
            <details class="picker" data-controller="picker" data-action="change->picker#choose">
              <summary class="select">
                <span data-picker-target="label" data-blank="Not sure yet"><%=
                  params[:category_key].present? ? category_label(params[:category_key]) : "Not sure yet"
                %></span>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <div class="menu-pop picker-pop">
                <label class="picker-opt">
                  <%= radio_button_tag :category_key, "", params[:category_key].blank?,
                        id: nil, data: { label: "Not sure yet" } %>
                  Not sure yet
                </label>
                <% Fd::Case::CATEGORIES.each do |key| %>
                  <label class="picker-opt">
                    <%= radio_button_tag :category_key, key, params[:category_key] == key,
                          id: nil, data: { label: category_label(key) } %>
                    <%= category_label(key) %>
                  </label>
                <% end %>
              </div>
            </details>
          </div>

          <label class="field-label">
            What happened
            <%= render "fd/mention_field", name: :body, value: params[:body], rows: 4,
                  placeholder: "type @ to name somebody" %>
          </label>

          <label class="opt">
            <%= hidden_field_tag :assign_to_me, "0", id: nil %>
            <%= check_box_tag :assign_to_me, "1", params.fetch(:assign_to_me, "1") == "1",
                  class: "tick" %>
            <span class="opt-dot" aria-hidden="true"></span>
            <span>
              <span class="opt-label">Assign it to me</span>
            </span>
          </label>
        </div>
        <div class="modal-foot">
          <% if @open_for_subject.any? %>
            <%= link_to "Add to ##{@open_for_subject.first.id} instead",
                  fd_case_path(@open_for_subject.first), class: "btn btn-aside" %>
          <% end %>
          <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Cancel</button>
          <% if @open_for_subject.any? %>
            <%= button_tag "Open it anyway, this is separate", name: "separate", value: "1",
                  class: "btn btn-primary" %>
          <% else %>
            <%= submit_tag "Open the case", class: "btn btn-primary" %>
          <% end %>
        </div>
      <% end %>
<% end %>
