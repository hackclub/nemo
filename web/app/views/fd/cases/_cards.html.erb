<div class="deck">
  <% cases.each do |kase| %>
    <div class="deck-card<%= " deck-done" if kase.resolved? %>"
         data-controller="row-link" data-row-link-href-value="<%= fd_case_path(kase) %>"
         data-action="click->row-link#go">
      <div class="deck-head">
        <%= face(kase.subject_user_ids.first, css: "person-face") %>
        <span class="grow two-line">
          <b>Case <%= kase.id %></b>
          <span class="<%= "is-none" if kase.subject_user_ids.empty? %>">
            <% if kase.subject_user_ids.one? %>
              <%= handle(kase.subject_user_ids.first) %>
            <% else %>
              <%= row_subject_label(kase) %>
            <% end %>
            <% if kase.duplicate_of %>
              &middot; <%= row_merged_phrase(kase) %>
            <% end %>
          </span>
        </span>
        <span class="deck-age <%= age_tone(case_age_seconds(kase)) %>">
          <%= kase.resolved? ? "resolved" : case_age_label(case_age_seconds(kase)) %>
        </span>
      </div>

      <p class="deck-meta"><%= case_meta_line(kase, thread_channels) %></p>

      <div class="deck-said">
        <% excerpt = case_excerpt(kase) %>
        <% if excerpt %>
          <p class="deck-body"><%= mentioned(excerpt) %></p>
        <% else %>
          <p class="deck-body is-none">No report on file.</p>
        <% end %>
      </div>

      <div class="deck-do">
        <%= link_to "Open", fd_case_path(kase), class: "btn btn-primary" %>
        <% unless kase.resolved? || kase.assigned? %>
          <%= gated_button "case.open", "Claim", fd_case_claim_path(kase), on: kase,
                css: "btn", method: :post %>
        <% end %>
        <span class="grow"></span>
        <% unless kase.resolved? %>
          <%= check_box_tag "case_ids[]", kase.id, false, id: "tick-#{kase.id}",
                form: "merge-form", class: "tick tick-case",
                data: { action: "change->merge#refresh" },
                aria: { label: "select case #{kase.id} to merge" } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
