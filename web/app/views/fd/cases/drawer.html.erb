<turbo-frame id="case-drawer">
  <div class="drawer-h">
    <%= row_avatar(@case) %>
    <b><span class="mono">#<%= @case.id %></span> · <%= subject_handles(@case) %></b>
    <%= case_status_chip(@case) %>
    <span style="flex:1"></span>
    <span class="kbd" data-action="click->case-drawer#close">esc</span>
    <%= link_to "open ↗", fd_case_path(@case), class: "btn ghost",
          data: { turbo_frame: "_top", case_drawer_target: "open" } %>
  </div>
  <div class="drawer-b">
    <p class="drawer-sub"><%= case_head_meta(@case, @reports) %></p>

    <%= render "fd/flagstrip", flags: @flags %>

    <% if @reports.any? %>
      <div class="card card-chat">
        <%= render "chat", kase: @case, reports: @reports, notes: [], composer: false %>
      </div>
    <% else %>
      <p class="card-note">No report on file.</p>
    <% end %>

    <div class="keys-bar">
      <% unless @case.resolved? %>
        <% if @case.assigned? %>
          <%= link_to fd_case_path(@case, do: "resolve"), class: "keys-item",
                data: { turbo_frame: "_top", case_drawer_target: "resolve" } do %>
            <span class="kbd">r</span><span>resolve</span>
          <% end %>
        <% else %>
          <%= form_with url: fd_case_claim_path(@case), method: :post,
                data: { case_drawer_target: "claim" } do %>
            <button type="submit" class="keys-item">
              <span class="kbd">a</span><span>claim</span>
            </button>
          <% end %>
        <% end %>
        <% if @merge_into %>
          <%= link_to fd_case_merge_path(@case, into: @merge_into.id), class: "keys-item",
                data: { turbo_frame: "_top", case_drawer_target: "merge" } do %>
            <span class="kbd">m</span><span>merge <%= @merge_into.id %></span>
          <% end %>
        <% end %>
      <% end %>
      <span class="kbd">↵</span><span>open the case</span>
    </div>
  </div>
</turbo-frame>
