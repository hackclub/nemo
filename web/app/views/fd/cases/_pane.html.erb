<section class="pane" aria-label="Case queue" data-controller="pane-filter">
  <div class="pane-head">
    <% tabs = views.select { |view| Fd::CaseQuery::TABS.include?(view.key) } %>
    <% primary_tabs, more_tabs = tabs.partition { |view| FdHelper::CASE_QUEUE_PRIMARY_VIEWS.include?(view.key) } %>
    <% current_more = more_tabs.find(&:current) %>
    <nav class="views" aria-label="Case views">
      <% primary_tabs.each do |view| %>
        <%= link_to fd_cases_path({ view: view.key }.merge(query.order_params)), class: "view",
              aria: { current: ("true" if view.current) } do %>
          <%= view.label %>
          <span class="view-count"><%= view.count %></span>
        <% end %>
      <% end %>
      <% if more_tabs.any? %>
        <%= render layout: "shared/dropdown", locals: {
              css: "views-more", trigger_css: "view", pop_css: "menu-start", label: "More case views",
              current: ("true" if current_more),
              trigger: safe_join([
                current_more&.label || "More",
                (tag.span(current_more.count, class: "view-count") if current_more),
                tag.svg(tag.path(d: "m6 9 6 6 6-6"), width: 12, height: 12, viewBox: "0 0 24 24", fill: "none",
                  stroke: "currentColor", "stroke-width": 2, "stroke-linecap": "round", "aria-hidden": true)
              ].compact) } do %>
          <% more_tabs.each do |view| %>
            <%= link_to fd_cases_path({ view: view.key }.merge(query.order_params)), aria: { current: ("true" if view.current) } do %>
              <%= view.label %>
              <span class="menu-val"><%= view.count %></span>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </nav>
    <div class="queue-tools">
      <label class="visually-hidden" for="pane-case-filter">Filter cases</label>
      <input class="input input-sm grow" id="pane-case-filter" type="search"
             autocomplete="off" placeholder="Filter cases"
             data-pane-filter-target="query" data-action="input->pane-filter#filter">
      <span class="segmented queue-order" role="group" aria-label="Sort order">
        <% { "desc" => "Newest", "asc" => "Oldest" }.each do |dir, label| %>
          <% order = query.reordered_params(dir) %>
          <%= link_to label, open_id ? fd_case_path(open_id, order) : fd_cases_path(order),
                aria: { current: ("true" if query["dir"] == dir) } %>
        <% end %>
      </span>
    </div>
    <% if query.view.nil? %>
      <div class="pane-filt">
        <span class="trunc"><%= named_text(query.title) %></span>
        <%= link_to "Clear", fd_cases_path, class: "lnk" %>
      </div>
    <% end %>
  </div>

  <div class="pane-list" data-pane-filter-target="list">
    <% if cases.any? %>
      <div aria-label="Cases">
        <% cases.each do |kase| %>
          <%= link_to fd_case_path(kase, query.to_params), class: "queue-row", role: "option",
                aria: { selected: (open_id == kase.id).to_s },
                data: { pane_filter_target: "row", action: "click->pane#hide" } do %>
            <%= render "fd/cases/queue_row", kase: kase, violations: violations,
                  priors_by_user: priors_by_user, reachable: local_assigns[:reachable] %>
          <% end %>
        <% end %>
      </div>
      <div class="empty pane-filter-empty" data-pane-filter-target="empty" hidden>
        <p class="empty-title">No matches</p>
      </div>
    <% else %>
      <div class="empty">
        <p class="empty-title"><%= query.empty_note %></p>
      </div>
    <% end %>
  </div>
</section>
