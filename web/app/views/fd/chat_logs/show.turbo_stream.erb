<% entries = chat_entries(@reports, @chat, @conversation_said, @queued) %>
<turbo-stream action="replace_chat" target="chat-said-<%= @case.id %>" version="<%= @version %>">
  <template>
    <%= render "fd/cases/chat_entries", entries: entries, earlier: @earlier_chat,
          earlier_said: @earlier_said, limit: @chat_limit, kase: @case, reports: @reports %>
  </template>
</turbo-stream>
