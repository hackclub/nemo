<% entries = @everything ? chat_entries(@reports, @chat, @conversation_messages, @queued) :
     changed_chat_entries(@reports, @chat_changed, @messages_changed, @queued_changed) %>
<% if entries.any? %><%= turbo_stream.remove("chat-empty-#{@case.id}") %><% end %>
<% @gone.each do |id| %><%= turbo_stream.remove("message-queued-#{id}") %><% end %>
<turbo-stream action="upsert" target="chat-messages-<%= @case.id %>" version="<%= @version %>">
  <template><%
    last_entry = nil
    entries.each do |entry|
  %><%= render partial: "fd/cases/message",
        locals: { entry: entry, grouped: grouped_with?(entry, last_entry) },
        formats: [:html] %><%
      last_entry = entry
    end
  %></template>
</turbo-stream>
