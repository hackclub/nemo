<% held = account&.live? ? account : nil %>
<% gone = account&.given_up? ? account : nil %>
<% told = gone || (held&.stumbled? && held) %>

<div class="panel-body">
  <% if told %>
    <div class="fbox fbox-warn">
      <div class="ft">Slack refused your link <%= last_case_label(told.last_error_at) %></div>
      <div class="fb">
        <div class="fb-line">
          <code class="mono"><%= told.last_error %></code>. Since then your replies have gone
          out as <b>nemo</b>, not as you.
        </div>
        <% if linkable %>
          <div class="fb-do">
            <%= button_to "Link Slack again", fd_slack_account_path, class: "btn btn-primary",
                  form: { class: "contents", data: { turbo: false } } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="fbox">
    <div class="ft">Your Slack account</div>
    <div class="fb">
      <div class="who">
        <%= face(current_staff.user_id) %>
        <span class="grow two-line">
          <b><%= current_profile&.display_name || current_staff.user_id %></b>
          <span class="mono"><%= current_staff.user_id %></span>
        </span>
        <% if held %>
          <%= button_to "Unlink", fd_slack_account_path, method: :delete, class: "btn",
                form: { class: "contents", data: { turbo_confirm:
                  "Unlink Slack? Your replies go out through nemo instead." } } %>
        <% elsif linkable %>
          <%= button_to(gone ? "Link Slack again" : "Link Slack", fd_slack_account_path,
                class: "btn btn-primary", form: { class: "contents", data: { turbo: false } }) %>
        <% end %>
      </div>

      <% if held %>
        <div class="sub2 mono"><%= held.scopes %></div>
        <div class="sub2">
          linked <%= last_case_label(held.granted_at) %> &middot;
          used <%= last_case_label(held.last_used_at) %>
        </div>
      <% elsif !linkable %>
        <div class="sub2">Linking is not set up on this server.</div>
      <% end %>
    </div>
  </div>

  <div class="fbox">
    <div class="ft">Appearance</div>
    <div class="fb">
      <%= link_to "Theme and contrast", fd_settings_path(tab: "appearance"), class: "btn" %>
    </div>
  </div>
</div>
