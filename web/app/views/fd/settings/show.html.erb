<% content_for :page_title, "Settings" %>
<% content_for :page_subtitle do %>
  <%= role_tally(@grants) %>
<% end %>
<% if current_staff.may?("access.grant") %>
  <% content_for :head_actions do %>
    <label for="give-access" class="btn btn-primary">Give access</label>
  <% end %>
<% end %>

<div class="stack">
  <div class="views">
    <% Fd::SettingsController::TABS.each do |key, label| %>
      <%= link_to fd_settings_path(key == "access" ? {} : { tab: key }), class: "view",
            aria: { current: ("true" if key == @tab) } do %>
        <%= label %>
        <% if @counts[key] %>
          <span class="view-count"><%= @counts[key] %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <% if @tab != "history" %>
    <% @dormant.each do |grant| %>
      <% next unless @tab == "access" %>
      <div class="strip">
        <b><%= names[grant.user_id] %> has held a <%= grant.role.tr("_", " ") %> grant
          since <%= grant.granted_at.strftime("%b %Y") %> and done nothing</b>
      </div>
    <% end %>

    <% if @tab == "roles" %>
    <% Fd::Permission.by_area.each do |area, keys| %>
      <p class="band-label"><%= area %> · <%= keys.size %></p>
      <div class="card card-flush">
        <div class="scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Permission</th>
                <th class="said-cell">What it lets them do</th>
                <% Fd::Permission::ROLES.each do |role| %>
                  <th class="col-num"><%= Fd::Permission::ROLE_LABELS.fetch(role) %></th>
                <% end %>
                <th class="col-num">Used 30d</th>
              </tr>
            </thead>
            <tbody>
              <% keys.each do |key| %>
                <tr>
                  <td class="mono"><%= key %></td>
                  <td class="said-cell"><%= Fd::Permission.label(key) %></td>
                  <% Fd::Permission::ROLES.each do |role| %>
                    <td class="col-num">
                      <%= holds_mark(Fd::Permission.roles(key).include?(role)) %>
                    </td>
                  <% end %>
                  <td class="col-num"><%= @used[key] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
    <% elsif @tab == "usage" %>
      <div class="kpis">
        <div class="card">
          <p class="kpi-label">Grants held</p>
          <p class="kpi-val"><%= @grants.size %></p>
          <div class="delta-note"><%= grant_change_note(@given, @taken_back) %></div>
        </div>
        <div class="card">
          <p class="kpi-label">Identity reads</p>
          <p class="kpi-val"><%= @reads_total %></p>
          <div class="delta-note"><%= reads_note(@read_counts, @top_reader) %></div>
        </div>
        <div class="card">
          <p class="kpi-label">Refused attempts</p>
          <p class="kpi-val"><%= @refused_total %></p>
          <div class="delta-note"><%= refused_note(@refused_kinds) %></div>
        </div>
        <div class="card">
          <p class="kpi-label">Grants unused</p>
          <p class="kpi-val"><%= @dormant.size %></p>
          <div class="delta-note">
            <%= dormant_note(@dormant, Fd::SettingsController::DORMANT_SHOWN) %>
          </div>
        </div>
      </div>

      <div class="card card-flush">
        <div class="scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Person</th>
                <th class="col-num">Cases</th>
                <th class="col-num">Actions</th>
                <th class="col-num">Reversed</th>
                <th class="col-num">Reads</th>
                <th class="col-num">Refused</th>
                <th>Share of the load</th>
              </tr>
            </thead>
            <tbody>
              <% @load.each do |row| %>
                <tr>
                  <td>
                    <span class="two-line">
                      <b>
                        <%= link_to names[row.user_id], fd_settings_path(person: row.user_id) %>
                        <%= role_chip(row.role) %>
                      </b>
                      <span class="idline"><%= acted_line(@last_acted[row.user_id]) %></span>
                    </span>
                  </td>
                  <td class="col-num"><%= row.cases %></td>
                  <td class="col-num"><%= row.actions %></td>
                  <td class="col-num"><%= row.reversals %></td>
                  <td class="col-num"><%= row.reads %></td>
                  <td class="col-num"><%= row.refused %></td>
                  <td><%= load_bar(row.share) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <% elsif @person %>
      <div class="inspector">
        <div class="index-side">
          <% @grants.each do |grant| %>
            <%= link_to fd_settings_path(person: grant.user_id), class: "index-item",
                  aria: { current: (grant.user_id == @person.user_id ? "true" : nil) } do %>
              <span class="index-face"><%= names.initial(grant.user_id) %></span>
              <%= names[grant.user_id] %>
              <%= role_chip(grant.role) %>
            <% end %>
          <% end %>
        </div>

        <div class="pane">
          <div class="mcard-top">
            <span class="mcard-face"><%= names.initial(@person.user_id) %></span>
            <span>
              <span class="mcard-name">
                <%= names[@person.user_id] %>
                <%= role_chip(@role) %>
              </span>
              <span class="mcard-sub">
                <span class="mono"><%= @person.user_id %></span>
                <span>·</span>
                since <%= @person.granted_at.strftime("%-d %b %Y") %>
                <span>·</span>
                given by <%= given_by(@person.granted_by) %>
                <% if @person.reason.present? %>
                  <span>·</span>
                  <span class="said-cell"><%= @person.reason %></span>
                <% end %>
              </span>
            </span>
            <span class="mcard-acts">
              <% if current_staff.may?("access.grant") %>
                <label for="change-access" class="btn">Change</label>
              <% end %>
              <%= link_to "Everyone", fd_settings_path, class: "btn" %>
            </span>
          </div>

          <div>
            <p class="band-label">What they did with it · 30 days</p>
            <div class="lines">
              <% @did.select { |_key, count| count.positive? }.each do |key, count| %>
                <span class="line-row">
                  <b><%= Fd::Permission.label(key) %></b>
                  <span class="mono"><%= key %></span>
                  <span class="line-end"><%= count %></span>
                </span>
              <% end %>
              <span class="line-row">
                <b>Identity reads</b>
                <span class="mono">identity.read</span>
                <span class="line-end"><%= @reads %></span>
              </span>
            </div>
          </div>

          <div>
            <p class="band-label">What the role does not cover · <%= @cannot.size %></p>
            <% if @cannot.any? %>
              <div class="lines">
                <% @cannot.each do |key| %>
                  <span class="line-row">
                    <b><%= Fd::Permission.label(key) %></b>
                    <span class="mono"><%= key %></span>
                    <span class="line-end">
                      <%= Fd::Permission::ROLE_LABELS.fetch(Fd::Permission.least(key)).downcase %> only
                    </span>
                  </span>
                <% end %>
              </div>
            <% else %>
              <p class="card-note">Nothing. They hold the lot.</p>
            <% end %>
          </div>

          <div>
            <p class="band-label">Refused · <%= @refused.size %></p>
            <% if @refused.any? %>
              <div class="lines">
                <% @refused.each do |row| %>
                  <span class="line-row">
                    <b><%= Fd::Permission.label(row.after["permission"]) %></b>
                    <span><%= row.entity_type %> <%= row.entity_id.positive? ? row.entity_id : nil %></span>
                    <span class="line-end"><%= row.occurred_at.strftime("%-d %b %H:%M") %></span>
                  </span>
                <% end %>
              </div>
            <% else %>
              <p class="card-note">Never refused.</p>
            <% end %>
          </div>
        </div>
      </div>
    <% elsif @grants.any? %>
      <div class="card card-flush">
        <div class="scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Person</th>
                <th class="col-role">Role</th>
                <th>Since</th>
                <th>Given by</th>
                <th class="col-num">Acted 30d</th>
                <th>Last acted</th>
              </tr>
            </thead>
            <tbody>
              <% @grants.each do |grant| %>
                <tr>
                  <td>
                    <span class="two-line">
                      <%= link_to fd_settings_path(person: grant.user_id) do %>
                        <b><%= names[grant.user_id] %></b>
                      <% end %>
                      <span class="idline mono"><%= grant.user_id %></span>
                    </span>
                  </td>
                  <td class="col-role"><%= role_chip(grant.role) %></td>
                  <td><%= grant.granted_at.strftime("%b %Y") %></td>
                  <td><%= given_by(grant.granted_by) %></td>
                  <td class="col-num"><%= @acted[grant.user_id] || 0 %></td>
                  <td><%= acted_label(@last_acted[grant.user_id]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="card">
        <p class="card-note">Nobody holds a grant yet.</p>
      </div>
    <% end %>
  <% else %>
    <div class="card card-flush">
      <div class="scroll">
        <table class="data-table">
          <tbody>
            <% @history.each do |grant| %>
              <tr>
                <td>
                  <span class="two-line">
                    <b><%= names[grant.user_id] %></b>
                    <span class="idline"><%= grant.role.tr("_", " ") %></span>
                  </span>
                </td>
                <td class="said-cell"><%= grant.reason %></td>
                <td><%= grant_span(grant) %></td>
                <td class="col-state"><%= grant_state_chip(grant) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

<% if current_staff.may?("access.grant") %>
  <%= render "fd/settings/give_modal" %>
  <% if @person %>
    <%= render "fd/settings/change_modal", grant: @person %>
  <% end %>
<% end %>
