<% content_for :page_title, "Settings" %>
<% if @grants && current_staff.may?("access.grant") %>
  <% content_for :head_actions do %>
    <label for="give-access" class="btn btn-primary" tabindex="0" role="button">Give access</label>
  <% end %>
<% end %>

<% roles = Fd::Permission::ROLES %>

<div class="cols <%= "c-2" if %w[usage you activity].include?(@tab) && !@person %>">
  <div class="panel">
    <div class="views">
      <% @tabs.each do |key, label| %>
        <%= link_to fd_settings_path(key == "access" ? {} : { tab: key }), class: "view",
              aria: { current: ("true" if key == @tab) } do %>
          <span><%= label %></span>
          <% if @counts[key] %>
            <span class="view-count"><%= @counts[key] %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <% if @tab == "activity" %>
      <div class="panel-head">
        <b>What you did</b>
        <span class="qspacer"></span>
        <span class="qlab">last 30 days &middot; only your own</span>
      </div>
      <% if @deeds.rows.any? %>
        <div class="scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>what</th>
                <th class="said-cell">about</th>
                <th class="col-num">when</th>
              </tr>
            </thead>
            <tbody>
              <% @deeds.rows.each do |deed| %>
                <tr>
                  <td><b><%= deed_head(deed) %></b></td>
                  <td class="said-cell"><%= deed_said(deed) %></td>
                  <td class="mono col-num"><%= deed.at.strftime("%-d %b %H:%M") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty">
          <p class="empty-title">Nothing in 30 days</p>
        </div>
      <% end %>

    <% elsif @tab == "you" %>
      <%= render "you", account: @account, linkable: @linkable %>

    <% elsif @tab == "roles" %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Permission</th>
              <th class="said-cell">What it lets them do</th>
              <% roles.each do |role| %>
                <th class="col-num"><%= Fd::Permission::ROLE_LABELS.fetch(role) %></th>
              <% end %>
              <th class="col-num">Used 30d</th>
            </tr>
          </thead>
          <tbody>
            <% Fd::Permission.by_area.each do |area, keys| %>
              <tr class="band-row">
                <td colspan="<%= roles.size + 3 %>"><%= area %> &middot; <%= keys.size %></td>
              </tr>
              <% keys.each do |key| %>
                <tr>
                  <td class="mono"><%= key %> <%= moved_chip(key) %></td>
                  <td class="said-cell"><%= Fd::Permission.label(key) %></td>
                  <% roles.each do |role| %>
                    <td class="col-num"><%= role_switch(key, role) %></td>
                  <% end %>
                  <td class="col-num"><%= @used[key] %></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

    <% elsif @tab == "api" %>
      <div class="panel-body">
        <div class="kpis">
          <div>
            <p class="kpi-label">Opted in</p>
            <p class="kpi-val"><%= number_with_delimiter(@opted_in) %></p>
            <p class="car"><%= pluralize(Api::Capability::KEYS.size, "capability") %></p>
          </div>
          <div>
            <p class="kpi-label">Live tokens</p>
            <p class="kpi-val"><%= @tokens.count { |one| !one.spent? } %></p>
            <p class="car">across <%= @tokens.map(&:owner_user_id).uniq.size %> owners</p>
          </div>
          <div>
            <p class="kpi-label">Checks, 30 days</p>
            <p class="kpi-val"><%= number_with_delimiter(@checks) %></p>
            <p class="car"><%= pluralize(@channels, "channel") %></p>
          </div>
          <div>
            <p class="kpi-label">Withheld</p>
            <p class="kpi-val"><%= number_with_delimiter(@withheld) %></p>
            <p class="car"><%= withheld_share(@withheld, @checks) %></p>
          </div>
        </div>

        <div class="fbox">
          <div class="ft">
            <span>How it runs</span>
            <span class="cap-do">
              <%= api_state_chip %>
              <%= flag_switch(:public_api) %>
            </span>
          </div>
          <div class="rows">
            <% @dials.each do |key, value| %>
              <div class="row">
                <span class="row-k"><%= dial_label(key) %></span>
                <span class="cap-do">
                  <b class="row-v"><%= value %></b>
                  <label for="dial-<%= key %>" class="text-btn" tabindex="0"
                         role="button">Change</label>
                </span>
              </div>
            <% end %>
            <div class="row">
              <span class="row-k">Manager data last read</span>
              <b class="row-v <%= "is-none" unless @synced %>"><%= synced_line(@synced) %></b>
            </div>
            <div class="row">
              <span class="row-k">Last changed</span>
              <b class="row-v <%= "is-none" unless @last_dial %>"><%= dial_change(@last_dial) %></b>
            </div>
          </div>
        </div>
      </div>

      <div class="panel-head">
        <b>Every token</b>
        <span class="qspacer"></span>
        <span class="qlab">
          <%= @tokens.count { |one| !one.spent? } %> live &middot;
          <%= @tokens.count(&:spent?) %> spent
        </span>
      </div>

      <% if @tokens.any? %>
        <div class="scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>owner</th>
                <th>name</th>
                <th>key</th>
                <th class="col-num">rate</th>
                <th class="col-num">expires</th>
                <th class="col-num">asks 30d</th>
                <th class="col-date">last used</th>
                <th class="col-btn"></th>
              </tr>
            </thead>
            <tbody>
              <% @tokens.each do |token| %>
                <tr>
                  <td>
                    <span class="row-name">
                      <%= face(token.owner_user_id) %>
                      <b><%= names[token.owner_user_id] %></b>
                    </span>
                  </td>
                  <td class="<%= "sub2" if token.revoked? %>"><%= token.name %></td>
                  <td class="mono"><%= token.shown %></td>
                  <td class="col-num mono <%= "rate-own" if token.rate_limit %>">
                    <%= token.revoked? ? "n/a" : token.rate %>
                  </td>
                  <td class="col-num mono"><%= token.spent? ? "n/a" : token.dies_in %></td>
                  <td class="col-num"><%= number_with_delimiter(@asks[token.id].to_i) %></td>
                  <td class="col-date mono">
                    <%= token.last_used_at ? time_ago_in_words(token.last_used_at) : "never" %>
                  </td>
                  <td class="col-btn">
                    <% if token.revoked? %>
                      <span class="chip chip-crit">
                        Revoked <%= token.revoked_at.strftime("%-d %b") %>
                      </span>
                    <% else %>
                      <label for="rate-<%= token.id %>" class="text-btn" tabindex="0"
                             role="button">Set rate</label>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="empty">
          <p class="empty-title">Nobody holds a token</p>
        </div>
      <% end %>

    <% elsif @tab == "sections" %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Section</th>
              <th class="said-cell">What it covers</th>
              <th>Who loses it</th>
              <th class="col-num">Showing</th>
            </tr>
          </thead>
          <tbody>
            <% holders = Fd::AccessGrant.live.count %>
            <% Fd::Flag::KEYS.each do |key| %>
              <tr>
                <td><b><%= Fd::Flag.label(key) %></b></td>
                <td class="said-cell"><%= Fd::Flag.covers(key) %></td>
                <td class="sub2">
                  <%= Fd::Flag.audience(key) || pluralize(holders, "person") %>
                </td>
                <td class="col-num"><%= flag_switch(key) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% elsif @tab == "usage" && @person %>
      <div class="panel-body">
        <div class="who">
          <%= face(@person.user_id) %>
          <span class="grow two-line">
            <b><%= names[@person.user_id] %> <%= role_chip(@role) %></b>
            <span><%= acted_line(@last_acted[@person.user_id]) %></span>
          </span>
          <%= link_to "The grant", fd_settings_path(person: @person.user_id), class: "btn" %>
          <%= link_to "Everyone", fd_settings_path(tab: "usage"), class: "btn btn-ghost" %>
        </div>

        <div class="facts-grid stat-row">
          <div class="cell"><span class="fg-k">Cases</span><span class="fg-v"><%= @mine.cases %></span></div>
          <div class="cell"><span class="fg-k">Actions</span><span class="fg-v"><%= @mine.actions %></span></div>
          <div class="cell"><span class="fg-k">Reversed</span><span class="fg-v"><%= @mine.reversals %></span></div>
          <div class="cell"><span class="fg-k">Reads</span><span class="fg-v"><%= @mine.reads %></span></div>
          <div class="cell"><span class="fg-k">Refused</span><span class="fg-v"><%= @mine.refused %></span></div>
          <div class="cell"><span class="fg-k">Share</span><span class="fg-v"><%= @mine.share %>%</span></div>
        </div>

        <div class="fbox">
          <div class="ft">What they did with it &middot; 30 days</div>
          <div class="rows">
            <% @did.select { |_key, count| count.positive? }.each do |key, count| %>
              <%= link_to did_path(@person, key, @asked), class: "row",
                    aria: { current: ("true" if @asked == key) } do %>
                <span class="row-k">
                  <b><%= Fd::Permission.label(key) %></b>
                  <span class="mono"><%= key %></span>
                </span>
                <span class="row-v"><%= count %></span>
              <% end %>
            <% end %>
            <%= link_to did_path(@person, "identity.read", @asked), class: "row",
                  aria: { current: ("true" if @asked == "identity.read") } do %>
              <span class="row-k">
                <b>Identity reads</b>
                <span class="mono">identity.read</span>
              </span>
              <span class="row-v"><%= @reads %></span>
            <% end %>
          </div>
        </div>

        <div class="fbox">
          <div class="ft">
            <%= @asked ? Fd::Permission.label(@asked) : "Newest first" %>
            <span class="chip"><%= @deeds.rows.size %></span>
          </div>
          <% if @deeds.rows.any? %>
            <div class="rows">
              <% @deeds.rows.each do |deed| %>
                <span class="row">
                  <span class="row-k"><b><%= deed_head(deed) %></b> <%= deed_said(deed) %></span>
                  <span class="row-v"><%= deed.at.strftime("%-d %b %H:%M") %></span>
                </span>
              <% end %>
            </div>
          <% else %>
            <div class="fb"><span class="sub2">Nothing in 30 days.</span></div>
          <% end %>
        </div>

        <div class="fbox <%= "fbox-warn" if @refused.any? %>">
          <div class="ft">Refused <span class="chip"><%= @refused.size %></span></div>
          <% if @refused.any? %>
            <div class="rows">
              <% @refused.each do |row| %>
                <span class="row">
                  <span class="row-k">
                    <%= Fd::Permission.label(row.after["permission"]) %>
                    <%= "#{row.entity_type} #{row.entity_id}" if row.entity_id.positive? %>
                  </span>
                  <span class="row-v"><%= row.occurred_at.strftime("%-d %b %H:%M") %></span>
                </span>
              <% end %>
            </div>
          <% else %>
            <div class="fb"><span class="sub2">Never refused.</span></div>
          <% end %>
        </div>
      </div>

    <% elsif @tab == "usage" %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Person</th>
              <th class="col-num">Cases</th>
              <th class="col-num">Actions</th>
              <th class="col-num">Reversed</th>
              <th class="col-num">Refused</th>
              <th>Share of the load</th>
            </tr>
          </thead>
          <tbody>
            <% @load.each do |row| %>
              <tr>
                <td>
                  <span class="row-name">
                    <%= face(row.user_id) %>
                    <span class="two-line">
                      <%= link_to fd_settings_path(tab: "usage", person: row.user_id) do %>
                        <b><%= names[row.user_id] %></b>
                      <% end %>
                      <span><%= acted_line(@last_acted[row.user_id]) %></span>
                    </span>
                  </span>
                </td>
                <td class="col-num"><%= tally_link(row.user_id, row.cases) %></td>
                <td class="col-num"><%= tally_link(row.user_id, row.actions, "case.act") %></td>
                <td class="col-num">
                  <%= tally_link(row.user_id, row.reversals, "case.reverse") %>
                </td>
                <td class="col-num"><%= tally_link(row.user_id, row.refused) %></td>
                <td><%= load_bar(row.share) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% elsif @person %>
      <div class="panel-body">
        <div class="who">
          <%= face(@person.user_id) %>
          <span class="grow two-line">
            <b><%= names[@person.user_id] %> <%= role_chip(@role) %></b>
            <span>
              since <%= on_day(@person.granted_at) %>,
              given by <%= given_by(@person.granted_by) %>
            </span>
          </span>
          <% if current_staff.may?("access.grant") %>
            <label for="change-access" class="btn" tabindex="0" role="button">Change</label>
          <% end %>
          <%= link_to "What they did", fd_settings_path(tab: "usage",
                person: @person.user_id), class: "btn" %>
          <%= link_to "Everyone", fd_settings_path, class: "btn btn-ghost" %>
        </div>

        <% if @person.reason.present? %>
          <div class="outcome"><%= @person.reason %></div>
        <% end %>

        <div class="fbox">
          <div class="ft">
            What the role does not cover <span class="chip"><%= @cannot.size %></span>
          </div>
          <% if @cannot.any? %>
            <div class="rows">
              <% @cannot.each do |key| %>
                <span class="row">
                  <span class="row-k"><%= Fd::Permission.label(key) %></span>
                  <span class="row-v">
                    <%= Fd::Permission::ROLE_LABELS.fetch(Fd::Permission.least(key)).downcase %>
                    only
                  </span>
                </span>
              <% end %>
            </div>
          <% else %>
            <div class="fb"><span class="sub2">Nothing. They hold the lot.</span></div>
          <% end %>
        </div>
      </div>

    <% elsif @tab == "history" %>
      <div class="scroll">
        <table class="data-table record-table">
          <colgroup>
            <col style="width: 14%">
            <col style="width: 44%">
            <col style="width: 20%">
            <col style="width: 22%">
          </colgroup>
          <thead>
            <tr>
              <th>Happened</th>
              <th>What</th>
              <th>Who</th>
              <th>When</th>
            </tr>
          </thead>
          <tbody>
            <% @history.each do |grant| %>
              <tr>
                <td><%= grant_state_chip(grant) %></td>
                <td>
                  <span class="two-line">
                    <b><%= names[grant.user_id] %>, <%= grant.role.tr("_", " ") %></b>
                    <span class="said-cell">
                      <%= grant.reason.presence || "no reason given" %>
                    </span>
                  </span>
                </td>
                <td class="sub2"><%= given_by(grant.granted_by) %></td>
                <td class="sub2"><%= grant_span(grant) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% elsif @grants.any? %>
      <% if @dormant.any? %>
        <div class="panel-body">
          <% @dormant.each do |grant| %>
            <div class="todo">
              <p class="todo-t">
                <%= names[grant.user_id] %> has held a
                <%= grant.role.tr("_", " ") %> grant since
                <%= grant.granted_at.strftime("%b %Y") %> and done nothing
              </p>
              <div class="todo-row">
                <%= link_to "See what they can do", fd_settings_path(person: grant.user_id),
                      class: "btn" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <div class="scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Person</th>
              <th class="col-role">Role</th>
              <th>Since</th>
              <th>Given by</th>
              <th class="col-num">Acted 30d</th>
              <th>Last acted</th>
            </tr>
          </thead>
          <tbody>
            <% @grants.each do |grant| %>
              <tr>
                <td>
                  <span class="row-name">
                    <%= face(grant.user_id) %>
                    <span class="two-line">
                      <%= link_to fd_settings_path(person: grant.user_id) do %>
                        <b><%= names[grant.user_id] %></b>
                      <% end %>
                      <span class="mono"><%= grant.user_id %></span>
                    </span>
                  </span>
                </td>
                <td class="col-role">
                  <%= role_chip(grant.role) %>
                  <% if @linked.include?(grant.user_id) %>
                    <span class="chip chip-good">slack</span>
                  <% end %>
                </td>
                <td><%= grant.granted_at.strftime("%b %Y") %></td>
                <td><%= given_by(grant.granted_by) %></td>
                <td class="col-num"><%= @acted[grant.user_id] || 0 %></td>
                <td><%= acted_label(@last_acted[grant.user_id]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    <% else %>
      <div class="empty">
        <p class="empty-title">Nobody holds a grant yet</p>
        <% if current_staff.may?("access.grant") %>
          <label for="give-access" class="btn btn-primary" tabindex="0"
                 role="button">Give access</label>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @tab == "usage" && !@person %>
    <div class="facts">
      <p class="facts-h">Thirty days</p>
      <div class="facts-grid">
        <div class="cell">
          <span class="fg-k">Grants held</span>
          <span class="fg-v"><%= @grants.size %></span>
        </div>
        <div class="cell">
          <span class="fg-k">Reads</span>
          <span class="fg-v"><%= @reads_total %></span>
        </div>
        <div class="cell">
          <span class="fg-k">Refused</span>
          <span class="fg-v"><%= @refused_total %></span>
        </div>
        <div class="cell">
          <span class="fg-k">Unused</span>
          <span class="fg-v"><%= @dormant.size %></span>
        </div>
      </div>

      <div class="fbox">
        <div class="ft">Identity reads</div>
        <% ranked = @read_counts.sort_by { |_who, count| -count }.first(4) %>
        <% if ranked.any? %>
          <% most = ranked.first.last %>
          <div class="rows">
            <% ranked.each do |who, count| %>
              <div class="bar-row">
                <span class="row-k"><%= names[who] %></span>
                <span class="row-v"><%= count %></span>
                <span class="bar-track">
                  <span class="bar-fill" style="width: <%= share_of(count, most) %>%"></span>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="fb"><span class="sub2">Nobody read an identity in 30 days.</span></div>
        <% end %>
      </div>

      <div class="fbox <%= "fbox-warn" if @refused_total.positive? %>">
        <div class="ft">Refused attempts</div>
        <div class="fb">
          <div class="rail-line"><%= refused_note(@refused_kinds) %></div>
        </div>
      </div>

      <div class="fbox">
        <div class="ft">Grants</div>
        <div class="fb">
          <div class="rail-line"><%= grant_change_note(@given, @taken_back) %></div>
          <div class="rail-line">
            <%= dormant_note(@dormant, Fd::SettingsController::DORMANT_SHOWN) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% if %w[you activity].include?(@tab) %>
    <div class="facts">
      <p class="facts-h">You</p>
      <div class="fbox">
        <div class="ft">Signed in</div>
        <div class="fb">
          <div class="who">
            <%= face(current_staff.user_id) %>
            <span class="two-line">
              <b><%= current_profile&.display_name || current_staff.user_id %></b>
              <span>via Hack Club</span>
            </span>
          </div>
        </div>
      </div>
      <div class="fbox">
        <div class="ft">Your role <%= role_chip(current_staff.role) %></div>
        <div class="fb">
          <div class="rail-line">
            Holds <b><%= Fd::Permission.keys.count { |key|
              Fd::Permission.roles(key).include?(current_staff.role) } %></b>
            of <%= Fd::Permission.keys.size %> permissions.
          </div>
        </div>
      </div>
      <% if @yours %>
        <div class="facts-grid">
          <div class="cell">
            <span class="fg-k">Cases 30d</span>
            <span class="fg-v"><%= @yours[:cases] %></span>
          </div>
          <div class="cell">
            <span class="fg-k">Actions</span>
            <span class="fg-v"><%= @yours[:actions] %></span>
          </div>
          <div class="cell">
            <span class="fg-k">Reads</span>
            <span class="fg-v"><%= @yours[:reads] %></span>
          </div>
          <div class="cell">
            <span class="fg-k">Refused</span>
            <span class="fg-v"><%= @yours[:refused] %></span>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<% if current_staff.may?("access.grant") %>
  <% if @tab == "api" %>
    <%= render "fd/settings/api_modals" %>
  <% end %>
  <%= render "fd/settings/give_modal" %>
  <% if @person %>
    <%= render "fd/settings/change_modal", grant: @person %>
  <% end %>
<% end %>
