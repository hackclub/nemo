<% content_for :page_title, "Audit log" %>

<div class="panel">
  <div class="panel-head">
    <b>Everything firefighters did</b>
    <span class="qspacer"></span>
    <span class="qlab">
      last 30 days &middot; <%= pluralize(@total, "entry") %>
      &middot; page <%= @page %> of <%= @pages %>
    </span>
  </div>

  <% if @rows.any? %>
    <div class="scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>who</th>
            <th>what</th>
            <th class="said-cell">about</th>
            <th class="col-num">when</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |deed| %>
            <tr>
              <td>
                <% if deed.actor %>
                  <span class="row-name">
                    <%= face(deed.actor) %>
                    <b><%= names[deed.actor] %></b>
                  </span>
                <% else %>
                  <span class="sub2">n/a</span>
                <% end %>
              </td>
              <td><b><%= deed_head(deed) %></b></td>
              <td class="said-cell"><%= deed_said(deed) %></td>
              <td class="mono col-num"><%= deed.at.strftime("%-d %b %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @pages > 1 %>
      <div class="pager">
        <% if @page > 1 %>
          <%= link_to "Back", fd_audit_path(page: @page - 1), class: "btn" %>
        <% else %>
          <span class="btn is-off">Back</span>
        <% end %>
        <span class="pager-at">Page <%= @page %> of <%= @pages %></span>
        <% if @page < @pages %>
          <%= link_to "Next", fd_audit_path(page: @page + 1), class: "btn" %>
        <% else %>
          <span class="btn is-off">Next</span>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="empty">
      <p class="empty-title">Nothing logged in 30 days</p>
    </div>
  <% end %>
</div>
