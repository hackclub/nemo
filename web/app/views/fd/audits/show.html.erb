<% content_for :page_title, "Audit log" %>

<div class="stack">
  <% if @rows.any? %>
    <div class="card card-flush">
      <%= render "shared/log", deeds: @rows, actors: true, names: names %>
    </div>

    <%= render "shared/pager", page: @page, pages: @pages,
          said: "#{pluralize(@total, 'entry')} &middot; page #{@page} of #{@pages}".html_safe,
          back_href: (fd_audit_path(page: @page - 1) if @page > 1),
          next_href: (fd_audit_path(page: @page + 1) if @page < @pages) %>
  <% else %>
    <div class="empty">
      <p class="empty-title">Nothing logged in 30 days</p>
      <p>Claiming a case, logging an action, or writing a note all land here.</p>
    </div>
  <% end %>
</div>
