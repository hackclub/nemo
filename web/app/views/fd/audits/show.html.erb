<% content_for :page_title, "Audit" %>

<% content_for :head_actions do %>
  <%= form_with url: fd_audit_path, method: :get, class: "queue-search audit-search",
        data: { controller: "live-search", action: "input->live-search#go",
                turbo_action: "advance" } do %>
    <% @query.to_params.except("q", "before_at", "before_id").each do |key, value| %>
      <%= hidden_field_tag key, value, id: nil %>
    <% end %>
    <%= search_field_tag :q, @query.term,
          placeholder: "an address, an email, a handle, or ip: about: did: in:",
          class: "queue-search-input", autocomplete: "off",
          aria: { label: "Search the record" } %>
  <% end %>

  <button type="button" class="btn btn-only" data-modal-open="audit-help"
          aria-haspopup="dialog" aria-label="Audit help">?</button>
<% end %>

<% content_for :page_tabs do %>
  <% @views.each do |view| %>
    <%= link_to fd_audit_path(@query.view_params(view.key)), class: "view",
          aria: { current: ("true" if view.current) } do %>
      <%= view.label %>
      <span class="view-count"><%= number_with_delimiter(view.count) %></span>
    <% end %>
  <% end %>
<% end %>

<div class="stack">
  <%= render "filters" %>

  <% if @query.terms.any? %>
    <div class="chiprow audit-chips">
      <% @query.terms.each do |term| %>
        <%= link_to fd_audit_path(@query.without_params(term)), class: "chip chip-on" do %>
          <%= term.label %> <span aria-hidden="true">&times;</span>
        <% end %>
      <% end %>
      <%= link_to "Clear", fd_audit_path(@query.placed), class: "chip" %>
    </div>
  <% end %>

  <% if @rows.any? %>
    <div class="card card-flush">
      <div class="scroll">
        <table class="data-table audit-table">
          <colgroup>
            <col style="width: 78px">
            <col style="width: 20%">
            <col>
            <col style="width: 20%">
            <col style="width: 160px">
          </colgroup>
          <thead>
            <tr>
              <th>When</th>
              <th>Who</th>
              <th>What</th>
              <th>About</th>
              <th class="audit-tail-head">Slack</th>
            </tr>
          </thead>
          <tbody>
            <%= render partial: "row", collection: @rows, as: :row %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="pagebar">
      <span class="btn is-off">Back</span>
      <span class="pager-at"><%= @query.summary %></span>
      <% if @query.next_params %>
        <%= link_to "Next", fd_audit_path(@query.next_params), class: "btn" %>
      <% else %>
        <span class="btn is-off">Next</span>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <p class="empty-title"><%= @query.empty_note %></p>
    </div>
  <% end %>
</div>

<%= render layout: "fd/modal", locals: { id: "audit-help", title: "Audit Help",
      open: false } do %>
  <div class="modal-body">
    <dl class="audit-help-list">
      <% Fd::AuditQuery::HELP.each do |term, what| %>
        <dt><button type="button" class="chip audit-help-try"
                    data-controller="fill-search" data-action="click->fill-search#use"
                    data-fill-search-term-value="<%= term %>"><%= term %></button></dt>
        <dd><%= what %></dd>
      <% end %>
    </dl>
  </div>
  <div class="modal-foot">
    <button type="button" class="btn btn-ghost" data-action="click->modal#shut">Close</button>
  </div>
<% end %>

<turbo-frame id="audit-panel" class="audit-panel-frame"
  data-controller="person-drawer" target="_top"></turbo-frame>
