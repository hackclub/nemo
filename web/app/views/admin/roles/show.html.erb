<% content_for :page_title, "Roles" %>

<div class="panel">
  <div class="panel-head">
    <span>What each role carries</span>
    <span class="grow"></span>
    <span class="sub2">baselines from db/capabilities.yml, moved at runtime here</span>
  </div>

  <% if @moved.positive? %>
    <div class="warnbar">
      <b><%= pluralize(@moved, "capability") %></b> off the catalogue default.
      A change here reaches every person holding the role.
      <span class="grow"></span>
      <%= gated_button "access.grant", "Put back the defaults", fd_role_permission_path,
            method: :delete,
            form: { data: { turbo_confirm: "Put every capability back to its default?" } } %>
    </div>
  <% end %>

  <div class="scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>capability</th>
          <th class="said-cell">what it lets them do</th>
          <% @roles.each do |role| %>
            <th class="col-num">
              <%= Authz.role_label(role) %>
              <span class="view-count"><%= @holders[role] || 0 %></span>
            </th>
          <% end %>
          <th>state</th>
        </tr>
      </thead>
      <tbody>
        <% @keys.each do |area, keys| %>
          <tr class="band-row">
            <td colspan="<%= @roles.size + 3 %>"><%= area %> &middot; <%= keys.size %></td>
          </tr>
          <% keys.each do |key| %>
            <tr>
              <td class="mono">
                <%= Authz.locked?(key) ? locked_note(key) : key %>
              </td>
              <td class="said-cell"><%= Authz.label(key) %></td>
              <% @roles.each do |role| %>
                <td class="col-num">
                  <%= role_capability_switch(role, key, @overrides[[role, key]]) %>
                </td>
              <% end %>
              <td>
                <% moved = @roles.filter_map { |role| [role, @overrides[[role, key]]] if @overrides[[role, key]] } %>
                <% moved.each do |role, row| %>
                  <span class="chip <%= row.allowed ? "chip-good" : "chip-crit" %>">
                    <%= row.allowed ? "given to" : "taken from" %>
                    <%= Authz.role_label(role).downcase %>
                  </span>
                <% end %>
                <% if Authz.every_account?(key) %>
                  <span class="chip">every member</span>
                <% elsif Authz.locked?(key) %>
                  <span class="chip chip-off">manager only</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="rowform">
    <span class="sub2">
      Community manager holds all <%= Authz.keys.size %> and is not shown as a column.
    </span>
  </div>
</div>
