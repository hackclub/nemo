<% if may_community?("analytics.channel.share") %>
  <%= render layout: "shared/dropdown", locals: {
        label: "Set who may read ##{channel.name}", trigger: menu_dots } do %>
      <% Channels::Audience::KINDS.each do |wanted| %>
        <%= button_to admin_channel_path(channel.channel_id), method: :patch,
              params: { audience: wanted, q: @q.presence }, class: "btn",
              aria: { current: ("true" if wanted == kind) } do %>
          <span class="menu-item-body">
            <span class="menu-item-title"><%= wanted.capitalize %></span>
            <span class="menu-item-note"><%= AdminHelper::AUDIENCE_NOTE.fetch(wanted) %></span>
          </span>
        <% end %>
      <% end %>
      <div class="menu-sep"></div>
      <% Admin::RoleChannelsController::SHARED_ROLES.each do |role| %>
        <% in_set = named.any? { |grant| grant.role == role } %>
        <%= button_to admin_role_channels_path,
              method: in_set ? :delete : :post,
              params: { role: role, channel_id: channel.channel_id,
                        from: "channels", q: @q.presence },
              class: "btn" do %>
          <span class="menu-item-body">
            <span class="menu-item-title"><%= in_set ? "Take out of" : "Give to" %>
              the <%= role_label_text(role) %> set</span>
            <span class="menu-item-note"><%= in_set ? "every #{role_label_text(role)} stops reading it" :
                                                "every #{role_label_text(role)} may read it" %></span>
          </span>
        <% end %>
      <% end %>
      <% if may_community?("analytics.message.show") %>
        <div class="menu-sep"></div>
        <% shown = @activity.include?(channel.channel_id) %>
        <%= button_to activity_admin_channel_path(channel.channel_id), method: :patch,
              params: { shown: shown ? "off" : "on", q: @q.presence }, class: "btn" do %>
          <span class="menu-item-body">
            <span class="menu-item-title"><%= shown ? "Stop showing" : "Show" %> how posts did</span>
            <span class="menu-item-note"><%= shown ? "authors lose the \"view message activity\" shortcut here" :
                                                "authors may ask nemo how their own post did" %></span>
          </span>
        <% end %>
      <% end %>
      <% people = named.select { |grant| grant.user_id.present? } %>
      <% if people.any? %>
        <div class="menu-sep"></div>
        <% people.each do |grant| %>
          <span class="btn">
            <span class="who">
              <%= face(grant.user_id) %>
              <span class="two-line">
                <b><%= person_name(grant.user_id) %></b>
                <span>named by <%= person_name(grant.granted_by) %>,
                  <%= on_day(grant.granted_at) %></span>
              </span>
            </span>
          </span>
        <% end %>
      <% end %>
  <% end %>
<% end %>
