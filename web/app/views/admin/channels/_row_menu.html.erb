<% if may_community?("analytics.channel.share") %>
  <details class="menu" data-controller="menu">
    <summary class="btn btn-only" aria-label="Set who may read #<%= channel.name %>">&hellip;</summary>
    <div class="menu-pop">
      <% Channels::Audience::KINDS.each do |wanted| %>
        <%= button_to admin_channel_path(channel.channel_id), method: :patch,
              params: { audience: wanted, q: @q.presence }, class: "btn",
              aria: { current: ("true" if wanted == kind) } do %>
          <span class="mi-body">
            <span class="mi-t"><%= wanted.capitalize %></span>
            <span class="mi-note"><%= AdminHelper::AUDIENCE_NOTE.fetch(wanted) %></span>
          </span>
        <% end %>
      <% end %>
      <div class="menu-sep"></div>
      <% Admin::RoleChannelsController::SHARED_ROLES.each do |role| %>
        <% in_set = named.any? { |grant| grant.role == role } %>
        <%= button_to admin_role_channels_path,
              method: in_set ? :delete : :post,
              params: { role: role, channel_id: channel.channel_id,
                        from: "channels", q: @q.presence },
              class: "btn" do %>
          <span class="mi-body">
            <span class="mi-t"><%= in_set ? "Take out of" : "Give to" %>
              the <%= role_said(role) %> set</span>
            <span class="mi-note"><%= in_set ? "every #{role_said(role)} stops reading it" :
                                                "every #{role_said(role)} may read it" %></span>
          </span>
        <% end %>
      <% end %>
      <% people = named.select { |grant| grant.user_id.present? } %>
      <% if people.any? %>
        <div class="menu-sep"></div>
        <% people.each do |grant| %>
          <span class="btn">
            <span class="who">
              <%= face(grant.user_id) %>
              <span class="two-line">
                <b><%= @names[grant.user_id] %></b>
                <span>named by <%= @names[grant.granted_by] %>,
                  <%= on_day(grant.granted_at) %></span>
              </span>
            </span>
          </span>
        <% end %>
      <% end %>
    </div>
  </details>
<% end %>
