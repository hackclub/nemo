<% content_for :page_title, @names[@user_id] %>

<div class="admin-split">
  <%= render "admin/nav" %>
  <div class="admin-main">
    <div class="cols c-2">
      <div class="stack">
        <div class="card card-flush">
          <div class="card-head">
            <div class="who">
              <%= face(@user_id) %>
              <span class="two-line">
                <b><%= @names[@user_id] %></b>
                <span class="mono"><%= @user_id %> &middot; <%= acted_label(@last_acted) %></span>
              </span>
            </div>
            <% if may_grant? %>
              <div class="card-tools">
                <%= opens_modal "access.grant", "Edit access", opens: "give-access",
                      css: "btn btn-primary" %>
              </div>
            <% end %>
          </div>

          <% if @implied %>
            <div class="line-row">
              <b>Fire Department</b>
              <span class="chip chip-crit"><%= Fd::Access::MANAGER_LABEL %></span>
              <span class="sub2">holds everything, in both ladders</span>
              <span class="grow"></span>
            </div>
          <% elsif @fd %>
            <div class="line-row">
              <b>Fire Department</b>
              <span class="chip"><%= @fd.role.tr("_", " ") %></span>
              <span class="sub2">since <%= @fd.granted_at.strftime("%b %Y") %>,
                given by <%= @names[@fd.granted_by] %></span>
              <span class="grow"></span>
            </div>
          <% end %>
          <% Community::Permission.families.each do |family| %>
            <% grant = @community.find { |row| row.family == family } %>
            <% implied = implied_role(@user_id, family) %>
            <% next if grant.nil? && implied.nil? %>
            <div class="line-row">
              <b><%= Community::Permission.family_label(family) %></b>
              <%= role_cell(grant&.role, implied: implied) %>
              <% if grant %>
                <span class="sub2">since <%= grant.granted_at.strftime("%b %Y") %>,
                  given by <%= @names[grant.granted_by] %></span>
              <% end %>
              <span class="grow"></span>
            </div>
          <% end %>
          <% if @fd.nil? && @community.empty? && !@implied %>
            <div class="empty"><p class="empty-title">Holds nothing yet</p></div>
          <% end %>

          <% Community::Permission.families.each do |family| %>
            <% role = implied_role(@user_id, family) ||
                 @community.find { |row| row.family == family }&.role %>
            <% may = you_may(role) %>
            <% next if may.empty? %>
            <details class="reveal">
              <summary class="reveal-head">
                <% whole = Community::Permission.keys.count { |key|
                     Community::Permission.family(key) == family } %>
                <span><%= Community::Permission.role_label(role) %>,
                  <%= may.size %> of <%= whole %> permissions</span>
                <span class="reveal-note">what that lets them do</span>
                <span class="car" aria-hidden="true">▾</span>
              </summary>
              <div class="reveal-body">
                <% may.each do |key, label| %>
                  <div class="line-row">
                    <span class="mono"><%= key %></span>
                    <span class="grow"></span>
                    <span class="sub2"><%= label %></span>
                  </div>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>

        <div class="panel">
          <div class="panel-head">
            <span>What they did</span>
            <span class="grow"></span>
            <span class="sub2">last 30 days</span>
          </div>
          <% if @deeds.any? %>
            <div class="scroll">
              <table class="data-table">
                <tbody>
                  <% @deeds.each do |deed| %>
                    <tr>
                      <td><b><%= deed_head(deed) %></b></td>
                      <td class="said-cell"><%= deed_said(deed) %></td>
                      <td class="mono col-num"><%= deed.at.strftime("%-d %b %H:%M") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="empty"><p class="empty-title">Nothing in 30 days</p></div>
          <% end %>
        </div>
      </div>

      <div class="stack">
        <div class="fbox">
          <div class="ft"><span>Grant history</span></div>
          <div class="rows">
            <% (@community + [@fd].compact).each do |grant| %>
              <div class="row">
                <span class="row-k"><%= grant.role.tr("_", " ") %></span>
                <span class="row-v"><%= grant.granted_at&.strftime("%b %Y") || "n/a" %></span>
              </div>
            <% end %>
            <% @past.each do |grant| %>
              <div class="row row-locked">
                <span class="row-k"><%= grant.role.tr("_", " ") %>, taken back</span>
                <span class="row-v"><%= grant.revoked_at&.strftime("%b %Y") || "n/a" %></span>
              </div>
            <% end %>
            <% if @community.empty? && @fd.nil? && @past.empty? %>
              <div class="row"><span class="row-k sub2">never held anything</span></div>
            <% end %>
          </div>
        </div>

        <div class="facts-grid">
          <div class="cell">
            <span class="fg-k">Held since</span>
            <span class="fg-v"><%= @held_since&.strftime("%b %Y") || "n/a" %></span>
          </div>
          <div class="cell">
            <span class="fg-k">Last acted</span>
            <span class="fg-v"><%= acted_label(@last_acted) %></span>
          </div>
          <div class="cell">
            <span class="fg-k">Identity reads</span>
            <span class="fg-v"><%= @identity_reads %></span>
          </div>
          <div class="cell">
            <span class="fg-k">Channels named on</span>
            <span class="fg-v"><%= @channels_named %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% if may_grant? %>
  <%= render "admin/people/give_modal", person: @user_id,
        held: { "fd" => @implied ? Fd::Access::MANAGER_ROLE : @fd&.role }
                .merge(@community.to_h { |g| [g.family, g.role] }) %>
<% end %>
