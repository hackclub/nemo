<% content_for :page_title, "Flags" %>

<div class="stack">
  <div class="panel">
    <div class="panel-head">
      <span>Sections</span>
      <span class="sub">
        <%= @dark.empty? ? "all showing" : "#{@dark.size} of #{@flags.size} dark" %>
      </span>
    </div>
    <div class="list">
      <% @flags.each do |key| %>
        <% row = @flipped[key.to_s] %>
        <div class="lrow">
          <span class="grow">
            <b><%= Fd::Flag.label(key) %></b>
            <span class="sub flag-paths">
              <% routes(key).each do |said, kind| %>
                <% if kind == :path %>
                  <span class="mono"><%= said %></span>
                <% else %>
                  <span><%= said %></span>
                <% end %>
              <% end %>
            </span>
          </span>
          <span class="lrow-right">
            <span class="sub"><%= pluralize(@losers[key], "person") %> lose it</span>
            <span class="sub">
              <% if row&.changed_at %>
                <%= @names[row.changed_by] %>, <%= row.changed_at.strftime("%-d %b") %>
              <% else %>
                never flipped
              <% end %>
            </span>
            <%= flag_switch(key) %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</div>
