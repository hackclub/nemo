<nav class="admin-side" aria-label="Admin">
  <p class="admin-lab">Admin</p>
  <%= link_to "Overview", admin_root_path, class: "admin-link",
        aria: { current: ("page" if controller_path == "admin/overview") } %>
  <%= link_to admin_people_path, class: "admin-link",
        aria: { current: ("page" if controller_path == "admin/people") } do %>
    <span>People</span>
    <% if local_assigns[:people_count] %>
      <span class="view-count"><%= people_count %></span>
    <% end %>
  <% end %>
  <%= link_to "Roles", admin_roles_path, class: "admin-link",
        aria: { current: ("page" if controller_path == "admin/roles") } %>
  <%= link_to admin_channels_path, class: "admin-link",
        aria: { current: ("page" if controller_path == "admin/channels") } do %>
    <span>Channels</span>
    <% if local_assigns[:channel_count] %>
      <span class="view-count"><%= channel_count %></span>
    <% end %>
  <% end %>
  <%= link_to "Flags", admin_flags_path, class: "admin-link",
        aria: { current: ("page" if controller_path == "admin/flags") } %>
</nav>
